	$(MAKE) $(MAKESILENT) -f CMakeFiles/mualibs.dir/build.make CMakeFiles/mualibs.dir/mu_fnl.c.s
.PHONY : mu_fnl.c.s

mu_stb.o: mu_stb.c.o
