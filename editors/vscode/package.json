{
  "name": "mu",
  "displayName": "Mu",
  "description": "Mu language support — syntax highlighting, bracket matching, indentation.",
  "version": "0.1.0",
  "license": "MIT",
  "publisher": "mu",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "mu",
        "aliases": [
          "Mu",
          "mu"
        ],
        "extensions": [
          ".mu"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mu",
        "scopeName": "source.mu",
        "path": "./syntaxes/mu.tmLanguage.json"
      }
    ]
  }
}
