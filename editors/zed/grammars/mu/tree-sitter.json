{
  "name": "mu",
  "version": "0.1.0",
  "description": "Mu programming language grammar for tree-sitter",
  "main": "grammar.js",
  "keywords": ["mu", "language", "tree-sitter"],
  "grammars": [
    {
      "name": "mu",
      "camelCase": "Mu",
      "scope": "source.mu",
      "path": ".",
      "file-types": ["mu"],
      "highlights": "../languages/mu/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "authors": [
      { "name": "Mu Contributors" }
    ],
    "links": {
      "repository": "https://github.com/coralc-lang/Mu"
    }
  },
  "bindings": {
    "c": true,
    "rust": false,
    "node": false,
    "python": false,
    "go": false,
    "swift": false
  },
  "license": "MIT",
  "repository": "https://github.com/coralc-lang/Mu"
}
