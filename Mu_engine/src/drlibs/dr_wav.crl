// dr_wav externs - WAV half of vendored dr_libs (github.com/mackron/
// dr_libs, public domain / MIT-0), for the audio layer at M6 (ENGINE.md
// §14). Declared in the file that matches upstream dr_wav.h; drlibs.crl
// imports them. Implementation: native/mu_drlibs.c → libmualibs.a.
//
// ABI: size_t = usize, drwav_uint64 = u64, channels/sample rate are
// u32* out-params, *_allocation_callbacks engine-null (default malloc).

pub extern rawptr drwav_open_memory_and_read_pcm_frames_f32(const rawptr data, usize dataSize, u32* channelsOut, u32* sampleRateOut, u64* totalFrameCountOut, rawptr pAllocationCallbacks);
pub extern void drwav_free(rawptr p, rawptr pAllocationCallbacks);
