// dr_libs extern port — vendored single headers from github.com/mackron/dr_libs
// (public domain / MIT-0): WAV, MP3 and FLAC whole-file decoders for the
// audio layer (M6, ENGINE.md §14). Implementations compiled from
// native/mu_drlibs.c into libmualibs.a.
//
// ABI notes: size_t = usize, drwav/drmp3/drflac_uint64 = u64, channels and
// sample rate are unsigned int out-params = u32*. The *_allocation_callbacks
// params are engine-null (default malloc). Decoders return a malloc'd
// interleaved f32 PCM buffer — release with the matching wavFree/mp3Free/
// flacFree. Load wrappers return Option: the vendor gives no error string,
// so absence IS the diagnostic (the caller knows which file failed).

import(lib) std::data { option::Option };

pub struct drmp3_config
{
    u32 channels;
    u32 sampleRate;
}

// --- whole-file decode to interleaved f32 ---

pub extern rawptr drwav_open_memory_and_read_pcm_frames_f32(const rawptr data, usize dataSize, u32* channelsOut, u32* sampleRateOut, u64* totalFrameCountOut, rawptr pAllocationCallbacks);
pub extern rawptr drmp3_open_memory_and_read_pcm_frames_f32(const rawptr data, usize dataSize, drmp3_config* pConfig, u64* pTotalFrameCount, rawptr pAllocationCallbacks);
pub extern rawptr drflac_open_memory_and_read_pcm_frames_f32(const rawptr data, usize dataSize, u32* channels, u32* sampleRate, u64* totalPCMFrameCount, rawptr pAllocationCallbacks);

pub extern void drwav_free(rawptr p, rawptr pAllocationCallbacks);
pub extern void drmp3_free(rawptr p, rawptr pAllocationCallbacks);
pub extern void drflac_free(rawptr p, rawptr pAllocationCallbacks);

// --- engine wrappers: Option, since decode failure carries no message ---

pub Option<rawptr> loadWavF32(const rawptr data, usize len, u32* channels, u32* sampleRate, u64* frames)
{
    rawptr pcm = drwav_open_memory_and_read_pcm_frames_f32(data, len, channels, sampleRate, frames, null);
    if (pcm == null) return Option<rawptr>::None;
    return Option<rawptr>::Some { .value = pcm };
}

pub Option<rawptr> loadMp3F32(const rawptr data, usize len, u32* channels, u32* sampleRate, u64* frames)
{
    drmp3_config cfg = drmp3_config { .channels = 0, .sampleRate = 0 };
    rawptr pcm = drmp3_open_memory_and_read_pcm_frames_f32(data, len, &cfg, frames, null);
    if (pcm == null) return Option<rawptr>::None;
    *channels = cfg.channels;
    *sampleRate = cfg.sampleRate;
    return Option<rawptr>::Some { .value = pcm };
}

pub Option<rawptr> loadFlacF32(const rawptr data, usize len, u32* channels, u32* sampleRate, u64* frames)
{
    rawptr pcm = drflac_open_memory_and_read_pcm_frames_f32(data, len, channels, sampleRate, frames, null);
    if (pcm == null) return Option<rawptr>::None;
    return Option<rawptr>::Some { .value = pcm };
}

pub void wavFree(rawptr pcm)
{
    drwav_free(pcm, null);
}

pub void mp3Free(rawptr pcm)
{
    drmp3_free(pcm, null);
}

pub void flacFree(rawptr pcm)
{
    drflac_free(pcm, null);
}
