// dr_mp3 extern port — vendored from github.com/mackron/dr_libs (public
// domain / MIT-0): MP3 whole-file decode for the audio layer (M6,
// ENGINE.md §14). Declared here — the file named after upstream
// dr_mp3.h — and imported by drlibs.crl as though written there.
// Implementation compiled from native/mu_drlibs.c into libmualibs.a.
//
// ABI notes: size_t = usize, drmp3_uint64 = u64, *_allocation_callbacks
// are engine-null (default malloc). The config struct mirrors the C
// header (channels / sample rate fill on success).

pub struct drmp3_config
{
    u32 channels;
    u32 sampleRate;
}

pub extern rawptr drmp3_open_memory_and_read_pcm_frames_f32(const rawptr data, usize dataSize, drmp3_config* pConfig, u64* pTotalFrameCount, rawptr pAllocationCallbacks);
pub extern void drmp3_free(rawptr p, rawptr pAllocationCallbacks);
