// stb extern port — vendored headers from github.com/nothings/stb (public
// domain / MIT). Images (M5 asset load), image write (editor/debug capture)
// and truetype (SDF font baking for the UI, ENGINE.md §9) all ride on stb;
// this module is the single shared declaration. Implementations are
// compiled from native/mu_stb.c into libmualibs.a — nothing to link beyond
// that archive.
//
// ABI notes: stbi_uc = u8, int = i32, pointers = rawptr on the Coral side.
// stbtt_fontinfo is an opaque struct — pass rawptr storage of at least 256
// 8-aligned bytes (InitFont fills it); same for the mz-style caller-buffers
// elsewhere in the engine.

import(lib) std::data { result::Result };
import(lib) std::text::string { String };

// --- stb_image: decode ---

pub extern rawptr stbi_load(const cchar* filename, i32* x, i32* y, i32* comp, i32 desired_channels);
pub extern rawptr stbi_load_from_memory(const rawptr buffer, i32 len, i32* x, i32* y, i32* comp, i32 desired_channels);
pub extern void stbi_image_free(rawptr retval_from_stbi_load);
pub extern const cchar* stbi_failure_reason();
pub extern i32 stbi_info(const cchar* filename, i32* x, i32* y, i32* comp);
pub extern void stbi_set_flip_vertically_on_load(i32 flag_true_if_should_flip);

// --- stb_image_write: encode ---

pub extern i32 stbi_write_png(const cchar* filename, i32 w, i32 h, i32 comp, const rawptr data, i32 stride_in_bytes);
pub extern i32 stbi_write_bmp(const cchar* filename, i32 w, i32 h, i32 comp, const rawptr data);
pub extern i32 stbi_write_tga(const cchar* filename, i32 w, i32 h, i32 comp, const rawptr data);
pub extern i32 stbi_write_jpg(const cchar* filename, i32 x, i32 y, i32 comp, const rawptr data, i32 quality);

// --- stb_truetype: metrics, rasterization, SDF glyphs ---

pub extern i32 stbtt_InitFont(rawptr info, const u8* data, i32 offset);
pub extern f32 stbtt_ScaleForPixelHeight(const rawptr info, f32 pixels);
pub extern void stbtt_GetFontVMetrics(const rawptr info, i32* ascent, i32* descent, i32* line_gap);
pub extern i32 stbtt_FindGlyphIndex(const rawptr info, i32 unicode_codepoint);
pub extern i32 stbtt_GetCodepointBox(const rawptr info, i32 codepoint, i32* x0, i32* y0, i32* x1, i32* y1);
pub extern i32 stbtt_GetGlyphBox(const rawptr info, i32 glyph_index, i32* x0, i32* y0, i32* x1, i32* y1);
pub extern i32 stbtt_GetCodepointAdvance(const rawptr info, i32 codepoint);
pub extern i32 stbtt_GetCodepointKernAdvance(const rawptr info, i32 ch1, i32 ch2);
pub extern rawptr stbtt_GetCodepointBitmap(const rawptr info, f32 scale_x, f32 scale_y, i32 codepoint, i32* width, i32* height, i32* xoff, i32* yoff);
pub extern rawptr stbtt_GetGlyphSDF(const rawptr info, f32 scale, i32 glyph, i32 padding, u8 onedge_value, f32 pixel_dist_scale, i32* width, i32* height, i32* xoff, i32* yoff);
pub extern void stbtt_FreeBitmap(rawptr bitmap, rawptr userdata);

// --- stb_vorbis: Ogg Vorbis decode (audio, M6 — SDL3 outputs, stb decodes) ---
// Returns >0 samples-per-channel on success; error codes are the enum in
// stb_vorbis.c with VORBIS__no_error = 0. Implementation TU: stb_vorbis.c
// compiled directly into libmualibs.a. Handles are opaque (rawptr).

pub const i32 VORBIS_NO_ERROR = 0;

pub extern i32 stb_vorbis_decode_filename(const cchar* filename, i32* channels, i32* sample_rate, i16** output);
pub extern rawptr stb_vorbis_open_memory(const u8* data, i32 len, i32* error, rawptr alloc_buffer);
pub extern i32 stb_vorbis_get_error(rawptr f);
pub extern i32 stb_vorbis_get_samples_short_interleaved(rawptr f, i32 channels, i16* buffer, i32 num_shorts);
pub extern i32 stb_vorbis_seek(rawptr f, u32 sample_number);
pub extern i32 stb_vorbis_seek_start(rawptr f);
pub extern void stb_vorbis_close(rawptr f);

// --- engine wrappers (ENGINE.md §3 error convention) ---

// Decode any stb_image format (PNG, JPEG, BMP, TGA, GIF, HDR, ...) in one
// shot. wantChannels 0 keeps the file's own channel count; on success the
// out-params describe the buffer (free with stbi_image_free). Err owns a
// copied diagnostic — stbi_failure_reason() is a static buffer reused by
// the next load, hence the String copy.
pub Result<rawptr, String> loadImage(const cchar* path, i32 wantChannels, i32* outWidth, i32* outHeight, i32* outChannels)
{
    rawptr px = stbi_load(path, outWidth, outHeight, outChannels, wantChannels);
    if (px == null)
    {
        const cchar* why = stbi_failure_reason();
        if (why != null)
            return Result<rawptr, String>::Err { .error = String::fromCstr(why) };
        return Result<rawptr, String>::Err { .error = String::fromCstr(C"stb_image: decode failed") };
    }
    return Result<rawptr, String>::Ok { .value = px };
}
