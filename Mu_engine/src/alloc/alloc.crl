// Game allocator (ENGINE.md §9): std's mimalloc behind the std Allocator
// fn-ptr table (ctx + alloc/free/realloc). One shared instance for engine
// and game code, initialized on first use.
//
// mimalloc lives recursively under std, not at its top level:
//   std/lib.crl → pub mod allocator = import memory/allocators
//   std/x86_64/{linux,windows}/memory/allocators/mimalloc.crl
// The std manifests pick the platform copy; the import below resolves the
// same way muc's `import(lib) std::data { option::Option, ... }` does.

import(lib) std::allocator { mimalloc::MiAlloc, allocator::Allocator };

static MiAlloc MuAlloc;
static bool MuAllocReady = false;

// The allocator engine and game allocations should go through. Returns the
// shared mimalloc instance, initializing it exactly once.
pub Allocator gameAllocator()
{
    if (!MuAllocReady)
    {
        MuAlloc.init(1024 * 1024);   // initial arena reserve
        MuAllocReady = true;
    }
    return MuAlloc.allocator();
}

// Bytes currently live through the game allocator (0 before first use).
pub usize gameAllocated()
{
    if (!MuAllocReady) return 0;
    return MuAlloc.getUsed();
}
