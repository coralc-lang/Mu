// tinyexr extern port - vendored from github.com/syoyo/tinyexr (BSD-3):
// OpenEXR decode/encode for HDR textures, lightmaps and editor exchange
// (ENGINE.md §9). The implementation is third_party/tinyexr/tinyexr.cc
// (C++ TU, TINYEXR_IMPLEMENTATION) compiled into libmualibs.a; deflate
// comes from OUR miniz - tinyexr does `#include <miniz.h>` off the include
// path and only calls mz_compress / mz_compressBound / mz_uncompress, so
// the binary keeps exactly one copy of mz_*.
//
// ABI notes: int = i32; the `const char** err` out-param is declared
// `const cchar**` (heap message - copy it, then FreeEXRErrorMessage).
// EXRVersion mirrors the C struct (5 x i32, no padding). The struct-heavy
// parse API (EXRHeader / EXRImage / multipart) is ported when M5 needs it;
// LoadEXR covers single-frame RGBA load for now (deprecated upstream but
// still supported - revisit at M5).

import(lib) std::data { result::Result };
import(lib) std::text::string { String };
import(lib) platform::libc;

pub const i32 TINYEXR_SUCCESS = 0;

pub struct EXRVersion
{
    i32 version;
    i32 tiled;
    i32 long_name;
    i32 non_image;
    i32 multipart;
}

pub extern i32 ParseEXRVersionFromFile(EXRVersion* version, const cchar* filename);
pub extern i32 LoadEXR(f32** out_rgba, i32* width, i32* height, const cchar* filename, const cchar** err);
pub extern i32 SaveEXR(const rawptr data, i32 width, i32 height, const cchar* filename, const cchar** err);
pub extern void FreeEXRErrorMessage(const cchar* msg);

// Owned float RGBA buffer; @drop frees it when the ExrImage goes out of
// scope (DESIGN §6). Note the pairing: LoadEXR allocates with the
// vendor's libc malloc, so the free is libc::free - dealloc would hit
// Coral's default allocator (mimalloc), which is a different heap.
pub struct ExrImage
{
    rawptr rgba; // f32 x width x height x 4
    i32 width;
    i32 height;
}

pub extend ExrImage : @drop
{
    void drop()
    {
        libc::free(self.rgba);
    }
}

// Engine wrapper: decode a single-frame EXR into an owned RGBA buffer.
// Err owns a copied diagnostic String - the vendor message is freed before
// returning (that call is tinyexr's own error-buffer protocol, not a
// scope-lifetime free), never a dangling view.
//
//   Result<ExrImage, String> hdr = tinyexr::loadEXR(C"sky.exr").unwrap();
//   ... use hdr.value.rgba ...
//   (hdr goes out of scope at the end - pixels freed with it)
pub Result<ExrImage, String> loadEXR(const cchar* path)
{
    f32* pixels = null;
    i32 w = 0;
    i32 h = 0;
    const cchar* errMsg = null;
    i32 rc = LoadEXR(&pixels, &w, &h, path, &errMsg);
    if (rc != TINYEXR_SUCCESS)
    {
        if (errMsg != null)
        {
            String msg = String::fromCstr(errMsg);
            FreeEXRErrorMessage(errMsg);
            return Result<ExrImage, String>::Err { .error = msg };
        }
        return Result<ExrImage, String>::Err { .error = String::from("tinyexr: decode failed") };
    }
    return Result<ExrImage, String>::Ok { .value = ExrImage { .rgba = (rawptr)pixels, .width = w, .height = h } };
}
