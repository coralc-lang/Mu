// zstd extern port - vendored from github.com/facebook/zstd v1.5.7
// (BSD-3-Clause / GPLv2 dual): runtime compression for saves and cooked
// asset packs (ENGINE.md §17 open item - the codec half of the pack
// format, miniz stays for zip/zlib compat and tinyexr). Sources compile
// into libmualibs.a from native/CMakeLists.txt.
//
// ABI notes: size_t = usize (native width). Errors are usize codes - test
// with ZSTD_isError, get the text with ZSTD_getErrorName. Frame sizes
// return ZSTD_CONTENTSIZE_UNKNOWN (usize -1) for streaming-produced frames.
// Streaming (ZSTD_CCtx / ZSTD_DStream) is deferred until a call site needs
// it; one-shots cover saves and whole-buffer pack entries.

pub extern usize ZSTD_compress(rawptr dst, usize dstCapacity, const rawptr src, usize srcSize, i32 compressionLevel);
pub extern usize ZSTD_decompress(rawptr dst, usize dstCapacity, const rawptr src, usize compressedSize);
pub extern usize ZSTD_compressBound(usize srcSize);
pub extern u32 ZSTD_isError(usize code);
pub extern cchar* ZSTD_getErrorName(usize code);
pub extern u32 ZSTD_versionNumber(void);
pub extern i32 ZSTD_minCLevel(void);
pub extern i32 ZSTD_maxCLevel(void);
pub extern usize ZSTD_findFrameCompressedSize(const rawptr src, usize srcSize);
pub extern usize ZSTD_getFrameContentSize(const rawptr src, usize srcSize);
