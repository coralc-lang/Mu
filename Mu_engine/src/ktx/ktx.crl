// ktx extern port - vendored from github.com/KhronosGroup/KTX-Software
// v4.4.2 (Apache-2.0): KTX2 container + Basis Universal transcoding for
// the GPU texture path (M5 assets; ENGINE.md §9 codecs). libktx builds
// as its own static archives from native/CMakeLists.txt (libktx.a plus
// an astcenc archive on non-Apple hosts); its bundled zstd was dropped so
// the zstd symbols come from libmualibs.a.
//
// ABI notes: ktx_size_t = usize, KTX_error_code = i32 (KTX_SUCCESS = 0),
// ktx_bool_t = C bool = u8 return. ktxTexture/ktxTexture2 are opaque -
// pass rawptr; CreateFromMemory hands back a ktxTexture* that is really a
// ktxTexture2 for KTX2 input, cast aside (same rawptr) for the Transcode
// call. Transcode flag/format values come from ktx_transcode_fmt_e -
// only the subset the engine plans to target is pinned here, check
// include/ktx.h before adding more. numLevels lives in the public
// struct, not in a function - revisit when the engine reads it.

pub const i32 KTX_SUCCESS = 0;
pub const u32 KTX_TEXTURE_CREATE_LOAD_IMAGE_DATA_BIT = 0x01;

// ktx_transcode_fmt_e subset (full enum: KTX-Software include/ktx.h)
pub const i32 KTX_TTF_ETC2_RGBA = 1;
pub const i32 KTX_TTF_BC7_RGBA = 6;
pub const i32 KTX_TTF_ASTC_4x4_RGBA = 10;
pub const i32 KTX_TTF_RGBA32 = 13;

pub extern i32 ktxTexture_CreateFromMemory(const u8* bytes, usize size, u32 createFlags, rawptr* newTex);
pub extern void ktxTexture2_Destroy(rawptr This);
pub extern rawptr ktxTexture_GetData(rawptr This);
pub extern usize ktxTexture_GetDataSize(rawptr This);
pub extern u8 ktxTexture2_NeedsTranscoding(rawptr This);
pub extern i32 ktxTexture2_TranscodeBasis(rawptr This, i32 fmt, u32 transcodeFlags);
pub extern cchar* ktxErrorString(i32 error);
