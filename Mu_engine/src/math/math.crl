// math glue (ENGINE.md §3, core layer) - Vec3/Quat/RVec3 + the ops the
// scene/transform and physics layers share. Single definition: physics.crl
// and scene.crl both import from here, so types never need casting.
// Vector ops are methods so call sites chain: pos.add(q.rotate(off)).

pub struct Vec2
{
    f32 x;
    f32 y;

    static Vec2 new(f32 x, f32 y)
    {
        return Vec2 { .x = x, .y = y };
    }

    Vec2 add(Vec2 other)
    {
        return Vec2 {
            .x = self.x + other.x,
            .y = self.y + other.y
        };
    }

    Vec2 sub(Vec2 other)
    {
        return Vec2 {
            .x = self.x - other.x,
            .y = self.y - other.y
        };
    }

    Vec2 scale(f32 s)
    {
        return Vec2 { .x = self.x * s, .y = self.y * s };
    }

    f32 dot(Vec2 other)
    {
        return self.x * other.x + self.y * other.y;
    }

    f32 lengthSq()
    {
        return self.x * self.x + self.y * self.y;
    }

    f32 length()
    {
        return sqrt(self.lengthSq());
    }

    Vec2 normalize()
    {
        f32 len = self.length();
        if (len < 1e-15) return *self;
        return self.scale(1.0 / len);
    }

    Vec2 lerp(Vec2 other, f32 t)
    {
        return Vec2 {
            .x = self.x + (other.x - self.x) * t,
            .y = self.y + (other.y - self.y) * t
        };
    }
}

pub struct Vec3
{
    f32 x;
    f32 y;
    f32 z;

    static Vec3 new(f32 x, f32 y, f32 z)
    {
        return Vec3 { .x = x, .y = y, .z = z };
    }

    static Vec3 zero()
    {
        return Vec3 { .x = 0.0f, .y = 0.0f, .z = 0.0f };
    }

    static Vec3 one()
    {
        return Vec3 { .x = 1.0f, .y = 1.0f, .z = 1.0f };
    }

    Vec3 add(Vec3 other)
    {
        return Vec3 { .x = self.x + other.x, .y = self.y + other.y, .z = self.z + other.z };
    }

    Vec3 sub(Vec3 other)
    {
        return Vec3 { .x = self.x - other.x, .y = self.y - other.y, .z = self.z - other.z };
    }

    Vec3 scale(f32 s)
    {
        return Vec3 { .x = self.x * s, .y = self.y * s, .z = self.z * s };
    }

    Vec3 componentMul(Vec3 other)
    {
        return Vec3 { .x = self.x * other.x, .y = self.y * other.y, .z = self.z * other.z };
    }

    f32 dot(Vec3 other)
    {
        return self.x * other.x + self.y * other.y + self.z * other.z;
    }

    Vec3 cross(Vec3 other)
    {
        return Vec3 {
            .x = self.y * other.z - self.z * other.y,
            .y = self.z * other.x - self.x * other.z,
            .z = self.x * other.y - self.y * other.x
        };
    }
}

pub struct Quat
{
    f32 x;
    f32 y;
    f32 z;
    f32 w;

    static Quat identity()
    {
        return Quat { .x = 0.0f, .y = 0.0f, .z = 0.0f, .w = 1.0f };
    }

    // Hamilton product: a.mul(b) rotates by b first, then a.
    Quat mul(Quat other)
    {
        return Quat {
            .x = self.w * other.x + self.x * other.w + self.y * other.z - self.z * other.y,
            .y = self.w * other.y - self.x * other.z + self.y * other.w + self.z * other.x,
            .z = self.w * other.z + self.x * other.y - self.y * other.x + self.z * other.w,
            .w = self.w * other.w - self.x * other.x - self.y * other.y - self.z * other.z
        };
    }

    // v' = v + 2q.w*(u×v) + 2*u×(u×v),  u = q.xyz
    Vec3 rotate(Vec3 v)
    {
        Vec3 u = Vec3 { .x = self.x, .y = self.y, .z = self.z };
        Vec3 t = u.cross(v).scale(2.0f);
        return v.add(t.scale(self.w)).add(u.cross(t));
    }
}

pub struct RVec3
{
    f32 x;
    f32 y;
    f32 z;
}
