// FastNoiseLite extern port - vendored C header from github.com/Auburn/FastNoiseLite
// (MIT): procedural noise (open simplex, perlin, value, cellular - fractal
// octaves and domain warp on top) for terrain, textures and effects.
// Header-only C: one implementation TU (native/mu_fnl.c, `#define FNL_IMPL`)
// compiled into libmualibs.a.
//
// ABI notes: fnl_state mirrors the C struct exactly - 15 fields, all 4-byte
// (the C enums are int), no padding. States are created with fnlCreateState
// (which sets the documented defaults!) and tuned by direct field
// assignment before sampling. No failure sites - noise always returns f32
// bounded [-1, 1].

pub struct fnl_state
{
    i32 seed;
    f32 frequency;
    i32 noise_type;
    i32 rotation_type_3d;
    i32 fractal_type;
    i32 octaves;
    f32 lacunarity;
    f32 gain;
    f32 weighted_strength;
    f32 ping_pong_strength;
    i32 cellular_distance_func;
    i32 cellular_return_type;
    f32 cellular_jitter_mod;
    i32 domain_warp_type;
    f32 domain_warp_amp;
}

// noise algorithm - fnl_state.noise_type
pub const i32 FNL_NOISE_OPENSIMPLEX2 = 0;
pub const i32 FNL_NOISE_OPENSIMPLEX2S = 1;
pub const i32 FNL_NOISE_CELLULAR = 2;
pub const i32 FNL_NOISE_PERLIN = 3;
pub const i32 FNL_NOISE_VALUE_CUBIC = 4;
pub const i32 FNL_NOISE_VALUE = 5;

// 3D rotation - fnl_state.rotation_type_3d
pub const i32 FNL_ROTATION_NONE = 0;
pub const i32 FNL_ROTATION_IMPROVE_XY_PLANES = 1;
pub const i32 FNL_ROTATION_IMPROVE_XZ_PLANES = 2;

// fractal combine - fnl_state.fractal_type
pub const i32 FNL_FRACTAL_NONE = 0;
pub const i32 FNL_FRACTAL_FBM = 1;
pub const i32 FNL_FRACTAL_RIDGED = 2;
pub const i32 FNL_FRACTAL_PINGPONG = 3;
pub const i32 FNL_FRACTAL_DOMAIN_WARP_PROGRESSIVE = 4;
pub const i32 FNL_FRACTAL_DOMAIN_WARP_INDEPENDENT = 5;

// cellular distance function - fnl_state.cellular_distance_func
pub const i32 FNL_CELLULAR_DISTANCE_EUCLIDEAN = 0;
pub const i32 FNL_CELLULAR_DISTANCE_EUCLIDEANSQ = 1;
pub const i32 FNL_CELLULAR_DISTANCE_MANHATTAN = 2;
pub const i32 FNL_CELLULAR_DISTANCE_HYBRID = 3;

// cellular return type - fnl_state.cellular_return_type
pub const i32 FNL_CELLULAR_RETURN_TYPE_CELLVALUE = 0;
pub const i32 FNL_CELLULAR_RETURN_TYPE_DISTANCE = 1;
pub const i32 FNL_CELLULAR_RETURN_TYPE_DISTANCE2 = 2;
pub const i32 FNL_CELLULAR_RETURN_TYPE_DISTANCE2ADD = 3;
pub const i32 FNL_CELLULAR_RETURN_TYPE_DISTANCE2SUB = 4;
pub const i32 FNL_CELLULAR_RETURN_TYPE_DISTANCE2MUL = 5;
pub const i32 FNL_CELLULAR_RETURN_TYPE_DISTANCE2DIV = 6;

// domain warp algorithm - fnl_state.domain_warp_type
pub const i32 FNL_DOMAIN_WARP_OPENSIMPLEX2 = 0;
pub const i32 FNL_DOMAIN_WARP_OPENSIMPLEX2_REDUCED = 1;
pub const i32 FNL_DOMAIN_WARP_BASICGRID = 2;

pub extern fnl_state fnlCreateState();
pub extern f32 fnlGetNoise2D(const fnl_state* state, f32 x, f32 y);
pub extern f32 fnlGetNoise3D(const fnl_state* state, f32 x, f32 y, f32 z);
pub extern void fnlDomainWarp2D(const fnl_state* state, f32* x, f32* y);
pub extern void fnlDomainWarp3D(const fnl_state* state, f32* x, f32* y, f32* z);
