// SDL3 extern port — SDL release-3.4.18 (zlib license), vendored at
// third_party/SDL. Window, input events, GL context and audio all ride on
// this one library (ENGINE.md §2), so the C API is declared exactly once
// here and shared by every layer that needs it (platform, input, audio,
// render). Signatures transcribed from include/SDL3/*.h of that tag.
//
// ABI notes: SDL3 returns C `_Bool` (1 byte status) — declared u8 here so
// the value in AL reads identically regardless of Coral's bool width; treat
// nonzero as true. Enums are 32-bit. SDL_Event is a 128-byte 8-aligned
// union whose first member is the event type. Not linked until the M3
// build phase adds SDL3 to `link`.

pub typedef SDL_Window = rawptr;
pub typedef SDL_GLContext = rawptr;
pub typedef SDL_AudioStream = rawptr;
pub typedef SDL_FunctionPointer = rawptr;   // void (*)(void)
pub typedef SDL_AudioDeviceID = u32;
pub typedef SDL_InitFlags = u32;
pub typedef SDL_WindowFlags = u64;
pub typedef SDL_GLAttr = i32;               // C enum
pub typedef SDL_GLProfile = u32;
pub typedef SDL_AudioFormat = u32;          // C enum, 4 bytes

// --- init / error / clock ---

pub const u32 SDL_INIT_AUDIO    = 0x00000010;
pub const u32 SDL_INIT_VIDEO    = 0x00000020;
pub const u32 SDL_INIT_JOYSTICK = 0x00000200;
pub const u32 SDL_INIT_HAPTIC   = 0x00001000;
pub const u32 SDL_INIT_GAMEPAD  = 0x00002000;
pub const u32 SDL_INIT_EVENTS   = 0x00004000;

pub extern u8 SDL_Init(SDL_InitFlags flags);
pub extern u8 SDL_InitSubSystem(SDL_InitFlags flags);
pub extern void SDL_QuitSubSystem(SDL_InitFlags flags);
pub extern SDL_InitFlags SDL_WasInit(SDL_InitFlags flags);
pub extern void SDL_Quit();
pub extern const cchar* SDL_GetError();
pub extern u64 SDL_GetTicksNS();
pub extern u8 SDL_SetAppMetadata(const cchar* appname, const cchar* appversion, const cchar* appidentifier);

// --- window ---

pub const u64 SDL_WINDOW_FULLSCREEN         = 0x0000000000000001;
pub const u64 SDL_WINDOW_OPENGL             = 0x0000000000000002;
pub const u64 SDL_WINDOW_HIDDEN             = 0x0000000000000008;
pub const u64 SDL_WINDOW_RESIZABLE          = 0x0000000000000020;
pub const u64 SDL_WINDOW_HIGH_PIXEL_DENSITY = 0x0000000000002000;

pub extern SDL_Window* SDL_CreateWindow(const cchar* title, i32 w, i32 h, SDL_WindowFlags flags);
pub extern void SDL_DestroyWindow(SDL_Window* window);
pub extern SDL_WindowFlags SDL_GetWindowFlags(SDL_Window* window);
pub extern u8 SDL_SetWindowTitle(SDL_Window* window, const cchar* title);
pub extern u8 SDL_GetWindowSize(SDL_Window* window, i32* w, i32* h);
pub extern u8 SDL_ShowWindow(SDL_Window* window);
pub extern u8 SDL_HideWindow(SDL_Window* window);
pub extern u8 SDL_SetWindowFullscreen(SDL_Window* window, u8 fullscreen);

// --- GL context ---

pub const i32 SDL_GL_RED_SIZE                 = 0;
pub const i32 SDL_GL_GREEN_SIZE               = 1;
pub const i32 SDL_GL_BLUE_SIZE                = 2;
pub const i32 SDL_GL_ALPHA_SIZE               = 3;
pub const i32 SDL_GL_BUFFER_SIZE              = 4;
pub const i32 SDL_GL_DOUBLEBUFFER             = 5;
pub const i32 SDL_GL_DEPTH_SIZE               = 6;
pub const i32 SDL_GL_STENCIL_SIZE             = 7;
pub const i32 SDL_GL_ACCUM_RED_SIZE           = 8;
pub const i32 SDL_GL_ACCUM_GREEN_SIZE         = 9;
pub const i32 SDL_GL_ACCUM_BLUE_SIZE          = 10;
pub const i32 SDL_GL_ACCUM_ALPHA_SIZE         = 11;
pub const i32 SDL_GL_STEREO                   = 12;
pub const i32 SDL_GL_MULTISAMPLEBUFFERS       = 13;
pub const i32 SDL_GL_MULTISAMPLESAMPLES       = 14;
pub const i32 SDL_GL_ACCELERATED_VISUAL       = 15;
pub const i32 SDL_GL_RETAINED_BACKING         = 16;
pub const i32 SDL_GL_CONTEXT_MAJOR_VERSION    = 17;
pub const i32 SDL_GL_CONTEXT_MINOR_VERSION    = 18;
pub const i32 SDL_GL_CONTEXT_FLAGS            = 19;
pub const i32 SDL_GL_CONTEXT_PROFILE_MASK     = 20;
pub const i32 SDL_GL_SHARE_WITH_CURRENT_CONTEXT = 21;
pub const i32 SDL_GL_FRAMEBUFFER_SRGB_CAPABLE = 22;
pub const i32 SDL_GL_CONTEXT_RELEASE_BEHAVIOR = 23;
pub const i32 SDL_GL_CONTEXT_RESET_NOTIFICATION = 24;
pub const i32 SDL_GL_CONTEXT_NO_ERROR         = 25;
pub const i32 SDL_GL_FLOATBUFFERS             = 26;
pub const i32 SDL_GL_EGL_PLATFORM             = 27;

pub const u32 SDL_GL_CONTEXT_PROFILE_CORE          = 0x0001;
pub const u32 SDL_GL_CONTEXT_PROFILE_COMPATIBILITY = 0x0002;
pub const u32 SDL_GL_CONTEXT_PROFILE_ES            = 0x0004;

pub extern SDL_FunctionPointer SDL_GL_GetProcAddress(const cchar* proc);
pub extern u8 SDL_GL_SetAttribute(SDL_GLAttr attr, i32 value);
pub extern SDL_GLContext SDL_GL_CreateContext(SDL_Window* window);
pub extern u8 SDL_GL_DestroyContext(SDL_GLContext context);
pub extern u8 SDL_GL_MakeCurrent(SDL_Window* window, SDL_GLContext context);
pub extern void SDL_GL_SwapWindow(SDL_Window* window);
pub extern SDL_GLContext SDL_GL_GetCurrentContext();

// --- events ---

// 128-byte 8-aligned union; type/reserved/timestamp are the SDL_CommonEvent
// prefix every event shares. Pads reserve the rest for the union members;
// event-specific fields (key scancode, mouse x/y, ...) are decoded at the
// input layer (M3) against these offsets.
pub struct SDL_Event
{
    u32 type;
    u32 reserved;
    u64 timestamp;
    u64 pad0;
    u64 pad1;
    u64 pad2;
    u64 pad3;
    u64 pad4;
    u64 pad5;
    u64 pad6;
    u64 pad7;
    u64 pad8;
    u64 pad9;
    u64 pad10;
    u64 pad11;
    u64 pad12;
    u64 pad13;
}

pub const u32 SDL_EVENT_QUIT                   = 0x100;
pub const u32 SDL_EVENT_WINDOW_CLOSE_REQUESTED = 0x210;
pub const u32 SDL_EVENT_KEY_DOWN               = 0x300;
pub const u32 SDL_EVENT_KEY_UP                 = 0x301;
pub const u32 SDL_EVENT_MOUSE_MOTION           = 0x400;
pub const u32 SDL_EVENT_MOUSE_BUTTON_DOWN      = 0x401;
pub const u32 SDL_EVENT_MOUSE_BUTTON_UP        = 0x402;
pub const u32 SDL_EVENT_MOUSE_WHEEL            = 0x403;
pub const u32 SDL_EVENT_GAMEPAD_AXIS_MOTION    = 0x650;
pub const u32 SDL_EVENT_GAMEPAD_BUTTON_DOWN    = 0x651;

pub extern u8 SDL_PollEvent(SDL_Event* event);
pub extern u8 SDL_WaitEventTimeout(SDL_Event* event, i32 timeoutMS);
pub extern void SDL_FlushEvent(u32 type);
pub extern void SDL_FlushEvents(u32 minType, u32 maxType);
pub extern void SDL_PumpEvents();

// --- audio (M6, decided now: SDL3 audio per ENGINE.md §2) ---

pub const u32 SDL_AUDIO_S16 = 0x8010;
pub const u32 SDL_AUDIO_F32 = 0x8120;

pub struct SDL_AudioSpec
{
    SDL_AudioFormat format;
    i32 channels;
    i32 freq;
}

pub extern SDL_AudioDeviceID SDL_OpenAudioDevice(SDL_AudioDeviceID devid, const SDL_AudioSpec* spec);
pub extern u8 SDL_PauseAudioDevice(SDL_AudioDeviceID devid);
pub extern u8 SDL_ResumeAudioDevice(SDL_AudioDeviceID devid);
pub extern void SDL_CloseAudioDevice(SDL_AudioDeviceID devid);
pub extern SDL_AudioStream* SDL_CreateAudioStream(const SDL_AudioSpec* src_spec, const SDL_AudioSpec* dst_spec);
pub extern u8 SDL_PutAudioStreamData(SDL_AudioStream* stream, const rawptr buf, i32 len);
pub extern i32 SDL_GetAudioStreamQueued(SDL_AudioStream* stream);
pub extern void SDL_DestroyAudioStream(SDL_AudioStream* stream);
pub extern u8 SDL_BindAudioStream(SDL_AudioDeviceID devid, SDL_AudioStream* stream);
// callback ABI: void (void* userdata, SDL_AudioStream*, int additional, int total)
pub extern SDL_AudioStream* SDL_OpenAudioDeviceStream(SDL_AudioDeviceID devid, const SDL_AudioSpec* spec, rawptr callback, rawptr userdata);
