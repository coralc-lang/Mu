// platform layer (ENGINE.md §3) — headless until M3: SDL3 window, event
// pump, and input events land there. Quit is a cross-layer request (script
// natives / window close will call it later).

static bool MuQuitRequested = false;

pub void platformPump()
{
    // M3: SDL3 event pump → input
}

pub void platformRequestQuit()
{
    MuQuitRequested = true;
}

pub bool platformQuitRequested()
{
    return MuQuitRequested;
}
