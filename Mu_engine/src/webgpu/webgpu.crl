// --- native structs ---

pub struct WGPUXlibDisplayHandle
{
    rawptr display;
    i32 screen;
}

pub struct WGPUXcbDisplayHandle
{
    rawptr connection;
    i32 screen;
}

pub struct WGPUWaylandDisplayHandle
{
    rawptr display;
}

// C layout: u32 type, then an anonymous union { xlib, xcb, wayland } of 16
// bytes at offset 8 (max member size 16, align 8). Coral has no in-struct
// union syntax in use anywhere in this repo, so the union is reserved as
// pad0/data0/data1 — same approach as SDL_Event in sdl.crl. Decode the
// active member at the call site against WGPUNativeDisplayHandleType.
pub struct WGPUNativeDisplayHandle
{
    WGPUNativeDisplayHandleType type;
    u32 pad0;
    rawptr data0;
    rawptr data1;
}

