// wgpu-native extern port — hand transcription of packaged/*/include/webgpu/
// webgpu.h + wgpu.h (wgpu-native headers, BSD-3-Clause). All four packaged
// copies are byte-identical apart from CRLF, so this one declaration covers
// every platform. Links against libwgpu_native.a (packaged/*/lib); not added
// to `link` until a renderer backend milestone needs it — same policy as gl.
//
// ABI notes: object handles are opaque pointers (rawptr); WGPUBool = u32,
// WGPUFlags and all flag sets = u64, size_t = usize, char const* = const
// cchar, void* = rawptr, void const* = const rawptr, float = f32,
// double = f64, uint64_t = u64. Enums are u32 typedefs plus module consts
// (Force32 kept 1:1); flag sets are u64 typedefs plus u64 consts. Callback
// fn-pointer typedefs use unnamed params (named fn-ptr params are a parser
// gap per grammar.md). WGPU_*_INIT macros are skipped (zero-init on the
// Coral side), as is the WGPUProcs table (header ships it behind
// WGPU_SKIP_PROCS; we link functions directly).
//
// Platform notes: the headers have zero platform-conditional content, so
// this port is deliberately platform-agnostic — no flag(PLAT) here; the
// platform layer picks the surface source struct (WGPUSurfaceSource*) at
// each call site.
//
// WGPU_DEPTH_CLEAR_VALUE_UNDEFINED (NAN) is intentionally not ported: no
// NAN literal exists anywhere in this repo, and a NaN cannot be written as
// a Coral const. Test a depth clear value for NaN with `x != x` (IEEE-754).

// --- sentinels ---

pub const u32 WGPU_TRUE = 1;
pub const u32 WGPU_FALSE = 0;
pub const u32 WGPU_ARRAY_LAYER_COUNT_UNDEFINED = 0xFFFFFFFF;
pub const u32 WGPU_COPY_STRIDE_UNDEFINED = 0xFFFFFFFF;
pub const u32 WGPU_DEPTH_SLICE_UNDEFINED = 0xFFFFFFFF;
pub const u32 WGPU_LIMIT_U32_UNDEFINED = 0xFFFFFFFF;
pub const u64 WGPU_LIMIT_U64_UNDEFINED = 0xFFFFFFFFFFFFFFFF;
pub const u32 WGPU_MIP_LEVEL_COUNT_UNDEFINED = 0xFFFFFFFF;
pub const u32 WGPU_QUERY_SET_INDEX_UNDEFINED = 0xFFFFFFFF;
pub const usize WGPU_STRLEN = 0xFFFFFFFFFFFFFFFF;
pub const usize WGPU_WHOLE_MAP_SIZE = 0xFFFFFFFFFFFFFFFF;
pub const u64 WGPU_WHOLE_SIZE = 0xFFFFFFFFFFFFFFFF;

// --- utility types ---

pub struct WGPUStringView
{
    const cchar* data;
    usize length;
}

pub typedef WGPUFlags = u64;
pub typedef WGPUBool = u32;

