// --- chain head + compilation structs ---
// WGPUCompilationMessage / WGPUCompilationInfo are hoisted above the
// callback typedefs: WGPUCompilationInfoCallback takes a
// `const WGPUCompilationInfo*`, and Coral resolves typedefs eagerly
// (the header defers it with a C forward declaration).

pub struct WGPUChainedStruct
{
    WGPUChainedStruct* next;
    WGPUSType sType;
}

pub struct WGPUCompilationMessage
{
    WGPUChainedStruct* nextInChain;
    WGPUStringView message;
    WGPUCompilationMessageType type;
    u64 lineNum;
    u64 linePos;
    u64 offset;
    u64 length;
}

pub struct WGPUCompilationInfo
{
    WGPUChainedStruct* nextInChain;
    usize messageCount;
    const WGPUCompilationMessage* messages;
}

// --- callbacks (fn-pointer typedefs, unnamed params) ---

pub typedef WGPUProc = void();
pub typedef WGPUBufferMapCallback = void(WGPUMapAsyncStatus, WGPUStringView, rawptr, rawptr);
pub typedef WGPUCompilationInfoCallback = void(WGPUCompilationInfoRequestStatus, const WGPUCompilationInfo*, rawptr, rawptr);
pub typedef WGPUCreateComputePipelineAsyncCallback = void(WGPUCreatePipelineAsyncStatus, WGPUComputePipeline, WGPUStringView, rawptr, rawptr);
pub typedef WGPUCreateRenderPipelineAsyncCallback = void(WGPUCreatePipelineAsyncStatus, WGPURenderPipeline, WGPUStringView, rawptr, rawptr);
pub typedef WGPUDeviceLostCallback = void(const WGPUDevice*, WGPUDeviceLostReason, WGPUStringView, rawptr, rawptr);
pub typedef WGPUPopErrorScopeCallback = void(WGPUPopErrorScopeStatus, WGPUErrorType, WGPUStringView, rawptr, rawptr);
pub typedef WGPUQueueWorkDoneCallback = void(WGPUQueueWorkDoneStatus, WGPUStringView, rawptr, rawptr);
pub typedef WGPURequestAdapterCallback = void(WGPURequestAdapterStatus, WGPUAdapter, WGPUStringView, rawptr, rawptr);
pub typedef WGPURequestDeviceCallback = void(WGPURequestDeviceStatus, WGPUDevice, WGPUStringView, rawptr, rawptr);
pub typedef WGPUUncapturedErrorCallback = void(const WGPUDevice*, WGPUErrorType, WGPUStringView, rawptr, rawptr);

// --- callback infos ---

