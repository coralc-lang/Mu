// JoltC C API port — JoltC v5.6.0 (EvergineTeam/JoltPhysicsC, MIT),
// bound against Jolt 5.6.0 in third_party/jolt.
// ABI note: RVec3/Vec3/Quat are single precision (JOLTC_DOUBLE_PRECISION OFF).

import math::math { Vec3, Quat, RVec3 };

pub typedef PhysicsSystem = rawptr;
pub typedef BodyInterface = rawptr;
pub typedef TempAllocator = rawptr;
pub typedef JobSystem = rawptr;
pub typedef ObjectLayerPairFilter = rawptr;
pub typedef BroadPhaseLayerInterface = rawptr;
pub typedef ObjectVsBroadPhaseLayerFilter = rawptr;
pub typedef Shape = rawptr;
pub typedef BodyCreationSettings = rawptr;

pub typedef BodyID = u32;
pub typedef SubShapeID = u32;
pub typedef ObjectLayer = u16;
pub typedef BroadPhaseLayer = u8;
pub typedef CBool = i32;

pub const i32 MOTION_STATIC = 0;
pub const i32 MOTION_KINEMATIC = 1;
pub const i32 MOTION_DYNAMIC = 2;

pub const i32 ACTIVATE = 0;
pub const i32 DONT_ACTIVATE = 1;

pub const i32 BODY_RIGID = 0;
pub const i32 BODY_SOFT = 1;

// --- init / error ---

pub extern i32 JoltC_Init();
pub extern void JoltC_Shutdown();
pub extern const cchar* JoltC_GetLastError();
pub extern void JoltC_ClearLastError();

// --- temp allocator / job system ---

pub extern TempAllocator JoltC_TempAllocator_Create(u32 size);
pub extern void JoltC_TempAllocator_Destroy(TempAllocator allocator);
pub extern JobSystem JoltC_JobSystemThreadPool_Create(u32 maxJobs, u32 maxBarriers, i32 numThreads);
pub extern void JoltC_JobSystem_Destroy(JobSystem jobSystem);

// --- layer filters / broadphase mapping ---

pub extern ObjectLayerPairFilter JoltC_ObjectLayerPairFilterTable_Create(u32 numObjectLayers);
pub extern void JoltC_ObjectLayerPairFilterTable_EnableCollision(ObjectLayerPairFilter filter, ObjectLayer layer1, ObjectLayer layer2);
pub extern void JoltC_ObjectLayerPairFilterTable_DisableCollision(ObjectLayerPairFilter filter, ObjectLayer layer1, ObjectLayer layer2);
pub extern CBool JoltC_ObjectLayerPairFilterTable_ShouldCollide(const ObjectLayerPairFilter filter, ObjectLayer layer1, ObjectLayer layer2);
pub extern void JoltC_ObjectLayerPairFilter_Destroy(ObjectLayerPairFilter filter);

pub extern BroadPhaseLayerInterface JoltC_BroadPhaseLayerInterfaceTable_Create(u32 numObjectLayers, u32 numBroadPhaseLayers);
pub extern void JoltC_BroadPhaseLayerInterfaceTable_MapObjectToBroadPhaseLayer(BroadPhaseLayerInterface iface, ObjectLayer objectLayer, BroadPhaseLayer broadPhaseLayer);
pub extern void JoltC_BroadPhaseLayerInterface_Destroy(BroadPhaseLayerInterface iface);

pub extern ObjectVsBroadPhaseLayerFilter JoltC_ObjectVsBroadPhaseLayerFilterTable_Create(const BroadPhaseLayerInterface bpInterface, u32 numBroadPhaseLayers, const ObjectLayerPairFilter objectFilter, u32 numObjectLayers);
pub extern void JoltC_ObjectVsBroadPhaseLayerFilter_Destroy(ObjectVsBroadPhaseLayerFilter filter);

// --- physics system ---

pub extern PhysicsSystem JoltC_PhysicsSystem_Create();
pub extern void JoltC_PhysicsSystem_Destroy(PhysicsSystem system);
pub extern void JoltC_PhysicsSystem_Init(PhysicsSystem system, u32 maxBodies, u32 numBodyMutexes, u32 maxBodyPairs, u32 maxContactConstraints, BroadPhaseLayerInterface broadPhaseLayerInterface, ObjectVsBroadPhaseLayerFilter objectVsBroadPhaseLayerFilter, ObjectLayerPairFilter objectLayerPairFilter);
pub extern u32 JoltC_PhysicsSystem_Update(PhysicsSystem system, f32 deltaTime, i32 collisionSteps, TempAllocator tempAllocator, JobSystem jobSystem);
pub extern void JoltC_PhysicsSystem_OptimizeBroadPhase(PhysicsSystem system);
pub extern void JoltC_PhysicsSystem_SetGravity(PhysicsSystem system, Vec3 gravity);
pub extern Vec3 JoltC_PhysicsSystem_GetGravity(const PhysicsSystem system);
pub extern BodyInterface JoltC_PhysicsSystem_GetBodyInterface(PhysicsSystem system);
pub extern u32 JoltC_PhysicsSystem_GetNumBodies(const PhysicsSystem system);
pub extern u32 JoltC_PhysicsSystem_GetNumActiveBodies(const PhysicsSystem system, i32 bodyType);

// --- body creation settings ---

pub extern BodyCreationSettings JoltC_BodyCreationSettings_Create3(const Shape shape, RVec3 position, Quat rotation, i32 motionType, ObjectLayer objectLayer);
pub extern void JoltC_BodyCreationSettings_Destroy(BodyCreationSettings settings);
pub extern void JoltC_BodyCreationSettings_SetLinearVelocity(BodyCreationSettings settings, const Vec3* value);

// --- body interface ---

pub extern BodyID JoltC_BodyInterface_CreateAndAddBody(BodyInterface iface, BodyCreationSettings settings, i32 activation);
pub extern void JoltC_BodyInterface_RemoveBody(BodyInterface iface, BodyID bodyID);
pub extern void JoltC_BodyInterface_DestroyBody(BodyInterface iface, BodyID bodyID);
pub extern CBool JoltC_BodyInterface_IsAdded(const BodyInterface iface, BodyID bodyID);
pub extern RVec3 JoltC_BodyInterface_GetPosition(const BodyInterface iface, BodyID bodyID);
pub extern void JoltC_BodyInterface_GetPositionAndRotation(const BodyInterface iface, BodyID bodyID, RVec3* outPosition, Quat* outRotation);
pub extern Quat JoltC_BodyInterface_GetRotation(const BodyInterface iface, BodyID bodyID);
pub extern Vec3 JoltC_BodyInterface_GetLinearVelocity(const BodyInterface iface, BodyID bodyID);
pub extern void JoltC_BodyInterface_SetLinearVelocity(BodyInterface iface, BodyID bodyID, Vec3 velocity);
pub extern void JoltC_BodyInterface_AddLinearVelocity(BodyInterface iface, BodyID bodyID, Vec3 velocity);
pub extern void JoltC_BodyInterface_AddForce(BodyInterface iface, BodyID bodyID, Vec3 force);
pub extern void JoltC_BodyInterface_AddForceAtPosition(BodyInterface iface, BodyID bodyID, Vec3 force, RVec3 point);
pub extern void JoltC_BodyInterface_ActivateBody(BodyInterface iface, BodyID bodyID);

// --- shapes ---

pub extern Shape JoltC_BoxShape_Create(Vec3 halfExtent, f32 convexRadius);
pub extern Shape JoltC_SphereShape_Create(f32 radius);
pub extern void JoltC_Shape_Release(const Shape shape);
