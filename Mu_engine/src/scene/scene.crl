// Scene model (ENGINE.md §4): entity records (stable u32 id, alive flag),
// transform hierarchy (parent pointers, composed top-down each update),
// per-type component storage appended by entity id.
// No id recycling yet (open item) — ids bump, destroy only clears alive.
// Operations are methods on Scene/ComponentStore; compose chains the math
// layer: pos.add(parentRot.rotate(localPos.componentMul(parentScale))).

import math::math { Vec3, Quat };
import(lib) std::data { option::Option, result::Result };

pub typedef EntityId = u32;

pub const u32 NIL = 0xFFFFFFFF;

pub struct Transform
{
    Vec3 position;
    Quat rotation;
    Vec3 scale;

    static Transform zero()
    {
        return Transform {
            .position = Vec3.zero(),
            .rotation = Quat.identity(),
            .scale = Vec3.one()
        };
    }
}

pub struct Entity
{
    EntityId id;
    bool alive;
    EntityId parent;
    Transform local;
    Transform world;
}

pub struct Scene
{
    Entity* entities;    // caller-provided storage, indexed by id
    u32 capacity;
    u32 count;           // bump cursor: ids 0..count-1 have been created

    static Scene new(Entity* storage, u32 capacity)
    {
        return Scene { .entities = storage, .capacity = capacity, .count = 0 };
    }

    // Walk up from candidate to root; true if `child` is on that chain.
    bool _ancestorOf(EntityId candidate, EntityId child)
    {
        EntityId cur = candidate;
        u32 guard = 0;
        while (cur != NIL && guard <= self.count)
        {
            if (cur == child) return true;
            cur = self.entities[cur].parent;
            guard = guard + 1;
        }
        return false;
    }

    void _composeWorld(EntityId id)
    {
        Entity* e = &self.entities[id];
        if (e->parent == NIL)
        {
            e->world = e->local;
            return;
        }
        self._composeWorld(e->parent);
        Entity* p = &self.entities[e->parent];

        // world = parentWorld ∘ local (uniform-scale exact; non-uniform
        // scale under rotation is intentionally unsupported at M0)
        e->world.position = p->world.position.add(
            p->world.rotation.rotate(e->local.position.componentMul(p->world.scale)));
        e->world.rotation = p->world.rotation.mul(e->local.rotation);
        e->world.scale = p->world.scale.componentMul(e->local.scale);
    }

    // None when storage is full — no id to hand out (ENGINE.md §3 error
    // convention: absence has no message, so Option).
    Option<EntityId> create()
    {
        if (self.count >= self.capacity) return Option<EntityId>::None;
        EntityId id = self.count;
        self.count = self.count + 1;

        Entity* e = &self.entities[id];
        e->id = id;
        e->alive = true;
        e->parent = NIL;
        e->local = Transform.zero();
        e->world = Transform.zero();
        return Option<EntityId>::Some { .value = id };
    }

    // Mark dead and detach children (they become roots). Ids are not recycled.
    void destroy(EntityId id)
    {
        if (id >= self.count) return;
        if (!self.entities[id].alive) return;
        self.entities[id].alive = false;
        for (u32 i = 0; i < self.count; i++)
        {
            if (self.entities[i].alive && self.entities[i].parent == id)
                self.entities[i].parent = NIL;
        }
    }

    bool alive(EntityId id)
    {
        if (id >= self.count) return false;
        return self.entities[id].alive;
    }

    // parent = NIL roots the child. Rejects cycles (parent is a descendant).
    // Ok carries the child id; Err carries why the reparent was rejected —
    // the caller may log it (ENGINE.md §3 error convention).
    Result<EntityId, str> setParent(EntityId child, EntityId parent)
    {
        if (child >= self.count || !self.entities[child].alive)
            return Result<EntityId, str>::Err { .error = "setParent: child is dead or invalid" };
        if (parent != NIL)
        {
            if (parent >= self.count || !self.entities[parent].alive)
                return Result<EntityId, str>::Err { .error = "setParent: parent is dead or invalid" };
            if (self._ancestorOf(parent, child))
                return Result<EntityId, str>::Err { .error = "setParent: cycle rejected — parent is a descendant of child" };
        }
        self.entities[child].parent = parent;
        return Result<EntityId, str>::Ok { .value = child };
    }

    // The system the loop runs each frame: compose every alive entity's
    // world transform (parents compose first; acyclic by setParent).
    void update(f32 dt)
    {
        for (u32 i = 0; i < self.count; i++)
        {
            if (self.entities[i].alive)
                self._composeWorld(i);
        }
    }
}

// --- per-type component storage (sparse slot per entity id) ---

pub struct ComponentStore
{
    rawptr data;         // stride * capacity bytes, slot indexed by entity id
    u8* present;         // per-entity flag
    u32 stride;
    u32 capacity;
    u32 used;

    static ComponentStore new(rawptr data, u8* present, u32 capacity, u32 stride)
    {
        ComponentStore store = ComponentStore {
            .data = data, .present = present, .stride = stride,
            .capacity = capacity, .used = 0
        };
        for (u32 i = 0; i < capacity; i++)
        {
            store.present[i] = 0;
            u8* p = (u8*)store.data + (usize)i * stride;
            for (u32 b = 0; b < stride; b++) p[b] = 0;
        }
        return store;
    }

    // Ok carries the id; Err when out of range or the slot is taken.
    Result<EntityId, str> add(EntityId id)
    {
        if (id >= self.capacity)
            return Result<EntityId, str>::Err { .error = "component add: entity id out of range" };
        if (self.present[id] != 0)
            return Result<EntityId, str>::Err { .error = "component add: slot already used" };
        self.present[id] = 1;
        self.used = self.used + 1;
        return Result<EntityId, str>::Ok { .value = id };
    }

    void remove(EntityId id)
    {
        if (id >= self.capacity) return;
        if (self.present[id] == 0) return;
        self.present[id] = 0;
        self.used = self.used - 1;
    }

    bool has(EntityId id)
    {
        if (id >= self.capacity) return false;
        return self.present[id] != 0;
    }

    // None when absent (lookup miss is data, not a failure — Option).
    // Caller casts to its component type.
    Option<rawptr> get(EntityId id)
    {
        if (id >= self.capacity) return Option<rawptr>::None;
        if (self.present[id] == 0) return Option<rawptr>::None;
        return Option<rawptr>::Some { .value = (rawptr)((u8*)self.data + (usize)id * self.stride) };
    }
}
