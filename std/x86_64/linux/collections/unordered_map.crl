import(lib) std::option { Option };
import hashmap { HashMap };
import vec { Vec };

pub struct UnorderedMap<K, V>
{
    HashMap<K, V> inner;

    #[[inline]]
    static UnorderedMap<K, V> new(usize(K) hf, bool(K, K) ef) { return UnorderedMap<K, V> { .inner = HashMap<K, V>::new(hf, ef) }; }
    #[[inline]] void dispose() { self.inner.dispose(); }
    #[[inline]] usize count() { return self.inner.count(); }
    #[[inline]] bool isEmpty() { return self.inner.count() == 0; }
    #[[inline]] void insert(K key, V value) { self.inner.insert(key, value); }
    #[[inline]] Option<V> get(K key) { return self.inner.get(key); }
    #[[inline]] V* getPtr(K key) { return self.inner.getPtr(key); }
    #[[inline]] bool contains(K key) { return self.inner.contains(key); }
    #[[inline]] void remove(K key) { self.inner.remove(key); }
    #[[inline]] void clear() { self.inner.clear(); }
    #[[inline]] Vec<K> keys() { return self.inner.keys(); }
    #[[inline]] Vec<V> values() { return self.inner.values(); }
    #[[inline]] void each(void(K, V) fn) { self.inner.each(fn); }
}

pub extend<K, V> UnorderedMap<K, V> : @drop
{
    #[[inline]]
    void drop() { self.dispose(); }
}
