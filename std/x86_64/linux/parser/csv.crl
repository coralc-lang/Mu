import(lib) std::text::string { String };
import(lib) std::vec { Vec };

pub struct CsvReader
{
    const u8* data;
    usize len;
    usize pos;
    usize line;
    bool error;
    u8 delim;

    static CsvReader new(str input)
    {
        return CsvReader {
            .data = input.ptr,
            .len = input.len,
            .pos = 0,
            .line = 1,
            .error = false,
            .delim = ','
        };
    }

    bool eof() { return self.pos >= self.len; }

    bool _readField(String* out)
    {
        if (self.pos >= self.len) { self.error = true; return false; }
        out->clear();
        if (self.data[self.pos] == '\"')
        {
            self.pos++;
            bool quoted = true;
            while (self.pos < self.len && quoted)
            {
                u8 c = self.data[self.pos++];
                if (c == '\"')
                {
                    if (self.pos < self.len && self.data[self.pos] == '\"')
                    {
                        out->pushByte('\"');
                        self.pos++;
                    }
                    else quoted = false;
                }
                else out->pushByte(c);
            }
            if (quoted)
            {
                self.error = true;
                return false;
            }
            if (self.pos < self.len && self.data[self.pos] != self.delim && self.data[self.pos] != '\n' && self.data[self.pos] != '\r')
            {
                self.error = true;
                return false;
            }
        }
        else {
            while (self.pos < self.len)
            {
                u8 c = self.data[self.pos];
                if (c == self.delim || c == '\n' || c == '\r') break;
                out->pushByte(c);
                self.pos++;
            }
        }
        return true;
    }

    bool readRow(Vec<String>* fields)
    {
        for (usize i = 0; i < fields->count(); i++)
            fields->atPtr(i)->free();
        fields->clear();
        if (self.pos >= self.len) return false;
        loop {
            String field = String::new();
            if (!self._readField(&field)) { fields->push(field); return false; }
            fields->push(field);
            if (self.pos >= self.len) break;
            if (self.data[self.pos] == self.delim) { self.pos++; continue; }
            if (self.data[self.pos] == '\r') { self.pos++; }
            if (self.pos < self.len && self.data[self.pos] == '\n') { self.pos++; self.line++; break; }
            break;
        }
        return true;
    }
}
