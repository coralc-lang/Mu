import(lib) std::text::string { String };
import ios { println, eprintln };

pub variant LogLevel
{
    Debug,
    Info,
    Warn,
    Error,
    Fatal
}

pub struct Logger
{
    LogLevel minLevel;
    String name;

    #[[inline]]
    static Logger new(str name, LogLevel minLevel) { return Logger { .name = String::fromView(name), .minLevel = minLevel }; }

    #[[inline]] void dispose() { self.name.free(); }
    #[[inline]] void setLevel(LogLevel level) { self.minLevel = level; }
    #[[inline]] bool enabled(LogLevel level) { return level >= self.minLevel; }

    void _log(LogLevel level, str msg)
    {
        if (level < self.minLevel) return;
        str label;
        switch (level)
        {
            LogLevel::Debug => { label = "DEBUG"; },
            LogLevel::Info => { label = "INFO"; },
            LogLevel::Warn => { label = "WARN"; },
            LogLevel::Error => { label = "ERROR"; },
            else => { label = "FATAL"; }
        }
        if (level == LogLevel::Error || level == LogLevel::Fatal) {
            eprintln("[{}][{}] {}", label, self.name.asView(), msg) }
        else {
            println("[{}][{}] {}", label, self.name.asView(), msg) }
    }

    #[[inline]]
    void debug(str msg) { self._log(LogLevel::Debug, msg); }
    #[[inline]]
    void info(str msg) { self._log(LogLevel::Info, msg); }
    #[[inline]]
    void warn(str msg) { self._log(LogLevel::Warn, msg); }
    #[[inline]]
    void error(str msg) { self._log(LogLevel::Error, msg); }
    #[[inline]]
    void fatal(str msg) { self._log(LogLevel::Fatal, msg); }
}
