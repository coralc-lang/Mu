import(lib) platform::libc { close, socket, connect, bind, listen, accept, send, recv, sendto, recvfrom, setsockopt, htonl, htons };

const i32 AF_INET = 2;
const i32 SOCK_STREAM = 1;
const i32 SOCK_DGRAM = 2;
const i32 IPPROTO_TCP = 6;
const i32 IPPROTO_UDP = 17;
const i32 SOL_SOCKET = 1;
const i32 SO_REUSEADDR = 2;

pub struct sockaddr_in
{
    u16 sinFamily;
    u16 sinPort;
    u32 sinAddr;
    u8 sinZero[8];
}

static bool _parseIp(str ip, u32* out)
{
    u32 octet = 0;
    u32 addrVal = 0;
    u32 shift = 24;
    u32 octets = 0;
    bool octetHasDigit = false;
    for (usize i = 0; i <= ip.len; i++)
    {
        if (i == ip.len || ip.ptr[i] == '.')
        {
            if (!octetHasDigit || octet > 255) return false;
            addrVal |= (octet << shift);
            octet = 0;
            octetHasDigit = false;
            octets++;
            if (shift > 0) shift -= 8;
        }
        else
        {
            if (ip.ptr[i] < '0' || ip.ptr[i] > '9') return false;
            octet = octet * 10 + (u32)(ip.ptr[i] - '0');
            if (octet > 255) return false;
            octetHasDigit = true;
        }
    }
    if (octets != 4) return false;
    *out = htonl(addrVal);
    return true;
}

static void _zeroSockaddr(sockaddr_in* a)
{
    for (usize i = 0; i < 8; i++) a->sinZero[i] = 0;
}

pub distinct TcpSocket = i32;

pub TcpSocket tcpConnect(str ip, u16 port)
{
    i32 fd = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
    if (fd < 0) return (TcpSocket)(-1);

    u32 ipAddr;
    if (!_parseIp(ip, &ipAddr)) { close(fd); return (TcpSocket)(-1); }

    sockaddr_in addr;
    _zeroSockaddr(&addr);
    addr.sinFamily = AF_INET;
    addr.sinPort = htons(port);
    addr.sinAddr = ipAddr;

    if (connect(fd, (const rawptr)&addr, 16) < 0)
    {
        close(fd);
        return (TcpSocket)(-1);
    }
    return (TcpSocket)fd;
}

pub TcpSocket tcpListen(u16 port)
{
    i32 fd = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
    if (fd < 0) return (TcpSocket)(-1);

    // source bug, this was a 5-argument call to sendto (which takes 6);
    // the shape is setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, ...) — fixed.
    i32 optval = 1;
    setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, (const u8*)&optval, 4);

    sockaddr_in addr;
    _zeroSockaddr(&addr);
    addr.sinFamily = AF_INET;
    addr.sinPort = htons(port);
    addr.sinAddr = htonl(0u);
    if (bind(fd, (const rawptr)&addr, 16) < 0) { close(fd); return (TcpSocket)(-1); }
    if (listen(fd, 128) < 0) { close(fd); return (TcpSocket)(-1); }
    return (TcpSocket)fd;
}

pub TcpSocket tcpAccept(TcpSocket server)
{
    sockaddr_in addr;
    i32 addrLen = 16;
    i32 fd = accept((i32)server, (rawptr)&addr, &addrLen);
    return (TcpSocket)fd;
}

pub isize tcpSend(TcpSocket sock, const u8* buf, usize len)
{
    usize sent = 0;
    while (sent < len)
    {
        i64 n = send((i32)sock, buf + sent, len - sent, 0);
        if (n <= 0) return n < 0 ? n : (isize)sent;
        sent += (usize)n;
    }
    return (isize)sent;
}

pub isize tcpRecv(TcpSocket sock, u8* buf, usize len)
{
    usize got = 0;
    while (got < len)
    {
        i64 n = recv((i32)sock, buf + got, len - got, 0);
        if (n <= 0) return n < 0 ? n : (isize)got;
        got += (usize)n;
    }
    return (isize)got;
}

pub void tcpClose(TcpSocket sock)
{
    close((i32)sock);
}

pub struct UdpSocket
{
    i32 fd;
}

pub UdpSocket udpSocket()
{
    return UdpSocket { .fd = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP) };
}

pub bool udpBind(UdpSocket* s, u16 port)
{
    if (s->fd < 0) return false;
    sockaddr_in addr;
    _zeroSockaddr(&addr);
    addr.sinFamily = AF_INET;
    addr.sinPort = htons(port);
    addr.sinAddr = htonl(0u);
    return bind(s->fd, (const rawptr)&addr, 16) == 0;
}

pub isize udpSendTo(UdpSocket* s, const u8* buf, usize len, str ip, u16 port)
{
    if (s->fd < 0) return -1;
    u32 ipAddr;
    if (!_parseIp(ip, &ipAddr)) return -1;
    sockaddr_in addr;
    _zeroSockaddr(&addr);
    addr.sinFamily = AF_INET;
    addr.sinPort = htons(port);
    addr.sinAddr = ipAddr;
    return sendto(s->fd, buf, len, 0, (const rawptr)&addr, 16);
}

pub isize udpRecvFrom(UdpSocket* s, u8* buf, usize len)
{
    if (s->fd < 0) return -1;
    return recvfrom(s->fd, buf, len, 0, null, null);
}

pub void udpClose(UdpSocket* s)
{
    if (s->fd >= 0) close(s->fd);
    s->fd = -1;
}
