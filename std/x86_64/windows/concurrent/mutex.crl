// Win32 port, pthread_mutex_* -> CRITICAL_SECTION.
import(lib) platform::win32 { InitCriticalSection, DeleteCriticalSection, EnterCriticalSection, LeaveCriticalSection, TryEnterCriticalSection };

pub struct Mutex
{
    // 40B on x64 (RTL_CRITICAL_SECTION) — FLAGGED; array form so self._cs
    // passes by address, like the old pthread impl buffer.
    u8 _cs[40];

    #[[inline]]
    void init() {
        InitCriticalSection(self._cs);
    }
    void initRecursive()
    {
        // FLAG, CRITICAL_SECTION is always recursive, so
        // PTHREAD_MUTEX_RECURSIVE needs no equivalent.
        InitCriticalSection(self._cs);
    }

    #[[inline]]
    void destroy() { DeleteCriticalSection(self._cs); }
    #[[inline]]
    void lock() { EnterCriticalSection(self._cs); }
    #[[inline]]
    void unlock() { LeaveCriticalSection(self._cs); }
    #[[inline]]
    bool tryLock() { return TryEnterCriticalSection(self._cs); }
}
