import mutex { Mutex };
import thread { ConditionVar, Thread, threadCreate, threadJoin };
import(lib) std::mman { alloc, dealloc };

struct Task
{
    void(rawptr) func;
    rawptr arg;
    Task* next;
}

pub struct ThreadPool
{
    Mutex mutex;
    ConditionVar cond;
    Thread* threads;
    Task* queueHead;
    Task* queueTail;
    u32 threadCount;
    bool stop;

    bool init(u32 numThreads)
    {
        self.mutex.init();
        self.cond.init();
        self.queueHead = null;
        self.queueTail = null;
        self.threadCount = numThreads;
        self.stop = false;

        if (numThreads == 0) return false;
        self.threads = alloc<Thread>(numThreads);
        if (self.threads == null) return false;
        for (u32 i = 0; i < numThreads; i++)
        {
            self.threads[i] = threadCreate(_workerEntry, (rawptr)self);
            if (self.threads[i] == (Thread)0)
            {
                self.stop = true;
                self.cond.broadcast();
                for (u32 j = 0; j < i; j++)
                    threadJoin(self.threads[j], null);
                dealloc<Thread>(self.threads);
                self.threads = null;
                return false;
            }
        }
        return true;
    }

    void deinit()
    {
        self.mutex.lock();
        self.stop = true;
        self.mutex.unlock();
        self.cond.broadcast();

        for (u32 i = 0; i < self.threadCount; i++)
            threadJoin(self.threads[i], null);

        self.mutex.lock();
        while (self.queueHead != null) {
            Task* t = self.queueHead;
            self.queueHead = t->next;
            dealloc<Task>(t);
        }
        self.mutex.unlock();

        dealloc<Thread>(self.threads);
        self.threads = null;
        self.mutex.destroy();
        self.cond.destroy();
    }

    bool enqueue(void(rawptr) func, rawptr arg)
    {
        if (func == null) return false;

        Task* t = alloc<Task>(1);
        if (t == null) return false;
        t->func = func;
        t->arg = arg;
        t->next = null;

        self.mutex.lock();
        if (self.stop) { self.mutex.unlock(); dealloc<Task>(t); return false; }
        if (self.queueTail != null) self.queueTail->next = t;
        else self.queueHead = t;
        self.queueTail = t;
        self.mutex.unlock();
        self.cond.signal();
        return true;
    }

    u32 threadCount() { return self.threadCount; }

    void _worker()
    {
        loop {
            self.mutex.lock();
            while (self.queueHead == null && !self.stop)
                self.cond.wait(&self.mutex);

            if (self.stop && self.queueHead == null) {
                self.mutex.unlock();
                return;
            }

            Task* t = self.queueHead;
            self.queueHead = t->next;
            if (self.queueHead == null) self.queueTail = null;
            self.mutex.unlock();

            t->func(t->arg);
            dealloc<Task>(t);
        }
    }
}

void _workerEntry(rawptr arg)
{
    ((ThreadPool*)arg)->_worker();
}


pub extend ThreadPool : @drop
{
    void drop()
    {
        self.deinit();
    }
}
