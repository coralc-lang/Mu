import math { sqrt };

pub struct Vec2
{
    f64 x;
    f64 y;

    static Vec2 new(f64 x, f64 y)
    {
        return Vec2 { .x = x, .y = y };
    }

    Vec2 add(Vec2 other)
    {
        return Vec2 { .x = self.x + other.x, .y = self.y + other.y };
    }

    Vec2 sub(Vec2 other)
    {
        return Vec2 { .x = self.x - other.x, .y = self.y - other.y };
    }

    Vec2 scale(f64 s)
    {
        return Vec2 { .x = self.x * s, .y = self.y * s };
    }

    f64 dot(Vec2 other)
    {
        return self.x * other.x + self.y * other.y;
    }

    f64 lengthSq()
    {
        return self.x * self.x + self.y * self.y;
    }

    f64 length()
    {
        return sqrt(self.lengthSq());
    }

    Vec2 normalize()
    {
        f64 len = self.length();
        if (len < 1e-15) return *self;
        return self.scale(1.0 / len);
    }

    Vec2 lerp(Vec2 other, f64 t)
    {
        return Vec2 {
            .x = self.x + (other.x - self.x) * t,
            .y = self.y + (other.y - self.y) * t
        };
    }
}

pub struct Vec3
{
    f64 x;
    f64 y;
    f64 z;

    static Vec3 new(f64 x, f64 y, f64 z)
    {
        return Vec3 { .x = x, .y = y, .z = z };
    }

    Vec3 add(Vec3 other)
    {
        return Vec3 {
            .x = self.x + other.x,
            .y = self.y + other.y,
            .z = self.z + other.z
        };
    }

    Vec3 sub(Vec3 other)
    {
        return Vec3 {
            .x = self.x - other.x,
            .y = self.y - other.y,
            .z = self.z - other.z
        };
    }

    Vec3 scale(f64 s)
    {
        return Vec3 { .x = self.x * s, .y = self.y * s, .z = self.z * s };
    }

    f64 dot(Vec3 other)
    {
        return self.x * other.x + self.y * other.y + self.z * other.z;
    }

    Vec3 cross(Vec3 other)
    {
        return Vec3 {
            .x = self.y * other.z - self.z * other.y,
            .y = self.z * other.x - self.x * other.z,
            .z = self.x * other.y - self.y * other.x
        };
    }

    f64 lengthSq()
    {
        return self.x * self.x + self.y * self.y + self.z * self.z;
    }

    f64 length()
    {
        return sqrt(self.lengthSq());
    }

    Vec3 normalize()
    {
        f64 len = self.length();
        if (len < 1e-15) return *self;
        return self.scale(1.0 / len);
    }

    Vec3 lerp(Vec3 other, f64 t)
    {
        return Vec3 {
            .x = self.x + (other.x - self.x) * t,
            .y = self.y + (other.y - self.y) * t,
            .z = self.z + (other.z - self.z) * t
        };
    }
}

pub struct Vec4
{
    f64 x;
    f64 y;
    f64 z;
    f64 w;

    static Vec4 new(f64 x, f64 y, f64 z, f64 w)
    {
        return Vec4 { .x = x, .y = y, .z = z, .w = w };
    }

    Vec4 add(Vec4 other)
    {
        return Vec4 {
            .x = self.x + other.x,
            .y = self.y + other.y,
            .z = self.z + other.z,
            .w = self.w + other.w
        };
    }

    Vec4 sub(Vec4 other)
    {
        return Vec4 {
            .x = self.x - other.x,
            .y = self.y - other.y,
            .z = self.z - other.z,
            .w = self.w - other.w
        };
    }

    Vec4 scale(f64 s)
    {
        return Vec4 {
            .x = self.x * s,
            .y = self.y * s,
            .z = self.z * s,
            .w = self.w * s
        };
    }

    f64 dot(Vec4 other)
    {
        return self.x * other.x + self.y * other.y + self.z * other.z + self.w * other.w;
    }

    f64 lengthSq()
    {
        return self.x * self.x + self.y * self.y + self.z * self.z + self.w * self.w;
    }

    f64 length()
    {
        return sqrt(self.lengthSq());
    }

    Vec4 normalize()
    {
        f64 len = self.length();
        if (len < 1e-15) return *self;
        return self.scale(1.0 / len);
    }

    Vec4 lerp(Vec4 other, f64 t)
    {
        return Vec4 {
            .x = self.x + (other.x - self.x) * t,
            .y = self.y + (other.y - self.y) * t,
            .z = self.z + (other.z - self.z) * t,
            .w = self.w + (other.w - self.w) * t
        };
    }
}
