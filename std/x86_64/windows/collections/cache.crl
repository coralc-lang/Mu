import hashmap { HashMap };
import(lib) std::mman { alloc, dealloc };
import(lib) std::option { Option };

pub struct CacheEntry<K, V>
{
    K key;
    V value;
    CacheEntry<K, V>* prev;
    CacheEntry<K, V>* next;
}

pub struct Cache<K, V>
{
    HashMap<K, CacheEntry<K, V>*> map;
    CacheEntry<K, V>* head;
    CacheEntry<K, V>* tail;
    usize maxSize;
    usize(K) hashFn;
    bool(K, K) eqFn;

    static Cache<K, V> new(usize max, usize(K) hf, bool(K, K) ef)
    {
        return Cache<K, V> {
            .map = HashMap<K, CacheEntry<K, V>*>::new(hf, ef),
            .head = null,
            .tail = null,
            .maxSize = max > 0 ? max : 64,
            .hashFn = hf,
            .eqFn = ef
        };
    }

    void dispose()
    {
        CacheEntry<K, V>* cur = self.head;
        while (cur != null)
        {
            CacheEntry<K, V>* next = cur->next;
            dealloc<CacheEntry<K, V>>(cur);
            cur = next;
        }
        self.map.dispose();
        self.head = null;
        self.tail = null;
    }

    #[[inline]]
    usize count() { return self.map.count(); }
    usize maxSizeValue() { return self.maxSize; }

    void _moveToFront(CacheEntry<K, V>* entry)
    {
        if (entry == self.head) return;
        if (entry->prev != null) entry->prev->next = entry->next;
        if (entry->next != null) entry->next->prev = entry->prev;
        if (entry == self.tail) self.tail = entry->prev;
        entry->prev = null;
        entry->next = self.head;
        if (self.head != null) self.head->prev = entry;
        self.head = entry;
        if (self.tail == null) self.tail = entry;
    }

    void _evict()
    {
        if (self.tail == null) return;
        CacheEntry<K, V>* old = self.tail;
        self.tail = old->prev;
        if (self.tail != null) self.tail->next = null;
        else self.head = null;
        self.map.remove(old->key);
        dealloc<CacheEntry<K, V>>(old);
    }

    void insert(K key, V value)
    {
        CacheEntry<K, V>** entryPtr = self.map.getPtr(key);
        if (entryPtr != null)
        {
            CacheEntry<K, V>* existing = *entryPtr;
            existing->value = value;
            self._moveToFront(existing);
            return;
        }
        CacheEntry<K, V>* entry = alloc<CacheEntry<K, V>>(1);
        entry->key = key;
        entry->value = value;
        entry->prev = null;
        entry->next = self.head;
        if (self.head != null) self.head->prev = entry;
        self.head = entry;
        if (self.tail == null) self.tail = entry;
        self.map.insert(key, entry);
        if (self.map.count() > self.maxSize) self._evict();
    }

    Option<V> get(K key)
    {
        CacheEntry<K, V>** entryPtr = self.map.getPtr(key);
        if (entryPtr == null) return Option<V>::None;
        CacheEntry<K, V>* entry = *entryPtr;
        self._moveToFront(entry);
        return Option<V>::Some { .value = entry->value };
    }

    V* getPtr(K key)
    {
        CacheEntry<K, V>** entryPtr = self.map.getPtr(key);
        if (entryPtr == null) return null;
        CacheEntry<K, V>* entry = *entryPtr;
        self._moveToFront(entry);
        return &entry->value;
    }

    bool contains(K key)
    {
        return self.map.contains(key);
    }

    void remove(K key)
    {
        CacheEntry<K, V>** entryPtr = self.map.getPtr(key);
        if (entryPtr == null) return;
        CacheEntry<K, V>* entry = *entryPtr;
        if (entry->prev != null) entry->prev->next = entry->next;
        if (entry->next != null) entry->next->prev = entry->prev;
        if (entry == self.head) self.head = entry->next;
        if (entry == self.tail) self.tail = entry->prev;
        self.map.remove(key);
        dealloc<CacheEntry<K, V>>(entry);
    }

    void clear()
    {
        CacheEntry<K, V>* cur = self.head;
        while (cur != null)
        {
            CacheEntry<K, V>* next = cur->next;
            dealloc<CacheEntry<K, V>>(cur);
            cur = next;
        }
        self.map.clear();
        self.head = null;
        self.tail = null;
    }

    void each(void(K, V) fn)
    {
        CacheEntry<K, V>* cur = self.head;
        while (cur != null)
        {
            fn(cur->key, cur->value);
            cur = cur->next;
        }
    }

    void resize(usize newMax)
    {
        self.maxSize = newMax > 0 ? newMax : 1;
        while (self.map.count() > self.maxSize) self._evict();
    }
}

pub extend<K, V> Cache<K, V> : @drop
{
    #[[inline]]
    void drop() { self.dispose(); }
}
