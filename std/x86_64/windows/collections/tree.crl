import vec { Vec };
import(lib) std::mman { alloc, dealloc };

pub struct TreeNode<T>
{
    T value;
    Vec<TreeNode<T>*> children;
}

pub struct Tree<T>
{
    TreeNode<T>* root;

    static Tree<T> new()
    {
        return Tree<T> { .root = null };
    }

    void dispose()
    {
        if (self.root != null)
        {
            self._disposeNode(self.root);
            self.root = null;
        }
    }

    void _disposeNode(TreeNode<T>* node)
    {
        for (usize i = 0; i < node->children.count(); i++)
            self._disposeNode(node->children.at(i));
        node->children.dispose();
        dealloc<TreeNode<T>>(node);
    }

    bool isEmpty() { return self.root == null; }

    TreeNode<T>* setRoot(T val)
    {
        if (self.root != null) self._disposeNode(self.root);
        self.root = alloc<TreeNode<T>>(1);
        self.root->value = val;
        self.root->children = Vec<TreeNode<T>*>::new();
        return self.root;
    }

    TreeNode<T>* addChild(TreeNode<T>* parent, T val)
    {
        if (parent == null) return null;
        TreeNode<T>* child = alloc<TreeNode<T>>(1);
        child->value = val;
        child->children = Vec<TreeNode<T>*>::new();
        parent->children.push(child);
        return child;
    }

    usize childCount(TreeNode<T>* node)
    {
        if (node == null) return 0;
        return node->children.count();
    }

    TreeNode<T>* childAt(TreeNode<T>* node, usize idx)
    {
        if (node == null) return null;
        return node->children.at(idx);
    }

    void removeChild(TreeNode<T>* parent, usize idx)
    {
        if (parent == null || idx >= parent->children.count()) return;
        TreeNode<T>* child = parent->children.at(idx);
        self._disposeNode(child);
        parent->children.removeAt(idx);
    }

    void preOrder(void(T) fn)
    {
        if (self.root != null) self._preOrder(self.root, fn);
    }

    void _preOrder(TreeNode<T>* node, void(T) fn)
    {
        fn(node->value);
        for (usize i = 0; i < node->children.count(); i++)
            self._preOrder(node->children.at(i), fn);
    }

    void postOrder(void(T) fn)
    {
        if (self.root != null) self._postOrder(self.root, fn);
    }

    void _postOrder(TreeNode<T>* node, void(T) fn)
    {
        for (usize i = 0; i < node->children.count(); i++)
            self._postOrder(node->children.at(i), fn);
        fn(node->value);
    }

    usize depth(TreeNode<T>* node)
    {
        if (node == null) return 0;
        usize maxD = 0;
        for (usize i = 0; i < node->children.count(); i++)
        {
            usize d = self.depth(node->children.at(i));
            if (d > maxD) maxD = d;
        }
        return maxD + 1;
    }

    usize size()
    {
        usize n = 0;
        if (self.root != null) self._count(self.root, &n);
        return n;
    }

    void _count(TreeNode<T>* node, usize* n)
    {
        (*n)++;
        for (usize i = 0; i < node->children.count(); i++)
            self._count(node->children.at(i), n);
    }

    Vec<T> toVec()
    {
        Vec<T> v = Vec<T>::new();
        if (self.root != null) self._toVec(self.root, &v);
        return v;
    }

    void _toVec(TreeNode<T>* node, Vec<T>* v)
    {
        v->push(node->value);
        for (usize i = 0; i < node->children.count(); i++)
            self._toVec(node->children.at(i), v);
    }
}

pub extend<T> Tree<T> : @drop
{
    #[[inline]]
    void drop() { self.dispose(); }
}
