import(lib) std::mman { alloc, dealloc, realloc };

pub struct Vec<T>
{
    T* data;
    usize len;
    usize cap;

    static Vec<T> new()
    {
        return Vec<T> {
            .data = null,
            .len = 0,
            .cap = 0
        };
    }

    static Vec<T> withCap(usize capacity)
    {
        return Vec<T> {
            .data = alloc<T>(capacity),
            .len = 0,
            .cap = capacity
        };
    }

    void reserve(usize newCap)
    {
        if (newCap <= self.cap) return;
        self.data = realloc<T>(self.data, newCap);
        self.cap = newCap;
    }

    void push(T val)
    {
        if (self.len >= self.cap)
        {
            usize newCap = self.cap > 0 ? self.cap * 2 : 4;
            self.reserve(newCap);
        }
        self.data[self.len] = val;
        self.len++;
    }

    T pop()
    {
        @assertOut(self.len > 0);
        self.len--;
        return self.data[self.len];
    }

    usize count() { return self.len; }

    T* atPtr(usize i)
    {
        @assertOut(i < self.len, "Index Out of bounds");
        return &self.data[i];
    }

    const T* atConst(usize i)
    {
        @assertOut(i < self.len, "Index Out of bounds");
        return (const T*)&self.data[i];
    }

    T at(usize i)
    {
        @assertOut(i < self.len, "Index Out of bounds");
        return self.data[i];
    }

    T* ptr() { return self.data; }
    #[[inline]]
    const T* constPtr() { return (const T*)self.data; }
    bool isEmpty() { return self.len == 0; }

    void set(usize i, T val)
    {
        @assertOut(i < self.len, "attempt to set in an Index Out of bounds");
        self.data[i] = val;
    }

    T front()
    {
        @assertOut(self.len > 0, "Invalid Vector size");
        return self.data[0];
    }

    T back()
    {
        @assertOut(self.len > 0);
        return self.data[self.len - 1];
    }

    void insert(usize i, T val)
    {
        @assertOut(i <= self.len, "Invalid Vector size");
        if (self.len >= self.cap)
        {
            usize newCap = self.cap > 0 ? self.cap * 2 : 4;
            self.reserve(newCap);
        }
        for (usize j = self.len; j > i; j--)
            self.data[j] = self.data[j - 1];
        self.data[i] = val;
        self.len++;
    }

    void removeAt(usize i)
    {
        @assertOut(i < self.len, "Invalid Vector size");
        for (usize j = i; j < self.len - 1; j++)
            self.data[j] = self.data[j + 1];
        self.len--;
    }

    void removeRange(usize start, usize end)
    {
        @assertOut(start <= end);
        @assertOut(end <= self.len, "Invalid Vector size");
        usize tail = self.len - end;
        for (usize j = 0; j < tail; j++)
            self.data[start + j] = self.data[end + j];
        self.len -= (end - start);
    }

    bool contains(T val)
    {
        for (usize i = 0; i < self.len; i++)
        {
            if (val == self.data[i]) return true;
        }
        return false;
    }

    void fill(T val)
    {
        for (usize i = 0; i < self.len; i++)
            self.data[i] = val;
    }

    void reserveExact(usize newCap)
    {
        if (newCap <= self.cap) return;
        self.data = realloc<T>(self.data, newCap);
        self.cap = newCap;
    }

    void shrinkToFit()
    {
        if (self.len == self.cap) return;
        self.data = realloc<T>(self.data, self.len);
        self.cap = self.len;
    }

    void clear() { self.len = 0; }

    void reverse()
    {
        for (usize i = 0; i < self.len / 2; i++)
        {
            usize j = self.len - 1 - i;
            T tmp = self.data[i];
            self.data[i] = self.data[j];
            self.data[j] = tmp;
        }
    }

    bool isSortedBy(bool(T, T) less)
    {
        for (usize i = 1; i < self.len; i++)
            if (less(self.data[i], self.data[i - 1])) return false;
        return true;
    }

    #[[inline]]
    void sortBy(bool(T, T) less) { _sortByRange(0, self.len, less); }

    void _sortByRange(usize lo, usize hi, bool(T, T) less)
    {
        if (hi - lo <= 1) return;
        usize pi = _partitionBy(lo, hi, less);
        if (pi > lo) _sortByRange(lo, pi, less);
        if (pi + 1 < hi) _sortByRange(pi + 1, hi, less);
    }

    usize _partitionBy(usize lo, usize hi, bool(T, T) less)
    {
        T pivot = self.data[hi - 1];
        usize i = lo;
        for (usize j = lo; j < hi - 1; j++)
        {
            if (less(self.data[j], pivot))
            {
                T tmp = self.data[i];
                self.data[i] = self.data[j];
                self.data[j] = tmp;
                i++;
            }
        }
        T tmp = self.data[i];
        self.data[i] = self.data[hi - 1];
        self.data[hi - 1] = tmp;
        return i;
    }

    i64 binarySearchBy(T key, i32(T, T) cmp)
    {
        i64 lo = 0;
        i64 hi = (i64)self.len - 1;
        while (lo <= hi)
        {
            i64 mid = lo + (hi - lo) / 2;
            i32 c = cmp(key, self.data[(usize)mid]);
            if (c == 0) return mid;
            if (c > 0) lo = mid + 1;
            else hi = mid - 1;
        }
        return -1;
    }

    void dispose()
    {
        if (self.data != null)
        {
            dealloc<T>(self.data);
            self.data = null;
        }
        self.len = 0;
        self.cap = 0;
    }
}

pub extend<T> Vec<T> : @drop
{
    #[[inline]]
    void drop() { self.dispose(); }
}
// 
// // trait @drop { // drop trait impl.
// //     void drop(); // should be embeded into the compiler
// // }
// 
// '@' is reserved for inbuilt traits. iter, toString, eq, partialEd, add, sub...