pub struct Arr<T, N>
{
    T data[N];

    #[[inline]]
    T* ptr() { return (T*)self.data; }
    #[[inline]]
    const T* constPtr() { return (const T*)self.data; }
    usize count() { return N; }

    bool isEmpty() { return N == 0; }

    T at(usize i)
    {
        @assertOut(i < N, "Index out of bounds.");
        return self.data[i];
    }

    void set(usize i, T val)
    {
        @assertOut(i < N, "Index out of bounds.");
        self.data[i] = val;
    }

    T* atPtr(usize i)
    {
        @assertOut(i < N, "Index out of bounds.");
        return &self.data[i];
    }

    T front()
    {
        @assertOut(N > 0, "Invalid array size.");
        return self.data[0];
    }

    T back()
    {
        @assertOut(N > 0, "Invalid array size.");
        return self.data[N - 1];
    }

    void fill(T val)
    {
        for (usize i = 0; i < N; i++)
            self.data[i] = val;
    }

    void copyTo(T* dst)
    {
        for (usize i = 0; i < N; i++)
            dst[i] = self.data[i];
    }

    void copyFrom(const T* src)
    {
        for (usize i = 0; i < N; i++)
            self.data[i] = src[i];
    }
}