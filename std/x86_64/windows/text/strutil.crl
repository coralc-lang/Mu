import string { String };
import(lib) std::vec { Vec };

pub usize split(str sv, u8 delim, str* out, usize maxParts)
{
    if (maxParts == 0) return 0;
    usize count = 0;
    usize start = 0;
    for (usize i = 0; i <= sv.len; i++)
    {
        if (count + 1 >= maxParts)
        {
            out[count++] = str::fromParts(sv.ptr + start, sv.len - start);
            return count;
        }
        if (i == sv.len || sv.ptr[i] == delim)
        {
            out[count++] = str::fromParts(sv.ptr + start, i - start);
            start = i + 1;
        }
    }
    return count;
}

pub Vec<str> splitVec(str sv, u8 delim)
{
    Vec<str> v = Vec<str>::new();
    usize start = 0;
    for (usize i = 0; i <= sv.len; i++)
    {
        if (i == sv.len || sv.ptr[i] == delim)
        {
            v.push(str::fromParts(sv.ptr + start, i - start));
            start = i + 1;
        }
    }
    return v;
}

pub str trim(str sv)
{
    usize start = 0;
    while (start < sv.len && (sv.ptr[start] == ' ' || sv.ptr[start] == '\t' || sv.ptr[start] == '\n' || sv.ptr[start] == '\r'))
        start++;
    usize end = sv.len;
    while (end > start && (sv.ptr[end - 1] == ' ' || sv.ptr[end - 1] == '\t' || sv.ptr[end - 1] == '\n' || sv.ptr[end - 1] == '\r'))
        end--;
    return str::fromParts(sv.ptr + start, end - start);
}

pub str trimLeft(str sv)
{
    usize start = 0;
    while (start < sv.len && (sv.ptr[start] == ' ' || sv.ptr[start] == '\t' || sv.ptr[start] == '\n' || sv.ptr[start] == '\r'))
        start++;
    return str::fromParts(sv.ptr + start, sv.len - start);
}

pub str trimRight(str sv)
{
    usize end = sv.len;
    while (end > 0 && (sv.ptr[end - 1] == ' ' || sv.ptr[end - 1] == '\t' || sv.ptr[end - 1] == '\n' || sv.ptr[end - 1] == '\r'))
        end--;
    return str::fromParts(sv.ptr, end);
}

pub bool startsWith(str sv, str prefix)
{
    if (sv.len < prefix.len) return false;
    for (usize i = 0; i < prefix.len; i++)
        if (sv.ptr[i] != prefix.ptr[i]) return false;
    return true;
}

pub bool endsWith(str sv, str suffix)
{
    if (sv.len < suffix.len) return false;
    usize offset = sv.len - suffix.len;
    for (usize i = 0; i < suffix.len; i++)
        if (sv.ptr[offset + i] != suffix.ptr[i]) return false;
    return true;
}

pub bool contains(str sv, str sub)
{
    if (sub.len > sv.len) return false;
    for (usize i = 0; i <= sv.len - sub.len; i++)
    {
        bool match = true;
        for (usize j = 0; j < sub.len; j++)
        {
            if (sv.ptr[i + j] != sub.ptr[j]) { match = false; break; }
        }
        if (match) return true;
    }
    return false;
}

pub isize indexOf(str sv, str sub)
{
    if (sub.len > sv.len) return -1;
    for (usize i = 0; i <= sv.len - sub.len; i++)
    {
        bool match = true;
        for (usize j = 0; j < sub.len; j++)
        {
            if (sv.ptr[i + j] != sub.ptr[j]) { match = false; break; }
        }
        if (match) return (isize)i;
    }
    return -1;
}

pub isize indexOfChar(str sv, u8 ch)
{
    for (usize i = 0; i < sv.len; i++)
        if (sv.ptr[i] == ch) return (isize)i;
    return -1;
}

pub isize lastIndexOf(str sv, str sub)
{
    if (sub.len > sv.len) return -1;
    usize limit = sv.len - sub.len;
    for (usize i = limit; i > 0; i--)
    {
        bool match = true;
        for (usize j = 0; j < sub.len; j++)
        {
            if (sv.ptr[i + j] != sub.ptr[j]) { match = false; break; }
        }
        if (match) return (isize)i;
    }
    if (sub.len <= sv.len)
    {
        bool match = true;
        for (usize j = 0; j < sub.len; j++)
            if (sv.ptr[j] != sub.ptr[j]) { match = false; break; }
        if (match) return 0;
    }
    return -1;
}

pub String replace(str sv, str from, str to)
{
    String out = String::new();
    if (from.len == 0)
    {
        for (usize i = 0; i <= sv.len; i++)
        {
            out.pushView(to);
            if (i < sv.len) out.pushView(str::fromParts(sv.ptr + i, 1));
        }
        return out;
    }
    usize i = 0;
    while (i < sv.len)
    {
        isize idx = indexOf(str::fromParts(sv.ptr + i, sv.len - i), from);
        if (idx < 0)
        {
            out.pushView(str::fromParts(sv.ptr + i, sv.len - i));
            break;
        }
        if ((usize)idx > 0) out.pushView(str::fromParts(sv.ptr + i, (usize)idx));
        out.pushView(to);
        i += (usize)idx + from.len;
    }
    return out;
}

pub String join(const str* parts, usize count, str sep)
{
    String out = String::new();
    for (usize i = 0; i < count; i++)
    {
        if (i > 0) out.pushView(sep);
        out.pushView(parts[i]);
    }
    return out;
}

pub String joinVec(const Vec<str>* parts, str sep)
{
    String out = String::new();
    for (usize i = 0; i < parts->count(); i++)
    {
        if (i > 0) out.pushView(sep);
        out.pushView(parts->at(i));
    }
    return out;
}

pub str substr(str sv, usize start, usize len)
{
    if (start >= sv.len) return "";
    usize remaining = sv.len - start;
    usize clen = len < remaining ? len : remaining;
    return str::fromParts(sv.ptr + start, clen);
}

pub bool equalsIgnoreCase(str a, str b)
{
    if (a.len != b.len) return false;
    for (usize i = 0; i < a.len; i++)
    {
        u8 ca = a.ptr[i];
        u8 cb = b.ptr[i];
        if (ca >= 'A' && ca <= 'Z') ca += 0x20;
        if (cb >= 'A' && cb <= 'Z') cb += 0x20;
        if (ca != cb) return false;
    }
    return true;
}
