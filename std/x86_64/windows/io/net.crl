// Winsock — ws2_32 must be linked; close() is gone, sockets use
// closesocket(). recvfrom/sendto take a rawptr SOCKET in win32.crl.
import(lib) platform::win32 { socket, bind, listen, accept, connect, send, recv, closesocket, setsockopt, htonl, WSAStartup, sendto, recvfrom };

// htons isn't on the surface — byte swap in coral (x86 is little endian).
pub u16 htons(u16 v)
{
    return (u16)((v << 8) | (v >> 8));
}

// AF_INET/SOCK_*/IPPROTO_* match POSIX on Windows; SOL_SOCKET (0xFFFF)
// and SO_REUSEADDR (4) do not — converted.
const i32 AF_INET = 2;
const i32 SOCK_STREAM = 1;
const i32 SOCK_DGRAM = 2;
const i32 IPPROTO_TCP = 6;
const i32 IPPROTO_UDP = 17;
const i32 SOL_SOCKET = 0xFFFF; // POSIX is 1; winsock uses 0xFFFF
const i32 SO_REUSEADDR = 4;    // POSIX is 2; winsock uses 4

// One-time WSAStartup guard, called from the socket-creating paths
// (tcpConnect/tcpListen/udpSocket). ws2_32 must be linked.
// had to search for this, winsock wants one init before any socket call works.
static bool _wsaStarted = false;

static void _ensureWsa()
{
    if (_wsaStarted) return;
    // WSADATA is ~408B; only the version handshake matters, so an opaque
    // 512B buffer stands in (FLAG size) and is never read back.
    u8 wsa[512];
    if (WSAStartup(0x0202, (rawptr)wsa) == 0) _wsaStarted = true;
}

// INVALID_SOCKET = (rawptr)(-1), winsock's failure value.
static bool _badSock(rawptr s)
{
    return s == (rawptr)(-1);
}

// Layout is identical to Windows' sockaddr_in (16 bytes), u16 family,
// u16 port (network order), u32 address (network order), 8 bytes padding.
pub struct sockaddr_in
{
    u16 sinFamily;
    u16 sinPort;
    u32 sinAddr;
    u8 sinZero[8];
}

static bool _parseIp(str ip, u32* out)
{
    u32 octet = 0;
    u32 addrVal = 0;
    u32 shift = 24;
    u32 octets = 0;
    bool octetHasDigit = false;
    for (usize i = 0; i <= ip.len; i++)
    {
        if (i == ip.len || ip.ptr[i] == '.')
        {
            if (!octetHasDigit || octet > 255) return false;
            addrVal |= (octet << shift);
            octet = 0;
            octetHasDigit = false;
            octets++;
            if (shift > 0) shift -= 8;
        }
        else
        {
            if (ip.ptr[i] < '0' || ip.ptr[i] > '9') return false;
            octet = octet * 10 + (u32)(ip.ptr[i] - '0');
            if (octet > 255) return false;
            octetHasDigit = true;
        }
    }
    if (octets != 4) return false;
    // FLAG, win32.crl types htonl as u64 — cast back to u32.
    *out = (u32)htonl(addrVal);
    return true;
}

static void _zeroSockaddr(sockaddr_in* a)
{
    for (usize i = 0; i < 8; i++) a->sinZero[i] = 0;
}

// FLAG, was distinct TcpSocket = i32; a Win64 SOCKET is 64-bit, so the
// base is rawptr (invalid (rawptr)(-1), was -1).
pub distinct TcpSocket = rawptr;

pub TcpSocket tcpConnect(str ip, u16 port)
{
    _ensureWsa();
    rawptr s = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
    if (_badSock(s)) return (TcpSocket)(rawptr)(-1);

    u32 ipAddr;
    if (!_parseIp(ip, &ipAddr)) { closesocket(s); return (TcpSocket)(rawptr)(-1); }

    sockaddr_in addr;
    _zeroSockaddr(&addr);
    addr.sinFamily = AF_INET;
    addr.sinPort = htons(port);
    addr.sinAddr = ipAddr;

    if (connect(s, (const rawptr)&addr, 16) < 0)
    {
        closesocket(s);
        return (TcpSocket)(rawptr)(-1);
    }
    return (TcpSocket)s;
}

pub TcpSocket tcpListen(u16 port)
{
    _ensureWsa();
    rawptr s = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
    if (_badSock(s)) return (TcpSocket)(rawptr)(-1);

    // source bug, was a 5-arg sendto (6 params) — the shape is
    // setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, ...).
    i32 optval = 1;
    setsockopt(s, SOL_SOCKET, SO_REUSEADDR, (const cchar*)&optval, 4);

    sockaddr_in addr;
    _zeroSockaddr(&addr);
    addr.sinFamily = AF_INET;
    addr.sinPort = htons(port);
    addr.sinAddr = (u32)htonl(0u);
    if (bind(s, (const rawptr)&addr, 16) < 0) { closesocket(s); return (TcpSocket)(rawptr)(-1); }
    if (listen(s, 128) < 0) { closesocket(s); return (TcpSocket)(rawptr)(-1); }
    return (TcpSocket)s;
}

pub TcpSocket tcpAccept(TcpSocket server)
{
    sockaddr_in addr;
    i32 addrLen = 16;
    // INVALID_SOCKET casts straight to the (TcpSocket)(rawptr)(-1) error.
    rawptr s = accept((rawptr)server, (rawptr)&addr, &addrLen);
    return (TcpSocket)s;
}

pub isize tcpSend(TcpSocket sock, const u8* buf, usize len)
{
    usize sent = 0;
    while (sent < len)
    {
        i32 n = send((rawptr)sock, (const cchar*)(buf + sent), (i32)(len - sent), 0);
        if (n <= 0) return n < 0 ? (isize)n : (isize)sent;
        sent += (usize)n;
    }
    return (isize)sent;
}

pub isize tcpRecv(TcpSocket sock, u8* buf, usize len)
{
    usize got = 0;
    while (got < len)
    {
        i32 n = recv((rawptr)sock, (cchar*)(buf + got), (i32)(len - got), 0);
        if (n <= 0) return n < 0 ? (isize)n : (isize)got;
        got += (usize)n;
    }
    return (isize)got;
}

pub void tcpClose(TcpSocket sock)
{
    closesocket((rawptr)sock);
}

// FLAG, was i32 fd; rawptr Win64 SOCKET now (invalid (rawptr)(-1)).
pub struct UdpSocket
{
    rawptr fd;
}

pub UdpSocket udpSocket()
{
    _ensureWsa();
    return UdpSocket { .fd = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP) };
}

pub bool udpBind(UdpSocket* s, u16 port)
{
    if (_badSock(s->fd)) return false;
    sockaddr_in addr;
    _zeroSockaddr(&addr);
    addr.sinFamily = AF_INET;
    addr.sinPort = htons(port);
    addr.sinAddr = (u32)htonl(0u);
    return bind(s->fd, (const rawptr)&addr, 16) == 0;
}

pub isize udpSendTo(UdpSocket* s, const u8* buf, usize len, str ip, u16 port)
{
    if (_badSock(s->fd)) return -1;
    u32 ipAddr;
    if (!_parseIp(ip, &ipAddr)) return -1;
    sockaddr_in addr;
    _zeroSockaddr(&addr);
    addr.sinFamily = AF_INET;
    addr.sinPort = htons(port);
    addr.sinAddr = ipAddr;
    return (isize)sendto(s->fd, (const cchar*)buf, (u64)len, 0, (const rawptr)&addr, 16);
}

pub isize udpRecvFrom(UdpSocket* s, u8* buf, usize len)
{
    if (_badSock(s->fd)) return -1;
    return (isize)recvfrom(s->fd, (cchar*)buf, (u64)len, 0, null, null);
}

pub void udpClose(UdpSocket* s)
{
    if (!_badSock(s->fd)) closesocket(s->fd);
    s->fd = (rawptr)(-1);
}
