import(lib) platform::libc { fopen, fclose, fwrite, fread, feof, ferror, fflush };
import(lib) std::mman { copy };
import(lib) std::text::string { String };

// distinct wrapper over a FILE*, a bare rawptr can't be passed in its place
// by accident — callers have to cast it explicitly.
pub distinct FileHandle = rawptr;

pub FileHandle fileOpen(str path, str mode)
{
    u8 pathBuf[4096];
    u8 modeBuf[16];
    usize plen = path.len < 4095u ? path.len : 4095u;
    usize mlen = mode.len < 15 ? mode.len : 15u;
    copy<u8>(pathBuf, (u8*)path.ptr, plen);
    copy<u8>(modeBuf, (u8*)mode.ptr, mlen);
    pathBuf[plen] = 0;
    modeBuf[mlen] = 0;
    return (FileHandle)fopen(pathBuf, modeBuf);
}

#[[inline]] pub void fileClose(FileHandle fh) { fclose((rawptr)fh); }
#[[inline]] pub usize fileWrite(FileHandle fh, str data) { return fwrite(data.ptr, 1u, data.len, (rawptr)fh); }
#[[inline]] pub usize fileRead(FileHandle fh, u8* buf, usize maxLen) { return fread(buf, 1u, maxLen, (rawptr)fh); }
#[[inline]] pub bool fileEof(FileHandle fh) { return feof((rawptr)fh) != 0; }
#[[inline]] pub bool fileError(FileHandle fh) { return ferror((rawptr)fh) != 0; }
#[[inline]] pub void fileFlush(FileHandle fh){ fflush((rawptr)fh); }
#[[inline]] pub usize fileWriteString(FileHandle fh, const String* s) { return fwrite(s->ptr, 1u, s->len, (rawptr)fh); }

pub bool fileReadAll(str path, String* out)
{
    FileHandle fh = fileOpen(path, "rb");
    if (fh == (FileHandle)0) return false;
    u8 chunk[4096];
    while (true)
    {
        usize n = fileRead(fh, chunk, 4096u);
        if (n == 0u) break;
        out->pushView(str::fromParts(chunk, n));
    }
    bool ok = !fileError(fh);
    fileClose(fh);
    return ok;
}
