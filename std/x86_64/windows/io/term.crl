import(lib) platform::libc { snprintf };
import(lib) platform::win32 { GetStdHandle, WriteFile };

// STD_OUTPUT_HANDLE = (u32)-11.
const u32 STD_OUTPUT_HANDLE = (u32)-11;

// file-local CSI prefix; the cast keeps it valid whether the literals
// are str or cchar*.
str CSI = "\x1B[";

static bool _isTty()
{
    // isatty(1), GetConsoleMode succeeds only on console handles, so
    // redirected stdout answers false like isatty.
    u32 mode = 0;
    return GetConsoleMode(GetStdHandle(STD_OUTPUT_HANDLE), &mode);
}

// single write path for every CSI sequence below, WriteFile on the std
// handle - works console AND redirected (WriteConsoleA fails on a pipe);
// escape bytes pass through and the console renders them where VT is on.
static void _writeOut(str s)
{
    if (s.len == 0) return;
    u32 written = 0;
    WriteFile(GetStdHandle(STD_OUTPUT_HANDLE), (const cchar*)s.ptr, (u32)s.len, &written, null);
}

static void _writeCSI(str code)
{
    _writeOut(CSI);
    _writeOut(code);
}

static void _writeStr(str s)
{
    _writeOut(s);
}

pub void reset()
{
    _writeCSI("0m");
}

#[[inline]] pub void bold() { _writeCSI("1m"); }
#[[inline]] pub void dim() { _writeCSI("2m"); }
#[[inline]] pub void italic() { _writeCSI("3m"); }
#[[inline]] pub void underline() { _writeCSI("4m"); }
#[[inline]] pub void blink() { _writeCSI("5m"); }
#[[inline]] pub void reverse() { _writeCSI("7m"); }
#[[inline]] pub void hidden() { _writeCSI("8m"); }
#[[inline]] pub void strikethrough() { _writeCSI("9m"); }

#[[inline]] pub void black() { _writeCSI("30m"); }
#[[inline]] pub void red() { _writeCSI("31m"); }
#[[inline]] pub void green() { _writeCSI("32m"); }
#[[inline]] pub void yellow() { _writeCSI("33m"); }
#[[inline]] pub void blue() { _writeCSI("34m"); }
#[[inline]] pub void magenta() { _writeCSI("35m"); }
#[[inline]] pub void cyan() { _writeCSI("36m"); }
#[[inline]] pub void white() { _writeCSI("37m"); }

#[[inline]] pub void bgBlack() { _writeCSI("40m"); }
#[[inline]] pub void bgRed() { _writeCSI("41m"); }
#[[inline]] pub void bgGreen() { _writeCSI("42m"); }
#[[inline]] pub void bgYellow() { _writeCSI("43m"); }
#[[inline]] pub void bgBlue() { _writeCSI("44m"); }
#[[inline]] pub void bgMagenta() { _writeCSI("45m"); }
#[[inline]] pub void bgCyan() { _writeCSI("46m"); }
#[[inline]] pub void bgWhite() { _writeCSI("47m"); }

#[[inline]] pub void brightBlack() { _writeCSI("90m"); }
#[[inline]] pub void brightRed() { _writeCSI("91m"); }
#[[inline]] pub void brightGreen() { _writeCSI("92m"); }
#[[inline]] pub void brightYellow() { _writeCSI("93m"); }
#[[inline]] pub void brightBlue() { _writeCSI("94m"); }
#[[inline]] pub void brightMagenta() { _writeCSI("95m"); }
#[[inline]] pub void brightCyan() { _writeCSI("96m"); }
#[[inline]] pub void brightWhite() { _writeCSI("97m"); }

static u64 _clampN(u64 n)
{
    if (n > 99999999999999u) return 99999999999999u;
    return n;
}

pub void cursorUp(u64 n) { u8 buf[24]; n = _clampN(n); i32 l = snprintf(buf, 24u, (const cchar*)C"%lluA", n); if (l > 0) { _writeOut(CSI); _writeOut(str::fromParts(buf, (usize)l)); } }
pub void cursorDown(u64 n) { u8 buf[24]; n = _clampN(n); i32 l = snprintf(buf, 24u, (const cchar*)C"%lluB", n); if (l > 0) { _writeOut(CSI); _writeOut(str::fromParts(buf, (usize)l)); } }
pub void cursorRight(u64 n) { u8 buf[24]; n = _clampN(n); i32 l = snprintf(buf, 24u, (const cchar*)C"%lluC", n); if (l > 0) { _writeOut(CSI); _writeOut(str::fromParts(buf, (usize)l)); } }
pub void cursorLeft(u64 n) { u8 buf[24]; n = _clampN(n); i32 l = snprintf(buf, 24u, (const cchar*)C"%lluD", n); if (l > 0) { _writeOut(CSI); _writeOut(str::fromParts(buf, (usize)l)); } }

pub void cursorPos(u64 row, u64 col)
{
    u8 buf[40];
    row = _clampN(row);
    col = _clampN(col);
    i32 l = snprintf(buf, 40u, (const cchar*)C"%llu;%lluH", row, col);
    if (l > 0) {
        _writeOut(CSI);
        _writeOut(str::fromParts(buf, (usize)l));
    }
}

#[[inline]]
pub void clearScreen() { _writeCSI("2J"); }
#[[inline]]
pub void clearLine() { _writeCSI("2K"); }
#[[inline]]
pub void clearToEnd() { _writeCSI("0J"); }
#[[inline]]
pub void clearLineEnd() { _writeCSI("0K"); }

#[[inline]]
pub void saveCursor() { _writeCSI("s"); }
#[[inline]]
pub void restoreCursor() { _writeCSI("u"); }
#[[inline]]
pub void hideCursor() { _writeCSI("?25l"); }
#[[inline]]
pub void showCursor() { _writeCSI("?25h"); }
