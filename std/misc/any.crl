// any — poor-man's type erasure: a raw pointer wrapper with typed access.
// NOTE: overlaps with the language's dyn-trait form (`any TraitName`);
// kept as a plain struct because it is an existing public type (porting
// rule 1 — port the whole file, flag the overlap rather than drop it).
pub struct any
{
    rawptr p;

    rawptr ptr()
    {
        return self.p;
    }

    bool isNull()
    {
        return self.p == null;
    }

    T* as<T>()
    {
        return (T*)self.p;
    }
}

pub any wrap(rawptr value)
{
    return any { .p = value };
}
