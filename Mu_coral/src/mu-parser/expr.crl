import parser::base { Parser };
import common::token { Token, TokenKind, kindName };
import ast::ast {
    Loc, Op, Expr, ExprKind, newExpr, Type,
    FieldInit, newFieldInit, ArrayItem, newArrayItem,
    Stmt,
    PtrList, newList, listPush
};

pub extend Parser
{
    Expr* literalFromToken(Token t)
    {
        Loc loc = Loc { .line = t.line, .col = t.col };
        ExprKind k = ExprKind::Int;
        if (t.kind == TokenKind::Float) k = ExprKind::Float;
        else if (t.kind == TokenKind::Str) k = ExprKind::Str;
        else if (t.kind == TokenKind::CharLit) k = ExprKind::Char;
        else if (t.kind == TokenKind::KwTrue || t.kind == TokenKind::KwFalse) k = ExprKind::Bool;
        Expr* e = newExpr(self.arena, k, loc);
        e.text = t.text;
        return e;
    }

    Op binOp(TokenKind k)
    {
        switch (k)
        {
            TokenKind::Plus => { return Op::Add; },
            TokenKind::Minus => { return Op::Sub; },
            TokenKind::Star => { return Op::Mul; },
            TokenKind::Slash => { return Op::Div; },
            TokenKind::Percent => { return Op::Rem; },
            TokenKind::Shl => { return Op::Shl; },
            TokenKind::Shr => { return Op::Shr; },
            TokenKind::Amp => { return Op::Band; },
            TokenKind::Pipe => { return Op::Bor; },
            TokenKind::Caret => { return Op::Bxor; },
            TokenKind::EqualEqual => { return Op::Eq; },
            TokenKind::NotEqual => { return Op::Ne; },
            TokenKind::Less => { return Op::Lt; },
            TokenKind::LessEqual => { return Op::Le; },
            TokenKind::Greater => { return Op::Gt; },
            TokenKind::GreaterEqual => { return Op::Ge; },
            TokenKind::And => { return Op::LAnd; },
            TokenKind::Or => { return Op::LOr; },
            TokenKind::DotDot => { return Op::Range; },
            TokenKind::DotDotEq => { return Op::RangeEq; },
            TokenKind::Equal => { return Op::Assign; },
            TokenKind::PlusEqual => { return Op::AddA; },
            TokenKind::MinusEqual => { return Op::SubA; },
            TokenKind::StarEqual => { return Op::MulA; },
            TokenKind::SlashEqual => { return Op::DivA; },
            TokenKind::PercentEqual => { return Op::RemA; },
            TokenKind::AmpEqual => { return Op::BandA; },
            TokenKind::PipeEqual => { return Op::BorA; },
            TokenKind::CaretEqual => { return Op::BxorA; },
            TokenKind::ShlEqual => { return Op::ShlA; },
            TokenKind::ShrEqual => { return Op::ShrA; },
            else => { return Op::None; }
        }
    }

    bool isAssignOp(Op op)
    {
        return op == Op::Assign || op == Op::AddA || op == Op::SubA || op == Op::MulA ||
               op == Op::DivA || op == Op::RemA || op == Op::BandA || op == Op::BorA ||
               op == Op::BxorA || op == Op::ShlA || op == Op::ShrA;
    }

    bool isAssignTarget(Expr* e)
    {
        return e.kind == ExprKind::Name || e.kind == ExprKind::Field || e.kind == ExprKind::Index;
    }

    Expr* parseExpr()
    {
        return self.parseAssign();
    }

    Expr* parseAssign()
    {
        Expr* l = self.parseRangeExpr();
        Op op = self.binOp(self.cur.kind);
        if (self.isAssignOp(op))
        {
            Loc loc = self.here();
            if (!self.isAssignTarget(l))
            {
                self.perrAt(l.loc, "E0210", "invalid assignment target");
                self.diags.why("the left side of an assignment must be a name, a field, or an index");
                self.diags.help("assign to a variable, field, or element");
            }
            self.advance();
            Expr* r = self.parseAssign();
            Expr* n = newExpr(self.arena, ExprKind::Assign, loc);
            n.op = op;
            n.a = l;
            n.b = r;
            return n;
        }
        return l;
    }

    Expr* parseRangeExpr()
    {
        Expr* e = self.parseOr();
        while (true)
        {
            Op op = self.binOp(self.cur.kind);
            if (op != Op::Range && op != Op::RangeEq) break;
            Loc loc = self.here();
            self.advance();
            Expr* r = self.parseOr();
            Expr* n = newExpr(self.arena, ExprKind::Range, loc);
            n.op = op;
            n.a = e;
            n.b = r;
            e = n;
        }
        return e;
    }

    Expr* parseOr()
    {
        Expr* e = self.parseAnd();
        while (self.cur.kind == TokenKind::Or)
        {
            Loc loc = self.here();
            self.advance();
            Expr* r = self.parseAnd();
            Expr* n = newExpr(self.arena, ExprKind::Binary, loc);
            n.op = Op::LOr;
            n.a = e;
            n.b = r;
            e = n;
        }
        return e;
    }

    Expr* parseAnd()
    {
        Expr* e = self.parseCmp();
        while (self.cur.kind == TokenKind::And)
        {
            Loc loc = self.here();
            self.advance();
            Expr* r = self.parseCmp();
            Expr* n = newExpr(self.arena, ExprKind::Binary, loc);
            n.op = Op::LAnd;
            n.a = e;
            n.b = r;
            e = n;
        }
        return e;
    }

    Expr* parseCmp()
    {
        Expr* e = self.parseBitOrXor();
        usize count = 0;
        while (true)
        {
            Op op = self.binOp(self.cur.kind);
            if (op != Op::Eq && op != Op::Ne && op != Op::Lt && op != Op::Le && op != Op::Gt && op != Op::Ge) break;
            if (count > 0)
            {
                self.perr("E0209", "comparison operators cannot be chained");
                self.diags.why("a comparison produces a bool, so a second comparison would compare against a bool");
                self.diags.help("chain with `&&`, for example `a < b && b < c`");
            }
            Loc loc = self.here();
            self.advance();
            Expr* r = self.parseBitOrXor();
            Expr* n = newExpr(self.arena, ExprKind::Binary, loc);
            n.op = op;
            n.a = e;
            n.b = r;
            e = n;
            count++;
        }
        return e;
    }

    Expr* parseBitOrXor()
    {
        Expr* e = self.parseBitAnd();
        while (true)
        {
            Op op = self.binOp(self.cur.kind);
            if (op != Op::Bor && op != Op::Bxor) break;
            Loc loc = self.here();
            self.advance();
            Expr* r = self.parseBitAnd();
            Expr* n = newExpr(self.arena, ExprKind::Binary, loc);
            n.op = op;
            n.a = e;
            n.b = r;
            e = n;
        }
        return e;
    }

    Expr* parseBitAnd()
    {
        Expr* e = self.parseShift();
        while (self.cur.kind == TokenKind::Amp)
        {
            Loc loc = self.here();
            self.advance();
            Expr* r = self.parseShift();
            Expr* n = newExpr(self.arena, ExprKind::Binary, loc);
            n.op = Op::Band;
            n.a = e;
            n.b = r;
            e = n;
        }
        return e;
    }

    Expr* parseShift()
    {
        Expr* e = self.parseAdd();
        while (true)
        {
            Op op = self.binOp(self.cur.kind);
            if (op != Op::Shl && op != Op::Shr) break;
            Loc loc = self.here();
            self.advance();
            Expr* r = self.parseAdd();
            Expr* n = newExpr(self.arena, ExprKind::Binary, loc);
            n.op = op;
            n.a = e;
            n.b = r;
            e = n;
        }
        return e;
    }

    Expr* parseAdd()
    {
        Expr* e = self.parseMul();
        while (true)
        {
            Op op = self.binOp(self.cur.kind);
            if (op != Op::Add && op != Op::Sub) break;
            Loc loc = self.here();
            self.advance();
            Expr* r = self.parseMul();
            Expr* n = newExpr(self.arena, ExprKind::Binary, loc);
            n.op = op;
            n.a = e;
            n.b = r;
            e = n;
        }
        return e;
    }

    Expr* parseMul()
    {
        Expr* e = self.parseUnary();
        while (true)
        {
            Op op = self.binOp(self.cur.kind);
            if (op != Op::Mul && op != Op::Div && op != Op::Rem) break;
            Loc loc = self.here();
            self.advance();
            Expr* r = self.parseUnary();
            Expr* n = newExpr(self.arena, ExprKind::Binary, loc);
            n.op = op;
            n.a = e;
            n.b = r;
            e = n;
        }
        return e;
    }

    Expr* parseUnary()
    {
        Loc loc = self.here();
        if (self.cur.kind == TokenKind::Minus)
        {
            self.advance();
            Expr* n = newExpr(self.arena, ExprKind::Unary, loc);
            n.op = Op::Neg;
            n.a = self.parseUnary();
            return n;
        }
        if (self.cur.kind == TokenKind::Not)
        {
            self.advance();
            Expr* n = newExpr(self.arena, ExprKind::Unary, loc);
            n.op = Op::Not;
            n.a = self.parseUnary();
            return n;
        }
        if (self.cur.kind == TokenKind::KwAwait)
        {
            self.advance();
            Expr* n = newExpr(self.arena, ExprKind::Unary, loc);
            n.op = Op::Await;
            n.a = self.parseUnary();
            return n;
        }
        Expr* e = self.parsePostfix();
        while (self.cur.kind == TokenKind::KwAs)
        {
            Loc cl = self.here();
            self.advance();
            Type* t = self.parseType();
            Expr* n = newExpr(self.arena, ExprKind::Cast, cl);
            n.a = e;
            n.type = t;
            e = n;
        }
        return e;
    }

    Expr* parsePostfix()
    {
        Expr* e = self.parsePrimary();
        while (true)
        {
            TokenKind k = self.cur.kind;

            if (k == TokenKind::LParen)
            {
                Loc loc = self.here();
                bool saved = self.noStruct;
                self.noStruct = false;
                self.expect(TokenKind::LParen);
                PtrList* args = newList(self.arena);
                while (self.cur.kind != TokenKind::RParen && !self.atEnd())
                {
                    listPush(args, (rawptr)self.parseExpr());
                    if (!self.match(TokenKind::Comma)) break;
                }
                self.expect(TokenKind::RParen);
                self.noStruct = saved;
                Expr* c = newExpr(self.arena, ExprKind::Call, loc);
                c.a = e;
                c.list = args;
                c.gargs = e.gargs;
                e.gargs = null;
                e = c;
                continue;
            }

            if (k == TokenKind::LBracket)
            {
                Loc loc = self.here();
                bool saved = self.noStruct;
                self.noStruct = false;
                self.expect(TokenKind::LBracket);
                Expr* idx = self.parseExpr();
                self.expect(TokenKind::RBracket);
                self.noStruct = saved;
                Expr* n = newExpr(self.arena, ExprKind::Index, loc);
                n.a = e;
                n.b = idx;
                e = n;
                continue;
            }

            if (k == TokenKind::Dot)
            {
                if (self.nxt.kind == TokenKind::Ident)
                {
                    Loc loc = self.here();
                    self.advance();
                    Expr* f = newExpr(self.arena, ExprKind::Field, loc);
                    f.a = e;
                    f.name = self.cur.text;
                    f.text = self.cur.text;
                    self.advance();
                    e = f;
                    continue;
                }
                self.perr("E0200", "expected a field name after `.`");
                self.advance();
                break;
            }

            if (k == TokenKind::Question)
            {
                Loc loc = self.here();
                self.advance();
                Expr* n = newExpr(self.arena, ExprKind::Question, loc);
                n.a = e;
                e = n;
                continue;
            }

            if (k == TokenKind::ColonColon)
            {
                if (self.nxt.kind != TokenKind::Less) break;
                self.advance();
                PtrList* g = self.parseTypeArgs();
                e.gargs = g;
                continue;
            }

            break;
        }
        return e;
    }

    Expr* parsePrimary()
    {
        Loc loc = self.here();
        TokenKind k = self.cur.kind;

        #[[fallthrough]]
        switch (k)
        {
            TokenKind::Int => { Token t = self.cur; self.advance(); return self.literalFromToken(t); },
            TokenKind::Float => { Token t = self.cur; self.advance(); return self.literalFromToken(t); },
            TokenKind::Str => { Token t = self.cur; self.advance(); return self.literalFromToken(t); },
            TokenKind::CharLit => { Token t = self.cur; self.advance(); return self.literalFromToken(t); },
            TokenKind::KwTrue => { Token t = self.cur; self.advance(); return self.literalFromToken(t); },
            TokenKind::KwFalse => { Token t = self.cur; self.advance(); return self.literalFromToken(t); },
            TokenKind::KwIf => { return self.controlExpr(ExprKind::If, loc, self.parseIf()); },
            TokenKind::KwWhile => { return self.controlExpr(ExprKind::While, loc, self.parseWhile(loc)); },
            TokenKind::KwSwitch => { return self.controlExpr(ExprKind::Switch, loc, self.parseSwitch(loc)); },
        }

        if (k == TokenKind::KwSelf)
        {
            if (!self.inFn)
            {
                self.perr("E0225", "`self` outside of a method");
                self.diags.why("`self` is only valid inside a function that declares it as a parameter");
            }
            else if (!self.fnHasSelf)
            {
                self.perr("E0225", "`self` is not available in this function");
                self.diags.help("add a `self` parameter to use `self`");
            }
            self.advance();
            Expr* se = newExpr(self.arena, ExprKind::Name, loc);
            se.name = "self";
            se.text = "self";
            return se;
        }

        if (k == TokenKind::At)
        {
            self.perr("E0218", "`@` cannot start an expression");
            self.diags.why("labels are written `@name:` before a loop, or `break @name;`");
            self.advance();
            return newExpr(self.arena, ExprKind::Name, loc);
        }

        if (k == TokenKind::KwElse)
        {
            self.perr("E0224", "`else` without a matching `if`");
            self.diags.help("remove the `else`, or add an `if` before it");
            self.advance();
            return newExpr(self.arena, ExprKind::Name, loc);
        }

        if (k == TokenKind::Ident)
        {
            str name = self.cur.text;
            if (!self.noStruct && self.nxt.kind == TokenKind::LBrace)
            {
                self.advance();
                return self.parseStructLit(name, loc);
            }
            self.advance();
            while (self.cur.kind == TokenKind::ColonColon && self.nxt.kind == TokenKind::Ident)
            {
                self.advance();
                name = self.cat3(name, "::", self.cur.text);
                self.advance();
            }
            if (!self.noStruct && self.cur.kind == TokenKind::LBrace)
            {
                return self.parseStructLit(name, loc);
            }
            Expr* e = newExpr(self.arena, ExprKind::Name, loc);
            e.name = name;
            e.text = name;
            return e;
        }

        if (k == TokenKind::LParen)
        {
            self.expect(TokenKind::LParen);
            bool saved = self.noStruct;
            self.noStruct = false;
            Expr* first = self.parseExpr();
            if (self.cur.kind == TokenKind::Comma)
            {
                PtrList* items = newList(self.arena);
                listPush(items, (rawptr)first);
                while (self.match(TokenKind::Comma))
                {
                    if (self.cur.kind == TokenKind::RParen) break;
                    listPush(items, (rawptr)self.parseExpr());
                }
                self.expect(TokenKind::RParen);
                self.noStruct = saved;
                Expr* n = newExpr(self.arena, ExprKind::Tuple, loc);
                n.list = items;
                return n;
            }
            self.expect(TokenKind::RParen);
            self.noStruct = saved;
            return first;
        }

        if (k == TokenKind::LBracket)
        {
            self.expect(TokenKind::LBracket);
            bool saved = self.noStruct;
            self.noStruct = false;
            PtrList* items = newList(self.arena);
            while (self.cur.kind != TokenKind::RBracket && !self.atEnd())
            {
                ArrayItem* it = newArrayItem(self.arena);
                if (self.cur.kind == TokenKind::Ellipsis)
                {
                    self.advance();
                    it.spread = true;
                    it.value = self.parseExpr();
                }
                else
                {
                    Expr* e = self.parseExpr();
                    if (self.cur.kind == TokenKind::Colon)
                    {
                        self.advance();
                        it.key = e;
                        it.value = self.parseExpr();
                    }
                    else
                    {
                        it.value = e;
                    }
                }
                listPush(items, (rawptr)it);
                if (!self.match(TokenKind::Comma)) break;
            }
            self.expect(TokenKind::RBracket);
            self.noStruct = saved;
            Expr* n = newExpr(self.arena, ExprKind::ArrayLit, loc);
            n.list = items;
            return n;
        }

        self.perr("E0204", self.fmt("expected an expression, found `{}`", kindName(self.cur.kind)));
        self.whyFound();
        if (!self.isBoundary(self.cur.kind)) self.advance();
        Expr* bad = newExpr(self.arena, ExprKind::Name, loc);
        return bad;
    }

    Expr* controlExpr(ExprKind kind, Loc loc, Stmt* s)
    {
        Expr* e = newExpr(self.arena, kind, loc);
        e.stmt = s;
        return e;
    }

    Expr* parseStructLit(str name, Loc loc)
    {
        self.expect(TokenKind::LBrace);
        bool saved = self.noStruct;
        self.noStruct = false;
        Expr* e = newExpr(self.arena, ExprKind::StructLit, loc);
        e.name = name;
        e.text = name;
        e.list = newList(self.arena);
        while (self.cur.kind != TokenKind::RBrace && !self.atEnd())
        {
            FieldInit* f = newFieldInit(self.arena);
            if (self.cur.kind == TokenKind::DotDot)
            {
                self.advance();
                f.spread = true;
                f.value = self.parseExpr();
            }
            else if (self.cur.kind == TokenKind::Ident)
            {
                str fname = self.cur.text;
                Loc ff = self.here();
                if (self.nxt.kind == TokenKind::Colon)
                {
                    self.advance();
                    self.advance();
                    f.name = fname;
                    f.value = self.parseExpr();
                }
                else
                {
                    self.advance();
                    f.name = fname;
                    f.value = newExpr(self.arena, ExprKind::Name, Loc { .line = self.cur.line, .col = self.cur.col });
                    f.value.name = fname;
                    f.value.text = fname;
                }
                usize xi = 0;
                while (xi < e.list.len)
                {
                    FieldInit* prev = (FieldInit*)e.list.data[xi];
                    xi++;
                    if (prev.name.len == 0) continue;
                    if (!self.sameStr(prev.name, fname)) continue;
                    self.perrAt(ff, "E0207", self.fmtStr("duplicate field `{}`", fname));
                    if (prev.value != null) self.alsoAt(prev.value.loc, "first initializer is here");
                    break;
                }
            }
            else
            {
                self.perr("E0201", self.fmt("expected a field name, found `{}`", kindName(self.cur.kind)));
                if (!self.isBoundary(self.cur.kind)) self.advance();
            }
            listPush(e.list, (rawptr)f);
            if (!self.match(TokenKind::Comma)) break;
        }
        self.expect(TokenKind::RBrace);
        self.noStruct = saved;
        return e;
    }
}
