import common::token { Token, TokenKind, kindName, matchWord };
import diag::diag { Diags };
import lexer::lexer { Lexer };
import core::arena { Arena };
import ast::ast { Loc, Decl, DeclKind, PtrList, newList, listPush, newDecl, Attr, newAttr, Param, newParam, GenericParam, newGenericParam, FieldDecl, newFieldDecl, VariantCase, newVariantCase, UseSpec, newUseSpec, Type, Expr, ExprKind, newExpr, Stmt, Op, FieldInit, newFieldInit, ArrayItem, newArrayItem, StmtKind, newStmt, Prong, newProng, Pattern, PatternKind, newPattern, TypeKind, newType };

pub struct OpenTok
{
    TokenKind kind;
    usize line;
    usize col;
}

pub struct LabelDef
{
    str name;
    usize line;
    usize col;
}

pub struct Parser
{
    Lexer* lexer;
    Diags* diags;
    Arena* arena;
    Token cur;
    Token nxt;
    Token gtRest;
    bool hasGtRest;
    bool noStruct;
    OpenTok* opens;
    usize openLen;
    usize openCap;
    LabelDef* labels;
    usize labelLen;
    usize labelCap;
    usize loopDepth;
    bool inFn;
    bool fnHasSelf;
    PtrList* declAttrs;
}

pub extend Parser
{
    void init(Lexer* lx, Diags* dg, Arena* ar)
    {
        self = Parser {
            .lexer = lx,
            .diags = dg,
            .arena = ar,
            .hasGtRest = false,
            .noStruct = false,
            .opens = null,
            .openLen = 0,
            .openCap = 0,
            .labels = null,
            .labelLen = 0,
            .labelCap = 0,
            .loopDepth = 0,
            .inFn = false,
            .fnHasSelf = false,
            .declAttrs = null,
            .gtRest = Token { .kind = TokenKind::Eof, .text = str::empty(), .line = 0, .col = 0 },
            .cur = self.lexer.next(),
            .nxt = self.lexer.next()
        };
    }

    bool atEnd() { return self.cur.kind == TokenKind::Eof; }
    bool check(TokenKind kind) { return self.cur.kind == kind; }

    bool match(TokenKind kind)
    {
        if (self.cur.kind == kind)
        {
            self.advance();
            return true;
        }
        return false;
    }

    void advance()
    {
        if (self.hasGtRest)
        {
            self.cur = self.gtRest;
            self.hasGtRest = false;
            return;
        }
        self.cur = self.nxt;
        self.nxt = self.lexer.next();
    }

    void perr(str code, str title)
    {
        usize len = self.cur.text.len;
        if (len == 0) len = 1;
        self.diags.error(self.cur.line, self.cur.col, len, code, title);
    }

    str _fmtApply(str shape, str a, str b)
    {
        u8* buf = (u8*)self.arena.alloc(192, 1);
        usize o = 0;
        usize i = 0;
        usize used = 0;
        while (i < shape.len && o + 1 < 192)
        {
            if (shape.ptr[i] == (u8)'{' && i + 1 < shape.len && shape.ptr[i + 1] == (u8)'}')
            {
                str v = used == 0 ? a : b;
                used++;
                usize j = 0;
                while (j < v.len && o + 1 < 192)
                {
                    buf[o] = v.ptr[j];
                    o++;
                    j++;
                }
                i += 2;
                continue;
            }
            buf[o] = shape.ptr[i];
            o++;
            i++;
        }
        buf[o] = 0;
        return str::fromCstr(buf);
    }

    void whyFound()
    {
        self.diags.why(self.fmt("found `{}` here", kindName(self.cur.kind)));
    }

    str fmt(str shape, str a)
    {
        return self._fmtApply(shape, a, "");
    }

    str fmt2(str shape, str a, str b)
    {
        return self._fmtApply(shape, a, b);
    }

    str fmtStr(str shape, str a)
    {
        return self._fmtApply(shape, a, "");
    }

    str fmtStr2(str shape, str a, str b)
    {
        return self._fmtApply(shape, a, b);
    }

    bool sameStr(str a, str b)
    {
        if (a.len != b.len) return false;
        usize i = 0;
        while (i < a.len)
        {
            if (a.ptr[i] != b.ptr[i]) return false;
            i++;
        }
        return true;
    }

    str lastSeg(str s)
    {
        usize start = 0;
        usize i = 0;
        while (i < s.len)
        {
            if (s.ptr[i] == (u8)':' && i + 1 < s.len && s.ptr[i + 1] == (u8)':')
            {
                i += 2;
                start = i;
                continue;
            }
            i++;
        }
        if (start == 0) return s;
        return s.slice(start, s.len);
    }

    void perrAt(Loc loc, str code, str title) { self.diags.error(loc.line, loc.col, 1, code, title); }
    void alsoAt(Loc loc, str msg) { self.diags.also(loc.line, loc.col, 1, msg); }
    bool isOpen(TokenKind k) { return k == TokenKind::LParen || k == TokenKind::LBrace || k == TokenKind::LBracket; }
    bool isClose(TokenKind k) { return k == TokenKind::RParen || k == TokenKind::RBrace || k == TokenKind::RBracket; }
    Loc here() { return Loc { .line = self.cur.line, .col = self.cur.col }; }
    
    bool openPair(TokenKind open, TokenKind close)
    {
        if (open == TokenKind::LParen) return close == TokenKind::RParen;
        if (open == TokenKind::LBrace) return close == TokenKind::RBrace;
        if (open == TokenKind::LBracket) return close == TokenKind::RBracket;
        return false;
    }

    void pushOpen(TokenKind kind, usize line, usize col)
    {
        if (self.openLen >= self.openCap)
        {
            usize newCap = 8;
            if (self.openCap != 0) newCap = self.openCap * 2;
            OpenTok* fresh = (OpenTok*)self.arena.alloc(newCap * @sizeof(OpenTok), 8);
            usize i = 0;
            while (i < self.openLen)
            {
                fresh[i].kind = self.opens[i].kind;
                fresh[i].line = self.opens[i].line;
                fresh[i].col = self.opens[i].col;
                i++;
            }
            self.opens = fresh;
            self.openCap = newCap;
        }
        self.opens[self.openLen].kind = kind;
        self.opens[self.openLen].line = line;
        self.opens[self.openLen].col = col;
        self.openLen++;
    }

    void popOpen(TokenKind close, usize line, usize col)
    {
        if (self.openLen == 0) return;
        TokenKind tk = self.opens[self.openLen - 1].kind;
        usize tl = self.opens[self.openLen - 1].line;
        usize tc = self.opens[self.openLen - 1].col;
        if (self.openPair(tk, close))
        {
            self.openLen--;
            return;
        }
        self.diags.error(line, col, 1, "E0208", self.fmt2("mismatched `{}`, expected `{}`", kindName(close), kindName(tk)));
        self.diags.why("this delimiter does not close the one that is still open");
        self.diags.also(tl, tc, 1, self.fmt("unclosed `{}` opened here", kindName(tk)));
        self.openLen--;
    }

    void unclosedClose(TokenKind need)
    {
        if (self.openLen > 0)
        {
            TokenKind tk = self.opens[self.openLen - 1].kind;
            usize tl = self.opens[self.openLen - 1].line;
            usize tc = self.opens[self.openLen - 1].col;
            if (self.openPair(tk, need)) {
                self.perr("E0208", self.fmt("unclosed `{}`", kindName(tk)));
            }
            else {
                self.perr("E0208", self.fmt2("expected `{}`, found `{}`", kindName(need), kindName(self.cur.kind)));
            }
            self.whyFound();
            self.diags.also(tl, tc, 1, self.fmt("unclosed `{}` opened here", kindName(tk)));
            self.openLen--;
            return;
        }
        self.perr("E0208", self.fmt2("expected `{}`, found `{}`", kindName(need), kindName(self.cur.kind)));
        self.whyFound();
    }

    void pushLabel(str name, Loc loc)
    {
        if (self.labelLen >= self.labelCap)
        {
            usize newCap = 8;
            if (self.labelCap != 0) newCap = self.labelCap * 2;
            LabelDef* fresh = (LabelDef*)self.arena.alloc(newCap * @sizeof(LabelDef), 8);
            usize i = 0;
            while (i < self.labelLen)
            {
                fresh[i].name = self.labels[i].name;
                fresh[i].line = self.labels[i].line;
                fresh[i].col = self.labels[i].col;
                i++;
            }
            self.labels = fresh;
            self.labelCap = newCap;
        }
        self.labels[self.labelLen].name = name;
        self.labels[self.labelLen].line = loc.line;
        self.labels[self.labelLen].col = loc.col;
        self.labelLen++;
    }

    void popLabel()
    {
        if (self.labelLen > 0) self.labelLen = self.labelLen - 1;
    }

    usize findLabel(str name)
    {
        usize i = 0;
        while (i < self.labelLen)
        {
            if (self.sameStr(self.labels[i].name, name)) return i;
            i++;
        }
        return self.labelLen;
    }

    void validateManifest(Token t)
    {
        usize i = 2;
        while (i < t.text.len && (t.text.ptr[i] == (u8)' ' || t.text.ptr[i] == (u8)'\t')) i = i + 1;
        if (i >= t.text.len) return;
        while (i < t.text.len)
        {
            usize start = i;
            while (i < t.text.len && t.text.ptr[i] != (u8)',') i = i + 1;
            usize end = i;
            while (start < end && (t.text.ptr[start] == (u8)' ' || t.text.ptr[start] == (u8)'\t')) start = start + 1;
            while (end > start && (t.text.ptr[end - 1] == (u8)' ' || t.text.ptr[end - 1] == (u8)'\t')) end = end - 1;
            if (end > start)
            {
                str g = t.text.slice(start, end);
                if (!matchWord(g, "string.casing") && !matchWord(g, "string.format"))
                {
                    self.diags.error(t.line, t.col, t.text.len, "E0214", self.fmtStr("unknown manifest group `{}`", g));
                    self.diags.help("known groups are `string.casing` and `string.format`");
                }
            }
            if (i < t.text.len) i = i + 1;
        }
    }

    str cat(str a, str b)
    {
        usize n = a.len + b.len;
        if (n == 0) return str::empty();
        u8* p = (u8*)self.arena.alloc(n, 1);
        if (p == null) return str::empty();
        usize i = 0;
        while (i < a.len)
        {
            p[i] = a.ptr[i];
            i++;
        }
        usize j = 0;
        while (j < b.len)
        {
            p[a.len + j] = b.ptr[j];
            j++;
        }
        return str::fromParts(p, n);
    }

    str cat3(str a, str sep, str b)
    {
        return self.cat(self.cat(a, sep), b);
    }

    bool isBoundary(TokenKind kind)
    {
        switch (kind)
        {
            TokenKind::RParen => { return true; },
            TokenKind::RBrace => { return true; },
            TokenKind::RBracket => { return true; },
            TokenKind::Semicolon => { return true; },
            TokenKind::Comma => { return true; },
            TokenKind::Eof => { return true; },
            TokenKind::FatArrow => { return true; },
            TokenKind::KwPub => { return true; },
            TokenKind::KwFn => { return true; },
            TokenKind::KwStruct => { return true; },
            TokenKind::KwVariant => { return true; },
            TokenKind::KwTrait => { return true; },
            TokenKind::KwExtend => { return true; },
            TokenKind::KwConst => { return true; },
            TokenKind::KwType => { return true; },
            TokenKind::KwUse => { return true; },
            TokenKind::KwAsync => { return true; },
            TokenKind::KwExtern => { return true; },
            TokenKind::KwElse => { return true; },
            else => { return false; }
        }
    }

    bool isDeclStart(TokenKind kind)
    {
        switch (kind)
        {
            TokenKind::KwPub => { return true; },
            TokenKind::KwFn => { return true; },
            TokenKind::KwStruct => { return true; },
            TokenKind::KwVariant => { return true; },
            TokenKind::KwTrait => { return true; },
            TokenKind::KwExtend => { return true; },
            TokenKind::KwConst => { return true; },
            TokenKind::KwType => { return true; },
            TokenKind::KwUse => { return true; },
            TokenKind::KwAsync => { return true; },
            TokenKind::KwExtern => { return true; },
            TokenKind::At => { return true; },
            else => { return false; }
        }
    }

    Token expect(TokenKind kind)
    {
        if (self.cur.kind == kind)
        {
            Token t = self.cur;
            if (self.isOpen(kind)) self.pushOpen(kind, t.line, t.col);
            else if (self.isClose(kind)) self.popOpen(kind, t.line, t.col);
            self.advance();
            return t;
        }
        if (self.isClose(kind))
        {
            self.unclosedClose(kind);
            return self.cur;
        }
        self.perr("E0200", self.fmt2("expected `{}`, found `{}`", kindName(kind), kindName(self.cur.kind)));
        self.whyFound();
        if (!self.isBoundary(self.cur.kind)) self.advance();
        return self.cur;
    }

    Token expectName()
    {
        if (self.cur.kind == TokenKind::Ident)
        {
            Token t = self.cur;
            self.advance();
            return t;
        }
        self.perr("E0200", self.fmt("expected a name, found `{}`", kindName(self.cur.kind)));
        if (!self.isBoundary(self.cur.kind)) self.advance();
        return Token {
            .kind = TokenKind::Ident,
            .text = "",
            .line = self.cur.line,
            .col = self.cur.col
        };
    }

    void makeGtRest(TokenKind rest)
    {
        str t = self.cur.text;
        self.gtRest.kind = rest;
        self.gtRest.text = t.slice(1, t.len);
        self.gtRest.line = self.cur.line;
        self.gtRest.col = self.cur.col + 1;
        self.cur.kind = TokenKind::Greater;
        self.cur.text = t.slice(0, 1);
        self.hasGtRest = true;
    }

    void expectGt()
    {
        #[[fallthrough]]
        switch (self.cur.kind)
        {
            TokenKind::Greater => { self.advance(); return; },
            TokenKind::Shr => { self.makeGtRest(TokenKind::Greater); self.advance(); return; },
            TokenKind::GreaterEqual => { self.makeGtRest(TokenKind::Equal); self.advance(); return; },
            TokenKind::ShrEqual => { self.makeGtRest(TokenKind::GreaterEqual); self.advance(); return; },
        }
        self.perr("E0200", "expected `>`, the end of a generic argument list");
        if (!self.isBoundary(self.cur.kind)) self.advance();
    }

    str parsePath()
    {
        if (self.cur.kind != TokenKind::Ident)
        {
            self.perr("E0200", self.fmt("expected a name, found `{}`", kindName(self.cur.kind)));
            if (!self.isBoundary(self.cur.kind)) self.advance();
            return str::empty();
        }
        str acc = self.cur.text;
        self.advance();
        while (self.cur.kind == TokenKind::ColonColon)
        {
            if (self.nxt.kind != TokenKind::Ident) break;
            self.advance();
            acc = self.cat3(acc, "::", self.cur.text);
            self.advance();
        }
        return acc;
    }

    void synchronize()
    {
        while (!self.atEnd())
        {
            TokenKind k = self.cur.kind;
            if (k == TokenKind::Semicolon)
            {
                self.advance();
                return;
            }
            if (k == TokenKind::RBrace || k == TokenKind::RParen || k == TokenKind::RBracket) return;
            if (self.isDeclStart(k)) return;
            self.advance();
        }
    }

    PtrList* parseFile()
    {
        PtrList* decls = newList(self.arena);
        bool started = false;
        while (!self.atEnd())
        {
            if (self.cur.kind == TokenKind::Manifest)
            {
                if (started) self.perr("E0202", "manifest directive must appear before any code");
                self.validateManifest(self.cur);
                self.advance();
                continue;
            }
            started = true;
            if (self.cur.kind == TokenKind::RBrace || self.cur.kind == TokenKind::RParen || self.cur.kind == TokenKind::RBracket)
            {
                self.perr("E0201", "unexpected closing token at file scope");
                self.whyFound();
                self.advance();
                continue;
            }
            usize errs = self.diags.errors;
            usize pos = self.lexer.pos;
            u8* ptr = self.cur.text.ptr;
            TokenKind kb = self.cur.kind;
            Decl* d = self.parseDecl();
            if (d != null)
            {
                if (d.kind != DeclKind::DcExtend && d.name.len > 0)
                {
                    usize i = 0;
                    while (i < decls.len)
                    {
                        Decl* prev = (Decl*)decls.data[i];
                        i++;
                        if (prev.kind == DeclKind::DcExtend) continue;
                        if (prev.name.len == 0) continue;
                        if (!self.sameStr(prev.name, d.name)) continue;
                        self.perrAt(d.loc, "E0207", self.fmtStr("duplicate definition of `{}`", d.name));
                        self.diags.why("a name may only be defined once at file scope");
                        self.alsoAt(prev.loc, "first defined here");
                        self.diags.help("rename or remove one of the definitions");
                        break;
                    }
                }
                listPush(decls, (rawptr)d);
            }
            bool progressed = self.lexer.pos != pos || self.cur.kind != kb || self.cur.text.ptr != ptr;
            if (!progressed && !self.atEnd()) self.advance();
            if (self.diags.errors > errs) self.synchronize();
        }
        return decls;
    }


    Decl* parseDecl()
    {
        Loc loc = self.here();
        bool isPub = false;
        bool isAsync = false;
        bool isExtern = false;
        Loc pubLoc = loc;
        Loc asyncLoc = loc;
        Loc externLoc = loc;

        loop {
            if (self.cur.kind == TokenKind::KwPub)
            {
                if (isPub)
                {
                    self.perr("E0215", "duplicate `pub`");
                    self.alsoAt(pubLoc, "first `pub` is here");
                }
                else
                {
                    pubLoc = self.here();
                    isPub = true;
                }
                self.advance();
                continue;
            }
            if (self.cur.kind == TokenKind::KwAsync)
            {
                if (isAsync)
                {
                    self.perr("E0215", "duplicate `async`");
                    self.alsoAt(asyncLoc, "first `async` is here");
                }
                else
                {
                    asyncLoc = self.here();
                    isAsync = true;
                }
                self.advance();
                continue;
            }
            if (self.cur.kind == TokenKind::At)
            {
                if (self.nxt.kind == TokenKind::KwExtern)
                {
                    if (isExtern) {
                        self.perr("E0215", "duplicate `@extern`");
                        self.alsoAt(externLoc, "first `@extern` is here");
                    }
                    else {
                        externLoc = self.here();
                        isExtern = true;
                    }
                    self.advance();
                    self.advance();
                    continue;
                }
                Attr* a = self.parseAttr();
                if (self.declAttrs == null) self.declAttrs = newList(self.arena);
                listPush(self.declAttrs, (rawptr)a);
                continue;
            }
            break;
        }

        if (isExtern && self.cur.kind != TokenKind::KwFn)
        {
            self.perr("E0215", "`@extern` may only be applied to functions");
            self.diags.help("remove `@extern`, or apply it to a `fn` declaration");
        }

        PtrList* attrs = self.declAttrs;
        self.declAttrs = null;
        Decl* d = null;

        #[[fallthrough]]
        switch (self.cur.kind)
        {
            TokenKind::KwFn => { d = self.parseFn(loc, isPub, isAsync, isExtern); },
            TokenKind::KwStruct => { d = self.parseStructDecl(loc, isPub); },
            TokenKind::KwVariant => { d = self.parseVariantDecl(loc, isPub); },
            TokenKind::KwTrait => { d = self.parseTraitDecl(loc, isPub); },
            TokenKind::KwExtend => { d = self.parseExtendDecl(loc, isPub); },
            TokenKind::KwConst => { d = self.parseConstDecl(loc, isPub); },
            TokenKind::KwType => { d = self.parseTypeAliasDecl(loc, isPub); },
            TokenKind::KwUse => { d = self.parseUseDecl(loc, isPub); },
        }
        self.declAttrs = null;

        if (d != null)
        {
            d.attrs = attrs;
            self.validateAttrs(d);
            return d;
        }

        if (self.cur.kind == TokenKind::KwElse)
        {
            self.perr("E0224", "`else` without a matching `if`");
            self.diags.help("remove the `else`, or add an `if` before it");
            self.advance();
            return null;
        }

        self.perr("E0203", self.fmt("expected a declaration, found `{}`", kindName(self.cur.kind)));
        self.whyFound();
        if (!self.isBoundary(self.cur.kind)) self.advance();
        return null;
    }

    Decl* parseFn(Loc loc, bool isPub, bool isAsync, bool isExtern)
    {
        self.expect(TokenKind::KwFn);
        Decl* d = newDecl(self.arena, DeclKind::DcFn, loc);
        d.isPub = isPub;
        d.isAsync = isAsync;
        d.isExtern = isExtern;
        d.attrs = self.declAttrs;
        self.declAttrs = null;
        d.name = self.expectName().text;
        if (self.cur.kind == TokenKind::Less) d.generics = self.parseGenericParams();
        self.expect(TokenKind::LParen);
        bool savedInFn = self.inFn;
        bool savedSelf = self.fnHasSelf;
        self.inFn = true;
        self.fnHasSelf = false;
        d.params = self.parseParams();
        self.expect(TokenKind::RParen);
        d.ret = self.parseRetType();
        usize pi = 0;
        while (pi < d.params.len)
        {
            Param* p = (Param*)d.params.data[pi];
            if (p.isSelf)
            {
                self.fnHasSelf = true;
                break;
            }
            pi++;
        }
        if (isExtern && self.cur.kind == TokenKind::LBrace)
        {
            self.perr("E0215", "`@extern` functions cannot have a body");
            self.diags.help("end the declaration with `;` instead");
            d.body = self.parseBlock();
            self.inFn = savedInFn;
            self.fnHasSelf = savedSelf;
            self.validateAttrs(d);
            return d;
        }
        if (isExtern || self.cur.kind == TokenKind::Semicolon)
        {
            self.expect(TokenKind::Semicolon);
            self.inFn = savedInFn;
            self.fnHasSelf = savedSelf;
            self.validateAttrs(d);
            return d;
        }
        d.body = self.parseBlock();
        self.inFn = savedInFn;
        self.fnHasSelf = savedSelf;
        self.validateAttrs(d);
        return d;
    }

    Type* parseRetType()
    {
        if (self.cur.kind == TokenKind::Arrow)
        {
            self.advance();
            return self.parseType();
        }
        if (self.cur.kind == TokenKind::LBrace || self.cur.kind == TokenKind::Semicolon) return null;
        if (self.isTypeStart()) return self.parseType();
        self.perr("E0200", "expected a return type, `->`, `{`, or `;`");
        return null;
    }

    PtrList* parseGenericParams()
    {
        self.expect(TokenKind::Less);
        PtrList* list = newList(self.arena);
        loop {
            TokenKind k = self.cur.kind;
            if (k == TokenKind::Greater || k == TokenKind::Shr || k == TokenKind::GreaterEqual || k == TokenKind::ShrEqual) break;
            Loc gl = self.here();
            GenericParam* g = newGenericParam(self.arena);
            g.name = self.expectName().text;
            g.loc = gl;
            if (self.cur.kind == TokenKind::Colon)
            {
                self.advance();
                g.bound = self.parseType();
            }
            listPush(list, (rawptr)g);
            if (!self.match(TokenKind::Comma)) break;
        }
        if (list.len == 0) self.perr("E0200", "expected a generic parameter");
        self.expectGt();
        return list;
    }

    PtrList* parseParams()
    {
        PtrList* list = newList(self.arena);
        while (self.cur.kind != TokenKind::RParen && !self.atEnd())
        {
            Loc pl = self.here();
            Param* p = newParam(self.arena);
            p.loc = pl;
            if (self.cur.kind == TokenKind::KwSelf)
            {
                p.isSelf = true;
                p.name = self.cur.text;
                Loc sl = self.here();
                self.advance();
                if (list.len > 0)
                {
                    self.perrAt(sl, "E0225", "`self` must be the first parameter");
                    Param* first = (Param*)list.data[0];
                    self.alsoAt(first.loc, "first parameter is here");
                    self.diags.help("move `self` before the other parameters");
                }
                if (self.cur.kind == TokenKind::Colon)
                {
                    self.perr("E0225", "`self` cannot have a type annotation");
                    self.diags.help("write a bare `self` parameter");
                    self.advance();
                    self.parseType();
                }
            }
            else
            {
                p.name = self.expectName().text;
                self.expect(TokenKind::Colon);
                p.type = self.parseType();
                if (p.name.len > 0)
                {
                    usize qi = 0;
                    while (qi < list.len)
                    {
                        Param* prev = (Param*)list.data[qi];
                        qi++;
                        if (!self.sameStr(prev.name, p.name)) continue;
                        self.perrAt(pl, "E0207", self.fmtStr("duplicate parameter `{}`", p.name));
                        self.alsoAt(prev.loc, "first parameter is here");
                        break;
                    }
                }
            }
            listPush(list, (rawptr)p);
            if (!self.match(TokenKind::Comma)) break;
        }
        return list;
    }

    Decl* parseStructDecl(Loc loc, bool isPub)
    {
        self.expect(TokenKind::KwStruct);
        Decl* d = newDecl(self.arena, DeclKind::DcStruct, loc);
        d.isPub = isPub;
        d.name = self.expectName().text;
        if (self.cur.kind == TokenKind::Less) d.generics = self.parseGenericParams();
        self.expect(TokenKind::LBrace);
        d.fields = newList(self.arena);
        d.members = newList(self.arena);
        while (self.cur.kind != TokenKind::RBrace && !self.atEnd())
        {
            if (self.match(TokenKind::Comma)) continue;
            if (self.cur.kind == TokenKind::Semicolon)
            {
                self.advance();
                continue;
            }
            usize errs = self.diags.errors;
            usize pos = self.lexer.pos;
            u8* ptr = self.cur.text.ptr;
            TokenKind kb = self.cur.kind;
            bool fPub = self.match(TokenKind::KwPub);
            while (self.cur.kind == TokenKind::At)
            {
                if (self.nxt.kind == TokenKind::KwExtern)
                {
                    self.perr("E0215", "`@extern` cannot be applied to methods");
                    self.diags.help("foreign functions are declared at the top level");
                    self.advance();
                    self.advance();
                    continue;
                }
                Attr* ma = self.parseAttr();
                if (self.declAttrs == null) self.declAttrs = newList(self.arena);
                listPush(self.declAttrs, (rawptr)ma);
            }
            if (self.cur.kind == TokenKind::KwFn)
            {
                Decl* m = self.parseFn(self.here(), fPub, false, false);
                if (m.name.len > 0)
                {
                    usize mi = 0;
                    while (mi < d.members.len)
                    {
                        Decl* prev = (Decl*)d.members.data[mi];
                        mi++;
                        if (!self.sameStr(prev.name, m.name)) continue;
                        self.perrAt(m.loc, "E0207", self.fmtStr("duplicate method `{}`", m.name));
                        self.alsoAt(prev.loc, "first defined here");
                        break;
                    }
                }
                listPush(d.members, (rawptr)m);
            }
            else
            {
                if (self.declAttrs != null)
                {
                    usize ai = 0;
                    while (ai < self.declAttrs.len)
                    {
                        Attr* la = (Attr*)self.declAttrs.data[ai];
                        ai++;
                        if (la.name.len == 0) continue;
                        self.perrAt(la.loc, "E0222", self.fmtStr("`@{}` is not valid on a field", la.name));
                    }
                    self.declAttrs = null;
                }
                Loc fl = self.here();
                FieldDecl* f = newFieldDecl(self.arena);
                f.isPub = fPub;
                f.name = self.expectName().text;
                self.expect(TokenKind::Colon);
                f.type = self.parseType();
                f.loc = fl;
                self.expect(TokenKind::Semicolon);
                if (f.name.len > 0)
                {
                    usize fi = 0;
                    while (fi < d.fields.len)
                    {
                        FieldDecl* prev = (FieldDecl*)d.fields.data[fi];
                        fi++;
                        if (!self.sameStr(prev.name, f.name)) continue;
                        self.perrAt(fl, "E0207", self.fmtStr("duplicate field `{}`", f.name));
                        self.alsoAt(prev.loc, "first defined here");
                        break;
                    }
                }
                listPush(d.fields, (rawptr)f);
            }
            bool progressed = self.lexer.pos != pos || self.cur.kind != kb || self.cur.text.ptr != ptr;
            if (!progressed)
            {
                self.advance();
                continue;
            }
            if (self.diags.errors > errs) self.synchronize();
        }
        self.expect(TokenKind::RBrace);
        return d;
    }

    Decl* parseVariantDecl(Loc loc, bool isPub)
    {
        self.expect(TokenKind::KwVariant);
        Decl* d = newDecl(self.arena, DeclKind::DcVariant, loc);
        d.isPub = isPub;
        d.name = self.expectName().text;
        if (self.cur.kind == TokenKind::Less) d.generics = self.parseGenericParams();
        self.expect(TokenKind::LBrace);
        d.cases = newList(self.arena);
        while (self.cur.kind != TokenKind::RBrace && !self.atEnd())
        {
            if (self.match(TokenKind::Comma)) continue;
            if (self.cur.kind == TokenKind::Semicolon)
            {
                self.advance();
                continue;
            }
            usize errs = self.diags.errors;
            usize pos = self.lexer.pos;
            u8* ptr = self.cur.text.ptr;
            TokenKind kb = self.cur.kind;
            Loc cl = self.here();
            VariantCase* c = newVariantCase(self.arena);
            c.name = self.expectName().text;
            c.loc = cl;
            if (self.cur.kind == TokenKind::LParen)
            {
                self.expect(TokenKind::LParen);
                c.payload = newList(self.arena);
                if (self.cur.kind != TokenKind::RParen)
                {
                    loop {
                        listPush(c.payload, (rawptr)self.parseType());
                        if (!self.match(TokenKind::Comma)) break;
                        if (self.cur.kind == TokenKind::RParen) break;
                    }
                }
                self.expect(TokenKind::RParen);
            }
            if (c.name.len > 0)
            {
                usize ci = 0;
                while (ci < d.cases.len)
                {
                    VariantCase* prev = (VariantCase*)d.cases.data[ci];
                    ci++;
                    if (!self.sameStr(prev.name, c.name)) continue;
                    self.perrAt(cl, "E0207", self.fmtStr("duplicate variant case `{}`", c.name));
                    self.alsoAt(prev.loc, "first defined here");
                    break;
                }
            }
            listPush(d.cases, (rawptr)c);
            bool progressed = self.lexer.pos != pos || self.cur.kind != kb || self.cur.text.ptr != ptr;
            if (!progressed)
            {
                self.advance();
                continue;
            }
            if (self.diags.errors > errs)
            {
                self.synchronize();
                continue;
            }
            if (self.cur.kind != TokenKind::Comma && self.cur.kind != TokenKind::RBrace && !self.atEnd())
            {
                self.perr("E0200", "expected `,` or `}` after a variant case");
                if (!self.isBoundary(self.cur.kind)) self.advance();
            }
        }
        self.expect(TokenKind::RBrace);
        return d;
    }

    Decl* parseTraitDecl(Loc loc, bool isPub)
    {
        self.expect(TokenKind::KwTrait);
        Decl* d = newDecl(self.arena, DeclKind::DcTrait, loc);
        d.isPub = isPub;
        d.name = self.expectName().text;
        if (self.cur.kind == TokenKind::Less) d.generics = self.parseGenericParams();
        self.expect(TokenKind::LBrace);
        d.members = newList(self.arena);
        while (self.cur.kind != TokenKind::RBrace && !self.atEnd())
        {
            if (self.match(TokenKind::Comma)) continue;
            if (self.cur.kind == TokenKind::Semicolon)
            {
                self.advance();
                continue;
            }
            usize errs = self.diags.errors;
            usize pos = self.lexer.pos;
            u8* ptr = self.cur.text.ptr;
            TokenKind kb = self.cur.kind;
            bool mPub = self.match(TokenKind::KwPub);
            while (self.cur.kind == TokenKind::At)
            {
                if (self.nxt.kind == TokenKind::KwExtern)
                {
                    self.perr("E0215", "`@extern` cannot be applied to methods");
                    self.diags.help("foreign functions are declared at the top level");
                    self.advance();
                    self.advance();
                    continue;
                }
                Attr* ma = self.parseAttr();
                if (self.declAttrs == null) self.declAttrs = newList(self.arena);
                listPush(self.declAttrs, (rawptr)ma);
            }
            if (self.cur.kind == TokenKind::KwFn)
            {
                Decl* m = self.parseFn(self.here(), mPub, false, false);
                if (m.name.len > 0)
                {
                    usize mi = 0;
                    while (mi < d.members.len)
                    {
                        Decl* prev = (Decl*)d.members.data[mi];
                        mi++;
                        if (!self.sameStr(prev.name, m.name)) continue;
                        self.perrAt(m.loc, "E0207", self.fmtStr("duplicate method `{}`", m.name));
                        self.alsoAt(prev.loc, "first defined here");
                        break;
                    }
                }
                listPush(d.members, (rawptr)m);
            }
            else
            {
                self.perr("E0203", self.fmt("expected a method, found `{}`", kindName(self.cur.kind)));
                if (!self.isBoundary(self.cur.kind)) self.advance();
            }
            bool progressed = self.lexer.pos != pos || self.cur.kind != kb || self.cur.text.ptr != ptr;
            if (!progressed)
            {
                self.advance();
                continue;
            }
            if (self.diags.errors > errs) self.synchronize();
        }
        self.expect(TokenKind::RBrace);
        return d;
    }

    Decl* parseExtendDecl(Loc loc, bool isPub)
    {
        self.expect(TokenKind::KwExtend);
        Decl* d = newDecl(self.arena, DeclKind::DcExtend, loc);
        d.isPub = isPub;
        d.target = self.parseType();
        if (self.cur.kind == TokenKind::Colon)
        {
            self.advance();
            self.expect(TokenKind::KwTrait);
            d.traitName = self.expectName().text;
        }
        self.expect(TokenKind::LBrace);
        d.members = newList(self.arena);
        while (self.cur.kind != TokenKind::RBrace && !self.atEnd())
        {
            if (self.match(TokenKind::Comma)) continue;
            if (self.cur.kind == TokenKind::Semicolon)
            {
                self.advance();
                continue;
            }
            usize errs = self.diags.errors;
            usize pos = self.lexer.pos;
            u8* ptr = self.cur.text.ptr;
            TokenKind kb = self.cur.kind;
            bool mPub = self.match(TokenKind::KwPub);
            while (self.cur.kind == TokenKind::At)
            {
                if (self.nxt.kind == TokenKind::KwExtern)
                {
                    self.perr("E0215", "`@extern` cannot be applied to methods");
                    self.diags.help("foreign functions are declared at the top level");
                    self.advance();
                    self.advance();
                    continue;
                }
                Attr* ma = self.parseAttr();
                if (self.declAttrs == null) self.declAttrs = newList(self.arena);
                listPush(self.declAttrs, (rawptr)ma);
            }
            if (self.cur.kind == TokenKind::KwFn)
            {
                Decl* m = self.parseFn(self.here(), mPub, false, false);
                if (m.name.len > 0)
                {
                    usize mi = 0;
                    while (mi < d.members.len)
                    {
                        Decl* prev = (Decl*)d.members.data[mi];
                        mi++;
                        if (!self.sameStr(prev.name, m.name)) continue;
                        self.perrAt(m.loc, "E0207", self.fmtStr("duplicate method `{}`", m.name));
                        self.alsoAt(prev.loc, "first defined here");
                        break;
                    }
                }
                listPush(d.members, (rawptr)m);
            }
            else
            {
                self.perr("E0203", self.fmt("expected a method, found `{}`", kindName(self.cur.kind)));
                if (!self.isBoundary(self.cur.kind)) self.advance();
            }
            bool progressed = self.lexer.pos != pos || self.cur.kind != kb || self.cur.text.ptr != ptr;
            if (!progressed)
            {
                self.advance();
                continue;
            }
            if (self.diags.errors > errs) self.synchronize();
        }
        self.expect(TokenKind::RBrace);
        return d;
    }

    Decl* parseConstDecl(Loc loc, bool isPub)
    {
        self.expect(TokenKind::KwConst);
        Decl* d = newDecl(self.arena, DeclKind::DcConst, loc);
        d.isPub = isPub;
        d.name = self.expectName().text;
        self.expect(TokenKind::Colon);
        d.target = self.parseType();
        self.expect(TokenKind::Equal);
        d.value = self.parseExpr();
        self.expect(TokenKind::Semicolon);
        return d;
    }

    Decl* parseTypeAliasDecl(Loc loc, bool isPub)
    {
        self.expect(TokenKind::KwType);
        Decl* d = newDecl(self.arena, DeclKind::DcTypeAlias, loc);
        d.isPub = isPub;
        d.name = self.expectName().text;
        self.expect(TokenKind::Equal);
        d.target = self.parseType();
        self.expect(TokenKind::Semicolon);
        return d;
    }

    Decl* parseUseDecl(Loc loc, bool isPub)
    {
        self.expect(TokenKind::KwUse);
        Decl* d = newDecl(self.arena, DeclKind::DcUse, loc);
        d.isPub = isPub;
        d.specs = newList(self.arena);
        UseSpec* spec = self.parseUseSpec();
        listPush(d.specs, (rawptr)spec);
        if (spec.specs == null)
        {
            if (spec.alias.len > 0) d.name = spec.alias;
            else d.name = self.lastSeg(spec.name);
        }
        self.expect(TokenKind::Semicolon);
        return d;
    }

    UseSpec* parseUseSpec()
    {
        Loc sl = self.here();
        UseSpec* s = newUseSpec(self.arena);
        s.loc = sl;
        s.name = self.expectName().text;
        while (self.cur.kind == TokenKind::ColonColon)
        {
            self.advance();
            if (self.cur.kind == TokenKind::LBrace)
            {
                self.expect(TokenKind::LBrace);
                s.specs = newList(self.arena);
                while (self.cur.kind != TokenKind::RBrace && !self.atEnd())
                {
                    if (self.match(TokenKind::Comma)) continue;
                    usize pos = self.lexer.pos;
                    u8* ptr = self.cur.text.ptr;
                    TokenKind kb = self.cur.kind;
                    UseSpec* sub = self.parseUseSpec();
                    listPush(s.specs, (rawptr)sub);
                    bool progressed = self.lexer.pos != pos || self.cur.kind != kb || self.cur.text.ptr != ptr;
                    if (!progressed) self.advance();
                }
                self.expect(TokenKind::RBrace);
                break;
            }
            Token part = self.expectName();
            s.name = self.cat3(s.name, "::", part.text);
        }
        if (self.cur.kind == TokenKind::KwAs)
        {
            self.advance();
            s.alias = self.expectName().text;
        }
        return s;
    }

    Attr* parseAttr()
    {
        Loc loc = self.here();
        self.expect(TokenKind::At);
        Attr* a = newAttr(self.arena);
        a.loc = loc;
        a.name = self.expectName().text;
        if (self.cur.kind == TokenKind::LParen)
        {
            self.expect(TokenKind::LParen);
            a.args = newList(self.arena);
            while (self.cur.kind != TokenKind::RParen && !self.atEnd())
            {
                listPush(a.args, (rawptr)self.parseAttrArg());
                if (!self.match(TokenKind::Comma)) break;
            }
            self.expect(TokenKind::RParen);
        }
        return a;
    }

    Expr* parseAttrArg()
    {
        Loc loc = self.here();
        TokenKind k = self.cur.kind;
        if (k == TokenKind::Int || k == TokenKind::Float || k == TokenKind::Str ||
            k == TokenKind::CharLit || k == TokenKind::KwTrue || k == TokenKind::KwFalse)
        {
            Token t = self.cur;
            self.advance();
            return self.literalFromToken(t);
        }
        if (k == TokenKind::Ident)
        {
            Expr* e = newExpr(self.arena, ExprKind::Name, loc);
            str p = self.parsePath();
            e.name = p;
            e.text = p;
            return e;
        }
        self.perr("E0221", "expected a literal or a name as an attribute argument");
        if (!self.isBoundary(self.cur.kind)) self.advance();
        return newExpr(self.arena, ExprKind::Name, loc);
    }

    bool isPhase(str name)
    {
        if (matchWord(name, "startup")) return true;
        if (matchWord(name, "pre_update")) return true;
        if (matchWord(name, "update")) return true;
        if (matchWord(name, "fixed_update")) return true;
        if (matchWord(name, "post_update")) return true;
        if (matchWord(name, "render")) return true;
        if (matchWord(name, "shutdown")) return true;
        return false;
    }

    void attrArgs(Attr* a, usize min, usize max)
    {
        if (a.args == null)
        {
            if (min > 0) self.perrAt(a.loc, "E0221", self.fmtStr("`@{}` requires an argument", a.name));
            return;
        }
        if (a.args.len < min)
        {
            self.perrAt(a.loc, "E0221", self.fmtStr("`@{}` requires an argument", a.name));
            return;
        }
        if (a.args.len > max)
        {
            if (max == 0) self.perrAt(a.loc, "E0221", self.fmtStr("`@{}` takes no arguments", a.name));
            else self.perrAt(a.loc, "E0221", self.fmtStr("`@{}` takes at most one argument", a.name));
        }
    }

    void attrTarget(Attr* a, str what)
    {
        self.perrAt(a.loc, "E0222", self.fmtStr("`@{}` is not valid on this declaration", a.name));
        self.diags.help(self.fmtStr2("`@{}` can only be applied to {}", a.name, what));
    }

    void validateAttrs(Decl* d)
    {
        if (d.attrs == null) return;
        usize i = 0;
        while (i < d.attrs.len)
        {
            Attr* a = (Attr*)d.attrs.data[i];
            i++;
            if (a.name.len == 0) continue;
            bool known =
                matchWord(a.name, "component") || matchWord(a.name, "resource") ||
                matchWord(a.name, "event") || matchWord(a.name, "system") ||
                matchWord(a.name, "save") || matchWord(a.name, "inline") ||
                matchWord(a.name, "noinline") || matchWord(a.name, "must_use") ||
                matchWord(a.name, "test") || matchWord(a.name, "repr") ||
                matchWord(a.name, "deprecated") || matchWord(a.name, "doc");
            if (!known)
            {
                self.perrAt(a.loc, "E0219", self.fmtStr("unknown attribute `{}`", a.name));
                self.diags.help("known attributes are @extern @component @resource @event @system @save @inline @noinline @must_use @test @repr @deprecated @doc");
                continue;
            }
            usize j = 0;
            while (j + 1 < i)
            {
                Attr* prev = (Attr*)d.attrs.data[j];
                j++;
                if (prev.name.len == 0) continue;
                if (!self.sameStr(prev.name, a.name)) continue;
                self.perrAt(a.loc, "E0220", self.fmtStr("duplicate attribute `{}`", a.name));
                self.alsoAt(prev.loc, "first attribute is here");
                break;
            }
            if (matchWord(a.name, "component"))
            {
                self.attrArgs(a, 0, 0);
                if (d.kind != DeclKind::DcStruct && d.kind != DeclKind::DcVariant) self.attrTarget(a, "structs and variants");
            }
            else if (matchWord(a.name, "resource"))
            {
                self.attrArgs(a, 0, 0);
                if (d.kind != DeclKind::DcStruct) self.attrTarget(a, "structs");
            }
            else if (matchWord(a.name, "event"))
            {
                self.attrArgs(a, 0, 0);
                if (d.kind != DeclKind::DcStruct && d.kind != DeclKind::DcVariant) self.attrTarget(a, "structs and variants");
            }
            else if (matchWord(a.name, "system"))
            {
                self.attrArgs(a, 0, 1);
                if (d.kind != DeclKind::DcFn) self.attrTarget(a, "functions");
                if (a.args != null && a.args.len > 0)
                {
                    Expr* arg = (Expr*)a.args.data[0];
                    if (arg.kind != ExprKind::Name)
                    {
                        self.perrAt(arg.loc, "E0221", "`@system` takes a phase name");
                        self.diags.help("phases are startup, pre_update, update, fixed_update, post_update, render, shutdown");
                    }
                    else if (!self.isPhase(arg.name))
                    {
                        self.perrAt(arg.loc, "E0223", self.fmtStr("unknown system phase `{}`", arg.name));
                        self.diags.help("phases are startup, pre_update, update, fixed_update, post_update, render, shutdown");
                    }
                }
            }
            else if (matchWord(a.name, "save"))
            {
                self.attrArgs(a, 0, 0);
                if (d.kind != DeclKind::DcStruct && d.kind != DeclKind::DcVariant) self.attrTarget(a, "structs and variants");
            }
            else if (matchWord(a.name, "inline") || matchWord(a.name, "noinline") ||
                     matchWord(a.name, "must_use") || matchWord(a.name, "test"))
            {
                self.attrArgs(a, 0, 0);
                if (d.kind != DeclKind::DcFn) self.attrTarget(a, "functions");
            }
            else if (matchWord(a.name, "repr"))
            {
                self.attrArgs(a, 1, 1);
                if (d.kind != DeclKind::DcStruct) self.attrTarget(a, "structs");
                if (a.args != null && a.args.len == 1)
                {
                    Expr* arg = (Expr*)a.args.data[0];
                    bool okLayout = false;
                    if (arg.kind == ExprKind::Name)
                    {
                        if (self.sameStr(arg.name, "c") || self.sameStr(arg.name, "packed")) okLayout = true;
                    }
                    if (!okLayout)
                    {
                        self.perrAt(arg.loc, "E0221", "invalid `@repr` layout");
                        self.diags.help("valid layouts are `c` and `packed`");
                    }
                }
            }
            else if (matchWord(a.name, "deprecated"))
            {
                self.attrArgs(a, 0, 1);
                if (d.kind == DeclKind::DcUse || d.kind == DeclKind::DcExtend) self.attrTarget(a, "functions, structs, variants, traits, constants, and type aliases");
                if (a.args != null && a.args.len == 1)
                {
                    Expr* arg = (Expr*)a.args.data[0];
                    if (arg.kind != ExprKind::Str)
                    {
                        self.perrAt(arg.loc, "E0221", "`@deprecated` takes a message string");
                        self.diags.help("write `@deprecated(\"use something else\")`");
                    }
                }
            }
            else if (matchWord(a.name, "doc"))
            {
                self.attrArgs(a, 1, 1);
                if (d.kind == DeclKind::DcUse || d.kind == DeclKind::DcExtend) self.attrTarget(a, "functions, structs, variants, traits, constants, and type aliases");
                if (a.args != null && a.args.len == 1)
                {
                    Expr* arg = (Expr*)a.args.data[0];
                    if (arg.kind != ExprKind::Str)
                    {
                        self.perrAt(arg.loc, "E0221", "`@doc` takes a string argument");
                        self.diags.help("write `@doc(\"what this item does\")`");
                    }
                }
            }
        }
    }


    Expr* literalFromToken(Token t)
    {
        Loc loc = Loc { .line = t.line, .col = t.col };
        ExprKind k = ExprKind::Int;
        if (t.kind == TokenKind::Float) k = ExprKind::Float;
        else if (t.kind == TokenKind::Str) k = ExprKind::Str;
        else if (t.kind == TokenKind::CharLit) k = ExprKind::Char;
        else if (t.kind == TokenKind::KwTrue || t.kind == TokenKind::KwFalse) k = ExprKind::Bool;
        Expr* e = newExpr(self.arena, k, loc);
        e.text = t.text;
        return e;
    }

    Op binOp(TokenKind k)
    {
        switch (k)
        {
            TokenKind::Plus => { return Op::Add; },
            TokenKind::Minus => { return Op::Sub; },
            TokenKind::Star => { return Op::Mul; },
            TokenKind::Slash => { return Op::Div; },
            TokenKind::Percent => { return Op::Rem; },
            TokenKind::Shl => { return Op::Shl; },
            TokenKind::Shr => { return Op::Shr; },
            TokenKind::Amp => { return Op::Band; },
            TokenKind::Pipe => { return Op::Bor; },
            TokenKind::Caret => { return Op::Bxor; },
            TokenKind::EqualEqual => { return Op::Eq; },
            TokenKind::NotEqual => { return Op::Ne; },
            TokenKind::Less => { return Op::Lt; },
            TokenKind::LessEqual => { return Op::Le; },
            TokenKind::Greater => { return Op::Gt; },
            TokenKind::GreaterEqual => { return Op::Ge; },
            TokenKind::And => { return Op::LAnd; },
            TokenKind::Or => { return Op::LOr; },
            TokenKind::DotDot => { return Op::Range; },
            TokenKind::DotDotEq => { return Op::RangeEq; },
            TokenKind::Equal => { return Op::Assign; },
            TokenKind::PlusEqual => { return Op::AddA; },
            TokenKind::MinusEqual => { return Op::SubA; },
            TokenKind::StarEqual => { return Op::MulA; },
            TokenKind::SlashEqual => { return Op::DivA; },
            TokenKind::PercentEqual => { return Op::RemA; },
            TokenKind::AmpEqual => { return Op::BandA; },
            TokenKind::PipeEqual => { return Op::BorA; },
            TokenKind::CaretEqual => { return Op::BxorA; },
            TokenKind::ShlEqual => { return Op::ShlA; },
            TokenKind::ShrEqual => { return Op::ShrA; },
            else => { return Op::None; }
        }
    }

    bool isAssignOp(Op op)
    {
        return op == Op::Assign || op == Op::AddA || op == Op::SubA || op == Op::MulA ||
               op == Op::DivA || op == Op::RemA || op == Op::BandA || op == Op::BorA ||
               op == Op::BxorA || op == Op::ShlA || op == Op::ShrA;
    }

    bool isAssignTarget(Expr* e)
    {
        return e.kind == ExprKind::Name || e.kind == ExprKind::Field || e.kind == ExprKind::Index;
    }

    Expr* parseExpr()
    {
        return self.parseAssign();
    }

    Expr* parseAssign()
    {
        Expr* l = self.parseRangeExpr();
        Op op = self.binOp(self.cur.kind);
        if (self.isAssignOp(op))
        {
            Loc loc = self.here();
            if (!self.isAssignTarget(l))
            {
                self.perrAt(l.loc, "E0210", "invalid assignment target");
                self.diags.why("the left side of an assignment must be a name, a field, or an index");
                self.diags.help("assign to a variable, field, or element");
            }
            self.advance();
            Expr* r = self.parseAssign();
            Expr* n = newExpr(self.arena, ExprKind::Assign, loc);
            n.op = op;
            n.a = l;
            n.b = r;
            return n;
        }
        return l;
    }

    Expr* parseRangeExpr()
    {
        Expr* e = self.parseOr();
        loop {
            Op op = self.binOp(self.cur.kind);
            if (op != Op::Range && op != Op::RangeEq) break;
            Loc loc = self.here();
            self.advance();
            Expr* r = self.parseOr();
            Expr* n = newExpr(self.arena, ExprKind::Range, loc);
            n.op = op;
            n.a = e;
            n.b = r;
            e = n;
        }
        return e;
    }

    Expr* parseOr()
    {
        Expr* e = self.parseAnd();
        while (self.cur.kind == TokenKind::Or)
        {
            Loc loc = self.here();
            self.advance();
            Expr* r = self.parseAnd();
            Expr* n = newExpr(self.arena, ExprKind::Binary, loc);
            n.op = Op::LOr;
            n.a = e;
            n.b = r;
            e = n;
        }
        return e;
    }

    Expr* parseAnd()
    {
        Expr* e = self.parseCmp();
        while (self.cur.kind == TokenKind::And)
        {
            Loc loc = self.here();
            self.advance();
            Expr* r = self.parseCmp();
            Expr* n = newExpr(self.arena, ExprKind::Binary, loc);
            n.op = Op::LAnd;
            n.a = e;
            n.b = r;
            e = n;
        }
        return e;
    }

    Expr* parseCmp()
    {
        Expr* e = self.parseBitOrXor();
        usize count = 0;
        loop {
            Op op = self.binOp(self.cur.kind);
            if (op != Op::Eq && op != Op::Ne && op != Op::Lt && op != Op::Le && op != Op::Gt && op != Op::Ge) break;
            if (count > 0)
            {
                self.perr("E0209", "comparison operators cannot be chained");
                self.diags.why("a comparison produces a bool, so a second comparison would compare against a bool");
                self.diags.help("chain with `&&`, for example `a < b && b < c`");
            }
            Loc loc = self.here();
            self.advance();
            Expr* r = self.parseBitOrXor();
            Expr* n = newExpr(self.arena, ExprKind::Binary, loc);
            n.op = op;
            n.a = e;
            n.b = r;
            e = n;
            count++;
        }
        return e;
    }

    Expr* parseBitOrXor()
    {
        Expr* e = self.parseBitAnd();
        loop {
            Op op = self.binOp(self.cur.kind);
            if (op != Op::Bor && op != Op::Bxor) break;
            Loc loc = self.here();
            self.advance();
            Expr* r = self.parseBitAnd();
            Expr* n = newExpr(self.arena, ExprKind::Binary, loc);
            n.op = op;
            n.a = e;
            n.b = r;
            e = n;
        }
        return e;
    }

    Expr* parseBitAnd()
    {
        Expr* e = self.parseShift();
        while (self.cur.kind == TokenKind::Amp)
        {
            Loc loc = self.here();
            self.advance();
            Expr* r = self.parseShift();
            Expr* n = newExpr(self.arena, ExprKind::Binary, loc);
            n.op = Op::Band;
            n.a = e;
            n.b = r;
            e = n;
        }
        return e;
    }

    Expr* parseShift()
    {
        Expr* e = self.parseAdd();
        loop {
            Op op = self.binOp(self.cur.kind);
            if (op != Op::Shl && op != Op::Shr) break;
            Loc loc = self.here();
            self.advance();
            Expr* r = self.parseAdd();
            Expr* n = newExpr(self.arena, ExprKind::Binary, loc);
            n.op = op;
            n.a = e;
            n.b = r;
            e = n;
        }
        return e;
    }

    Expr* parseAdd()
    {
        Expr* e = self.parseMul();
        loop {
            Op op = self.binOp(self.cur.kind);
            if (op != Op::Add && op != Op::Sub) break;
            Loc loc = self.here();
            self.advance();
            Expr* r = self.parseMul();
            Expr* n = newExpr(self.arena, ExprKind::Binary, loc);
            n.op = op;
            n.a = e;
            n.b = r;
            e = n;
        }
        return e;
    }

    Expr* parseMul()
    {
        Expr* e = self.parseUnary();
        loop {
            Op op = self.binOp(self.cur.kind);
            if (op != Op::Mul && op != Op::Div && op != Op::Rem) break;
            Loc loc = self.here();
            self.advance();
            Expr* r = self.parseUnary();
            Expr* n = newExpr(self.arena, ExprKind::Binary, loc);
            n.op = op;
            n.a = e;
            n.b = r;
            e = n;
        }
        return e;
    }

    Expr* parseUnary()
    {
        Loc loc = self.here();
        if (self.cur.kind == TokenKind::Minus)
        {
            self.advance();
            Expr* n = newExpr(self.arena, ExprKind::Unary, loc);
            n.op = Op::Neg;
            n.a = self.parseUnary();
            return n;
        }
        if (self.cur.kind == TokenKind::Not)
        {
            self.advance();
            Expr* n = newExpr(self.arena, ExprKind::Unary, loc);
            n.op = Op::Not;
            n.a = self.parseUnary();
            return n;
        }
        if (self.cur.kind == TokenKind::KwAwait)
        {
            self.advance();
            Expr* n = newExpr(self.arena, ExprKind::Unary, loc);
            n.op = Op::Await;
            n.a = self.parseUnary();
            return n;
        }
        Expr* e = self.parsePostfix();
        while (self.cur.kind == TokenKind::KwAs)
        {
            Loc cl = self.here();
            self.advance();
            Type* t = self.parseType();
            Expr* n = newExpr(self.arena, ExprKind::Cast, cl);
            n.a = e;
            n.type = t;
            e = n;
        }
        return e;
    }

    Expr* parsePostfix()
    {
        Expr* e = self.parsePrimary();
        loop {
            TokenKind k = self.cur.kind;

            if (k == TokenKind::LParen)
            {
                Loc loc = self.here();
                bool saved = self.noStruct;
                self.noStruct = false;
                self.expect(TokenKind::LParen);
                PtrList* args = newList(self.arena);
                while (self.cur.kind != TokenKind::RParen && !self.atEnd())
                {
                    listPush(args, (rawptr)self.parseExpr());
                    if (!self.match(TokenKind::Comma)) break;
                }
                self.expect(TokenKind::RParen);
                self.noStruct = saved;
                Expr* c = newExpr(self.arena, ExprKind::Call, loc);
                c.a = e;
                c.list = args;
                c.gargs = e.gargs;
                e.gargs = null;
                e = c;
                continue;
            }

            if (k == TokenKind::LBracket)
            {
                Loc loc = self.here();
                bool saved = self.noStruct;
                self.noStruct = false;
                self.expect(TokenKind::LBracket);
                Expr* idx = self.parseExpr();
                self.expect(TokenKind::RBracket);
                self.noStruct = saved;
                Expr* n = newExpr(self.arena, ExprKind::Index, loc);
                n.a = e;
                n.b = idx;
                e = n;
                continue;
            }

            if (k == TokenKind::Dot)
            {
                if (self.nxt.kind == TokenKind::Ident)
                {
                    Loc loc = self.here();
                    self.advance();
                    Expr* f = newExpr(self.arena, ExprKind::Field, loc);
                    f.a = e;
                    f.name = self.cur.text;
                    f.text = self.cur.text;
                    self.advance();
                    e = f;
                    continue;
                }
                self.perr("E0200", "expected a field name after `.`");
                self.advance();
                break;
            }

            if (k == TokenKind::Question)
            {
                Loc loc = self.here();
                self.advance();
                Expr* n = newExpr(self.arena, ExprKind::Question, loc);
                n.a = e;
                e = n;
                continue;
            }

            if (k == TokenKind::ColonColon)
            {
                if (self.nxt.kind != TokenKind::Less) break;
                self.advance();
                PtrList* g = self.parseTypeArgs();
                e.gargs = g;
                continue;
            }

            break;
        }
        return e;
    }

    Expr* parsePrimary()
    {
        Loc loc = self.here();
        TokenKind k = self.cur.kind;

        #[[fallthrough]]
        switch (k)
        {
            TokenKind::Int => { Token t = self.cur; self.advance(); return self.literalFromToken(t); },
            TokenKind::Float => { Token t = self.cur; self.advance(); return self.literalFromToken(t); },
            TokenKind::Str => { Token t = self.cur; self.advance(); return self.literalFromToken(t); },
            TokenKind::CharLit => { Token t = self.cur; self.advance(); return self.literalFromToken(t); },
            TokenKind::KwTrue => { Token t = self.cur; self.advance(); return self.literalFromToken(t); },
            TokenKind::KwFalse => { Token t = self.cur; self.advance(); return self.literalFromToken(t); },
            TokenKind::KwIf => { return self.controlExpr(ExprKind::If, loc, self.parseIf()); },
            TokenKind::KwWhile => { return self.controlExpr(ExprKind::While, loc, self.parseWhile(loc)); },
            TokenKind::KwSwitch => { return self.controlExpr(ExprKind::Switch, loc, self.parseSwitch(loc)); },
        }

        if (k == TokenKind::KwSelf)
        {
            if (!self.inFn)
            {
                self.perr("E0225", "`self` outside of a method");
                self.diags.why("`self` is only valid inside a function that declares it as a parameter");
            }
            else if (!self.fnHasSelf)
            {
                self.perr("E0225", "`self` is not available in this function");
                self.diags.help("add a `self` parameter to use `self`");
            }
            self.advance();
            Expr* se = newExpr(self.arena, ExprKind::Name, loc);
            se.name = "self";
            se.text = "self";
            return se;
        }

        if (k == TokenKind::At)
        {
            self.perr("E0218", "`@` cannot start an expression");
            self.diags.why("labels are written `@name:` before a loop, or `break @name;`");
            self.advance();
            return newExpr(self.arena, ExprKind::Name, loc);
        }

        if (k == TokenKind::KwElse)
        {
            self.perr("E0224", "`else` without a matching `if`");
            self.diags.help("remove the `else`, or add an `if` before it");
            self.advance();
            return newExpr(self.arena, ExprKind::Name, loc);
        }

        if (k == TokenKind::Ident)
        {
            str name = self.cur.text;
            if (!self.noStruct && self.nxt.kind == TokenKind::LBrace)
            {
                self.advance();
                return self.parseStructLit(name, loc);
            }
            self.advance();
            while (self.cur.kind == TokenKind::ColonColon && self.nxt.kind == TokenKind::Ident)
            {
                self.advance();
                name = self.cat3(name, "::", self.cur.text);
                self.advance();
            }
            if (!self.noStruct && self.cur.kind == TokenKind::LBrace)
            {
                return self.parseStructLit(name, loc);
            }
            Expr* e = newExpr(self.arena, ExprKind::Name, loc);
            e.name = name;
            e.text = name;
            return e;
        }

        if (k == TokenKind::LParen)
        {
            self.expect(TokenKind::LParen);
            bool saved = self.noStruct;
            self.noStruct = false;
            Expr* first = self.parseExpr();
            if (self.cur.kind == TokenKind::Comma)
            {
                PtrList* items = newList(self.arena);
                listPush(items, (rawptr)first);
                while (self.match(TokenKind::Comma))
                {
                    if (self.cur.kind == TokenKind::RParen) break;
                    listPush(items, (rawptr)self.parseExpr());
                }
                self.expect(TokenKind::RParen);
                self.noStruct = saved;
                Expr* n = newExpr(self.arena, ExprKind::Tuple, loc);
                n.list = items;
                return n;
            }
            self.expect(TokenKind::RParen);
            self.noStruct = saved;
            return first;
        }

        if (k == TokenKind::LBracket)
        {
            self.expect(TokenKind::LBracket);
            bool saved = self.noStruct;
            self.noStruct = false;
            PtrList* items = newList(self.arena);
            while (self.cur.kind != TokenKind::RBracket && !self.atEnd())
            {
                ArrayItem* it = newArrayItem(self.arena);
                if (self.cur.kind == TokenKind::Ellipsis)
                {
                    self.advance();
                    it.spread = true;
                    it.value = self.parseExpr();
                }
                else
                {
                    Expr* e = self.parseExpr();
                    if (self.cur.kind == TokenKind::Colon)
                    {
                        self.advance();
                        it.key = e;
                        it.value = self.parseExpr();
                    }
                    else
                    {
                        it.value = e;
                    }
                }
                listPush(items, (rawptr)it);
                if (!self.match(TokenKind::Comma)) break;
            }
            self.expect(TokenKind::RBracket);
            self.noStruct = saved;
            Expr* n = newExpr(self.arena, ExprKind::ArrayLit, loc);
            n.list = items;
            return n;
        }

        self.perr("E0204", self.fmt("expected an expression, found `{}`", kindName(self.cur.kind)));
        self.whyFound();
        if (!self.isBoundary(self.cur.kind)) self.advance();
        Expr* bad = newExpr(self.arena, ExprKind::Name, loc);
        return bad;
    }

    Expr* controlExpr(ExprKind kind, Loc loc, Stmt* s)
    {
        Expr* e = newExpr(self.arena, kind, loc);
        e.stmt = s;
        return e;
    }

    Expr* parseStructLit(str name, Loc loc)
    {
        self.expect(TokenKind::LBrace);
        bool saved = self.noStruct;
        self.noStruct = false;
        Expr* e = newExpr(self.arena, ExprKind::StructLit, loc);
        e.name = name;
        e.text = name;
        e.list = newList(self.arena);
        while (self.cur.kind != TokenKind::RBrace && !self.atEnd())
        {
            FieldInit* f = newFieldInit(self.arena);
            if (self.cur.kind == TokenKind::DotDot)
            {
                self.advance();
                f.spread = true;
                f.value = self.parseExpr();
            }
            else if (self.cur.kind == TokenKind::Ident)
            {
                str fname = self.cur.text;
                Loc ff = self.here();
                if (self.nxt.kind == TokenKind::Colon)
                {
                    self.advance();
                    self.advance();
                    f.name = fname;
                    f.value = self.parseExpr();
                }
                else
                {
                    self.advance();
                    f.name = fname;
                    f.value = newExpr(self.arena, ExprKind::Name, Loc { .line = self.cur.line, .col = self.cur.col });
                    f.value.name = fname;
                    f.value.text = fname;
                }
                usize xi = 0;
                while (xi < e.list.len)
                {
                    FieldInit* prev = (FieldInit*)e.list.data[xi];
                    xi++;
                    if (prev.name.len == 0) continue;
                    if (!self.sameStr(prev.name, fname)) continue;
                    self.perrAt(ff, "E0207", self.fmtStr("duplicate field `{}`", fname));
                    if (prev.value != null) self.alsoAt(prev.value.loc, "first initializer is here");
                    break;
                }
            }
            else
            {
                self.perr("E0201", self.fmt("expected a field name, found `{}`", kindName(self.cur.kind)));
                if (!self.isBoundary(self.cur.kind)) self.advance();
            }
            listPush(e.list, (rawptr)f);
            if (!self.match(TokenKind::Comma)) break;
        }
        self.expect(TokenKind::RBrace);
        self.noStruct = saved;
        return e;
    }

    bool isLiteralExpr(Expr* e)
    {
        if (e == null) return false;
        return e.kind == ExprKind::Int || e.kind == ExprKind::Float || e.kind == ExprKind::Str ||
               e.kind == ExprKind::Char || e.kind == ExprKind::Bool ||
               e.kind == ExprKind::ArrayLit || e.kind == ExprKind::Tuple || e.kind == ExprKind::StructLit;
    }

    Stmt* parseBlock()
    {
        Loc loc = self.here();
        bool saved = self.noStruct;
        self.noStruct = false;
        self.expect(TokenKind::LBrace);
        Stmt* b = newStmt(self.arena, StmtKind::StBlock, loc);
        b.list = newList(self.arena);
        bool term = false;
        while (self.cur.kind != TokenKind::RBrace && !self.atEnd())
        {
            usize errs = self.diags.errors;
            usize pos = self.lexer.pos;
            u8* ptr = self.cur.text.ptr;
            TokenKind kb = self.cur.kind;
            Stmt* s = self.parseStmt();
            if (s != null)
            {
                if (term) {
                    self.diags.warn(s.loc.line, s.loc.col, 1, "W0101", "unreachable code");
                    self.diags.why("control flow never reaches this statement");
                }
                listPush(b.list, (rawptr)s);
                if (s.kind == StmtKind::StReturn || s.kind == StmtKind::StBreak || s.kind == StmtKind::StContinue) term = true;
            }
            bool progressed = self.lexer.pos != pos || self.cur.kind != kb || self.cur.text.ptr != ptr;
            if (!progressed)
            {
                self.advance();
                continue;
            }
            if (self.diags.errors > errs) self.synchronize();
        }
        self.expect(TokenKind::RBrace);
        self.noStruct = saved;
        return b;
    }

    Stmt* parseStmt()
    {
        Loc loc = self.here();
        TokenKind k = self.cur.kind;

        if (k == TokenKind::Manifest)
        {
            self.perr("E0202", "manifest directive must appear before any code");
            self.advance();
            return null;
        }

        if (k == TokenKind::At)
        {
            if (self.nxt.kind == TokenKind::KwExtern)
            {
                self.perr("E0215", "declarations cannot appear inside a function body");
                self.diags.help("move `@extern` declarations to the top level");
                self.advance();
                self.advance();
                return null;
            }
            Loc aloc = self.here();
            self.advance();
            if (self.cur.kind != TokenKind::Ident)
            {
                self.perr("E0200", "expected a label name after `@`");
                self.whyFound();
                if (!self.isBoundary(self.cur.kind)) self.advance();
                return null;
            }
            str label = self.cur.text;
            self.advance();
            if (self.cur.kind == TokenKind::Colon)
            {
                self.advance();
            }
            else
            {
                self.perr("E0200", "expected `:` after a label name");
                self.whyFound();
            }
            bool isLoop = self.cur.kind == TokenKind::KwWhile || self.cur.kind == TokenKind::KwFor;
            if (!isLoop)
            {
                self.perrAt(aloc, "E0216", "a label must be attached to a loop");
                self.diags.why("only `while` and `for` loops can be labeled");
                self.diags.help("write `@name: while ...` or `@name: for ...`");
            }
            usize dup = self.findLabel(label);
            if (dup < self.labelLen)
            {
                self.perrAt(aloc, "E0216", self.fmtStr("duplicate label `{}`", label));
                self.diags.also(self.labels[dup].line, self.labels[dup].col, 1, "label is already in scope here");
            }
            self.pushLabel(label, aloc);
            Stmt* s = self.parseStmt();
            self.popLabel();
            if (s != null) s.label = label;
            return s;
        }

        if (k == TokenKind::KwElse)
        {
            self.perr("E0224", "`else` without a matching `if`");
            self.diags.help("remove the `else`, or add an `if` before it");
            self.advance();
            return null;
        }

        if (k == TokenKind::KwFn || k == TokenKind::KwStruct || k == TokenKind::KwVariant ||
            k == TokenKind::KwTrait || k == TokenKind::KwExtend || k == TokenKind::KwConst ||
            k == TokenKind::KwType || k == TokenKind::KwUse || k == TokenKind::KwPub ||
            k == TokenKind::KwAsync || k == TokenKind::KwExtern)
        {
            self.perr("E0215", "declarations cannot appear inside a function body");
            self.diags.help("move it to the top level of the file");
            self.advance();
            return null;
        }

        #[[fallthrough]]
        switch (k)
        {
            TokenKind::KwVar => { return self.parseVarLet(loc, false); },
            TokenKind::KwLet => { return self.parseVarLet(loc, true); },
            TokenKind::KwIf => { return self.parseIf(); },
            TokenKind::KwWhile => { return self.parseWhile(loc); },
            TokenKind::KwFor => { return self.parseFor(loc); },
            TokenKind::KwSwitch => { return self.parseSwitch(loc); },
            TokenKind::LBrace => { return self.parseBlock(); },
            TokenKind::KwBreak => { return self.parseJump(loc, true); },
            TokenKind::KwContinue => { return self.parseJump(loc, false); },
            TokenKind::KwReturn => { return self.parseReturn(loc); },
        }

        Expr* e = self.parseExpr();
        Stmt* s = newStmt(self.arena, StmtKind::StExpr, loc);
        s.expr = e;
        if (self.cur.kind == TokenKind::RBrace) return s;
        self.expect(TokenKind::Semicolon);
        if (self.isLiteralExpr(e))
        {
            self.diags.warn(e.loc.line, e.loc.col, 1, "W0102", "unused value");
            self.diags.why("this literal is evaluated and its value is discarded");
            self.diags.help("assign it to a variable, or remove the statement");
        }
        return s;
    }

    Stmt* parseVarLet(Loc loc, bool isLet)
    {
        self.advance();
        Pattern* pat = self.parsePattern();
        Type* ty = null;
        Expr* init = null;
        if (self.cur.kind == TokenKind::Colon)
        {
            self.advance();
            ty = self.parseType();
        }
        if (self.cur.kind == TokenKind::Equal)
        {
            self.advance();
            init = self.parseExpr();
        }
        else if (isLet)
        {
            self.perr("E0201", "`let` requires an initializer");
            self.diags.why("immutable bindings must be given a value; use `var` for a later assignment");
        }
        self.expect(TokenKind::Semicolon);
        Stmt* s = newStmt(self.arena, StmtKind::StVar, loc);
        s.isLet = isLet;
        s.pat = pat;
        s.type = ty;
        s.expr = init;
        return s;
    }

    Stmt* parseIf()
    {
        Loc loc = self.here();
        self.expect(TokenKind::KwIf);
        bool saved = self.noStruct;
        self.noStruct = true;
        Expr* cond = self.parseExpr();
        self.noStruct = saved;
        Stmt* thenB = self.parseBlock();
        Stmt* elseB = null;
        if (self.cur.kind == TokenKind::KwElse)
        {
            self.advance();
            if (self.cur.kind == TokenKind::KwIf) elseB = self.parseIf();
            else if (self.cur.kind == TokenKind::LBrace) elseB = self.parseBlock();
            else
            {
                self.perr("E0200", self.fmt("expected `if` or `{` after `else`, found `{}`", kindName(self.cur.kind)));
                self.whyFound();
            }
        }
        Stmt* s = newStmt(self.arena, StmtKind::StIf, loc);
        s.expr = cond;
        s.a = thenB;
        s.b = elseB;
        return s;
    }

    Stmt* parseWhile(Loc loc)
    {
        self.advance();
        bool saved = self.noStruct;
        self.noStruct = true;
        Expr* cond = self.parseExpr();
        self.noStruct = saved;
        self.loopDepth++;
        Stmt* body = self.parseBlock();
        self.loopDepth--;
        Stmt* s = newStmt(self.arena, StmtKind::StWhile, loc);
        s.expr = cond;
        s.a = body;
        return s;
    }

    Stmt* parseFor(Loc loc)
    {
        self.advance();
        Pattern* pat = self.parsePattern();
        self.expect(TokenKind::KwIn);
        bool saved = self.noStruct;
        self.noStruct = true;
        Expr* iter = self.parseExpr();
        self.noStruct = saved;
        self.loopDepth++;
        Stmt* body = self.parseBlock();
        self.loopDepth--;
        Stmt* s = newStmt(self.arena, StmtKind::StFor, loc);
        s.pat = pat;
        s.expr = iter;
        s.a = body;
        return s;
    }

    Stmt* parseSwitch(Loc loc)
    {
        bool saved = self.noStruct;
        self.noStruct = false;
        self.advance();
        self.expect(TokenKind::LParen);
        Expr* scrut = self.parseExpr();
        self.expect(TokenKind::RParen);
        self.expect(TokenKind::LBrace);
        Stmt* s = newStmt(self.arena, StmtKind::StSwitch, loc);
        s.expr = scrut;
        s.prongs = newList(self.arena);
        bool sawElse = false;
        while (self.cur.kind != TokenKind::RBrace && !self.atEnd())
        {
            usize errs = self.diags.errors;
            usize pos = self.lexer.pos;
            u8* ptr = self.cur.text.ptr;
            TokenKind kb = self.cur.kind;
            Prong* pr = self.parseProng();
            if (pr != null)
            {
                if (pr.isElse && sawElse)
                {
                    self.perrAt(pr.loc, "E0212", "duplicate `else` prong");
                    self.diags.help("keep a single `else => ...` prong, at the end");
                }
                else if (!pr.isElse && sawElse)
                {
                    self.perrAt(pr.loc, "E0211", "`else` must be the last prong");
                    self.diags.help("move the `else` prong to the end");
                }
                if (pr.isElse) sawElse = true;
            }
            listPush(s.prongs, (rawptr)pr);
            bool progressed = self.lexer.pos != pos || self.cur.kind != kb || self.cur.text.ptr != ptr;
            if (!progressed)
            {
                self.advance();
                continue;
            }
            if (self.diags.errors > errs) self.synchronize();
        }
        self.expect(TokenKind::RBrace);
        self.noStruct = saved;
        return s;
    }

    Stmt* parseProngBody()
    {
        if (self.cur.kind == TokenKind::LBrace) return self.parseBlock();
        Loc loc = self.here();
        Expr* e = self.parseExpr();
        Stmt* st = newStmt(self.arena, StmtKind::StExpr, loc);
        st.expr = e;
        return st;
    }

    Prong* parseProng()
    {
        Prong* pr = newProng(self.arena);
        pr.loc = self.here();
        if (self.cur.kind == TokenKind::KwElse)
        {
            self.advance();
            pr.isElse = true;
            if (self.cur.kind == TokenKind::KwIf)
            {
                self.perr("E0213", "`else` prongs cannot have a guard");
                self.diags.why("the `else` prong already matches everything left");
                self.diags.help("use a guarded pattern prong instead: `value if cond => ...`");
                self.advance();
                self.parseExpr();
            }
        }
        else if (self.cur.kind == TokenKind::Ident &&
                 (matchWord(self.cur.text, "case") || matchWord(self.cur.text, "default")))
        {
            bool isCase = matchWord(self.cur.text, "case");
            if (isCase)
            {
                self.perr("E0217", "Mu has no `case` keyword");
                self.diags.help("write prongs as `pattern => value`");
            }
            else
            {
                self.perr("E0217", "`default` is not a prong");
                self.diags.help("use `else => ...` for the fallback prong");
            }
            while (!self.atEnd() && self.cur.kind != TokenKind::FatArrow && self.cur.kind != TokenKind::RBrace) self.advance();
            if (self.cur.kind == TokenKind::FatArrow)
            {
                self.advance();
                pr.body = self.parseProngBody();
            }
            self.match(TokenKind::Comma);
            return pr;
        }
        else
        {
            Pattern* acc = self.parsePattern();
            while (self.cur.kind == TokenKind::Comma)
            {
                self.advance();
                if (self.cur.kind == TokenKind::FatArrow) break;
                Pattern* more = self.parsePattern();
                Pattern* orp = newPattern(self.arena, PatternKind::PatOr, acc.loc);
                orp.a = acc;
                orp.b = more;
                acc = orp;
            }
            pr.pat = acc;
            if (self.cur.kind == TokenKind::KwIf)
            {
                self.advance();
                pr.guard = self.parseExpr();
            }
        }
        self.expect(TokenKind::FatArrow);
        pr.body = self.parseProngBody();
        self.match(TokenKind::Comma);
        return pr;
    }

    Stmt* parseJump(Loc loc, bool isBreak)
    {
        self.advance();
        str label = str::empty();
        if (self.cur.kind == TokenKind::At)
        {
            self.advance();
            if (self.cur.kind == TokenKind::Ident)
            {
                label = self.cur.text;
                self.advance();
            }
            else
            {
                self.perr("E0200", "expected a label name after `@`");
                self.whyFound();
            }
        }
        if (label.len == 0 && self.loopDepth == 0)
        {
            if (isBreak) self.perr("E0216", "`break` outside of a loop");
            else self.perr("E0216", "`continue` outside of a loop");
            self.diags.why("this statement is not inside a `while` or `for` loop");
        }
        else if (label.len > 0 && self.findLabel(label) >= self.labelLen)
        {
            self.perrAt(loc, "E0216", self.fmtStr("unknown label `{}`", label));
            self.diags.help("declare the label as `@name:` before a loop");
        }
        StmtKind sk = StmtKind::StBreak;
        if (!isBreak) sk = StmtKind::StContinue;
        Stmt* s = newStmt(self.arena, sk, loc);
        s.label = label;
        self.expect(TokenKind::Semicolon);
        return s;
    }

    Stmt* parseReturn(Loc loc)
    {
        self.advance();
        Stmt* s = newStmt(self.arena, StmtKind::StReturn, loc);
        if (self.cur.kind != TokenKind::Semicolon) s.expr = self.parseExpr();
        self.expect(TokenKind::Semicolon);
        return s;
    }

    bool isTypeStart()
    {
        TokenKind k = self.cur.kind;
        return k == TokenKind::Ident || k == TokenKind::LParen || k == TokenKind::KwDyn;
    }

    Type* parseType()
    {
        Loc loc = self.here();
        Type* t = null;

        if (self.cur.kind == TokenKind::KwDyn)
        {
            self.advance();
            t = newType(self.arena, TypeKind::Dyn, loc);
            t.text = self.parsePath();
        }
        else if (self.cur.kind == TokenKind::LParen)
        {
            self.expect(TokenKind::LParen);
            PtrList* items = newList(self.arena);
            if (self.cur.kind != TokenKind::RParen)
            {
                loop {
                    listPush(items, (rawptr)self.parseType());
                    if (!self.match(TokenKind::Comma)) break;
                    if (self.cur.kind == TokenKind::RParen) break;
                }
            }
            self.expect(TokenKind::RParen);
            if (items.len == 1)
            {
                t = (Type*)items.data[0];
            }
            else
            {
                t = newType(self.arena, TypeKind::Tuple, loc);
                t.items = items;
            }
        }
        else if (self.cur.kind == TokenKind::Ident)
        {
            t = newType(self.arena, TypeKind::Name, loc);
            t.text = self.parsePath();
            if (self.cur.kind == TokenKind::Less) t.args = self.parseTypeArgs();
        }
        else
        {
            self.perr("E0206", self.fmt("expected a type, found `{}`", kindName(self.cur.kind)));
            self.whyFound();
            if (!self.isBoundary(self.cur.kind)) self.advance();
            return newType(self.arena, TypeKind::Name, loc);
        }

        while (self.cur.kind == TokenKind::LBracket)
        {
            self.expect(TokenKind::LBracket);
            if (self.cur.kind == TokenKind::RBracket)
            {
                self.expect(TokenKind::RBracket);
                Type* s = newType(self.arena, TypeKind::Slice, loc);
                s.elem = t;
                s.text = t.text;
                t = s;
            }
            else
            {
                Expr* len = self.parseExpr();
                self.expect(TokenKind::RBracket);
                Type* a = newType(self.arena, TypeKind::Array, loc);
                a.elem = t;
                a.len = len;
                a.text = t.text;
                t = a;
            }
        }
        return t;
    }

    PtrList* parseTypeArgs()
    {
        self.expect(TokenKind::Less);
        PtrList* args = newList(self.arena);
        loop {
            TokenKind k = self.cur.kind;
            if (k == TokenKind::Greater || k == TokenKind::Shr || k == TokenKind::GreaterEqual || k == TokenKind::ShrEqual) break;
            listPush(args, (rawptr)self.parseType());
            if (!self.match(TokenKind::Comma)) break;
        }
        if (args.len == 0) self.perr("E0200", "expected a type argument");
        self.expectGt();
        return args;
    }

    bool isPatLiteralStart()
    {
        TokenKind k = self.cur.kind;
        return k == TokenKind::Int || k == TokenKind::Float || k == TokenKind::Str ||
               k == TokenKind::CharLit || k == TokenKind::KwTrue || k == TokenKind::KwFalse;
    }

    Pattern* parsePattern()
    {
        Pattern* p = self.parsePatternOne();
        while (self.cur.kind == TokenKind::Pipe)
        {
            self.advance();
            Pattern* r = self.parsePatternOne();
            Pattern* orp = newPattern(self.arena, PatternKind::PatOr, p.loc);
            orp.a = p;
            orp.b = r;
            p = orp;
        }
        return p;
    }

    Pattern* parsePatternOne()
    {
        Loc loc = self.here();
        Pattern* start = self.parsePatternPrimary();
        if (self.cur.kind == TokenKind::DotDot || self.cur.kind == TokenKind::DotDotEq)
        {
            bool incl = self.cur.kind == TokenKind::DotDotEq;
            self.advance();
            Pattern* end = self.parsePatternPrimary();
            Pattern* r = newPattern(self.arena, PatternKind::PatRange, loc);
            r.a = start;
            r.b = end;
            if (incl) r.text = "..=";
            else r.text = "..";
            return r;
        }
        return start;
    }

    Pattern* parsePatternPrimary()
    {
        Loc loc = self.here();
        TokenKind k = self.cur.kind;

        if (k == TokenKind::Ident)
        {
            str text = self.cur.text;
            if (text.len == 1 && text.ptr[0] == '_')
            {
                self.advance();
                Pattern* p = newPattern(self.arena, PatternKind::PatWildcard, loc);
                p.text = text;
                return p;
            }
            str name = self.cur.text;
            self.advance();
            while (self.cur.kind == TokenKind::ColonColon && self.nxt.kind == TokenKind::Ident)
            {
                self.advance();
                name = self.cat3(name, "::", self.cur.text);
                self.advance();
            }
            if (self.cur.kind == TokenKind::LParen)
            {
                self.expect(TokenKind::LParen);
                Pattern* p = newPattern(self.arena, PatternKind::PatVariant, loc);
                p.text = name;
                p.items = newList(self.arena);
                if (self.cur.kind != TokenKind::RParen)
                {
                    loop {
                        listPush(p.items, (rawptr)self.parsePattern());
                        if (!self.match(TokenKind::Comma)) break;
                        if (self.cur.kind == TokenKind::RParen) break;
                    }
                }
                self.expect(TokenKind::RParen);
                return p;
            }
            Pattern* p = newPattern(self.arena, PatternKind::PatBinding, loc);
            p.text = name;
            return p;
        }

        if (k == TokenKind::Minus)
        {
            self.advance();
            Pattern* p = self.parsePatternPrimary();
            p.neg = true;
            return p;
        }

        if (self.isPatLiteralStart())
        {
            Token t = self.cur;
            self.advance();
            PatternKind pk = PatternKind::PatInt;
            if (t.kind == TokenKind::Float) pk = PatternKind::PatFloat;
            else if (t.kind == TokenKind::Str) pk = PatternKind::PatStr;
            else if (t.kind == TokenKind::CharLit) pk = PatternKind::PatChar;
            else if (t.kind == TokenKind::KwTrue || t.kind == TokenKind::KwFalse) pk = PatternKind::PatBool;
            Pattern* p = newPattern(self.arena, pk, loc);
            p.text = t.text;
            p.value = self.literalFromToken(t);
            return p;
        }

        if (k == TokenKind::LParen)
        {
            self.expect(TokenKind::LParen);
            PtrList* items = newList(self.arena);
            if (self.cur.kind != TokenKind::RParen)
            {
                loop {
                    listPush(items, (rawptr)self.parsePattern());
                    if (!self.match(TokenKind::Comma)) break;
                    if (self.cur.kind == TokenKind::RParen) break;
                }
            }
            self.expect(TokenKind::RParen);
            if (items.len == 1) return (Pattern*)items.data[0];
            Pattern* p = newPattern(self.arena, PatternKind::PatTuple, loc);
            p.items = items;
            return p;
        }

        if (k == TokenKind::LBracket)
        {
            self.expect(TokenKind::LBracket);
            Pattern* p = newPattern(self.arena, PatternKind::PatSlice, loc);
            p.items = newList(self.arena);
            while (self.cur.kind != TokenKind::RBracket && !self.atEnd())
            {
                if (self.cur.kind == TokenKind::Ellipsis)
                {
                    self.advance();
                    Pattern* rest = self.parsePatternPrimary();
                    rest.rest = true;
                    listPush(p.items, (rawptr)rest);
                }
                else
                {
                    listPush(p.items, (rawptr)self.parsePattern());
                }
                if (!self.match(TokenKind::Comma)) break;
            }
            self.expect(TokenKind::RBracket);
            return p;
        }

        self.perr("E0205", self.fmt("expected a pattern, found `{}`", kindName(self.cur.kind)));
        self.whyFound();
        if (!self.isBoundary(self.cur.kind)) self.advance();
        return newPattern(self.arena, PatternKind::PatBinding, loc);
    }
