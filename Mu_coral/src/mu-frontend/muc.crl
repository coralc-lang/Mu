import core::io { readCmdline, readFile };
import core::arena { Arena };
import diag::diag { Diags };
import lexer::lexer { Lexer, newLexer };
import common::token { Token, TokenKind, kindName, matchWord };
import parser { base::Parser, decl, expr, pattern, stmt, type };
import ast::ast { PtrList };
import sema::sema { Checker };

import(lib) std::data { option::Option, result::Result };
import(lib) std::io::ios { print };

Option<str> nextArg(str all, usize* pos)
{
    usize i = *pos;
    while (i < all.len && all.ptr[i] == 0) i++;
    if (i >= all.len)
        return Option<str>::None;
    usize start = i;
    while (i < all.len && all.ptr[i] != 0) i++;
    *pos = i;
    return Option<str>::Some { .value = str::fromParts(all.ptr + start, i - start) };
}

void usage() { print("usage: muc [--tokens] <file.mu>\n"); }

pub i32 main()
{
    Option<str> cmdOpt = readCmdline();
    if (cmdOpt.isNone()) {
        print("muc: cannot read /proc/self/cmdline\n");
        return 1;
    }
    
    str cmd = cmdOpt.unwrap();
    usize pos = 0;
    
    nextArg(cmd, &pos);
    str path = str::empty();
    bool dumpTokens = false;
    
    loop {
        Option<str> moreOpt = nextArg(cmd, &pos);
        if (moreOpt.isNone()) break;
        str arg = moreOpt.unwrap();
        
        if (matchWord(arg, "--tokens")) dumpTokens = true;
        else if (path.len == 0) path = arg;
        else {
            print("muc: unexpected argument: {}\n", arg);
            usage();
            return 2;
        }
    }
    if (path.len == 0) {
        usage();
        return 2;
    }

    Result<str, str> file = readFile(path);
    if (file.isErr()) {
        str err = file.unwrapErr();
        print("muc: {}: {}\n", path, err);
        return 1;
    }
    str src = file.unwrap();

    Diags diags;
    diags.init(path, src);
    Lexer lx = newLexer(src.ptr, src.len, &diags);

    if (dumpTokens)
    {
        loop {
            Token t = lx.next();
            print("{}:{} {}: {}\n", t.line, t.col, kindName(t.kind), t.text);
            if (t.kind == TokenKind::Eof) break;
        }
        diags.summary();
        if (!diags.ok()) return 1;
        return 0;
    }

    Arena arena;
    arena.init(65536);
    Parser p;
    p.init(&lx, &diags, &arena);
    PtrList* decls = p.parseFile();
    print("muc: {} declaration(s)\n", decls.len);

    Checker chk;
    chk.init(&arena, &diags, decls);
    chk.checkAll();

    diags.summary();
    if (!diags.ok()) return 1;
    return 0;
}
