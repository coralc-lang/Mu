import core::io { readCmdline, readFile };
import core::arena { Arena };
import diag::diag { Diags };
import lexer::lexer { Lexer, newLexer };
import common::token { Token, TokenKind, kindName, matchWord };
import parser { base::Parser, decl, expr, pattern, stmt, type }; // to pull in the extend blocks
import ast::ast { PtrList };
import sema::sema { Checker };

import(lib) std::data { option::Option, result::Result };
import(lib) std::io::ios { print };
import buf::buf { printBufReport };
import json::json { printJsonReport };
import lsp::lsp { runLsp };

Option<str> nextArg(str all, usize* pos)
{
    usize i = *pos;
    while (i < all.len && all.ptr[i] == 0) i++;
    if (i >= all.len)
        return Option<str>::None;
    usize start = i;
    while (i < all.len && all.ptr[i] != 0) i++;
    *pos = i;
    return Option<str>::Some { .value = str::fromParts(all.ptr + start, i - start) };
}

void usage()
{
    print("usage: muc [--tokens] [--json] [--buf] [--lsp] <file.mu>\n");
    print("  --tokens  dump the token stream and exit\n");
    print("  --json    machine-readable diagnostics (one json document)\n");
    print("  --buf     compact tab-separated diagnostics (engine test editor)\n");
    print("  --lsp     act as a language server on stdin/stdout\n");
}

pub i32 main()
{
    Option<str> cmdOpt = readCmdline();
    if (cmdOpt.isNone()) {
        print("muc: cannot read /proc/self/cmdline\n");
        return 1;
    }

    str cmd = cmdOpt.unwrap();
    usize pos = 0;

    nextArg(cmd, &pos);
    str path = str::empty();
    bool dumpTokens = false;
    bool asJson = false;
    bool asBuf = false;
    bool asLsp = false;

    loop {
        Option<str> moreOpt = nextArg(cmd, &pos);
        if (moreOpt.isNone()) break;
        str arg = moreOpt.unwrap();

        if (matchWord(arg, "--tokens")) dumpTokens = true;
        else if (matchWord(arg, "--json")) asJson = true;
        else if (matchWord(arg, "--buf")) asBuf = true;
        else if (matchWord(arg, "--lsp")) asLsp = true;
        else if (path.len == 0) path = arg;
        else {
            print("muc: unexpected argument: {}\n", arg);
            usage();
            return 2;
        }
    }

    // the language server takes no input file: it reads documents on stdin
    if (asLsp) return runLsp();

    if (path.len == 0) {
        usage();
        return 2;
    }

    Result<str, str> file = readFile(path);
    if (file.isErr()) {
        str err = file.unwrapErr();
        print("muc: {}: {}\n", path, err);
        return 1;
    }
    str src = file.unwrap();

    Diags diags;
    diags.init(path, src);
    // machine modes must keep stdout clean for the serialized payload
    if (asJson || asBuf) diags.quiet = true;
    Lexer lx = newLexer(src.ptr, src.len, &diags);

    if (dumpTokens)
    {
        loop {
            Token t = lx.next();
            print("{}:{} {}: {}\n", t.line, t.col, kindName(t.kind), t.text);
            if (t.kind == TokenKind::Eof) break;
        }
        diags.summary();
        if (!diags.ok()) return 1;
        return 0;
    }

    Arena arena;
    arena.init(65536);
    Parser p;
    p.init(&lx, &diags, &arena);
    PtrList* decls = p.parseFile();
    if (!asJson && !asBuf) print("muc: {} declaration(s)\n", decls.len);

    Checker chk;
    chk.init(&arena, &diags, decls);
    chk.checkAll();

    if (asJson) printJsonReport(&diags, path);
    else if (asBuf) printBufReport(&diags, path);
    else diags.summary();
    if (!diags.ok()) return 1;
    return 0;
}
