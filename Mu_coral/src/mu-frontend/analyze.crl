import core::arena { Arena };
import common::token { Token, TokenKind, kindName };
import lexer::lexer { Lexer, newLexer };
import parser { base::Parser, decl, expr, pattern, stmt, type }; // to pull in the extend blocks
import ast::ast { PtrList };
import diag::diag { Diags };
import sema::sema { Checker };

// run the whole front end over one buffer: lex -> parse -> check.
// the caller owns `d` and reuses it across calls (see the lsp loop).
pub void analyze(str path, str src, Diags* d)
{
    Lexer lx = newLexer(src.ptr, src.len, d);
    Arena arena;
    arena.init(65536);

    Parser p;
    p.init(&lx, d, &arena);
    PtrList* decls = p.parseFile();

    Checker chk;
    chk.init(&arena, d, decls);
    chk.checkAll();
}
