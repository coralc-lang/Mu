import common::token { Token, TokenKind, keywordKind, matchWord };
import diag::diag { Diags };
import(lib) core;

bool isDigit(u8 c) { return core::charUtil::isDigit(c); }
bool isHex(u8 c) { return core::charUtil::isHexDigit(c); }
bool isIdentStart(u8 c) { return core::charUtil::isAlpha(c) || c == (u8)'_'; }
bool isIdentCont(u8 c) { return isIdentStart(c) || core::charUtil::isDigit(c); }

u8 utf8Len(u8 b0)
{
    if (b0 <= 0x7F) return 1;
    if ((b0 & 0xE0) == 0xC0) return 2;
    if ((b0 & 0xF0) == 0xE0) return 3;
    if ((b0 & 0xF8) == 0xF0) return 4;
    return 0;
}

u8 hexVal(u8 c)
{
    if (c >= (u8)'0' && c <= (u8)'9') return (u8)(c - (u8)'0');
    if (c >= (u8)'a' && c <= (u8)'f') return (u8)((c - (u8)'a') + 10);
    if (c >= (u8)'A' && c <= (u8)'F') return (u8)((c - (u8)'A') + 10);
    return 0;
}

bool numSuffix(str s)
{
    if (s.len == 0) return true;
    if (matchWord(s, "i8")) return true;
    if (matchWord(s, "i16")) return true;
    if (matchWord(s, "i32")) return true;
    if (matchWord(s, "i64")) return true;
    if (matchWord(s, "isize")) return true;
    if (matchWord(s, "u8")) return true;
    if (matchWord(s, "u16")) return true;
    if (matchWord(s, "u32")) return true;
    if (matchWord(s, "u64")) return true;
    if (matchWord(s, "usize")) return true;
    if (matchWord(s, "f32")) return true;
    if (matchWord(s, "f64")) return true;
    return false;
}

pub struct Lexer
{
    u8* src;
    usize len;
    usize pos;
    usize line;
    usize col;
    Diags* diags;

    bool atEnd() { return self.pos >= self.len; }

    u8 peek()
    {
        if (self.pos >= self.len) return 0;
        return self.src[self.pos];
    }

    u8 peekAt(usize n)
    {
        if (self.pos + n >= self.len) return 0;
        return self.src[self.pos + n];
    }

    u8 advance()
    {
        u8 c = self.src[self.pos];
        self.pos += 1;
        if (c == (u8)'\n') {
            self.line += 1;
            self.col = 1;
        }
        else {
            self.col += 1;
        }
        return c;
    }

    Token make(TokenKind kind, usize start, usize line, usize col)
    {
        return Token {
            .kind = kind,
            .text = str::fromParts(self.src + start, self.pos - start),
            .line = line,
            .col = col
        };
    }

    void error(usize line, usize col, usize len, str code, str title) { self.diags.error(line, col, len, code, title); }
    void why(str msg) { self.diags.why(msg); }
    void help(str msg) { self.diags.help(msg); }

    void skipSpace()
    {
        while (!self.atEnd())
        {
            u8 c = self.peek();
            if (c == (u8)' ' || c == (u8)'\t' || c == (u8)'\r' || c == (u8)'\n') {
                self.advance();
                continue;
            }
            if (c == (u8)'/' && self.peekAt(1) == (u8)'/') {
                while (!self.atEnd() && self.peek() != (u8)'\n') self.advance();
                continue;
            }
            if (c == (u8)'/' && self.peekAt(1) == (u8)'*')
            {
                usize line = self.line;
                usize col = self.col;
                self.advance();
                self.advance();
                bool closed = false;
                while (!self.atEnd())
                {
                    if (self.peek() == (u8)'*' && self.peekAt(1) == (u8)'/') {
                        self.advance();
                        self.advance();
                        closed = true;
                        break;
                    }
                    self.advance();
                }
                if (!closed) {
                    self.error(line, col, 2, "E0102", "unterminated block comment");
                    self.why("the comment opened here is never closed");
                    self.help("close it with `*/`");
                }
                continue;
            }
            break;
        }
    }

    void scanEscape()
    {
        usize esc = self.pos;
        usize line = self.line;
        usize col = self.col;
        self.advance();
        if (self.atEnd())
        {
            self.error(line, col, 1, "E0108", "unterminated escape sequence");
            self.help("complete the escape, for example `\\n` or `\\u{41}`");
            return;
        }
        u8 e = self.peek();
        if (e == (u8)'n' || e == (u8)'t' || e == (u8)'r' || e == (u8)'\\' || e == (u8)'\'' || e == (u8)'"')
        {
            self.advance();
            return;
        }
        if (e == (u8)'u')
        {
            self.advance();
            if (self.peek() != (u8)'{')
            {
                self.error(line, col, 2, "E0109", "expected `{` after `\\u`");
                self.help("write unicode escapes as `\\u{41}`");
                return;
            }
            self.advance();
            usize digits = 0;
            usize val = 0;
            while (!self.atEnd() && isHex(self.peek()))
            {
                if (digits < 8) val = val * 16 + (usize)hexVal(self.peek());
                self.advance();
                digits = digits + 1;
            }
            if (digits == 0)
            {
                self.error(line, col, self.pos - esc, "E0109", "unicode escape needs hex digits");
                self.help("write at least one digit, for example `\\u{41}`");
                return;
            }
            if (self.peek() != (u8)'}')
            {
                self.error(line, col, self.pos - esc, "E0109", "expected `}` to close unicode escape");
                self.help("add the closing brace, for example `\\u{41}`");
                return;
            }
            self.advance();
            if (digits > 6)
            {
                self.error(line, col, self.pos - esc, "E0109", "too many hex digits in unicode escape");
                self.why("a unicode scalar needs at most 6 hex digits");
                return;
            }
            if (val > 0x10FFFF || (val >= 0xD800 && val <= 0xDFFF))
            {
                self.error(line, col, self.pos - esc, "E0110", "invalid Unicode scalar value");
                self.why("surrogate code points and values above 0x10FFFF are not scalar values");
                self.help("valid ranges are 0x0..0xD7FF and 0xE000..0x10FFFF");
            }
            return;
        }
        self.error(line, col, 2, "E0107", "unknown escape sequence");
        self.why("only `\\n`, `\\t`, `\\r`, `\\\\`, `\\'`, `\\\"`, and `\\u{...}` are valid");
        self.advance();
    }

    Token scanIdent()
    {
        usize start = self.pos;
        usize line = self.line;
        usize col = self.col;
        while (!self.atEnd() && isIdentCont(self.peek())) self.advance();
        str text = str::fromParts(self.src + start, self.pos - start);
        return self.make(keywordKind(text), start, line, col);
    }

    Token scanNumber()
    {
        usize start = self.pos;
        usize line = self.line;
        usize col = self.col;
        bool isFloat = false;
        bool badExp = false;
        bool base = false;
        if (self.peek() == (u8)'0')
        {
            u8 p = self.peekAt(1);
            u8 bits = 0;
            if (p == (u8)'x' || p == (u8)'X') bits = 16;
            else if (p == (u8)'b' || p == (u8)'B') bits = 2;
            else if (p == (u8)'o' || p == (u8)'O') bits = 8;
            if (bits != 0)
            {
                base = true;
                self.advance();
                self.advance();
                bool sawDigit = false;
                while (!self.atEnd())
                {
                    u8 c = self.peek();
                    if (c == (u8)'_')
                    {
                        self.advance();
                        continue;
                    }
                    bool ok = false;
                    if (bits == 16) ok = isHex(c);
                    else if (bits == 2) ok = (c == (u8)'0' || c == (u8)'1');
                    else ok = (c >= (u8)'0' && c <= (u8)'7');
                    if (!ok) break;
                    sawDigit = true;
                    self.advance();
                }
                if (!sawDigit && isDigit(self.peek()))
                {
                    self.error(self.line, self.col, 1, "E0112", "invalid digit for this base");
                    while (!self.atEnd() && (isDigit(self.peek()) || self.peek() == (u8)'_')) self.advance();
                }
                else if (!sawDigit)
                {
                    self.error(line, col, 2, "E0111", "missing digits after radix prefix");
                    self.help("write at least one digit, for example `0x1F`");
                    while (!self.atEnd() && isIdentCont(self.peek())) self.advance();
                }
                else if (bits != 16 && isDigit(self.peek()))
                {
                    self.error(self.line, self.col, 1, "E0112", "invalid digit for this base");
                    while (!self.atEnd() && (isDigit(self.peek()) || self.peek() == (u8)'_')) self.advance();
                }
            }
        }
        if (!base)
        {
            if (self.peek() == (u8)'0' && (isDigit(self.peekAt(1)) || self.peekAt(1) == (u8)'_'))
            {
                self.error(line, col, 2, "E0113", "leading zeros are not allowed");
                self.why("a literal starting with `0` would read as octal, and Mu has no octal");
                self.help("remove the leading zeros");
            }
            while (!self.atEnd() && (isDigit(self.peek()) || self.peek() == (u8)'_')) self.advance();
            if (self.peek() == (u8)'.' && self.peekAt(1) != (u8)'.' && isDigit(self.peekAt(1)))
            {
                isFloat = true;
                self.advance();
                while (!self.atEnd() && (isDigit(self.peek()) || self.peek() == (u8)'_')) self.advance();
            }
            if (self.peek() == (u8)'e' || self.peek() == (u8)'E')
            {
                u8 n1 = self.peekAt(1);
                if (isDigit(n1))
                {
                    isFloat = true;
                    self.advance();
                    while (!self.atEnd() && (isDigit(self.peek()) || self.peek() == (u8)'_')) self.advance();
                }
                else if ((n1 == (u8)'+' || n1 == (u8)'-') && isDigit(self.peekAt(2)))
                {
                    isFloat = true;
                    self.advance();
                    self.advance();
                    while (!self.atEnd() && (isDigit(self.peek()) || self.peek() == (u8)'_')) self.advance();
                }
                else
                {
                    self.error(self.line, self.col, 1, "E0115", "exponent has no digits");
                    self.help("write digits after the exponent, for example `1.0e10`");
                    badExp = true;
                }
            }
        }
        if (!self.atEnd() && isIdentStart(self.peek()))
        {
            usize sl = self.line;
            usize sc = self.col;
            usize sp = self.pos;
            while (!self.atEnd() && isIdentCont(self.peek())) self.advance();
            str suffix = str::fromParts(self.src + sp, self.pos - sp);
            if (!badExp && !numSuffix(suffix))
            {
                self.error(sl, sc, suffix.len, "E0114", "invalid numeric suffix");
                self.why("a suffix must name a scalar numeric type");
                self.help("valid suffixes are i8 i16 i32 i64 isize u8 u16 u32 u64 usize f32 f64");
            }
            if (matchWord(suffix, "f32") || matchWord(suffix, "f64")) isFloat = true;
        }
        if (isFloat) return self.make(TokenKind::Float, start, line, col);
        return self.make(TokenKind::Int, start, line, col);
    }

    Token scanString()
    {
        usize start = self.pos;
        usize line = self.line;
        usize col = self.col;
        self.advance();
        while (true)
        {
            if (self.atEnd())
            {
                self.error(line, col, 1, "E0103", "unterminated string literal");
                self.why("the literal reaches the end of the file before a closing `\"`");
                self.help("add the closing quote");
                break;
            }
            u8 c = self.peek();
            if (c == (u8)'\n')
            {
                self.error(line, col, 1, "E0103", "unterminated string literal");
                self.why("string literals cannot span lines");
                self.help("add the closing `\"`, or use `\\n` for a line break");
                break;
            }
            if (c == (u8)'"')
            {
                self.advance();
                break;
            }
            if (c == (u8)'\\') self.scanEscape();
            else self.advance();
        }
        return self.make(TokenKind::Str, start, line, col);
    }

    Token scanChar()
    {
        usize start = self.pos;
        usize line = self.line;
        usize col = self.col;
        self.advance();
        if (self.atEnd() || self.peek() == (u8)'\n' || self.peek() == (u8)'\'')
        {
            self.error(line, col, 2, "E0105", "empty character literal");
            self.why("a character literal holds exactly one character");
            self.help("put a character between the quotes, for example `'a'`");
            if (!self.atEnd() && self.peek() == (u8)'\'') self.advance();
            return self.make(TokenKind::CharLit, start, line, col);
        }
        if (self.peek() == (u8)'\\')
        {
            self.scanEscape();
        }
        else
        {
            usize n = (usize)utf8Len(self.peek());
            if (n == 0)
            {
                self.error(line, col, 1, "E0116", "invalid UTF-8 in character literal");
                self.why("this byte cannot begin a UTF-8 encoded character");
                self.advance();
            }
            else
            {
                usize i = 0;
                while (i < n && !self.atEnd())
                {
                    self.advance();
                    i += 1;
                }
            }
        }
        if (self.peek() == (u8)'\'')
        {
            self.advance();
            return self.make(TokenKind::CharLit, start, line, col);
        }
        usize extra = 0;
        while (!self.atEnd() && self.peek() != (u8)'\'' && self.peek() != (u8)'\n')
        {
            self.advance();
            extra = extra + 1;
        }
        if (extra > 0 && self.peek() == (u8)'\'')
        {
            self.error(line, col, self.pos - start + 1, "E0106", "character literal holds more than one character");
            self.why("a character literal holds exactly one character");
            self.help("use a string literal for more than one character");
            self.advance();
        }
        else
        {
            self.error(line, col, 1, "E0104", "unterminated character literal");
            self.help("add the closing `'`");
        }
        return self.make(TokenKind::CharLit, start, line, col);
    }

    Token scanManifest()
    {
        usize start = self.pos;
        usize line = self.line;
        usize col = self.col;
        self.advance();
        self.advance();
        while (!self.atEnd() && self.peek() != (u8)'\n') self.advance();
        return self.make(TokenKind::Manifest, start, line, col);
    }

    Token scanOperator()
    {
        usize start = self.pos;
        usize line = self.line;
        usize col = self.col;
        u8 c = self.advance();

        switch (c)
        {
            '+' => {
                if (self.peek() == (u8)'=') { self.advance(); return self.make(TokenKind::PlusEqual, start, line, col); }
                return self.make(TokenKind::Plus, start, line, col);
            },
            '-' => {
                if (self.peek() == (u8)'=') { self.advance(); return self.make(TokenKind::MinusEqual, start, line, col); }
                if (self.peek() == (u8)'>') { self.advance(); return self.make(TokenKind::Arrow, start, line, col); }
                return self.make(TokenKind::Minus, start, line, col);
            },
            '*' => {
                if (self.peek() == (u8)'=') { self.advance(); return self.make(TokenKind::StarEqual, start, line, col); }
                return self.make(TokenKind::Star, start, line, col);
            },
            '/' => {
                if (self.peek() == (u8)'=') { self.advance(); return self.make(TokenKind::SlashEqual, start, line, col); }
                return self.make(TokenKind::Slash, start, line, col);
            },
            '%' => {
                if (self.peek() == (u8)'=') { self.advance(); return self.make(TokenKind::PercentEqual, start, line, col); }
                return self.make(TokenKind::Percent, start, line, col);
            },
            '=' => {
                if (self.peek() == (u8)'>') { self.advance(); return self.make(TokenKind::FatArrow, start, line, col); }
                if (self.peek() == (u8)'=') { self.advance(); return self.make(TokenKind::EqualEqual, start, line, col); }
                return self.make(TokenKind::Equal, start, line, col);
            },
            '!' => {
                if (self.peek() == (u8)'=') { self.advance(); return self.make(TokenKind::NotEqual, start, line, col); }
                return self.make(TokenKind::Not, start, line, col);
            },
            '<' => {
                if (self.peek() == (u8)'<' && self.peekAt(1) == (u8)'=') { self.advance(); self.advance(); return self.make(TokenKind::ShlEqual, start, line, col); }
                if (self.peek() == (u8)'<') { self.advance(); return self.make(TokenKind::Shl, start, line, col); }
                if (self.peek() == (u8)'=') { self.advance(); return self.make(TokenKind::LessEqual, start, line, col); }
                return self.make(TokenKind::Less, start, line, col);
            },
            '>' => {
                if (self.peek() == (u8)'>' && self.peekAt(1) == (u8)'=') { self.advance(); self.advance(); return self.make(TokenKind::ShrEqual, start, line, col); }
                if (self.peek() == (u8)'>') { self.advance(); return self.make(TokenKind::Shr, start, line, col); }
                if (self.peek() == (u8)'=') { self.advance(); return self.make(TokenKind::GreaterEqual, start, line, col); }
                return self.make(TokenKind::Greater, start, line, col);
            },
            '&' => {
                if (self.peek() == (u8)'&') { self.advance(); return self.make(TokenKind::And, start, line, col); }
                if (self.peek() == (u8)'=') { self.advance(); return self.make(TokenKind::AmpEqual, start, line, col); }
                return self.make(TokenKind::Amp, start, line, col);
            },
            '|' => {
                if (self.peek() == (u8)'|') { self.advance(); return self.make(TokenKind::Or, start, line, col); }
                if (self.peek() == (u8)'=') { self.advance(); return self.make(TokenKind::PipeEqual, start, line, col); }
                return self.make(TokenKind::Pipe, start, line, col);
            },
            '^' => {
                if (self.peek() == (u8)'=') { self.advance(); return self.make(TokenKind::CaretEqual, start, line, col); }
                return self.make(TokenKind::Caret, start, line, col);
            },
            ':' => {
                if (self.peek() == (u8)':') { self.advance(); return self.make(TokenKind::ColonColon, start, line, col); }
                return self.make(TokenKind::Colon, start, line, col);
            },
            '.' => {
                if (self.peek() == (u8)'.' && self.peekAt(1) == (u8)'.') { self.advance(); self.advance(); return self.make(TokenKind::Ellipsis, start, line, col); }
                if (self.peek() == (u8)'.' && self.peekAt(1) == (u8)'=') { self.advance(); self.advance(); return self.make(TokenKind::DotDotEq, start, line, col); }
                if (self.peek() == (u8)'.') { self.advance(); return self.make(TokenKind::DotDot, start, line, col); }
                return self.make(TokenKind::Dot, start, line, col);
            },
            '?' => { return self.make(TokenKind::Question, start, line, col); },
            '@' => { return self.make(TokenKind::At, start, line, col); },
            ';' => { return self.make(TokenKind::Semicolon, start, line, col); },
            ',' => { return self.make(TokenKind::Comma, start, line, col); },
            '(' => { return self.make(TokenKind::LParen, start, line, col); },
            ')' => { return self.make(TokenKind::RParen, start, line, col); },
            '{' => { return self.make(TokenKind::LBrace, start, line, col); },
            '}' => { return self.make(TokenKind::RBrace, start, line, col); },
            '[' => { return self.make(TokenKind::LBracket, start, line, col); },
            ']' => { return self.make(TokenKind::RBracket, start, line, col); },
            else => {
                self.error(line, col, 1, "E0101", "unexpected character");
                self.why("this byte does not start any Mu token");
                self.help("remove it, or put it inside a string literal");
                return self.make(TokenKind::Unknown, start, line, col);
            },
        }
    }

    Token next()
    {
        self.skipSpace();
        if (self.atEnd()) return self.make(TokenKind::Eof, self.pos, self.line, self.col);
        u8 c = self.peek();
        if (isIdentStart(c)) return self.scanIdent();
        if (isDigit(c)) return self.scanNumber();
        if (c == (u8)'"') return self.scanString();
        if (c == (u8)'\'') return self.scanChar();
        if (c == (u8)'#' && self.peekAt(1) == (u8)'!') return self.scanManifest();
        return self.scanOperator();
    }
}

pub Lexer newLexer(u8* src, usize len, Diags* diags)
{
    return Lexer {
        .src = src,
        .len = len,
        .pos = 0,
        .line = 1,
        .col = 1,
        .diags = diags
    };
}
