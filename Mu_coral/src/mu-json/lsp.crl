import(lib) std::io::ios { print, readChar, readLine, eprintln };
import(lib) std::parser::json { JsonType, JsonValue, JsonPair, parseJson, serialize };
import(lib) std::text::string { String };
import(lib) std::text::strutil { trim, startsWith };
import diag::diag { Diags };
import frontend::analyze { analyze };
import json::json { objPut, diagArrayJson, objGet, jsonStr };

// The language server: a stdio JSON-RPC 2.0 loop that keeps one document in
// memory and re-runs the compiler on every change.
//
//   Content-Length: <n>\r\n\r\n<json body>
//
// Supported methods: initialize, initialized, textDocument/didOpen,
// textDocument/didChange, textDocument/didClose, shutdown, exit. Requests for
// anything else answer with a method-not-implemented error so editors that
// probe (hover, completion, semantic tokens) fail fast instead of hanging.

struct Lsp
{
    Diags diags;
    String uri;
    String text;
    String out;      // frame scratch buffer
    bool wantExit;

    void init()
    {
        self.diags.init(str::empty(), str::empty());
        self.uri = String::new();
        self.text = String::new();
        self.out = String::new();
        self.wantExit = false;
    }

    void drop()
    {
        self.uri.free();
        self.text.free();
        self.out.free();
    }
}

void pushUint(String* s, usize v)
{
    if (v == 0)
    {
        s.pushByte('0');
        return;
    }
    u8 buf[20];
    usize n = 0;
    while (v > 0)
    {
        buf[n] = (u8)('0' + (v % 10));
        v /= 10;
        n++;
    }
    while (n > 0)
    {
        n = n - 1;
        s.pushByte(buf[n]);
    }
}

// one framed message: header built in `out`, body appended, single write
void send(Lsp* self, JsonValue* v)
{
    String body = serialize(v);
    self.out.clear();
    self.out.pushView("Content-Length: ");
    pushUint(&self.out, body.len);
    self.out.pushView("\r\n\r\n");
    print(self.out.asView());
    print(body.asView());
    body.free();
}

void respond(Lsp* self, JsonValue* id, JsonValue* result)
{
    JsonValue msg = JsonValue::objectVal();
    objPut(&msg, "jsonrpc", JsonValue::stringVal(String::from("2.0")));
    objPut(&msg, "id", id == null ? JsonValue::nullVal() : *id);
    objPut(&msg, "result", result == null ? JsonValue::nullVal() : *result);
    send(self, &msg);
    msg.dispose();
}

void publish(Lsp* self)
{
    JsonValue params = JsonValue::objectVal();
    objPut(&params, "uri", JsonValue::stringVal(String::from(self.uri.asView())));
    objPut(&params, "diagnostics", diagArrayJson(&self.diags));

    JsonValue msg = JsonValue::objectVal();
    objPut(&msg, "jsonrpc", JsonValue::stringVal(String::from("2.0")));
    objPut(&msg, "method", JsonValue::stringVal(String::from("textDocument/publishDiagnostics")));
    objPut(&msg, "params", params);
    send(self, &msg);
    msg.dispose();
}

void publishEmpty(Lsp* self)
{
    JsonValue params = JsonValue::objectVal();
    objPut(&params, "uri", JsonValue::stringVal(String::from(self.uri.asView())));
    objPut(&params, "diagnostics", JsonValue::arrayVal());

    JsonValue msg = JsonValue::objectVal();
    objPut(&msg, "jsonrpc", JsonValue::stringVal(String::from("2.0")));
    objPut(&msg, "method", JsonValue::stringVal(String::from("textDocument/publishDiagnostics")));
    objPut(&msg, "params", params);
    send(self, &msg);
    msg.dispose();
}

// run the front end over the in-memory buffer; diagnostics are cleared first so
// a long editing session does not accumulate records forever
void reanalyze(Lsp* self)
{
    self.diags.clearRecs();
    self.diags.errors = 0;
    self.diags.warnings = 0;
    self.diags.limitHit = false;
    self.diags.quiet = true;
    self.diags.file = docPath(self.uri.asView());
    analyze(self.diags.file, self.text.asView(), &self.diags);
}

// strip "file://" so the reported path looks like a real file path
str docPath(str uri)
{
    if (startsWith(uri, "file://")) return uri.slice(7, uri.len);
    return uri;
}

void openDoc(Lsp* self, JsonValue* params)
{
    JsonValue* td = objGet(params, "textDocument");
    if (td == null) return;
    JsonValue* uri = objGet(td, "uri");
    JsonValue* text = objGet(td, "text");
    if (uri == null || text == null) return;
    self.uri.clear();
    self.uri.pushView(jsonStr(uri));
    self.text.clear();
    self.text.pushView(jsonStr(text));
}

// full-text sync (initialize advertises sync kind 1), so the last change wins
void changeDoc(Lsp* self, JsonValue* params)
{
    JsonValue* changes = objGet(params, "contentChanges");
    if (changes == null || changes.type != JsonType::Array) return;
    if (changes.arrVal.isEmpty()) return;
    JsonValue* last = changes.arrVal.atPtr(changes.arrVal.count() - 1);
    JsonValue* text = objGet(last, "text");
    if (text == null) return;
    self.text.clear();
    self.text.pushView(jsonStr(text));
}

// read the header block, then exactly Content-Length bytes into out
bool readFrame(String* out)
{
    out.clear();
    usize contentLen = 0;
    String line = String::new();
    loop {
        if (!readLine(&line)) { line.free(); return false; }
        if (line.isEmpty()) break;
        if (line.startsWith("Content-Length:"))
        {
            str rest = trim(line.substr(15, line.len).asView());
            usize i = 0;
            while (i < rest.len)
            {
                u8 c = rest.ptr[i];
                if (c < (u8)'0' || c > (u8)'9') break;
                contentLen = contentLen * 10 + (usize)(c - (u8)'0');
                i++;
            }
        }
        line.clear();
    }
    line.free();
    if (contentLen == 0) return false;

    usize i = 0;
    while (i < contentLen)
    {
        u8 c = readChar();
        if (c == 0) break;
        out.pushByte(c);
        i++;
    }
    return i == contentLen;
}

void notImplemented(Lsp* self, JsonValue* id)
{
    JsonValue err = JsonValue::objectVal();
    objPut(&err, "code", JsonValue::i64Val(-32601));
    objPut(&err, "message", JsonValue::stringVal(String::from("method not implemented")));

    JsonValue msg = JsonValue::objectVal();
    objPut(&msg, "jsonrpc", JsonValue::stringVal(String::from("2.0")));
    objPut(&msg, "id", id == null ? JsonValue::nullVal() : *id);
    objPut(&msg, "error", err);
    send(self, &msg);
    msg.dispose();
}

void handle(Lsp* self, str body)
{
    JsonValue msg = JsonValue::nullVal();
    if (!parseJson(body, &msg))
    {
        eprintln("muc-lsp: unreadable message");
        return;
    }

    JsonValue* id = objGet(&msg, "id");
    JsonValue* params = objGet(&msg, "params");
    str m = jsonStr(objGet(&msg, "method"));

    if (m.equals("initialize"))
    {
        JsonValue caps = JsonValue::objectVal();
        objPut(&caps, "textDocumentSync", JsonValue::i64Val(1));
        respond(self, id, &caps);
    }
    else if (m.equals("textDocument/didOpen"))
    {
        openDoc(self, params);
        reanalyze(self);
        publish(self);
    }
    else if (m.equals("textDocument/didChange"))
    {
        changeDoc(self, params);
        reanalyze(self);
        publish(self);
    }
    else if (m.equals("textDocument/didClose"))
    {
        publishEmpty(self);
    }
    else if (m.equals("shutdown"))
    {
        respond(self, id, null);
    }
    else if (m.equals("exit"))
    {
        self.wantExit = true;
    }
    else if (id != null)
    {
        notImplemented(self, id);
    }
    msg.dispose();
}

pub i32 runLsp()
{
    Lsp self;
    self.init();

    String body = String::new();
    while (!self.wantExit)
    {
        if (!readFrame(&body)) break;
        handle(&self, body.asView());
        body.clear();
    }
    body.free();
    self.drop();
    return 0;
}
