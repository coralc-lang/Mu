import(lib) std::io::ios { print };
import(lib) std::text::string { String };
import diag::diag { Diags, DiagRec };

// The engine's in-game test editor reads diagnostics through this format
// instead of json: tab-separated, one record per line, no intermediate tree,
// no escaping rules, no numbers larger than u64. Designed to be parsed by a
// few dozen lines of C in the editor's status line.
//
//   H <file> <errors> <warnings> <records>
//   E <line> <col> <len> <code> <title>
//   W <line> <col> <len> <code> <title>
//   N <note>                                  (one per note, follows its record)
//
// messages and notes keep their text verbatim — no quotes, no escapes.
// a note or title containing a tab or newline loses that tab/newline, which
// no mu diagnostic does today.

void pushUint(String* s, usize v)
{
    if (v == 0)
    {
        s.pushByte('0');
        return;
    }
    u8 buf[20];
    usize n = 0;
    while (v > 0)
    {
        buf[n] = (u8)('0' + (v % 10));
        v /= 10;
        n++;
    }
    while (n > 0)
    {
        n = n - 1;
        s.pushByte(buf[n]);
    }
}

void pushRec(String* s, DiagRec* r)
{
    s.pushByte(r.isError ? 'E' : 'W');
    s.pushByte('\t');
    pushUint(s, r.line);
    s.pushByte('\t');
    pushUint(s, r.col);
    s.pushByte('\t');
    pushUint(s, r.len);
    s.pushByte('\t');
    s.pushView(r.code);
    s.pushByte('\t');
    s.pushView(r.title);
    s.pushByte('\n');
    usize i = 0;
    while (i < r.notes.count())
    {
        s.pushByte('N');
        s.pushByte('\t');
        s.pushView(r.notes.at(i));
        s.pushByte('\n');
        i++;
    }
}

// build the whole report in one buffer, emit it in a single write
pub void printBufReport(Diags* d, str file)
{
    String s = String::new();
    s.pushByte('H');
    s.pushByte('\t');
    s.pushView(file);
    s.pushByte('\t');
    pushUint(&s, d.errors);
    s.pushByte('\t');
    pushUint(&s, d.warnings);
    s.pushByte('\t');
    pushUint(&s, d.recCount());
    s.pushByte('\n');

    usize i = 0;
    while (i < d.recCount())
    {
        pushRec(&s, d.recAt(i));
        i++;
    }
    print(s.asView());
    s.free();
}
