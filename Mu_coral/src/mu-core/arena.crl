// Compiler arena: std::mman's ArenaAllocator (mimalloc-backed bump arena)
// behind the Arena { init / alloc / freeAll } surface the ast/parser/sema
// code already uses. Blocks used to come from hand-rolled linked lists;
// now mman owns growth (doubling via realloc) and the backing allocator.
//
//   std/lib.crl → pub mod mman = import memory::mman
//   std/x86_64/{linux,windows}/memory/mman.crl → ArenaAllocator

import(lib) std::mman { ArenaAllocator, defaultAllocator, ensureDefaultAllocator };

pub struct Arena
{
    ArenaAllocator inner;

    void init(usize size)
    {
        ensureDefaultAllocator();
        self.inner.init(defaultAllocator, size);
    }

    rawptr alloc(usize size, usize align)
    {
        (void)align; // mman's arena bump-aligns to 8; every call site passes 8
        return self.inner.push(size);
    }

    void freeAll()
    {
        self.inner.reset();
    }
}
