import(lib) std::mman { alloc };
import(lib) std::data { option::Option, result::Result };
import(lib) std::io { fios::fileReadAll, cmd::commandLine };
import(lib) std::text::string { String };

Option<str> readCmdline()
{
    str cmd = commandLine();
    if (cmd.len == 0) return Option<str>::None;
    return Option<str>::Some { .value = cmd };
}

Result<str, str> readFile(str path)
{
    String out = String::new();
    if (!fileReadAll(path, &out))
    {
        out.free();
        return Result<str, str>::Err { .error = "cannot open file" };
    }
    return Result<str, str>::Ok { .value = out.asView() };
}

Option<u8*> sliceCStr(str s)
{
    u8* p = alloc<u8>(s.len + 1);
    if (p == null) return Option<u8*>::None;
    usize i = 0;
    while (i < s.len)
    {
        p[i] = s.ptr[i];
        i++;
    }
    p[s.len] = 0;
    return Option<u8*>::Some { .value = p };
}
