import(lib) std::io::ios { print, spaces };

usize width(usize n)
{
    usize w = 1;
    while (n >= 10)
    {
        n /= 10;
        w++;
    }
    return w;
}

pub struct Diags
{
    str file;
    str src;
    usize errors;
    usize warnings;
    usize limit;
    bool limitHit;

    void init(str file, str src)
    {
        self.file = file;
        self.src = src;
        self.errors = 0;
        self.warnings = 0;
        self.limit = 100;
        self.limitHit = false;
    }

    bool shouldStop()
    {
        return self.limitHit;
    }

    bool ok()
    {
        return self.errors == 0;
    }

    void error(usize line, usize col, usize len, str code, str title)
    {
        if (self.errors >= self.limit)
        {
            if (!self.limitHit)
            {
                self.limitHit = true;
                print("error E0000  too many errors, aborting after {}\n", self.limit);
            }
            return;
        }
        self.emit("error", code, line, col, len, title);
        self.errors += 1;
    }

    void warn(usize line, usize col, usize len, str code, str title)
    {
        self.emit("warning", code, line, col, len, title);
        self.warnings += 1;
    }

    void why(str msg)
    {
        print("      why: {}\n", msg);
    }

    void help(str msg)
    {
        print("      help: {}\n", msg);
    }

    void also(usize line, usize col, usize len, str msg)
    {
        print("\n  also at {}:{}:{}: {}\n\n", self.file, line, col, msg);
        usize w = width(line);
        str text = self.lineOf(line).trimEnd();
        print("{} | {}\n", line, text);
        self.caret(w, col, len);
        print("  {}\n", msg);
    }

    void emit(str kind, str code, usize line, usize col, usize len, str title)
    {
        print("{} {}  {}\n", kind, code, title);
        print("\n  at {}:{}:{}\n\n", self.file, line, col);
        usize w = width(line);
        str text = self.lineOf(line).trimEnd();
        print("{} | {}\n", line, text);
        self.caret(w, col, len);
        print("\n");
    }

    void caret(usize w, usize col, usize len)
    {
        print("{}| ", spaces((u64)w));
        usize i = 0;
        while (i + 1 < col)
        {
            print(" ");
            i++;
        }
        print("^");
        usize extra = len > 1 ? len - 1 : 0;
        while (extra > 0)
        {
            print("~");
            extra--;
        }
    }

    str lineOf(usize line)
    {
        usize i = 0;
        usize cur = 1;
        while (i < self.src.len && cur < line)
        {
            if (self.src.ptr[i] == (u8)'\n') cur = cur + 1;
            i++;
        }
        usize start = i;
        while (i < self.src.len && self.src.ptr[i] != (u8)'\n') i = i + 1;
        return self.src.slice(start, i);
    }

    void summary()
    {
        if (self.errors == 0 && self.warnings == 0) return;
        print("\n  {} error(s), {} warning(s) in {}\n", self.errors, self.warnings, self.file);
    }
}
