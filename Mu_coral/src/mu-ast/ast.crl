{
    PatWildcard,
    PatBinding,
    PatInt,
    PatFloat,
    PatStr,
    PatChar,
    PatBool,
    PatRange,
    PatTuple,
    PatSlice,
    PatVariant,
    PatOr
}

pub struct Pattern
{
    PatternKind kind;
    Loc loc;
    str text;
    bool rest;
    bool neg;
    Expr* value;
    Pattern* a;
    Pattern* b;
    PtrList* items;
}

pub Pattern* newPattern(Arena* a, PatternKind k, Loc loc)
{
    Pattern* p = (Pattern*)a.alloc(@sizeof(Pattern), 8);
    p.kind = k;
    p.loc = loc;
    p.text = str::empty();
    p.rest = false;
    p.neg = false;
    p.value = null;
    p.a = null;
    p.b = null;
    p.items = null;
    return p;
}

pub enum StmtKind
{
    StVar,
    StExpr,
    StIf,
    StWhile,
    StFor,
    StBlock,
    StBreak,
    StContinue,
    StReturn,
    StSwitch
}

pub struct Stmt
{
    StmtKind kind;
    Loc loc;
    str label;
    bool isLet;
    Pattern* pat;
    Type* type;
    Expr* expr;
    Stmt* a;
    Stmt* b;
    PtrList* list;
    PtrList* prongs;
}

pub Stmt* newStmt(Arena* a, StmtKind k, Loc loc)
{
    Stmt* s = (Stmt*)a.alloc(@sizeof(Stmt), 8);
    s.kind = k;
    s.loc = loc;
    s.label = str::empty();
    s.isLet = false;
    s.pat = null;
    s.type = null;
    s.expr = null;
    s.a = null;
    s.b = null;
    s.list = null;
    s.prongs = null;
    return s;
}

pub struct Prong
{
    Loc loc;
    Pattern* pat;
    bool isElse;
    Expr* guard;
    Stmt* body;
}

pub Prong* newProng(Arena* a)
{
    Prong* p = (Prong*)a.alloc(@sizeof(Prong), 8);
    p.loc.line = 0;
    p.loc.col = 0;
    p.pat = null;
    p.isElse = false;
    p.guard = null;
    p.body = null;
    return p;
}

