}

pub Attr* newAttr(Arena* a)
{
    Attr* at = (Attr*)a.alloc(@sizeof(Attr), 8);
    at.name = str::empty();
    at.loc.line = 0;
    at.loc.col = 0;
    at.args = null;
    return at;
