import core::arena { Arena };

pub struct Loc
{
    usize line;
    usize col;
}

pub struct PtrList
{
    rawptr* data;
    usize len;
    usize cap;
    Arena* arena;
}

pub PtrList* newList(Arena* a)
{
    PtrList* l = (PtrList*)a.alloc(@sizeof(PtrList), 8);
    l.data = null;
    l.len = 0;
    l.cap = 0;
    l.arena = a;
    return l;
}

pub void listPush(PtrList* l, rawptr item)
{
    if (l.len >= l.cap)
    {
        usize newCap = 8;
        if (l.cap != 0) newCap = l.cap * 2;
        rawptr* fresh = (rawptr*)l.arena.alloc(newCap * @sizeof(rawptr), 8);
        usize i = 0;
        while (i < l.len)
        {
            fresh[i] = l.data[i];
            i++;
        }
        l.data = fresh;
        l.cap = newCap;
    }
    l.data[l.len] = item;
    l.len++;
}

pub enum Op
{
    Add,
    Sub,
    Mul,
    Div,
    Rem,
    Shl,
    Shr,
    Band,
    Bor,
    Bxor,
    Eq,
    Ne,
    Lt,
    Le,
    Gt,
    Ge,
    LAnd,
    LOr,
    Assign,
    AddA,
    SubA,
    MulA,
    DivA,
    RemA,
    BandA,
    BorA,
    BxorA,
    ShlA,
    ShrA,
    Neg,
    Not,
    Range,
    RangeEq,
    Await,
    None
}

// storage class decided by the memory phase (escape analysis, DESIGN §6)
pub enum MemClass
{
    McAuto,
    McStack,
    McHeap
}

pub enum TypeKind
{
    Name,
    Array,
    Slice,
    Tuple,
    Dyn
}

pub struct Type
{
    TypeKind kind;
    Loc loc;
    str text;
    Type* elem;
    Expr* len;
    PtrList* args;
    PtrList* items;
}

pub Type* newType(Arena* a, TypeKind k, Loc loc)
{
    Type* t = (Type*)a.alloc(@sizeof(Type), 8);
    t.kind = k;
    t.loc = loc;
    t.text = str::empty();
    t.elem = null;
    t.len = null;
    t.args = null;
    t.items = null;
    return t;
}

pub enum ExprKind
{
    Int,
    Float,
    Str,
    Char,
    Bool,
    Name,
    Unary,
    Binary,
    Assign,
    Call,
    Field,
    Index,
    Cast,
    Question,
    StructLit,
    Range,
    Tuple,
    ArrayLit,
    If,
    While,
    Switch
}

pub struct Expr
{
    ExprKind kind;
    Loc loc;
    str text;
    str name;
    Op op;
    Expr* a;
    Expr* b;
    PtrList* list;
    Type* type;
    PtrList* gargs;
    Stmt* stmt;
    MemClass mem;
}

pub Expr* newExpr(Arena* a, ExprKind k, Loc loc)
{
    Expr* e = (Expr*)a.alloc(@sizeof(Expr), 8);
    e.kind = k;
    e.loc = loc;
    e.text = str::empty();
    e.name = str::empty();
    e.op = Op::None;
    e.a = null;
    e.b = null;
    e.list = null;
    e.type = null;
    e.gargs = null;
    e.stmt = null;
    e.mem = MemClass::McAuto;
    return e;
}

pub struct FieldInit
{
    str name;
    Expr* value;
    bool spread;
}

pub FieldInit* newFieldInit(Arena* a)
{
    FieldInit* f = (FieldInit*)a.alloc(@sizeof(FieldInit), 8);
    f.name = str::empty();
    f.value = null;
    f.spread = false;
    return f;
}

pub struct ArrayItem
{
    Expr* key;
    Expr* value;
    bool spread;
}

pub ArrayItem* newArrayItem(Arena* a)
{
    ArrayItem* it = (ArrayItem*)a.alloc(@sizeof(ArrayItem), 8);
    it.key = null;
    it.value = null;
    it.spread = false;
    return it;
}

