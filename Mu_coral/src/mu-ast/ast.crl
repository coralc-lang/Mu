pub enum DeclKind
{
    DcFn,
    DcStruct,
    DcVariant,
    DcTrait,
    DcExtend,
    DcConst,
    DcTypeAlias,
    DcUse
}

pub struct Decl
{
    DeclKind kind;
    Loc loc;
    str name;
    str text;
    str alias;
    str traitName;
    bool isPub;
    bool isAsync;
    bool isExtern;
    PtrList* attrs;
    PtrList* generics;
    PtrList* params;
    Type* ret;
    Stmt* body;
    PtrList* fields;
    PtrList* members;
    PtrList* cases;
    Type* target;
    Expr* value;
    PtrList* specs;
}

pub Decl* newDecl(Arena* a, DeclKind k, Loc loc)
{
    Decl* d = (Decl*)a.alloc(@sizeof(Decl), 8);
    d.kind = k;
    d.loc = loc;
    d.name = str::empty();
    d.text = str::empty();
    d.alias = str::empty();
    d.traitName = str::empty();
    d.isPub = false;
    d.isAsync = false;
    d.isExtern = false;
    d.attrs = null;
    d.generics = null;
    d.params = null;
    d.ret = null;
    d.body = null;
    d.fields = null;
    d.members = null;
    d.cases = null;
    d.target = null;
    d.value = null;
    d.specs = null;
    return d;
}

