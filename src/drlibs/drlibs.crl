// dr_libs engine port - vendored single headers from github.com/mackron/dr_libs
// (public domain / MIT-0): WAV, MP3 and FLAC whole-file decoders for the
// audio layer (M6, ENGINE.md §14). The raw externs are declared beside this
// file, one per upstream header (dr_wav.crl / dr_mp3.crl / dr_flac.crl),
// and imported here as though written in this file; implementations are
// compiled from native/mu_drlibs.c into libmualibs.a.
//
// Decoders return a malloc'd interleaved f32 PCM buffer, wrapped as an
// owned Pcm (see below): @drop runs the vendor-matching free when the
// Pcm goes out of scope. There used to be wavFree/mp3Free/flacFree
// helpers for this; they're gone, so nobody frees PCM by hand. Loaders
// return Option because the vendor has no error string - absence is the
// diagnostic, and the caller knows which file it asked for.

import dr_wav { drwav_open_memory_and_read_pcm_frames_f32, drwav_free };
import dr_mp3 { drmp3_config, drmp3_open_memory_and_read_pcm_frames_f32, drmp3_free };
import dr_flac { drflac_open_memory_and_read_pcm_frames_f32, drflac_free };
import(lib) std::data { option::Option };

// Short handles for the 41-character vendor opens. #[[inline]] marks them
// inlinable, so the call site compiles down to the extern itself (same
// trick as std's crypto helpers) - the null allocator-callback arg is
// baked in here once instead of at every call.
#[[inline]]
pub rawptr wavOpenF32(const rawptr data, usize len, u32* channels, u32* rate, u64* frames)
{
    return drwav_open_memory_and_read_pcm_frames_f32(data, len, channels, rate, frames, null);
}

#[[inline]]
pub rawptr mp3OpenF32(const rawptr data, usize len, drmp3_config* cfg, u64* frames)
{
    return drmp3_open_memory_and_read_pcm_frames_f32(data, len, cfg, frames, null);
}

#[[inline]]
pub rawptr flacOpenF32(const rawptr data, usize len, u32* channels, u32* rate, u64* frames)
{
    return drflac_open_memory_and_read_pcm_frames_f32(data, len, channels, rate, frames, null);
}

// Owned decode result: buffer, metadata, and the vendor free it pairs
// with. `release` is set by whichever loader built the struct
// (drwav_free / drmp3_free / drflac_free), so @drop can't get the
// pairing wrong.
pub struct Pcm
{
    rawptr data;
    u32 channels;
    u32 sampleRate;
    u64 frames;
    void(rawptr, rawptr) release;
}

pub extend Pcm : @drop
{
    void drop()
    {
        self.release(self.data, null);
    }
}

// --- engine wrappers: Option, since decode failure carries no message ---

//   Option<Pcm> clip = drlibs::loadWavF32(bytes, len).unwrap();
//   ... use clip.value.data ...
//   (clip goes out of scope at the end - buffer freed with it)
pub Option<Pcm> loadWavF32(const rawptr data, usize len)
{
    u32 channels = 0;
    u32 sampleRate = 0;
    u64 frames = 0;
    rawptr pcm = wavOpenF32(data, len, &channels, &sampleRate, &frames);
    if (pcm == null) return Option<Pcm>::None;
    
    return Option<Pcm>::Some {
        .value = Pcm {
            .data = pcm,
            .channels = channels,
            .sampleRate = sampleRate,
            .frames = frames,
            .release = drwav_free
        }
    };
}

pub Option<Pcm> loadMp3F32(const rawptr data, usize len)
{
    drmp3_config cfg = drmp3_config { .channels = 0, .sampleRate = 0 };
    u64 frames = 0;
    rawptr pcm = mp3OpenF32(data, len, &cfg, &frames);
    if (pcm == null) return Option<Pcm>::None;
    
    return Option<Pcm>::Some {
        .value = Pcm {
            .data = pcm,
            .channels = cfg.channels,
            .sampleRate = cfg.sampleRate,
            .frames = frames,
            .release = drmp3_free
        }
    };
}

pub Option<Pcm> loadFlacF32(const rawptr data, usize len)
{
    u32 channels = 0;
    u32 sampleRate = 0;
    u64 frames = 0;
    rawptr pcm = flacOpenF32(data, len, &channels, &sampleRate, &frames);
    if (pcm == null) return Option<Pcm>::None;
    
    return Option<Pcm>::Some {
        .value = Pcm {
            .data = pcm,
            .channels = channels,
            .sampleRate = sampleRate,
            .frames = frames,
            .release = drflac_free
        }
    };
}
