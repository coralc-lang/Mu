// The default native set (ENGINE.md §11).

use scene::scene { Scene, EntityId, NIL };
use platform::platform { platformRequestQuit };
use render::render { Framebuffer, paint, present };
use physics::sim { Simulation, step };

use script::native { Native, NativeRegistry };
use script::loader { ScriptHost };

// Engine state the default natives read. Plain fn pointers cross the
// boundary, no closures (§5), so context lives host-side.
static Scene* MuNativeScene;
static u64* MuNativeFrame;
static Framebuffer* MuNativeFramebuffer;
static Simulation* MuNativeSimulation;

static void _nativeLog(str msg)
{
    println("[mu:script] {}", msg);
}

static void _nativeLogError(str msg)
{
    println("[mu:script:error] {}", msg);
}

static u64 _nativeFrame()
{
    if (MuNativeFrame == null) return 0;
    return MuNativeFrame[0];
}

static u64 _nativeNow()
{
    if (MuNativeFrame == null) return 0;
    return (MuNativeFrame[0] * 1000) / 60;
}

static EntityId _nativeSpawn()
{
    if (MuNativeScene == null) return NIL;
    Option<EntityId> id = MuNativeScene->create();
    switch (id)
    {
        Some { value } => { return value; },
        else => { return NIL; }
    }
}

static bool _nativeDespawn(EntityId id)
{
    if (MuNativeScene == null) return false;
    bool was = MuNativeScene->alive(id);
    MuNativeScene->destroy(id);
    return was;
}

static bool _nativeSetParent(EntityId child, EntityId parent)
{
    if (MuNativeScene == null) return false;
    Result<u32, str> r = MuNativeScene->setParent(child, parent);
    if (r.isOk()) return true;
    println("[mu:script] setParent rejected: {}", r.unwrapErr());
    return false;
}

static u64 _nativeSceneFrame()
{
    if (MuNativeScene == null) return 0;
    return (u64)MuNativeScene->count;
}

static void _nativePaint(i32 x, i32 y, i32 w, i32 h, u32 color)
{
    paint(MuNativeFramebuffer, x, y, w, h, color);
}

static void _nativeRenderDraw()
{
    present(MuNativeFramebuffer);
}

static u64 _nativePhysicsStep(f32 dt)
{
    if (MuNativeSimulation == null) return 0;
    return (u64)step(MuNativeSimulation, dt);
}

static void _nativeQuit()
{
    platformRequestQuit();
}

pub Result<u32, str> registerDefaultNatives(NativeRegistry* natives, Scene* scene,
    u64* frameCount, Framebuffer* framebuffer, Simulation* simulation)
{
    MuNativeScene = scene;
    MuNativeFrame = frameCount;
    MuNativeFramebuffer = framebuffer;
    MuNativeSimulation = simulation;

    natives->add("Mu::log::info", Native::StrFn { .f = _nativeLog }).unwrap();
    natives->add("Mu::log::error", Native::StrFn { .f = _nativeLogError }).unwrap();
    natives->add("Mu::timing::frame", Native::CountFn { .f = _nativeFrame }).unwrap();
    natives->add("Mu::timing::now", Native::CountFn { .f = _nativeNow }).unwrap();
    natives->add("Mu::scene::spawn", Native::IdFn { .f = _nativeSpawn }).unwrap();
    natives->add("Mu::scene::despawn", Native::IdPredFn { .f = _nativeDespawn }).unwrap();
    natives->add("Mu::scene::setParent", Native::IdPairFn { .f = _nativeSetParent }).unwrap();
    natives->add("Mu::scene::frame", Native::CountFn { .f = _nativeSceneFrame }).unwrap();
    natives->add("Mu::render", Native::Module).unwrap();
    natives->add("Mu::render::paint", Native::PaintFn { .f = _nativePaint }).unwrap();
    natives->add("Mu::render::draw", Native::UnitFn { .f = _nativeRenderDraw }).unwrap();
    natives->add("Mu::physics::step", Native::DeltaFn { .f = _nativePhysicsStep }).unwrap();
    natives->add("Mu::platform::quit", Native::UnitFn { .f = _nativeQuit }).unwrap();
    return Result<u32, str>::Ok { .value = natives->count };
}

// The Loop ticks this through a fn ptr (§6 order): core never uses script.
pub void scriptSystem(rawptr ctx, f32 dt)
{
    ScriptHost* host = (ScriptHost*)ctx;
    host->update(dt);
}
