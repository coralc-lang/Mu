// Script host lifecycle. This is the compiler seam, not a parser:
// muc compiles .mu ahead of time and hands the host IR plus compiler-emitted
// symbol hashes. Runtime source scanning, `use` expansion, and type parsing
// are compiler work and intentionally absent here.
//
// M2 replaces load() with IR ingestion and update() with WallVM execution.
// The binding table is available now so natives can be resolved by hash.

use script::abi { Binding, BindingTable, Native };

pub struct ScriptHost
{
    BindingTable* bindings;
    str path;
    bool loaded;
    u64 updateCalls;      // diagnostics: frames ticked (survives free)

    static ScriptHost new(BindingTable* bindings)
    {
        return ScriptHost {
            .bindings = bindings,
            .path = "",
            .loaded = false,
            .updateCalls = 0
        };
    }

    // Resolve a compiler-emitted hash. `path` is only for the diagnostic.
    Result<Binding*, str> requireHash(u64 hash, str path)
    {
        Binding* binding = self.bindings->lookup(hash);
        if (binding == null)
        {
            println("[mu:error] unresolved binding: {}", path);
            return Result<Binding*, str>::Err { .error = "binding: not found" };
        }
        return Result<Binding*, str>::Ok { .value = binding };
    }

    Result<Native, str> requireFunction(u64 hash, str path)
    {
        Binding* binding = self.bindings->lookup(hash);
        if (binding == null)
        {
            println("[mu:error] unresolved function binding: {}", path);
            return Result<Native, str>::Err { .error = "binding: function not found" };
        }
        switch (binding[0])
        {
            Function { native } => {
                return Result<Native, str>::Ok { .value = native };
            },
            else => {
                println("[mu:error] binding is not a function: {}", path);
                return Result<Native, str>::Err { .error = "binding: not a function" };
            }
        }
        return Result<Native, str>::Err { .error = "binding: not a function" };
    }

    // Compiler/IR hook: the host records the module; nothing is parsed here.
    Result<u32, str> load(str path)
    {
        self.path = path;
        self.loaded = true;
        return Result<u32, str>::Ok { .value = 0 };
    }

    // §6 slot: engine/main ticks this between scene.update and draw.
    void update(f32 dt)
    {
        if (!self.loaded) return;
        self.updateCalls = self.updateCalls + 1;
    }

    void free()
    {
        self.loaded = false;
        self.path = "";
    }
}

// Loop slot: tick the host without making core depend on script.
pub void scriptSystem(rawptr ctx, f32 dt)
{
    ScriptHost* host = (ScriptHost*)ctx;
    host->update(dt);
}
