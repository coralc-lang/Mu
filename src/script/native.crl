// Native registry: Mu:: path hash -> function pointer.
// Paths are hashed once at registration (FNV-1a); lookups probe an
// open-addressed table by hash only. Names are stored for diagnostics and
// duplicate/collision reporting, never touched on the dispatch path.

import std::hash { fnv1aStr };

use scene::scene { EntityId };

// Shared symbol hashing for native paths, Mu function names, and types.
pub u64 hashSymbol(str name)
{
    return fnv1aStr(name);
}

// One arm per *signature*, not per native.
pub variant Native
{
    Module,                                     // module marker for `use Mu::render;`
    UnitFn { void() f; }                        // fn()
    StrFn { void(str) f; }                      // fn(str)
    CountFn { u64() f; }                        // fn() -> u64
    IdFn { EntityId() f; }                      // fn() -> EntityId (NIL when full)
    IdPredFn { bool(EntityId) f; }              // fn(EntityId) -> bool
    IdPairFn { bool(EntityId, EntityId) f; }    // fn(EntityId, EntityId) -> bool
    PaintFn { void(i32, i32, i32, i32, u32) f; }// fn(x, y, w, h, rgba)
    DeltaFn { u64(f32) f; }                     // fn(dt) -> count
}

pub struct NativeEntry
{
    u64 hash;        // FNV-1a of the Mu:: path
    str name;        // diagnostics only
    Native native;
    bool used;       // open-addressed bucket occupancy
}

pub struct NativeRegistry
{
    NativeEntry* entries;   // caller-provided storage (static, §10)
    u32 capacity;
    u32 count;

    static NativeRegistry new(NativeEntry* entries, u32 capacity)
    {
        NativeRegistry registry = NativeRegistry {
            .entries = entries,
            .capacity = capacity,
            .count = 0
        };
        for (u32 i = 0; i < capacity; i++)
        {
            registry.entries[i].hash = 0;
            registry.entries[i].name = "";
            registry.entries[i].used = false;
        }
        return registry;
    }

    u64 hashOf(str name)
    {
        return hashSymbol(name);
    }

    u32 _slot(u64 hash)
    {
        return (u32)(hash % (u64)self.capacity);
    }

    Native* lookupHash(u64 hash)
    {
        if (self.capacity == 0) return null;
        u32 index = self._slot(hash);
        u32 probes = 0;
        while (probes < self.capacity)
        {
            if (!self.entries[index].used) return null;
            if (self.entries[index].hash == hash)
                return &self.entries[index].native;
            index = index + 1;
            if (index >= self.capacity) index = 0;
            probes = probes + 1;
        }
        return null;
    }

    Native* lookup(str name)
    {
        return self.lookupHash(self.hashOf(name));
    }

    Option<Native> resolveHash(u64 hash)
    {
        Native* native = self.lookupHash(hash);
        if (native == null) return Option<Native>::None;
        return Option<Native>::Some { .value = native[0] };
    }

    Option<Native> resolve(str name)
    {
        return self.resolveHash(self.hashOf(name));
    }

    // Ok: entry count after insertion. Err distinguishes duplicate/collision
    // (same hash) from a full table; only this path ever looks at names.
    Result<u32, str> add(str name, Native native)
    {
        if (self.capacity == 0)
            return Result<u32, str>::Err { .error = "native registry: no storage" };
        if (self.count >= self.capacity)
            return Result<u32, str>::Err { .error = "native registry: table full" };

        u64 hash = self.hashOf(name);
        u32 index = self._slot(hash);
        while (self.entries[index].used)
        {
            if (self.entries[index].hash == hash)
            {
                if (_strEq(self.entries[index].name, name))
                    return Result<u32, str>::Err { .error = "native registry: duplicate name" };
                return Result<u32, str>::Err { .error = "native registry: hash collision" };
            }
            index = index + 1;
            if (index >= self.capacity) index = 0;
        }

        self.entries[index].hash = hash;
        self.entries[index].name = name;
        self.entries[index].native = native;
        self.entries[index].used = true;
        self.count = self.count + 1;
        return Result<u32, str>::Ok { .value = self.count };
    }
}

static bool _strEq(str a, str b)
{
    if (a.len != b.len) return false;
    for (usize i = 0; i < a.len; i++)
    {
        if (a.ptr[i] != b.ptr[i]) return false;
    }
    return true;
}
