// tracy extern port - vendored from github.com/wolfpld/tracy v0.14.1
// (BSD-3-Clause): frame marks, plots and scoped zones for the engine
// profiler. TracyClient.cpp is compiled into libmualibs.a with
// TRACY_ENABLE (native/CMakeLists.txt), so these symbols always link;
// data only flows while a Tracy capture tool listens (localhost:8086),
// and an idle engine pays no meaningful cost.
//
// ABI notes: TracyCZoneCtx is `const void*` - pass rawptr. The zone
// source-location buffer mirrors ___tracy_source_location_data, 32 bytes
// on LP64: [cchar* name][cchar* function][cchar* file][u32 line][u32 color]
// - name may be null (function is used then), line is informational,
// color is 0xRRGGBB or 0. Keep the strings alive for the whole capture
// (static or interned literals). zone_begin returns the context that
// zone_end must receive; zones nest per-thread like Tracy's C macros.
// Callstack variants and dynamic source locations stay unported for now.

pub extern rawptr ___tracy_emit_zone_begin(rawptr srcloc, i32 active);
pub extern void ___tracy_emit_zone_end(rawptr ctx);
pub extern void ___tracy_emit_frame_mark(cchar* name);
pub extern void ___tracy_emit_frame_mark_start(cchar* name);
pub extern void ___tracy_emit_frame_mark_end(cchar* name);
pub extern void ___tracy_emit_plot(cchar* name, f64 val);
pub extern void ___tracy_emit_plot_float(cchar* name, f32 val);
pub extern void ___tracy_emit_plot_int(cchar* name, i64 val);
