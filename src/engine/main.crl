/* Mu Engine entry point: build the subsystems once, hand them to Loop, and
 * run until something asks to quit. Gameplay and demos belong outside this
 *  file; main only owns process lifetime and backend selection.
 */

use core::core { Loop, logInfo, logError };
use math::math { Vec3 };
use physics::world { BodyRecord, PhysicsWorld, physicsWorld, physicsSystem, start, stop };
use platform::platform {
    platformInit, platformShutdown, platformSdlWindow,
    platformNativeWindow, platformNativeDisplay, platformNativeType,
    platformBackendName, platformWidth, platformHeight
};
use render::render { Renderer, nullRenderer };
use render::sdl { sdlStart, sdlRenderer };
use render::bgfx {
    bgfxStart, bgfxRenderer, bgfxRendererType, bgfxRendererName,
    bgfxRendererTypeFromName
};
use bgfx::types { BGFX_RENDERER_TYPE_COUNT };
use scene::scene { Scene, Entity };
use script::abi { BindingEntry, BindingTable };
use script::loader { ScriptHost, scriptSystem };
use script::bindings { ScriptBinding, ScriptBindings };
import std::env { get };
import std::string { String };

static Entity[4096] MuSceneStorage;
static Scene MuScene;
static Renderer MuRenderer;
static Loop MuLoop;
static BindingEntry[128] MuBindingEntries;
static BindingTable MuBindings;
static ScriptHost MuHost;
static ScriptBinding[64] MuBindingSlots;
static ScriptBindings MuScripts;
static BodyRecord[4096] MuPhysicsBodies;
static PhysicsWorld MuPhysics;

/// Boots the engine and returns a process exit code. GUI runs choose bgfx
/// first and fall back to the SDL presenter.
pub i32 main()
{
    logInfo("engine starting");
    logInfo("engine: initializing subsystems");
    MuScene = Scene::new(MuSceneStorage, 4096);
    println("[mu] scene: capacity={} entities={}", MuScene.capacity, MuScene.count);

    MuBindings = BindingTable::new(MuBindingEntries, 128);
    MuHost = ScriptHost::new(&MuBindings);
    MuScripts = ScriptBindings::new(&MuScene, MuBindingSlots, 64);
    println("[mu] script: bindings={} bindingCapacity={} slots={}",
        MuScripts.count, MuBindings.capacity, MuScripts.capacity);

    MuPhysics = physicsWorld(MuPhysicsBodies, 4096);
    if (!start(&MuPhysics, &MuScene, Vec3::new(0.0f, -9.81f, 0.0f)))
        logError("physics: Jolt start failed");
    else
    {
        logInfo("physics: Jolt world started");
        println("[mu] physics: body capacity={} active={}",
            MuPhysics.capacity, MuPhysics.count);
    }

    bool forceSdl = get("MU_SDL_RENDERER").isSome();

    // MU_BGFX_RENDERER: auto, vulkan, opengl, gles, d3d11, d3d12, metal,
    // webgpu, or noop. MU_BGFX_FALLBACK=0 makes the request strict. Add new
    // window backends in platform/window.crl; bgfx uses native type 0 there
    // except Wayland, which needs type 1.
    i32 requestedRenderer = BGFX_RENDERER_TYPE_COUNT;
    Option<String> rendererEnv = get("MU_BGFX_RENDERER");
    if (rendererEnv.isSome())
    {
        String rendererName = rendererEnv.unwrap();
        requestedRenderer = bgfxRendererTypeFromName(rendererName.asView());
        if (requestedRenderer < 0)
        {
            logError("renderer: unknown MU_BGFX_RENDERER; using auto");
            requestedRenderer = BGFX_RENDERER_TYPE_COUNT;
        }
    }

    i32 bgfxFallback = 1;
    Option<String> fallbackEnv = get("MU_BGFX_FALLBACK");
    if (fallbackEnv.isSome())
    {
        String fallbackName = fallbackEnv.unwrap();
        if (fallbackName.equalsView("0") || fallbackName.equalsView("false")
            || fallbackName.equalsView("off"))
            bgfxFallback = 0;
    }

    MuRenderer = nullRenderer();

    if (platformInit()) {
        // bgfx is the real renderer. The SDL path stays around as a cheap
        // bring-up fallback for machines where bgfx cannot create a device.
        bool rendererReady = false;
        if (!forceSdl)
        {
            if (bgfxStart(
                platformWidth(), platformHeight(),
                platformNativeWindow(), platformNativeDisplay(),
                platformNativeType(), requestedRenderer, bgfxFallback))
            {
                MuRenderer = bgfxRenderer();
                i32 rendererType = bgfxRendererType();
                println("[mu] renderer: bgfx ({}) type {} platform={} requested={} fallback={}",
                    bgfxRendererName(rendererType), rendererType,
                    platformBackendName(), requestedRenderer, bgfxFallback);
                rendererReady = true;
            }
            else
            {
                logError("renderer: bgfx init failed; trying SDL fallback");
            }
        }
        if (!rendererReady)
        {
            if (sdlStart(platformSdlWindow()))
            {
                MuRenderer = sdlRenderer();
                println("[mu] renderer: SDL3 window presentation");
                rendererReady = true;
            }
            else
            {
                logError("renderer: SDL renderer init failed");
            }
        }
        if (!rendererReady) logInfo("renderer: null");
    }
    else
    {
        logInfo("platform: no window; running headless");
        logInfo("renderer: null");
    }

    MuLoop = Loop::new(
        &MuScene, &MuRenderer, (rawptr)&MuPhysics, physicsSystem);
    MuLoop.scriptCtx = (rawptr)&MuHost;
    MuLoop.scriptUpdate = scriptSystem;

    println("[mu] loop: dt={} hz={}", MuLoop.dt, 60);
    logInfo("engine running");
    MuLoop.runUntilQuit();

    println("[mu] engine: run summary frames={} ticks={} entities={} bodies={}",
        MuLoop.frameCount, MuLoop.simTicks, MuScene.count, MuPhysics.count);
    logInfo("engine: shutting down");
    stop(&MuPhysics);
    MuHost.free();
    println("[mu] engine: script host released");
    MuRenderer.shutdown(MuRenderer.ctx);
    platformShutdown();
    logInfo("engine stopped");
    return 0;
}
