use platform::window {
    PlatformWindow, platformWindowCreate, platformWindowDestroy,
    platformWindowNativeHandle, platformWindowNativeDisplay,
    platformWindowNativeType, platformWindowWidth, platformWindowHeight,
    PLATFORM_DEFAULT_WIDTH, PLATFORM_DEFAULT_HEIGHT
};

use platform::input { InputState, inputPump };

static bool MuQuitRequested = false;
static PlatformWindow MuWindow;
static InputState MuInput;

pub bool platformInit()
{
    if (MuWindow.ready) return true;
    MuWindow = platformWindowCreate(C"Mu", PLATFORM_DEFAULT_WIDTH, PLATFORM_DEFAULT_HEIGHT);
    return MuWindow.ready;
}

pub void platformShutdown()
{
    if (MuWindow.ready) println("[mu] platform: shutdown");
    platformWindowDestroy(&MuWindow);
}

pub void platformPump()
{
    if (!MuWindow.ready) return;
    inputPump(&MuInput);
    if (MuInput.quit && !MuQuitRequested)
        println("[mu] platform: quit detected");
    if (MuInput.quit) MuQuitRequested = true;
}

pub void platformRequestQuit()
{
    if (!MuQuitRequested) println("[mu] platform: quit requested");
    MuQuitRequested = true;
}

pub bool platformQuitRequested()
{
    return MuQuitRequested;
}

pub InputState* platformInput()
{
    return &MuInput;
}

pub bool platformReady()
{
    return MuWindow.ready;
}

pub rawptr platformSdlWindow()
{
    return (rawptr)MuWindow.handle;
}

pub rawptr platformNativeWindow()
{
    return platformWindowNativeHandle(&MuWindow);
}

pub rawptr platformNativeDisplay()
{
    return platformWindowNativeDisplay(&MuWindow);
}

pub i32 platformNativeType()
{
    return platformWindowNativeType(&MuWindow);
}

pub i32 platformWidth()
{
    return platformWindowWidth(&MuWindow);
}

pub i32 platformHeight()
{
    return platformWindowHeight(&MuWindow);
}
