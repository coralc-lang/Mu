/* bgfx backend. Device creation, the main view, and swap-chain reset live
   here. The ABI is tied to the packaged libbgfx.a, whose init struct is older
   than upstream master; see thirdparty/bgfx/types.crl before touching fields. */

use bgfx::types {
    bgfx_init_t, bgfx_swap_chain_t, bgfx_renderer_type_t,
    bgfx_callback_t, bgfx_callback_vtbl_t,
    BGFX_RENDERER_TYPE_NOOP, BGFX_RENDERER_TYPE_DIRECT3D11,
    BGFX_RENDERER_TYPE_DIRECT3D12, BGFX_RENDERER_TYPE_METAL,
    BGFX_RENDERER_TYPE_OPENGLES, BGFX_RENDERER_TYPE_OPENGL,
    BGFX_RENDERER_TYPE_VULKAN, BGFX_RENDERER_TYPE_WEBGPU,
    BGFX_RENDERER_TYPE_COUNT, BGFX_RESET_VSYNC, BGFX_CLEAR_COLOR,
    BGFX_CLEAR_DEPTH
};
use bgfx::init {
    bgfx_init_ctor, bgfx_init, bgfx_reset, bgfx_shutdown, bgfx_frame,
    bgfx_get_renderer_type, bgfx_get_renderer_name
};
use bgfx::views {
    bgfx_set_view_name, bgfx_set_view_rect, bgfx_set_view_clear, bgfx_touch
};
use render::render { Renderer, customRenderer };

static bool MuBgfxReady = false;
static bgfx_swap_chain_t MuBgfxSwapChain;
static bgfx_callback_t MuBgfxCallback;
static bgfx_callback_vtbl_t MuBgfxCallbackVtbl;

void _bgfxFatal(rawptr userData, const cchar* filePath, u16 line,
    i32 code, const cchar* message)
{
    println("[mu:error] bgfx fatal {}:{} code={} {}",
        filePath, line, code, message);
}

void _bgfxTrace(rawptr userData, const cchar* filePath, u16 line,
    const cchar* format, rawptr args)
{
    println("[mu] bgfx trace {}:{} {}", filePath, line, format);
}

void _bgfxProfilerBegin(rawptr userData, const cchar* name, u32 abgr,
    const cchar* filePath, u16 line)
{
}

void _bgfxProfilerBeginLiteral(rawptr userData, const cchar* name, u32 abgr,
    const cchar* filePath, u16 line)
{
}

void _bgfxProfilerEnd(rawptr userData)
{
}

u32 _bgfxCacheReadSize(rawptr userData, u64 id)
{
    return 0;
}

u32 _bgfxCacheRead(rawptr userData, u64 id, rawptr data, u32 size)
{
    return 0;
}

void _bgfxCacheWrite(rawptr userData, u64 id, rawptr data, u32 size)
{
}

void _bgfxScreenShot(rawptr userData, const cchar* filePath, u32 width,
    u32 height, u32 pitch, i32 format, rawptr data, u32 size, u8 flipV)
{
}

void _bgfxCaptureBegin(rawptr userData, u32 width, u32 height, u32 pitch,
    i32 format, u8 flipV)
{
}

void _bgfxCaptureEnd(rawptr userData)
{
}

void _bgfxCaptureFrame(rawptr userData, rawptr data, u32 size)
{
}

void _bgfxCallbackInit()
{
    MuBgfxCallbackVtbl.fatal = _bgfxFatal;
    MuBgfxCallbackVtbl.traceVargs = _bgfxTrace;
    MuBgfxCallbackVtbl.profilerBegin = _bgfxProfilerBegin;
    MuBgfxCallbackVtbl.profilerBeginLiteral = _bgfxProfilerBeginLiteral;
    MuBgfxCallbackVtbl.profilerEnd = _bgfxProfilerEnd;
    MuBgfxCallbackVtbl.cacheReadSize = _bgfxCacheReadSize;
    MuBgfxCallbackVtbl.cacheRead = _bgfxCacheRead;
    MuBgfxCallbackVtbl.cacheWrite = _bgfxCacheWrite;
    MuBgfxCallbackVtbl.screenShot = _bgfxScreenShot;
    MuBgfxCallbackVtbl.captureBegin = _bgfxCaptureBegin;
    MuBgfxCallbackVtbl.captureEnd = _bgfxCaptureEnd;
    MuBgfxCallbackVtbl.captureFrame = _bgfxCaptureFrame;
    MuBgfxCallback.vtbl = &MuBgfxCallbackVtbl;
}

/// Maps `MU_BGFX_RENDERER` names to bgfx renderer types; -1 means unknown.
pub i32 bgfxRendererTypeFromName(str name)
{
    if (name.equals("auto")) return BGFX_RENDERER_TYPE_COUNT;
    if (name.equals("noop")) return BGFX_RENDERER_TYPE_NOOP;
    if (name.equals("d3d11")) return BGFX_RENDERER_TYPE_DIRECT3D11;
    if (name.equals("d3d12")) return BGFX_RENDERER_TYPE_DIRECT3D12;
    if (name.equals("metal")) return BGFX_RENDERER_TYPE_METAL;
    if (name.equals("gles")) return BGFX_RENDERER_TYPE_OPENGLES;
    if (name.equals("opengles")) return BGFX_RENDERER_TYPE_OPENGLES;
    if (name.equals("opengl")) return BGFX_RENDERER_TYPE_OPENGL;
    if (name.equals("vulkan")) return BGFX_RENDERER_TYPE_VULKAN;
    if (name.equals("webgpu")) return BGFX_RENDERER_TYPE_WEBGPU;
    return -1;
}

/// Creates the bgfx device and its first swap chain. `nativeType` is bgfx's
/// platform handle enum (0 default, 1 Wayland); width/height are pixels.
pub bool bgfxStart(i32 width, i32 height, rawptr nativeWindow,
    rawptr nativeDisplay, i32 nativeType, i32 rendererType, i32 fallback)
{
    if (MuBgfxReady) return true;
    if (width <= 0 || height <= 0)
    {
        println("[mu:error] renderer: invalid framebuffer size {}x{}", width, height);
        return false;
    }

    println("[mu] renderer: bgfx init request={}x{} nativeType={} rendererType={} fallback={} vsync=1",
        width, height, nativeType, rendererType, fallback);

    bgfx_init_t init;
    bgfx_init_ctor(&init);
    _bgfxCallbackInit();
    init.callback = (rawptr)&MuBgfxCallback;
    init.type = rendererType;
    init.fallback = (u8)fallback;
    init.platformData.type = nativeType;
    init.swapChain.nwh = nativeWindow;
    init.swapChain.ndt = nativeDisplay;
    init.swapChain.width = (u32)width;
    init.swapChain.height = (u32)height;
    init.reset = BGFX_RESET_VSYNC;

    // Keep a copy: bgfx_reset needs the same native handles and formats when
    // the window changes size.
    MuBgfxSwapChain = init.swapChain;

    if (bgfx_init(&init) == 0)
    {
        println("[mu:error] renderer: bgfx init failed");
        return false;
    }

    MuBgfxReady = true;
    println("[mu] renderer: bgfx initialized type={}", bgfx_get_renderer_type());
    bgfx_set_view_name(0, C"main", 4);
    bgfx_set_view_rect(0, 0, 0, (u16)width, (u16)height);
    bgfx_set_view_clear(
        0, BGFX_CLEAR_COLOR | BGFX_CLEAR_DEPTH, 0x20242cff, 1.0f, 0);
    bgfx_touch(0);
    bgfx_frame(0);
    println("[mu] renderer: view 0 configured; first frame submitted");
    return true;
}

/// Releases the bgfx device. Safe to call when init never succeeded.
pub void bgfxShutdown()
{
    if (!MuBgfxReady) return;
    println("[mu] renderer: bgfx shutdown");
    bgfx_shutdown();
    MuBgfxReady = false;
}

void _bgfxDraw(rawptr ctx, rawptr scene, rawptr ui)
{
    bgfx_touch(0);
    bgfx_frame(0);
}

void _bgfxResize(rawptr ctx, i32 width, i32 height)
{
    if (!MuBgfxReady || width <= 0 || height <= 0) return;

    MuBgfxSwapChain.width = (u32)width;
    MuBgfxSwapChain.height = (u32)height;
    bgfx_set_view_rect(0, 0, 0, (u16)width, (u16)height);
    bgfx_reset(BGFX_RESET_VSYNC, (rawptr)&MuBgfxSwapChain);
    println("[mu] renderer: bgfx resize={}x{}", width, height);
}

void _bgfxRendererShutdown(rawptr ctx)
{
    bgfxShutdown();
}

/// Returns the bgfx backend behind the engine's Renderer interface.
pub Renderer bgfxRenderer()
{
    return customRenderer(null, _bgfxDraw, _bgfxResize, _bgfxRendererShutdown);
}

/// The concrete backend bgfx picked (Vulkan, D3D11, Metal, ...).
pub bgfx_renderer_type_t bgfxRendererType()
{
    return bgfx_get_renderer_type();
}

/// Human-readable backend name for logs.
pub const cchar* bgfxRendererName(bgfx_renderer_type_t type)
{
    return bgfx_get_renderer_name(type);
}
