/* Render resource manager: explicit mesh, material, texture, shader, and
   program handles with ownership, lifetime tracking, slot reuse, and safe
   bgfx cleanup. */

use math::math { Vec4 };
use render::bgfx { bgfxIsReady };
use bgfx::types {
    bgfx_vertex_buffer_handle_t, bgfx_index_buffer_handle_t,
    bgfx_texture_handle_t, bgfx_shader_handle_t, bgfx_program_handle_t,
    BGFX_INVALID_HANDLE
};
use bgfx::resources {
    bgfx_destroy_vertex_buffer, bgfx_destroy_index_buffer,
    bgfx_destroy_texture, bgfx_destroy_shader, bgfx_destroy_program
};

/// Opaque typed handles. Upper 16 bits encode generation; lower 16 bits encode slot index.
pub typedef MeshHandle = u32;
pub typedef MaterialHandle = u32;
pub typedef TextureHandle = u32;
pub typedef ShaderHandle = u32;
pub typedef ProgramHandle = u32;

pub const MeshHandle INVALID_MESH = 0xFFFFFFFF;
pub const MaterialHandle INVALID_MATERIAL = 0xFFFFFFFF;
pub const TextureHandle INVALID_TEXTURE = 0xFFFFFFFF;
pub const ShaderHandle INVALID_SHADER = 0xFFFFFFFF;
pub const ProgramHandle INVALID_PROGRAM = 0xFFFFFFFF;

pub const u32 HANDLE_INDEX_MASK = 0x0000FFFF;
pub const u32 HANDLE_GEN_SHIFT = 16;

pub const i32 SHADER_STAGE_VERTEX = 0;
pub const i32 SHADER_STAGE_FRAGMENT = 1;
pub const i32 SHADER_STAGE_COMPUTE = 2;

u32 _handleIndex(u32 handle)
{
    return handle & HANDLE_INDEX_MASK;
}

u32 _handleGen(u32 handle)
{
    return (handle >> HANDLE_GEN_SHIFT) & HANDLE_INDEX_MASK;
}

u32 _makeHandle(u32 index, u32 gen)
{
    return (gen << HANDLE_GEN_SHIFT) | (index & HANDLE_INDEX_MASK);
}

pub struct MeshRecord
{
    MeshHandle handle;
    bgfx_vertex_buffer_handle_t vbh;
    bgfx_index_buffer_handle_t ibh;
    u32 vertexCount;
    u32 indexCount;
    u16 gen;
    bool hasIndices;
    bool alive;
}

pub struct TextureRecord
{
    TextureHandle handle;
    bgfx_texture_handle_t bgfxHandle;
    u16 width;
    u16 height;
    i32 format;
    u64 flags;
    u16 gen;
    bool alive;
}

pub struct ShaderRecord
{
    ShaderHandle handle;
    bgfx_shader_handle_t bgfxHandle;
    i32 stage;
    u16 gen;
    bool alive;
}

pub struct ProgramRecord
{
    ProgramHandle handle;
    bgfx_program_handle_t bgfxHandle;
    ShaderHandle vsh;
    ShaderHandle fsh;
    u16 gen;
    bool alive;
}

pub struct MaterialRecord
{
    MaterialHandle handle;
    ProgramHandle program;
    TextureHandle baseColorTexture;
    TextureHandle normalTexture;
    TextureHandle metallicRoughnessTexture;
    Vec4 baseColorFactor;
    f32 metallicFactor;
    f32 roughnessFactor;
    u64 stateFlags;
    u16 gen;
    bool alive;
}

/// Owns tables of render resources with slot recycling and generation checks.
pub struct RenderResources
{
    MeshRecord* meshes;
    u32 meshCapacity;
    u32 meshCount;

    MaterialRecord* materials;
    u32 materialCapacity;
    u32 materialCount;

    TextureRecord* textures;
    u32 textureCapacity;
    u32 textureCount;

    ShaderRecord* shaders;
    u32 shaderCapacity;
    u32 shaderCount;

    ProgramRecord* programs;
    u32 programCapacity;
    u32 programCount;

    static RenderResources new(
        MeshRecord* meshes, u32 meshCapacity,
        MaterialRecord* materials, u32 materialCapacity,
        TextureRecord* textures, u32 textureCapacity,
        ShaderRecord* shaders, u32 shaderCapacity,
        ProgramRecord* programs, u32 programCapacity)
    {
        RenderResources res = {
            .meshes = meshes,
            .meshCapacity = meshCapacity,
            .meshCount = 0,
            .materials = materials,
            .materialCapacity = materialCapacity,
            .materialCount = 0,
            .textures = textures,
            .textureCapacity = textureCapacity,
            .textureCount = 0,
            .shaders = shaders,
            .shaderCapacity = shaderCapacity,
            .shaderCount = 0,
            .programs = programs,
            .programCapacity = programCapacity,
            .programCount = 0
        };

        if (meshes != null)
        {
            for (u32 i = 0; i < meshCapacity; i++)
            {
                meshes[i].handle = INVALID_MESH;
                meshes[i].vbh = BGFX_INVALID_HANDLE;
                meshes[i].ibh = BGFX_INVALID_HANDLE;
                meshes[i].vertexCount = 0;
                meshes[i].indexCount = 0;
                meshes[i].gen = 1;
                meshes[i].hasIndices = false;
                meshes[i].alive = false;
            }
        }

        if (materials != null)
        {
            for (u32 i = 0; i < materialCapacity; i++)
            {
                materials[i].handle = INVALID_MATERIAL;
                materials[i].program = INVALID_PROGRAM;
                materials[i].baseColorTexture = INVALID_TEXTURE;
                materials[i].normalTexture = INVALID_TEXTURE;
                materials[i].metallicRoughnessTexture = INVALID_TEXTURE;
                materials[i].baseColorFactor = Vec4::new(1.0f, 1.0f, 1.0f, 1.0f);
                materials[i].metallicFactor = 0.0f;
                materials[i].roughnessFactor = 1.0f;
                materials[i].stateFlags = 0;
                materials[i].gen = 1;
                materials[i].alive = false;
            }
        }

        if (textures != null)
        {
            for (u32 i = 0; i < textureCapacity; i++)
            {
                textures[i].handle = INVALID_TEXTURE;
                textures[i].bgfxHandle = BGFX_INVALID_HANDLE;
                textures[i].width = 0;
                textures[i].height = 0;
                textures[i].format = 0;
                textures[i].flags = 0;
                textures[i].gen = 1;
                textures[i].alive = false;
            }
        }

        if (shaders != null)
        {
            for (u32 i = 0; i < shaderCapacity; i++)
            {
                shaders[i].handle = INVALID_SHADER;
                shaders[i].bgfxHandle = BGFX_INVALID_HANDLE;
                shaders[i].stage = SHADER_STAGE_VERTEX;
                shaders[i].gen = 1;
                shaders[i].alive = false;
            }
        }

        if (programs != null)
        {
            for (u32 i = 0; i < programCapacity; i++)
            {
                programs[i].handle = INVALID_PROGRAM;
                programs[i].bgfxHandle = BGFX_INVALID_HANDLE;
                programs[i].vsh = INVALID_SHADER;
                programs[i].fsh = INVALID_SHADER;
                programs[i].gen = 1;
                programs[i].alive = false;
            }
        }

        return res;
    }

    // --- Mesh management ---

    MeshHandle createMesh(
        bgfx_vertex_buffer_handle_t vbh, bgfx_index_buffer_handle_t ibh,
        u32 vertexCount, u32 indexCount, bool hasIndices)
    {
        if (self.meshes == null) return INVALID_MESH;
        i32 slot = -1;
        for (u32 i = 0; i < self.meshCapacity; i++)
        {
            if (!self.meshes[i].alive)
            {
                slot = (i32)i;
                break;
            }
        }
        if (slot < 0) return INVALID_MESH;

        u32 uSlot = (u32)slot;
        u16 curGen = self.meshes[uSlot].gen;
        if (curGen == (u16)0) curGen = 1;
        MeshHandle handle = _makeHandle(uSlot, (u32)curGen);

        self.meshes[uSlot].handle = handle;
        self.meshes[uSlot].vbh = vbh;
        self.meshes[uSlot].ibh = ibh;
        self.meshes[uSlot].vertexCount = vertexCount;
        self.meshes[uSlot].indexCount = indexCount;
        self.meshes[uSlot].hasIndices = hasIndices;
        self.meshes[uSlot].alive = true;
        if (uSlot >= self.meshCount) self.meshCount = uSlot + 1;
        return handle;
    }

    bool isValidMesh(MeshHandle handle)
    {
        if (handle == INVALID_MESH || self.meshes == null) return false;
        u32 slot = _handleIndex(handle);
        u32 gen = _handleGen(handle);
        if (slot >= self.meshCapacity) return false;
        if (!self.meshes[slot].alive) return false;
        return (u32)self.meshes[slot].gen == gen;
    }

    MeshRecord* getMesh(MeshHandle handle)
    {
        if (!self.isValidMesh(handle)) return null;
        return &self.meshes[_handleIndex(handle)];
    }

    bool destroyMesh(MeshHandle handle)
    {
        if (!self.isValidMesh(handle)) return false;
        u32 slot = _handleIndex(handle);
        if (bgfxIsReady())
        {
            if (self.meshes[slot].vbh != BGFX_INVALID_HANDLE)
                bgfx_destroy_vertex_buffer(self.meshes[slot].vbh);
            if (self.meshes[slot].hasIndices && self.meshes[slot].ibh != BGFX_INVALID_HANDLE)
                bgfx_destroy_index_buffer(self.meshes[slot].ibh);
        }
        self.meshes[slot].alive = false;
        self.meshes[slot].handle = INVALID_MESH;
        self.meshes[slot].vbh = BGFX_INVALID_HANDLE;
        self.meshes[slot].ibh = BGFX_INVALID_HANDLE;
        self.meshes[slot].vertexCount = 0;
        self.meshes[slot].indexCount = 0;
        self.meshes[slot].hasIndices = false;
        u16 nextGen = self.meshes[slot].gen + (u16)1;
        if (nextGen == (u16)0) nextGen = 1;
        self.meshes[slot].gen = nextGen;
        return true;
    }

    // --- Texture management ---

    TextureHandle createTexture(
        bgfx_texture_handle_t bgfxHandle, u16 width, u16 height,
        i32 format, u64 flags)
    {
        if (self.textures == null) return INVALID_TEXTURE;
        i32 slot = -1;
        for (u32 i = 0; i < self.textureCapacity; i++)
        {
            if (!self.textures[i].alive)
            {
                slot = (i32)i;
                break;
            }
        }
        if (slot < 0) return INVALID_TEXTURE;

        u32 uSlot = (u32)slot;
        u16 curGen = self.textures[uSlot].gen;
        if (curGen == (u16)0) curGen = 1;
        TextureHandle handle = _makeHandle(uSlot, (u32)curGen);

        self.textures[uSlot].handle = handle;
        self.textures[uSlot].bgfxHandle = bgfxHandle;
        self.textures[uSlot].width = width;
        self.textures[uSlot].height = height;
        self.textures[uSlot].format = format;
        self.textures[uSlot].flags = flags;
        self.textures[uSlot].alive = true;
        if (uSlot >= self.textureCount) self.textureCount = uSlot + 1;
        return handle;
    }

    bool isValidTexture(TextureHandle handle)
    {
        if (handle == INVALID_TEXTURE || self.textures == null) return false;
        u32 slot = _handleIndex(handle);
        u32 gen = _handleGen(handle);
        if (slot >= self.textureCapacity) return false;
        if (!self.textures[slot].alive) return false;
        return (u32)self.textures[slot].gen == gen;
    }

    TextureRecord* getTexture(TextureHandle handle)
    {
        if (!self.isValidTexture(handle)) return null;
        return &self.textures[_handleIndex(handle)];
    }

    bool destroyTexture(TextureHandle handle)
    {
        if (!self.isValidTexture(handle)) return false;
        u32 slot = _handleIndex(handle);
        if (bgfxIsReady())
        {
            if (self.textures[slot].bgfxHandle != BGFX_INVALID_HANDLE)
                bgfx_destroy_texture(self.textures[slot].bgfxHandle);
        }
        self.textures[slot].alive = false;
        self.textures[slot].handle = INVALID_TEXTURE;
        self.textures[slot].bgfxHandle = BGFX_INVALID_HANDLE;
        self.textures[slot].width = 0;
        self.textures[slot].height = 0;
        u16 nextGen = self.textures[slot].gen + (u16)1;
        if (nextGen == (u16)0) nextGen = 1;
        self.textures[slot].gen = nextGen;
        return true;
    }

    // --- Shader management ---

    ShaderHandle createShader(bgfx_shader_handle_t bgfxHandle, i32 stage)
    {
        if (self.shaders == null) return INVALID_SHADER;
        i32 slot = -1;
        for (u32 i = 0; i < self.shaderCapacity; i++)
        {
            if (!self.shaders[i].alive)
            {
                slot = (i32)i;
                break;
            }
        }
        if (slot < 0) return INVALID_SHADER;

        u32 uSlot = (u32)slot;
        u16 curGen = self.shaders[uSlot].gen;
        if (curGen == (u16)0) curGen = 1;
        ShaderHandle handle = _makeHandle(uSlot, (u32)curGen);

        self.shaders[uSlot].handle = handle;
        self.shaders[uSlot].bgfxHandle = bgfxHandle;
        self.shaders[uSlot].stage = stage;
        self.shaders[uSlot].alive = true;
        if (uSlot >= self.shaderCount) self.shaderCount = uSlot + 1;
        return handle;
    }

    bool isValidShader(ShaderHandle handle)
    {
        if (handle == INVALID_SHADER || self.shaders == null) return false;
        u32 slot = _handleIndex(handle);
        u32 gen = _handleGen(handle);
        if (slot >= self.shaderCapacity) return false;
        if (!self.shaders[slot].alive) return false;
        return (u32)self.shaders[slot].gen == gen;
    }

    ShaderRecord* getShader(ShaderHandle handle)
    {
        if (!self.isValidShader(handle)) return null;
        return &self.shaders[_handleIndex(handle)];
    }

    bool destroyShader(ShaderHandle handle)
    {
        if (!self.isValidShader(handle)) return false;
        u32 slot = _handleIndex(handle);
        if (bgfxIsReady())
        {
            if (self.shaders[slot].bgfxHandle != BGFX_INVALID_HANDLE)
                bgfx_destroy_shader(self.shaders[slot].bgfxHandle);
        }
        self.shaders[slot].alive = false;
        self.shaders[slot].handle = INVALID_SHADER;
        self.shaders[slot].bgfxHandle = BGFX_INVALID_HANDLE;
        u16 nextGen = self.shaders[slot].gen + (u16)1;
        if (nextGen == (u16)0) nextGen = 1;
        self.shaders[slot].gen = nextGen;
        return true;
    }

    // --- Program management ---

    ProgramHandle createProgram(
        bgfx_program_handle_t bgfxHandle, ShaderHandle vsh, ShaderHandle fsh)
    {
        if (self.programs == null) return INVALID_PROGRAM;
        i32 slot = -1;
        for (u32 i = 0; i < self.programCapacity; i++)
        {
            if (!self.programs[i].alive)
            {
                slot = (i32)i;
                break;
            }
        }
        if (slot < 0) return INVALID_PROGRAM;

        u32 uSlot = (u32)slot;
        u16 curGen = self.programs[uSlot].gen;
        if (curGen == (u16)0) curGen = 1;
        ProgramHandle handle = _makeHandle(uSlot, (u32)curGen);

        self.programs[uSlot].handle = handle;
        self.programs[uSlot].bgfxHandle = bgfxHandle;
        self.programs[uSlot].vsh = vsh;
        self.programs[uSlot].fsh = fsh;
        self.programs[uSlot].alive = true;
        if (uSlot >= self.programCount) self.programCount = uSlot + 1;
        return handle;
    }

    bool isValidProgram(ProgramHandle handle)
    {
        if (handle == INVALID_PROGRAM || self.programs == null) return false;
        u32 slot = _handleIndex(handle);
        u32 gen = _handleGen(handle);
        if (slot >= self.programCapacity) return false;
        if (!self.programs[slot].alive) return false;
        return (u32)self.programs[slot].gen == gen;
    }

    ProgramRecord* getProgram(ProgramHandle handle)
    {
        if (!self.isValidProgram(handle)) return null;
        return &self.programs[_handleIndex(handle)];
    }

    bool destroyProgram(ProgramHandle handle)
    {
        if (!self.isValidProgram(handle)) return false;
        u32 slot = _handleIndex(handle);
        if (bgfxIsReady())
        {
            if (self.programs[slot].bgfxHandle != BGFX_INVALID_HANDLE)
                bgfx_destroy_program(self.programs[slot].bgfxHandle);
        }
        self.programs[slot].alive = false;
        self.programs[slot].handle = INVALID_PROGRAM;
        self.programs[slot].bgfxHandle = BGFX_INVALID_HANDLE;
        self.programs[slot].vsh = INVALID_SHADER;
        self.programs[slot].fsh = INVALID_SHADER;
        u16 nextGen = self.programs[slot].gen + (u16)1;
        if (nextGen == (u16)0) nextGen = 1;
        self.programs[slot].gen = nextGen;
        return true;
    }

    // --- Material management ---

    MaterialHandle createMaterial(ProgramHandle program)
    {
        if (self.materials == null) return INVALID_MATERIAL;
        i32 slot = -1;
        for (u32 i = 0; i < self.materialCapacity; i++)
        {
            if (!self.materials[i].alive)
            {
                slot = (i32)i;
                break;
            }
        }
        if (slot < 0) return INVALID_MATERIAL;

        u32 uSlot = (u32)slot;
        u16 curGen = self.materials[uSlot].gen;
        if (curGen == (u16)0) curGen = 1;
        MaterialHandle handle = _makeHandle(uSlot, (u32)curGen);

        self.materials[uSlot].handle = handle;
        self.materials[uSlot].program = program;
        self.materials[uSlot].baseColorTexture = INVALID_TEXTURE;
        self.materials[uSlot].normalTexture = INVALID_TEXTURE;
        self.materials[uSlot].metallicRoughnessTexture = INVALID_TEXTURE;
        self.materials[uSlot].baseColorFactor = Vec4::new(1.0f, 1.0f, 1.0f, 1.0f);
        self.materials[uSlot].metallicFactor = 0.0f;
        self.materials[uSlot].roughnessFactor = 1.0f;
        self.materials[uSlot].stateFlags = 0;
        self.materials[uSlot].alive = true;
        if (uSlot >= self.materialCount) self.materialCount = uSlot + 1;
        return handle;
    }

    bool isValidMaterial(MaterialHandle handle)
    {
        if (handle == INVALID_MATERIAL || self.materials == null) return false;
        u32 slot = _handleIndex(handle);
        u32 gen = _handleGen(handle);
        if (slot >= self.materialCapacity) return false;
        if (!self.materials[slot].alive) return false;
        return (u32)self.materials[slot].gen == gen;
    }

    MaterialRecord* getMaterial(MaterialHandle handle)
    {
        if (!self.isValidMaterial(handle)) return null;
        return &self.materials[_handleIndex(handle)];
    }

    bool destroyMaterial(MaterialHandle handle)
    {
        if (!self.isValidMaterial(handle)) return false;
        u32 slot = _handleIndex(handle);
        self.materials[slot].alive = false;
        self.materials[slot].handle = INVALID_MATERIAL;
        self.materials[slot].program = INVALID_PROGRAM;
        self.materials[slot].baseColorTexture = INVALID_TEXTURE;
        self.materials[slot].normalTexture = INVALID_TEXTURE;
        self.materials[slot].metallicRoughnessTexture = INVALID_TEXTURE;
        u16 nextGen = self.materials[slot].gen + (u16)1;
        if (nextGen == (u16)0) nextGen = 1;
        self.materials[slot].gen = nextGen;
        return true;
    }

    // --- Lifecycle cleanup ---

    void releaseAll()
    {
        if (self.materials != null)
        {
            for (u32 i = 0; i < self.materialCapacity; i++)
            {
                if (self.materials[i].alive)
                    self.destroyMaterial(self.materials[i].handle);
            }
            self.materialCount = 0;
        }

        if (self.programs != null)
        {
            for (u32 i = 0; i < self.programCapacity; i++)
            {
                if (self.programs[i].alive)
                    self.destroyProgram(self.programs[i].handle);
            }
            self.programCount = 0;
        }

        if (self.shaders != null)
        {
            for (u32 i = 0; i < self.shaderCapacity; i++)
            {
                if (self.shaders[i].alive)
                    self.destroyShader(self.shaders[i].handle);
            }
            self.shaderCount = 0;
        }

        if (self.textures != null)
        {
            for (u32 i = 0; i < self.textureCapacity; i++)
            {
                if (self.textures[i].alive)
                    self.destroyTexture(self.textures[i].handle);
            }
            self.textureCount = 0;
        }

        if (self.meshes != null)
        {
            for (u32 i = 0; i < self.meshCapacity; i++)
            {
                if (self.meshes[i].alive)
                    self.destroyMesh(self.meshes[i].handle);
            }
            self.meshCount = 0;
        }
    }
}

// Default static tables for the engine
const u32 DEFAULT_MESH_CAPACITY = 1024;
const u32 DEFAULT_MATERIAL_CAPACITY = 1024;
const u32 DEFAULT_TEXTURE_CAPACITY = 1024;
const u32 DEFAULT_SHADER_CAPACITY = 256;
const u32 DEFAULT_PROGRAM_CAPACITY = 256;

static MeshRecord[1024] MuMeshes;
static MaterialRecord[1024] MuMaterials;
static TextureRecord[1024] MuTextures;
static ShaderRecord[256] MuShaders;
static ProgramRecord[256] MuPrograms;
static RenderResources MuDefaultResources;
static bool MuResourcesReady = false;

/// Initializes the default render resources table once.
pub void renderResourcesInit()
{
    if (MuResourcesReady) return;
    MuDefaultResources = RenderResources::new(
        MuMeshes, DEFAULT_MESH_CAPACITY,
        MuMaterials, DEFAULT_MATERIAL_CAPACITY,
        MuTextures, DEFAULT_TEXTURE_CAPACITY,
        MuShaders, DEFAULT_SHADER_CAPACITY,
        MuPrograms, DEFAULT_PROGRAM_CAPACITY
    );
    MuResourcesReady = true;
    println("[mu] render: resources initialized (meshes={} mats={} texs={} shaders={} programs={})",
        DEFAULT_MESH_CAPACITY, DEFAULT_MATERIAL_CAPACITY, DEFAULT_TEXTURE_CAPACITY,
        DEFAULT_SHADER_CAPACITY, DEFAULT_PROGRAM_CAPACITY);
}

/// The engine's default render resource manager.
pub RenderResources* defaultRenderResources()
{
    if (!MuResourcesReady) renderResourcesInit();
    return &MuDefaultResources;
}

/// Releases all registered render resources.
pub void renderResourcesShutdown()
{
    if (!MuResourcesReady) return;
    MuDefaultResources.releaseAll();
    MuResourcesReady = false;
    println("[mu] render: resources shutdown");
}
