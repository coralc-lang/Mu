// Renderer interface + headless software rasterizer (ENGINE.md §3/§6).
// Loop only sees Renderer (ctx + draw + shutdown), so the bgfx backend can
// replace the software path later without touching scene or script code.
// The software path paints into caller-owned RGBA pixels and can snapshot
// the result as a binary PPM, which makes headless runs produce real frames.

import std::fios { FileHandle, fileOpen, fileClose, fileWrite };
import std::fs { IoError };

pub struct Framebuffer
{
    u32* pixels;      // 0xRRGGBBAA, row-major  // i dont want a ppm, i want us to use bgfx as the rendere backend.
    i32 width;
    i32 height;
    u32 clearColor;
    u64 paintCalls;
    u64 presents;

    static Framebuffer new(u32* pixels, i32 width, i32 height)
    {
        return Framebuffer {
            .pixels = pixels,
            .width = width,
            .height = height,
            .clearColor = 0x000000FF,
            .paintCalls = 0,
            .presents = 0
        };
    }
}

pub u32 rgba(u8 r, u8 g, u8 b, u8 a)
{
    return ((u32)r << 24) | ((u32)g << 16) | ((u32)b << 8) | (u32)a;
}

static u32 _blend(u32 dst, u32 src)
{
    u32 alpha = src & 0xFF;
    if (alpha == 255) return src;
    if (alpha == 0) return dst;

    u32 inv = 255 - alpha;
    u32 sr = (src >> 24) & 0xFF;
    u32 sg = (src >> 16) & 0xFF;
    u32 sb = (src >> 8) & 0xFF;
    u32 dr = (dst >> 24) & 0xFF;
    u32 dg = (dst >> 16) & 0xFF;
    u32 db = (dst >> 8) & 0xFF;
    u32 da = dst & 0xFF;

    u32 r = (sr * alpha + dr * inv) / 255;
    u32 g = (sg * alpha + dg * inv) / 255;
    u32 b = (sb * alpha + db * inv) / 255;
    u32 a = alpha + (da * inv) / 255;
    return (r << 24) | (g << 16) | (b << 8) | a;
}

pub void pixel(Framebuffer* fb, i32 x, i32 y, u32 color)
{
    if (fb == null) return;
    if (x < 0 || y < 0) return;
    if (x >= fb->width || y >= fb->height) return;
    i32 index = y * fb->width + x;
    fb->pixels[index] = _blend(fb->pixels[index], color);
}

pub void clear(Framebuffer* fb, u32 color)
{
    if (fb == null) return;
    fb->clearColor = color;
    i32 n = fb->width * fb->height;
    for (i32 i = 0; i < n; i++) fb->pixels[i] = color;
}

// Filled rectangle - the workhorse primitive scripts get as Mu::render::paint.
pub void paint(Framebuffer* fb, i32 x, i32 y, i32 w, i32 h, u32 color)
{
    if (fb == null) return;
    if (w <= 0 || h <= 0) return;
    fb->paintCalls = fb->paintCalls + 1;

    i32 x1 = x + w;
    i32 y1 = y + h;
    if (x < 0) x = 0;
    if (y < 0) y = 0;
    if (x1 > fb->width) x1 = fb->width;
    if (y1 > fb->height) y1 = fb->height;
    if (x >= x1 || y >= y1) return;

    for (i32 yy = y; yy < y1; yy++)
    {
        i32 row = yy * fb->width;
        for (i32 xx = x; xx < x1; xx++)
            fb->pixels[row + xx] = _blend(fb->pixels[row + xx], color);
    }
}

pub void line(Framebuffer* fb, i32 x0, i32 y0, i32 x1, i32 y1, u32 color)
{
    if (fb == null) return;
    i32 dx = x1 - x0;
    i32 dy = y1 - y0;
    if (dx < 0) dx = -dx;
    if (dy < 0) dy = -dy;
    i32 sx = x0 < x1 ? 1 : -1;
    i32 sy = y0 < y1 ? 1 : -1;
    i32 err = dx - dy;

    while (true)
    {
        pixel(fb, x0, y0, color);
        if (x0 == x1 && y0 == y1) break;
        i32 e2 = err * 2;
        if (e2 > -dy) { err -= dy; x0 += sx; }
        if (e2 < dx) { err += dx; y0 += sy; }
    }
}

pub void circle(Framebuffer* fb, i32 cx, i32 cy, i32 radius, u32 color)
{
    if (fb == null || radius < 0) return;
    i32 r2 = radius * radius;
    for (i32 dy = -radius; dy <= radius; dy++)
    {
        for (i32 dx = -radius; dx <= radius; dx++)
        {
            if (dx * dx + dy * dy <= r2)
                pixel(fb, cx + dx, cy + dy, color);
        }
    }
}

pub void present(Framebuffer* fb)
{
    if (fb == null) return;
    fb->presents = fb->presents + 1;
}

static i32 _putUint(u8* out, i32 pos, u32 value)
{
    if (value == 0)
    {
        out[pos] = '0';
        return pos + 1;
    }
    u8[10] digits;
    i32 n = 0;
    while (value > 0)
    {
        digits[n] = (u8)('0' + (value % 10));
        value = value / 10;
        n = n + 1;
    }
    while (n > 0)
    {
        n = n - 1;
        out[pos] = digits[n];
        pos = pos + 1;
    }
    return pos;
}

// Binary PPM snapshot (P6). Headless "present": deterministic, no window,
// no image codec dependency; view with any image viewer.
pub bool savePPM(Framebuffer* fb, str path)
{
    if (fb == null || fb->pixels == null) return false;

    Result<FileHandle, IoError> opened = fileOpen(path, "wb");
    if (opened.isErr()) return false;
    FileHandle file = opened.unwrap();

    u8[40] header;
    i32 hlen = 0;
    header[hlen] = 'P'; hlen = hlen + 1;
    header[hlen] = '6'; hlen = hlen + 1;
    header[hlen] = '\n'; hlen = hlen + 1;
    hlen = _putUint(header, hlen, (u32)fb->width);
    header[hlen] = ' '; hlen = hlen + 1;
    hlen = _putUint(header, hlen, (u32)fb->height);
    header[hlen] = '\n'; hlen = hlen + 1;
    header[hlen] = '2'; hlen = hlen + 1;
    header[hlen] = '5'; hlen = hlen + 1;
    header[hlen] = '5'; hlen = hlen + 1;
    header[hlen] = '\n'; hlen = hlen + 1;

    Result<usize, IoError> wrote = fileWrite(file, str { .ptr = header, .len = (usize)hlen });
    if (wrote.isErr())
    {
        fileClose(file);
        return false;
    }

    u8[12288] row;
    i32 maxPixels = 4096;
    i32 remaining = fb->width;
    for (i32 y = 0; y < fb->height; y++)
    {
        i32 off = 0;
        while (off < fb->width)
        {
            i32 chunk = remaining < maxPixels ? remaining : maxPixels;
            for (i32 x = 0; x < chunk; x++)
            {
                u32 c = fb->pixels[y * fb->width + off + x];
                row[x * 3 + 0] = (u8)(c >> 24);
                row[x * 3 + 1] = (u8)(c >> 16);
                row[x * 3 + 2] = (u8)(c >> 8);
            }
            Result<usize, IoError> rows = fileWrite(file,
                str { .ptr = row, .len = (usize)(chunk * 3) });
            if (rows.isErr())
            {
                fileClose(file);
                return false;
            }
            off += chunk;
            remaining -= chunk;
        }
        remaining = fb->width;
    }

    fileClose(file);
    return true;
}

// --- Loop-facing interface (ENGINE.md §3: null until M3/M4) ---

pub struct Renderer
{
    rawptr ctx;
    void(rawptr, rawptr, rawptr) draw;    // ctx, scene, ui
    void(rawptr) shutdown;
}

void _nullDraw(rawptr ctx, rawptr scene, rawptr ui)
{
    // headless: nothing to present
}

void _nullShutdown(rawptr ctx) { }

pub Renderer nullRenderer()
{
    return Renderer {
        .ctx = null,
        .draw = _nullDraw,
        .shutdown = _nullShutdown
    };
}

void _softwareDraw(rawptr ctx, rawptr scene, rawptr ui)
{
    present((Framebuffer*)ctx);
}

void _softwareShutdown(rawptr ctx) { }

pub Renderer softwareRenderer(Framebuffer* fb)
{
    return Renderer {
        .ctx = (rawptr)fb,
        .draw = _softwareDraw,
        .shutdown = _softwareShutdown
    };
}

// Compose a renderer from engine-side callbacks (the demo uses this to
// draw its scene before presenting).
pub Renderer customRenderer(rawptr ctx, void(rawptr, rawptr, rawptr) draw, void(rawptr) shutdown)
{
    return Renderer {
        .ctx = ctx,
        .draw = draw,
        .shutdown = shutdown
    };
}
