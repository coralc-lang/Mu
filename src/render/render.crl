/* Renderer seam. Everything above this file talks to a draw/resize/shutdown
   function table, so switching between bgfx, SDL's 2D presenter, or a null
   backend never leaks into scene or gameplay code. */

/// Backend-neutral renderer handle. `ctx` is whatever the backend needs.
pub struct Renderer
{
    rawptr ctx;
    void(rawptr, rawptr, rawptr) draw;
    void(rawptr, i32, i32) resize;
    void(rawptr) shutdown;
}

void _nullDraw(rawptr ctx, rawptr scene, rawptr ui)
{
}

void _nullResize(rawptr ctx, i32 width, i32 height)
{
}

void _nullShutdown(rawptr ctx)
{
}

/// A renderer that silently drops every call. Used for probes and headless runs.
pub Renderer nullRenderer()
{
    return Renderer {
        .ctx = null,
        .draw = _nullDraw,
        .resize = _nullResize,
        .shutdown = _nullShutdown
    };
}

/// Builds a renderer from a backend's function pointers. `resize` may be a
/// no-op when the backend follows the window automatically.
pub Renderer customRenderer(
    rawptr ctx, void(rawptr, rawptr, rawptr) draw,
    void(rawptr, i32, i32) resize, void(rawptr) shutdown)
{
    return Renderer {
        .ctx = ctx,
        .draw = draw,
        .resize = resize,
        .shutdown = shutdown
    };
}
