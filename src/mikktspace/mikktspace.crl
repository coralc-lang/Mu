// MikkTSpace extern port - vendored pair from github.com/mmikk/MikkTSpace
// (zlib license): the reference tangent-space generator. Normal-mapped glTF
// meshes want MikkTSpace-compatible tangents (ENGINE.md §9/§15). The .c
// compiles straight into libmualibs.a via native/CMakeLists.txt.
//
// ABI notes: tbool = C int = i32; float = f32. Callbacks receive
// `const SMikkTSpaceContext*` - the C header forward-declares that struct,
// so the fn-ptr params are typed rawptr here (pointer-sized either way);
// keep the typed SMikkTSpaceContext on the Coral side for filling in.
// Results are UNINDEXED (one output row per face-vertex) - never average an
// existing tangent list; see the vendored header for the full contract.
//
// Failure site: genTangSpace* return tbool - a valueless, message-less
// status, so the raw int stays until the importer (M4) lands and picks the
// Ok shape per the ENGINE.md §3 error convention.

pub typedef tbool = i32;

pub struct SMikkTSpaceInterface
{
    // ctx = const SMikkTSpaceContext*
    i32(rawptr) m_getNumFaces;                         // faces (tris/quads)
    i32(rawptr, i32) m_getNumVerticesOfFace;           // ctx, iFace
    void(rawptr, f32*, i32, i32) m_getPosition;        // ctx, fvPosOut, iFace, iVert
    void(rawptr, f32*, i32, i32) m_getNormal;          // ctx, fvNormOut, iFace, iVert
    void(rawptr, f32*, i32, i32) m_getTexCoord;        // ctx, fvTexcOut, iFace, iVert
    void(rawptr, const f32*, f32, i32, i32) m_setTSpaceBasic;  // ctx, fvTangent, fSign, iFace, iVert
    void(rawptr, const f32*, const f32*, f32, f32, tbool, i32, i32) m_setTSpace;
}

pub struct SMikkTSpaceContext
{
    SMikkTSpaceInterface* m_pInterface;
    rawptr m_pUserData;
}

pub extern tbool genTangSpaceDefault(const SMikkTSpaceContext* pContext);
pub extern tbool genTangSpace(const SMikkTSpaceContext* pContext, f32 fAngularThreshold);
