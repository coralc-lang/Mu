// SDL3 extern port - SDL release-3.4.18 (zlib license), vendored at
// third_party/SDL. This file: init/error/clock + window + native handle
// retrieval for bgfx. Signatures from include/SDL3/*.h of that tag.
//
// ABI notes: SDL3 returns C `_Bool` (1 byte status) - declared u8 here so
// the value in AL reads identically regardless of Coral's bool width; treat
// nonzero as true. Enums are 32-bit. Not linked until the M3 build phase
// adds SDL3 to `link`.

import sdl::types { SDL_Window, SDL_PropertiesID };

pub typedef SDL_InitFlags = u32;
pub typedef SDL_WindowFlags = u64;

// --- init / error / clock ---

pub const u32 SDL_INIT_AUDIO    = 0x00000010;
pub const u32 SDL_INIT_VIDEO    = 0x00000020;
pub const u32 SDL_INIT_JOYSTICK = 0x00000200;
pub const u32 SDL_INIT_HAPTIC   = 0x00001000;
pub const u32 SDL_INIT_GAMEPAD  = 0x00002000;
pub const u32 SDL_INIT_EVENTS   = 0x00004000;

pub extern u8 SDL_Init(SDL_InitFlags flags);
pub extern u8 SDL_InitSubSystem(SDL_InitFlags flags);
pub extern void SDL_QuitSubSystem(SDL_InitFlags flags);
pub extern SDL_InitFlags SDL_WasInit(SDL_InitFlags flags);
pub extern void SDL_Quit();
pub extern const cchar* SDL_GetError();
pub extern u64 SDL_GetTicksNS();
pub extern u8 SDL_SetAppMetadata(const cchar* appname, const cchar* appversion, const cchar* appidentifier);

// --- window ---

pub const u64 SDL_WINDOW_FULLSCREEN         = 0x0000000000000001;
pub const u64 SDL_WINDOW_HIDDEN             = 0x0000000000000008;
pub const u64 SDL_WINDOW_RESIZABLE          = 0x0000000000000020;
pub const u64 SDL_WINDOW_HIGH_PIXEL_DENSITY = 0x0000000000002000;
pub const u64 SDL_WINDOW_VULKAN             = 0x0000000010000000;
pub const u64 SDL_WINDOW_METAL              = 0x0000000020000000;

pub extern SDL_Window* SDL_CreateWindow(const cchar* title, i32 w, i32 h, SDL_WindowFlags flags);
pub extern void SDL_DestroyWindow(SDL_Window* window);
pub extern SDL_WindowFlags SDL_GetWindowFlags(SDL_Window* window);
pub extern u8 SDL_SetWindowTitle(SDL_Window* window, const cchar* title);
pub extern u8 SDL_GetWindowSize(SDL_Window* window, i32* w, i32* h);
pub extern u8 SDL_GetWindowSizeInPixels(SDL_Window* window, i32* w, i32* h);
pub extern u8 SDL_ShowWindow(SDL_Window* window);
pub extern u8 SDL_HideWindow(SDL_Window* window);
pub extern u8 SDL_SetWindowFullscreen(SDL_Window* window, u8 fullscreen);

// --- native window handle for bgfx platform data ---
// SDL_GetWindowProperties returns an ID; pull the platform pointer out with
// SDL_GetPointerProperty and hand it to bgfx as SwapChain.nwh.

pub const cchar* SDL_PROP_WINDOW_WIN32_HWND_POINTER          = c"SDL.window.win32.hwnd";
pub const cchar* SDL_PROP_WINDOW_COCOA_WINDOW_POINTER        = c"SDL.window.cocoa.window";
pub const cchar* SDL_PROP_WINDOW_WAYLAND_DISPLAY_POINTER     = c"SDL.window.wayland.display";
pub const cchar* SDL_PROP_WINDOW_WAYLAND_SURFACE_POINTER     = c"SDL.window.wayland.surface";
pub const cchar* SDL_PROP_WINDOW_X11_DISPLAY_POINTER         = c"SDL.window.x11.display";
pub const cchar* SDL_PROP_WINDOW_X11_WINDOW_NUMBER           = c"SDL.window.x11.window";
pub const cchar* SDL_PROP_WINDOW_ANDROID_WINDOW_POINTER      = c"SDL.window.android.window";
pub const cchar* SDL_PROP_WINDOW_UIKIT_WINDOW_POINTER        = c"SDL.window.uikit.window";
pub const cchar* SDL_PROP_WINDOW_UWP_WINDOW_POINTER          = c"SDL.window.uwp.window";

pub extern SDL_PropertiesID SDL_GetWindowProperties(SDL_Window* window);
pub extern rawptr SDL_GetPointerProperty(SDL_PropertiesID props, const cchar* name, rawptr default_value);
