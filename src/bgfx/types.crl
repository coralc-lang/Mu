pub const i32 BGFX_NATIVE_WINDOW_HANDLE_TYPE_DEFAULT = 0;
pub const i32 BGFX_NATIVE_WINDOW_HANDLE_TYPE_WAYLAND = 1;
pub const i32 BGFX_NATIVE_WINDOW_HANDLE_TYPE_COUNT   = 2;

