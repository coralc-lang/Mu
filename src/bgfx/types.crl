pub const i32 BGFX_RENDERER_TYPE_OPENGLES   = 7;
pub const i32 BGFX_RENDERER_TYPE_OPENGL     = 8;
pub const i32 BGFX_RENDERER_TYPE_VULKAN     = 9;
pub const i32 BGFX_RENDERER_TYPE_WEBGPU     = 10;
pub const i32 BGFX_RENDERER_TYPE_COUNT      = 11;

