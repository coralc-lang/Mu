pub const i32 BGFX_RENDER_FRAME_NO_CONTEXT = 0;
pub const i32 BGFX_RENDER_FRAME_RENDER     = 1;
pub const i32 BGFX_RENDER_FRAME_TIMEOUT    = 2;
pub const i32 BGFX_RENDER_FRAME_EXITING    = 3;
pub const i32 BGFX_RENDER_FRAME_COUNT      = 4;

// View clear flags (bgfx.h BGFX_CLEAR_*): the three that are stable and need no
// bit-mask transcription. The DISCARD_* family lives in bgfx.h.
pub const u16 BGFX_CLEAR_NONE    = 0x0000;
pub const u16 BGFX_CLEAR_COLOR   = 0x0001;
pub const u16 BGFX_CLEAR_DEPTH   = 0x0002;
pub const u16 BGFX_CLEAR_STENCIL = 0x0004;

// Reset flags: only NONE is needed to bring a window up; the VSYNC/MSAA/flip
// bits are defined in bgfx.h and should be transcribed there when M4 tunes them.
pub const u32 BGFX_RESET_NONE = 0;

// --- handles (by-value u16; 0xFFFF == invalid) ---

pub typedef bgfx_index_buffer_handle_t = u16;
pub typedef bgfx_vertex_buffer_handle_t = u16;
pub typedef bgfx_dynamic_index_buffer_handle_t = u16;
pub typedef bgfx_dynamic_vertex_buffer_handle_t = u16;
pub typedef bgfx_frame_buffer_handle_t = u16;
pub typedef bgfx_indirect_buffer_handle_t = u16;
pub typedef bgfx_occlusion_query_handle_t = u16;
pub typedef bgfx_program_handle_t = u16;
pub typedef bgfx_shader_handle_t = u16;
pub typedef bgfx_texture_handle_t = u16;
pub typedef bgfx_uniform_handle_t = u16;
pub typedef bgfx_vertex_layout_handle_t = u16;

pub const u16 BGFX_INVALID_HANDLE = 0xFFFF;

pub typedef bgfx_encoder_t = rawptr;   // opaque struct bgfx_encoder_s

// --- structs (field order mirrors the IDL-generated header) ---

pub struct bgfx_memory_t
{
    u8* data;
    u32 size;
}

pub struct bgfx_platform_data_t
{
    rawptr context;
    rawptr queue;
    bgfx_native_window_handle_type_t type;
}

pub struct bgfx_swap_chain_t
{
    rawptr nwh;
    rawptr ndt;
    u32 width;
    u32 height;
    u32 flags;
    bgfx_texture_format_t formatColor;
    bgfx_texture_format_t formatDepthStencil;
    bgfx_texture_handle_t depth;
    u8 numBackBuffers;
    u8 maxFrameLatency;
}

pub struct bgfx_init_limits_t
{
    u16 maxEncoders;
    u32 numDrawCalls;
    u32 numDrawCallPeakFrames;
    u32 minViews;
    u32 minResourceCbSize;
    u32 maxTransientVbSize;
    u32 maxTransientIbSize;
    u32 minUniformBufferSize;
    u32 minUniformCacheSize;
}

pub struct bgfx_init_t
{
    bgfx_renderer_type_t type;
    u16 vendorId;
    u16 deviceId;
    u64 capabilities;
    u8 debug;
    u8 profile;
    u8 fallback;
    u8 videoDecode;
    bgfx_platform_data_t platformData;
    bgfx_swap_chain_t swapChain;
    u32 reset;
    bgfx_init_limits_t limits;
    rawptr callback;
    rawptr allocator;
}

pub struct bgfx_vertex_layout_t
{
    u32 hash;
    u16 stride;
    u16 offset[26];       // BGFX_ATTRIB_COUNT
    u16 attributes[26];   // BGFX_ATTRIB_COUNT
}

pub struct bgfx_texture_region_t
{
    bgfx_texture_handle_t handle;
    u8 mip;
    u16 x;
    u16 y;
    u16 z;
    u16 width;
    u16 height;
    u16 depth;
}

pub struct bgfx_transient_index_buffer_t
{
    u8* data;
    u32 size;
    u32 startIndex;
    bgfx_index_buffer_handle_t handle;
    u8 isIndex16;
}

pub struct bgfx_transient_vertex_buffer_t
{
    u8* data;
    u32 size;
    u32 startVertex;
    u16 stride;
    bgfx_vertex_buffer_handle_t handle;
    bgfx_vertex_layout_handle_t layoutHandle;
}

pub struct bgfx_instance_data_buffer_t
{
    u8* data;
    u32 size;
    u32 offset;
    u32 num;
    u16 stride;
    bgfx_vertex_buffer_handle_t handle;
}

pub struct bgfx_uniform_info_t
{
    u8 name[256];
    bgfx_uniform_type_t type;
    u16 num;
}

pub struct bgfx_caps_gpu_t
{
    u16 vendorId;
    u16 deviceId;
}

pub struct bgfx_internal_data_t
{
    rawptr caps;      // const bgfx_caps_t*
    rawptr context;
}
