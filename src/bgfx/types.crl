// bgfx C99 FFI - shared types, handles and enums (bkaradzic/bgfx, BSD-2).
// Source of truth: include/bgfx/c99/bgfx.h (auto-generated from IDL) of the
// bgfx.cmake checkout. bgfx is the render backend (ENGINE.md §2): graphics-API
// agnostic, so GLES3/Vulkan/Metal/D3D are chosen at runtime, not us.
//
// ABI notes:
//  * bgfx handle types are `struct { uint16_t idx; }` passed/returned BY VALUE.
//    On every supported ABI a single-u16 struct travels in one register, so
//    they are typed as `u16` here (BGFX_INVALID_HANDLE == 0xFFFF).
//  * C `bool` is 1 byte - declared u8 so the register reads identically.
//  * bgfx's C enums are `int`-sized - declared i32, constants transcribed with
//    the exact numeric values from the header's inline comments.
//  * Struct layouts below mirror the header field-for-field; do NOT reorder.

pub typedef bgfx_view_id_t = u16;

pub typedef bgfx_renderer_type_t = i32;
pub const i32 BGFX_RENDERER_TYPE_NOOP       = 0;
pub const i32 BGFX_RENDERER_TYPE_AGC        = 1;
pub const i32 BGFX_RENDERER_TYPE_DIRECT3D11 = 2;
