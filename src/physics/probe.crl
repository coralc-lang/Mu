// Headless Jolt probe: creates a ground, a box and a sphere, steps the real
// world, then checks that the dynamic bodies landed. Enabled with
// MU_PHYSICS_PROBE=1 so normal engine startup stays gameplay-free.

use math::math { Vec3, Quat };
use physics::body { addBox, addBoxOnLayer, addSphereOnLayer };
use physics::character {
    Character, characterConfig, characterCreate, characterDestroy,
    characterGrounded, characterJump, characterMove, characterPosition
};
use physics::layers { layersShouldCollide, setLayerMask };
use physics::queries {
    OverlapHit, RayHit, ShapeCastHit,
    boxCast, overlapBox, overlapSphere, overlapSphereOnLayer, raycast, sphereCast
};
use physics::world { PhysicsWorld, step };
use scene::scene { Scene, EntityId };
use thirdparty::jolt {
    JoltC_PhysicsSystem_GetNumBodies,
    JoltC_PhysicsSystem_GetNumActiveBodies,
    BODY_RIGID
};

pub bool runProbe(PhysicsWorld* world, Scene* scene)
{
    if (world == null || scene == null) return false;

    Option<EntityId> groundSlot = scene->create();
    Option<EntityId> boxSlot = scene->create();
    Option<EntityId> sphereSlot = scene->create();
    Option<EntityId> ghostSlot = scene->create();
    Option<EntityId> characterSlot = scene->create();
    if (groundSlot.isNone() || boxSlot.isNone() || sphereSlot.isNone() ||
        ghostSlot.isNone() || characterSlot.isNone())
    {
        println("[mu:error] physics probe: scene is full");
        return false;
    }

    EntityId ground = groundSlot.unwrap();
    EntityId box = boxSlot.unwrap();
    EntityId sphere = sphereSlot.unwrap();
    EntityId ghost = ghostSlot.unwrap();
    EntityId characterEntity = characterSlot.unwrap();

    scene->entities[ground].local.position = Vec3::new(0.0f, -0.5f, 0.0f);
    scene->entities[box].local.position = Vec3::new(0.0f, 6.0f, 0.0f);
    scene->entities[sphere].local.position = Vec3::new(3.0f, 8.0f, 0.0f);
    scene->entities[ghost].local.position = Vec3::new(6.0f, 6.0f, 0.0f);
    scene->entities[characterEntity].local.position = Vec3::new(9.0f, 2.0f, 0.0f);

    setLayerMask(&world->layers, 2, 0x04);

    Result<u32, str> groundBody = addBox(world, ground, Vec3::new(20.0f, 0.5f, 20.0f), false);
    Result<u32, str> boxBody = addBoxOnLayer(world, box, Vec3::new(0.5f, 0.5f, 0.5f), true, 1);
    Result<u32, str> sphereBody = addSphereOnLayer(world, sphere, 0.5f, true, 1);
    Result<u32, str> ghostBody = addSphereOnLayer(world, ghost, 0.5f, true, 2);

    if (groundBody.isErr() || boxBody.isErr() || sphereBody.isErr() || ghostBody.isErr())
    {
        println("[mu:error] physics probe: body creation failed");
        return false;
    }

    println("[mu] physics probe: created ground + box + sphere + ghost");

    u32 bodies = JoltC_PhysicsSystem_GetNumBodies(world->system);
    u32 active = JoltC_PhysicsSystem_GetNumActiveBodies(world->system, BODY_RIGID);
    u32 collide = (u32)layersShouldCollide(&world->layers, 0, 0);
    println("[mu] physics probe: bodies={} active={} collide={}", bodies, active, collide);

    u32 frames = 240;
    for (u32 i = 0; i < frames; i++)
        step(world, 1.0f / 60.0f);

    f32 boxY = scene->entities[box].local.position.y;
    f32 sphereY = scene->entities[sphere].local.position.y;
    f32 ghostY = scene->entities[ghost].local.position.y;
    println("[mu] physics probe: box y={} sphere y={} ghost y={}", boxY, sphereY, ghostY);

    bool landed = boxY > 0.0f && boxY < 1.5f && sphereY > 0.0f && sphereY < 1.5f;
    bool layersOk = ghostY < 0.0f &&
        layersShouldCollide(&world->layers, 0, 1) &&
        !layersShouldCollide(&world->layers, 1, 2) &&
        layersShouldCollide(&world->layers, 2, 2);

    bool queriesOk = true;
    Option<RayHit> ray = raycast(world, Vec3::new(0.0f, 5.0f, 0.0f), Vec3::new(0.0f, -10.0f, 0.0f));
    if (ray.isNone() || ray.unwrap().entity != box) queriesOk = false;

    Option<RayHit> miss = raycast(world, Vec3::new(0.0f, 5.0f, 0.0f), Vec3::new(0.0f, 10.0f, 0.0f));
    if (miss.isSome()) queriesOk = false;

    Option<ShapeCastHit> cast = boxCast(
        world, Vec3::new(0.1f, 0.1f, 0.1f),
        Vec3::new(0.0f, 5.0f, 0.0f), Quat::identity(),
        Vec3::new(0.0f, -10.0f, 0.0f));
    if (cast.isNone() || cast.unwrap().entity != box) queriesOk = false;

    Option<ShapeCastHit> castSphere = sphereCast(
        world, 0.1f, Vec3::new(3.0f, 5.0f, 0.0f), Quat::identity(),
        Vec3::new(0.0f, -10.0f, 0.0f));
    if (castSphere.isNone() || castSphere.unwrap().entity != sphere) queriesOk = false;

    OverlapHit[8] overlaps;
    u32 overlapCount = overlapSphere(world, 0.3f, Vec3::new(0.0f, 0.48f, 0.0f), overlaps, 8);
    bool overlapBoxFound = false;
    for (u32 i = 0; i < overlapCount && i < 8; i++)
    {
        if (overlaps[i].entity == box) overlapBoxFound = true;
    }
    if (!overlapBoxFound) queriesOk = false;

    u32 emptyCount = overlapBox(
        world, Vec3::new(0.5f, 0.5f, 0.5f),
        Vec3::new(0.0f, 10.0f, 0.0f), Quat::identity(), overlaps, 8);
    if (emptyCount != 0) queriesOk = false;

    Vec3 ghostPosition = scene->entities[ghost].local.position;
    u32 hiddenCount = overlapSphereOnLayer(
        world, 0.75f, 1, ghostPosition, overlaps, 8);
    if (hiddenCount != 0) queriesOk = false;

    u32 ghostCount = overlapSphereOnLayer(
        world, 0.75f, 2, ghostPosition, overlaps, 8);
    bool ghostFound = false;
    for (u32 i = 0; i < ghostCount && i < 8; i++)
    {
        if (overlaps[i].entity == ghost) ghostFound = true;
    }
    if (!ghostFound) queriesOk = false;

    bool characterOk = true;
    Result<Character, str> characterResult = characterCreate(
        world, characterEntity, characterConfig());
    if (characterResult.isErr())
    {
        println("[mu:error] physics probe: character create failed");
        characterOk = false;
    }
    else
    {
        Character character = characterResult.unwrap();
        for (u32 i = 0; i < 120; i++)
            characterMove(world, &character, Vec3::new(2.0f, 0.0f, 0.0f), 1.0f / 60.0f);

        Vec3 walkPosition = characterPosition(&character);
        bool walked = walkPosition.x > 9.5f;
        bool stood = characterGrounded(&character) &&
            walkPosition.y > 0.7f && walkPosition.y < 1.2f;

        bool jumped = characterJump(&character, 4.5f);
        characterMove(world, &character, Vec3::zero(), 1.0f / 60.0f);
        f32 jumpY = characterPosition(&character).y;
        bool rose = jumpY > walkPosition.y + 0.03f;

        for (u32 i = 0; i < 120; i++)
            characterMove(world, &character, Vec3::zero(), 1.0f / 60.0f);
        bool landedAgain = characterGrounded(&character);

        characterOk = walked && stood && jumped && rose && landedAgain;
        println("[mu] physics probe: character x={} y={} jump y={}",
            walkPosition.x, walkPosition.y, jumpY);
        characterDestroy(&character);
    }

    if (layersOk)
        println("[mu] physics probe: layers PASS");
    else
        println("[mu:error] physics probe: layers FAIL");

    if (queriesOk)
        println("[mu] physics probe: queries PASS");
    else
        println("[mu:error] physics probe: queries FAIL");

    if (characterOk)
        println("[mu] physics probe: character PASS");
    else
        println("[mu:error] physics probe: character FAIL");

    bool ok = landed && layersOk && queriesOk && characterOk;
    if (ok)
        println("[mu] physics probe: PASS");
    else
        println("[mu:error] physics probe: FAIL");
    return ok;
}
