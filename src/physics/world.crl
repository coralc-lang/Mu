// Jolt-backed physics world. This is the real runtime path: Jolt owns
// simulation state, the scene keeps coral-side transforms in sync after each
// fixed step. Binding code stays in thirdparty/jolt; this file is the small
// engine-facing wrapper.

use math::math { Vec3, Quat, RVec3 };
use scene::scene { Scene, Entity, EntityId, NIL };
use thirdparty::jolt { jolt };
use jolt {
    PhysicsSystem, BodyInterface, TempAllocator, JobSystem,
    ObjectLayerPairFilter, BroadPhaseLayerInterface,
    ObjectVsBroadPhaseLayerFilter, Shape, BodyCreationSettings, BodyID,
    BODY_ID_INVALID, MOTION_STATIC, MOTION_DYNAMIC, ACTIVATE,
    JoltC_Init, JoltC_Shutdown,
    JoltC_TempAllocator_Create, JoltC_TempAllocator_Destroy,
    JoltC_JobSystemThreadPool_Create, JoltC_JobSystem_Destroy,
    JoltC_ObjectLayerPairFilterTable_Create,
    JoltC_ObjectLayerPairFilterTable_EnableCollision,
    JoltC_ObjectLayerPairFilter_Destroy,
    JoltC_BroadPhaseLayerInterfaceTable_Create,
    JoltC_BroadPhaseLayerInterfaceTable_MapObjectToBroadPhaseLayer,
    JoltC_BroadPhaseLayerInterface_Destroy,
    JoltC_ObjectVsBroadPhaseLayerFilterTable_Create,
    JoltC_ObjectVsBroadPhaseLayerFilter_Destroy,
    JoltC_PhysicsSystem_Create, JoltC_PhysicsSystem_Destroy,
    JoltC_PhysicsSystem_Init, JoltC_PhysicsSystem_Update,
    JoltC_PhysicsSystem_SetGravity,
    JoltC_PhysicsSystem_GetBodyInterface,
    JoltC_BodyCreationSettings_Create3,
    JoltC_BodyCreationSettings_Destroy,
    JoltC_BodyCreationSettings_SetFriction,
    JoltC_BodyCreationSettings_SetRestitution,
    JoltC_BodyInterface_CreateAndAddBody,
    JoltC_BodyInterface_DestroyBody,
    JoltC_BodyInterface_GetPosition,
    JoltC_BodyInterface_GetRotation,
    JoltC_BodyInterface_SetLinearVelocity,
    JoltC_BoxShape_Create, JoltC_SphereShape_Create,
    JoltC_Shape_Release
};

pub const u32 DEFAULT_CAPACITY = 4096;

pub struct BodyRecord
{
    EntityId entity;
    BodyID body;
}

pub struct PhysicsWorld
{
    Scene* scene;
    PhysicsSystem system;
    BodyInterface bodies;
    TempAllocator temp;
    JobSystem jobs;
    ObjectLayerPairFilter objectFilter;
    BroadPhaseLayerInterface broadPhase;
    ObjectVsBroadPhaseLayerFilter broadPhaseFilter;
    BodyRecord* records;
    u32 capacity;
    u32 count;
    Vec3 gravity;
    bool joltReady;
    bool started;
}

pub PhysicsWorld physicsWorld(BodyRecord* records, u32 capacity)
{
    return PhysicsWorld {
        .scene = null,
        .system = null,
        .bodies = null,
        .temp = null,
        .jobs = null,
        .objectFilter = null,
        .broadPhase = null,
        .broadPhaseFilter = null,
        .records = records,
        .capacity = capacity,
        .count = 0,
        .gravity = Vec3::new(0.0f, -9.81f, 0.0f),
        .joltReady = false,
        .started = false
    };
}

// One JoltC world per process (JoltC_Init/Shutdown are global).
pub bool start(PhysicsWorld* world, Scene* scene, Vec3 gravity)
{
    if (world == null || scene == null) return false;
    if (world->started) return true;
    if (world->records == null || world->capacity == 0) return false;

    world->scene = scene;
    if (JoltC_Init() == 0) return false;
    world->joltReady = true;

    world->temp = JoltC_TempAllocator_Create(16u * 1024u * 1024u);
    world->jobs = JoltC_JobSystemThreadPool_Create(2048, 8, 1);
    world->objectFilter = JoltC_ObjectLayerPairFilterTable_Create(1);
    world->broadPhase = JoltC_BroadPhaseLayerInterfaceTable_Create(1, 1);
    world->broadPhaseFilter = JoltC_ObjectVsBroadPhaseLayerFilterTable_Create(
        world->broadPhase, 1, world->objectFilter, 1);

    if (world->temp == null || world->jobs == null ||
        world->objectFilter == null || world->broadPhase == null ||
        world->broadPhaseFilter == null)
    {
        stop(world);
        return false;
    }

    JoltC_ObjectLayerPairFilterTable_EnableCollision(world->objectFilter, 0, 0);
    JoltC_BroadPhaseLayerInterfaceTable_MapObjectToBroadPhaseLayer(world->broadPhase, 0, 0);

    world->system = JoltC_PhysicsSystem_Create();
    if (world->system == null)
    {
        stop(world);
        return false;
    }

    JoltC_PhysicsSystem_Init(
        world->system, world->capacity,
        0, 1024, 1024, world->broadPhase,
        world->broadPhaseFilter,
        world->objectFilter
    );
    
    JoltC_PhysicsSystem_SetGravity(world->system, gravity);
    world->gravity = gravity;

    world->bodies = JoltC_PhysicsSystem_GetBodyInterface(world->system);
    if (world->bodies == null)
    {
        stop(world);
        return false;
    }

    world->started = true;
    return true;
}

pub void stop(PhysicsWorld* world)
{
    if (world == null) return;

    if (world->system != null)
    {
        if (world->bodies != null)
        {
            for (u32 i = 0; i < world->count; i++)
                JoltC_BodyInterface_DestroyBody(world->bodies, world->records[i].body);
        }
        JoltC_PhysicsSystem_Destroy(world->system);
    }

    if (world->broadPhaseFilter != null)
        JoltC_ObjectVsBroadPhaseLayerFilter_Destroy(world->broadPhaseFilter);
    if (world->broadPhase != null)
        JoltC_BroadPhaseLayerInterface_Destroy(world->broadPhase);
    if (world->objectFilter != null)
        JoltC_ObjectLayerPairFilter_Destroy(world->objectFilter);
    if (world->jobs != null)
        JoltC_JobSystem_Destroy(world->jobs);
    if (world->temp != null)
        JoltC_TempAllocator_Destroy(world->temp);
    if (world->joltReady)
        JoltC_Shutdown();

    world->scene = null;
    world->system = null;
    world->bodies = null;
    world->temp = null;
    world->jobs = null;
    world->objectFilter = null;
    world->broadPhase = null;
    world->broadPhaseFilter = null;
    world->count = 0;
    world->joltReady = false;
    world->started = false;
}

Result<u32, str> _addShape(PhysicsWorld* world, EntityId entity, Shape shape, bool dynamic)
{
    if (world == null || !world->started)
        return Result<u32, str>::Err { .error = "physics: world not started" };
    if (world->scene == null)
        return Result<u32, str>::Err { .error = "physics: no scene bound" };
    if (!world->scene->alive(entity))
        return Result<u32, str>::Err { .error = "physics: entity is dead or invalid" };
    if (world->scene->entities[entity].parent != NIL)
        return Result<u32, str>::Err { .error = "physics: body entity must be a root" };
    if (world->count >= world->capacity)
        return Result<u32, str>::Err { .error = "physics: body table full" };
    if (shape == null)
        return Result<u32, str>::Err { .error = "physics: shape creation failed" };

    Entity* e = &world->scene->entities[entity];
    Vec3 p = e->local.position;
    Quat q = e->local.rotation;
    RVec3 position = RVec3 { .x = p.x, .y = p.y, .z = p.z };
    i32 motion = MOTION_STATIC;
    if (dynamic) motion = MOTION_DYNAMIC;

    BodyCreationSettings settings = JoltC_BodyCreationSettings_Create3(
        shape, position, q, motion, 0);
    if (settings == null)
    {
        JoltC_Shape_Release(shape);
        return Result<u32, str>::Err { .error = "physics: body settings creation failed" };
    }

    JoltC_BodyCreationSettings_SetFriction(settings, 0.5f);
    JoltC_BodyCreationSettings_SetRestitution(settings, 0.0f);
    
    BodyID body = JoltC_BodyInterface_CreateAndAddBody(world->bodies, settings, ACTIVATE);
    
    JoltC_BodyCreationSettings_Destroy(settings);
    JoltC_Shape_Release(shape);

    if (body == BODY_ID_INVALID)
        return Result<u32, str>::Err { .error = "physics: body creation failed" };

    BodyRecord* record = &world->records[world->count];
    record->entity = entity;
    record->body = body;
    world->count = world->count + 1;
    return Result<u32, str>::Ok { .value = body };
}

pub Result<u32, str> addBox(PhysicsWorld* world, EntityId entity, Vec3 halfExtent, bool dynamic)
{
    Shape shape = JoltC_BoxShape_Create(halfExtent, 0.05f);
    return _addShape(world, entity, shape, dynamic);
}

pub Result<u32, str> addSphere(PhysicsWorld* world, EntityId entity, f32 radius, bool dynamic)
{
    Shape shape = JoltC_SphereShape_Create(radius);
    return _addShape(world, entity, shape, dynamic);
}

i32 _find(PhysicsWorld* world, EntityId entity)
{
    if (world == null) return -1;
    for (u32 i = 0; i < world->count; i++)
    {
        if (world->records[i].entity == entity) return (i32)i;
    }
    return -1;
}

pub bool destroyBody(PhysicsWorld* world, EntityId entity)
{
    i32 index = _find(world, entity);
    if (index < 0) return false;

    u32 i = (u32)index;
    JoltC_BodyInterface_DestroyBody(world->bodies, world->records[i].body);
    world->count = world->count - 1;
    if (i < world->count)
        world->records[i] = world->records[world->count];
    return true;
}

pub bool setLinearVelocity(PhysicsWorld* world, EntityId entity, Vec3 velocity)
{
    i32 index = _find(world, entity);
    if (index < 0) return false;
    JoltC_BodyInterface_SetLinearVelocity(world->bodies, world->records[(u32)index].body, velocity);
    return true;
}

// One fixed step, then copy Jolt transforms back into root entities. The
// scene update that follows composes world transforms for children.
pub u32 step(PhysicsWorld* world, f32 dt)
{
    if (world == null || !world->started) return 0;
    if (dt <= 0.0f) return world->count;

    u32 error = JoltC_PhysicsSystem_Update(world->system, dt, 1, world->temp, world->jobs);
    if (error != 0) return world->count;

    for (u32 i = 0; i < world->count; i++)
    {
        EntityId entity = world->records[i].entity;
        if (!world->scene->alive(entity)) continue;
        if (world->scene->entities[entity].parent != NIL) continue;

        RVec3 p = JoltC_BodyInterface_GetPosition(world->bodies, world->records[i].body);
        Quat q = JoltC_BodyInterface_GetRotation(world->bodies, world->records[i].body);
        Entity* e = &world->scene->entities[entity];
        e->local.position = Vec3::new(p.x, p.y, p.z);
        e->local.rotation = Quat::new(q.x, q.y, q.z, q.w);
    }
    return world->count;
}

// Loop slot: core only sees a raw context + function pointer.
pub void physicsSystem(rawptr ctx, f32 dt)
{
    step((PhysicsWorld*)ctx, dt);
}
