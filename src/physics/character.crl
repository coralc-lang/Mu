/* Kinematic character built on Jolt's CharacterVirtual. It is not a rigid
   body: movement, ground checks, and stepping are explicit, which keeps the
   controller responsive and lets gameplay own the velocity. */

use math::math { Vec3, Quat, RVec3 };
use scene::scene { Entity, EntityId, NIL };
use physics::world { PhysicsWorld };
use physics::layers {
    hasLayer, objectLayerFor, LayerFilters,
    layerFilters, layerFiltersReady, destroyLayerFilters
};
use thirdparty::jolt {
    CharacterVirtual, CharacterVirtualSettings, ExtendedUpdateSettings, Shape, JoltC_CapsuleShape_Create,
    JoltC_Shape_Release, JoltC_CharacterVirtualSettings_SetDefault, JoltC_ExtendedUpdateSettings_SetDefault,
    JoltC_CharacterVirtual_Create, JoltC_CharacterVirtual_Destroy, JoltC_CharacterVirtual_GetLinearVelocity,
    JoltC_CharacterVirtual_SetLinearVelocity, JoltC_CharacterVirtual_GetPosition, JoltC_CharacterVirtual_SetPosition,
    JoltC_CharacterVirtual_GetRotation, JoltC_CharacterVirtual_ExtendedUpdate_WithFilters,
    JoltC_CharacterVirtual_IsSupported, JoltC_CharacterVirtual_GetGroundState, JoltC_CharacterVirtual_GetGroundNormal
};

/// Capsule size and movement tuning passed to `characterCreate`.
pub struct CharacterConfig
{
    f32 radius;
    f32 halfHeight;
    f32 maxSlopeAngle;
    f32 mass;
    f32 maxStrength;
    u32 layer;
}

/// Sensible human-scale defaults (about 1.8 m tall, 70 kg).
pub CharacterConfig characterConfig()
{
    return CharacterConfig {
        .radius = 0.35f,
        .halfHeight = 0.55f,
        .maxSlopeAngle = 0.8726646f,
        .mass = 70.0f,
        .maxStrength = 100.0f,
        .layer = 0
    };
}

/// A live character handle plus the cached state gameplay reads each frame.
pub struct Character
{
    CharacterVirtual handle;
    EntityId entity;
    u32 layer;
    f32 radius;
    f32 halfHeight;
    Vec3 velocity;
    bool grounded;
}

// Vec3 and RVec3 share a layout; this keeps the conversion explicit at the
// Jolt boundary instead of relying on casts.
RVec3 _rvec(Vec3 p)
{
    return RVec3 { .x = p.x, .y = p.y, .z = p.z };
}

// A missing layer means "collide with nothing", not "collide with everything".
LayerFilters _characterFilters(PhysicsWorld* world, const Character* character)
{
    if (world == null || character == null) return LayerFilters { .broadPhase = null, .object = null };
    if (!hasLayer(&world->layers, character->layer)) return LayerFilters { .broadPhase = null, .object = null };
    return layerFilters(world->system, objectLayerFor(&world->layers, character->layer));
}

/// Copies the character's Jolt position/rotation into its scene entity.
pub void characterSync(PhysicsWorld* world, Character* character)
{
    if (world == null || character == null || character->handle == null) return;
    if (world->scene == null || !world->scene->alive(character->entity)) return;

    RVec3 p = JoltC_CharacterVirtual_GetPosition(character->handle);
    Quat q = JoltC_CharacterVirtual_GetRotation(character->handle);
    Entity* entity = &world->scene->entities[character->entity];
    entity->local.position = Vec3::new(p.x, p.y, p.z);
    entity->local.rotation = Quat::new(q.x, q.y, q.z, q.w);
}

/// Creates a capsule character at the entity's current local transform. The
/// entity must be a live root; the character is not attached as a rigid body.
pub Result<Character, str> characterCreate(PhysicsWorld* world, EntityId entity, CharacterConfig config)
{
    if (world == null || !world->started)
        return Result<Character, str>::Err { .error = "character: world not started" };
    if (world->scene == null)
        return Result<Character, str>::Err { .error = "character: no scene bound" };
    if (!world->scene->alive(entity))
        return Result<Character, str>::Err { .error = "character: entity is dead or invalid" };
    if (world->scene->entities[entity].parent != NIL)
        return Result<Character, str>::Err { .error = "character: entity must be a root" };
    if (config.radius <= 0.0f || config.halfHeight <= 0.0f)
        return Result<Character, str>::Err { .error = "character: invalid capsule size" };
    if (!hasLayer(&world->layers, config.layer))
        return Result<Character, str>::Err { .error = "character: layer out of range" };

    Shape shape = JoltC_CapsuleShape_Create(config.halfHeight, config.radius);
    if (shape == null)
        return Result<Character, str>::Err { .error = "character: capsule creation failed" };

    CharacterVirtualSettings settings;
    JoltC_CharacterVirtualSettings_SetDefault(&settings);
    // Y-up. The supporting volume starts at the capsule bottom so small
    // ledges count as ground instead of letting the character hover.
    settings.up = Vec3::new(0.0f, 1.0f, 0.0f);
    settings.maxSlopeAngle = config.maxSlopeAngle;
    settings.enhancedInternalEdgeRemoval = 1;
    settings.shape = shape;
    settings.supportingVolumeNormal = Vec3::new(0.0f, 1.0f, 0.0f);
    settings.supportingVolumeConstant = -config.halfHeight;
    settings.mass = config.mass;
    settings.maxStrength = config.maxStrength;

    Entity* source = &world->scene->entities[entity];
    CharacterVirtual handle = JoltC_CharacterVirtual_Create(
        &settings, _rvec(source->local.position), source->local.rotation,
        (u64)entity, world->system);
    JoltC_Shape_Release(shape);

    if (handle == null)
        return Result<Character, str>::Err { .error = "character: create failed" };

    return Result<Character, str>::Ok {
        .value = Character {
            .handle = handle,
            .entity = entity,
            .layer = config.layer,
            .radius = config.radius,
            .halfHeight = config.halfHeight,
            .velocity = Vec3::zero(),
            .grounded = false
        }
    };
}

/// Moves with the given horizontal velocity while keeping vertical motion
/// under the character's own gravity/ground state.
pub void characterMove(PhysicsWorld* world, Character* character, Vec3 horizontalVelocity, f32 dt)
{
    if (world == null || character == null || character->handle == null) return;
    if (!world->started || dt <= 0.0f) return;

    // Horizontal speed is caller-driven. Vertical is ours: cancel downward
    // drift on the ground, otherwise integrate the world's gravity.
    Vec3 current = JoltC_CharacterVirtual_GetLinearVelocity(character->handle);
    f32 vertical = current.y;
    if (character->grounded) {
        if (vertical < 0.0f) vertical = 0.0f;
    }
    else {
        vertical = vertical + world->gravity.y * dt;
    }
    JoltC_CharacterVirtual_SetLinearVelocity(
        character->handle,
        Vec3::new(horizontalVelocity.x, vertical, horizontalVelocity.z));

    LayerFilters filters = _characterFilters(world, character);
    ExtendedUpdateSettings update;
    JoltC_ExtendedUpdateSettings_SetDefault(&update);
    JoltC_CharacterVirtual_ExtendedUpdate_WithFilters(
        character->handle, dt, world->gravity, &update,
        filters.broadPhase, filters.object, null, null, world->temp);
    destroyLayerFilters(&filters);

    character->grounded = JoltC_CharacterVirtual_IsSupported(character->handle) != 0;
    character->velocity = JoltC_CharacterVirtual_GetLinearVelocity(character->handle);
    characterSync(world, character);
}

/// Requests a jump. Returns false when airborne or the speed is invalid.
pub bool characterJump(Character* character, f32 speed)
{
    if (character == null || character->handle == null) return false;
    if (!character->grounded || speed <= 0.0f) return false;

    Vec3 velocity = JoltC_CharacterVirtual_GetLinearVelocity(character->handle);
    JoltC_CharacterVirtual_SetLinearVelocity(
        character->handle, Vec3::new(velocity.x, speed, velocity.z));
    character->velocity = Vec3::new(velocity.x, speed, velocity.z);
    character->grounded = false;
    return true;
}

/// Moves the character immediately, bypassing collision resolution.
pub void characterTeleport(PhysicsWorld* world, Character* character, Vec3 position)
{
    if (character == null || character->handle == null) return;
    JoltC_CharacterVirtual_SetPosition(character->handle, _rvec(position));
    characterSync(world, character);
}

/// Current world-space position.
pub Vec3 characterPosition(const Character* character)
{
    if (character == null || character->handle == null) return Vec3::zero();
    RVec3 p = JoltC_CharacterVirtual_GetPosition(character->handle);
    return Vec3::new(p.x, p.y, p.z);
}

/// Current linear velocity, including the vertical component.
pub Vec3 characterVelocity(const Character* character)
{
    if (character == null || character->handle == null) return Vec3::zero();
    return JoltC_CharacterVirtual_GetLinearVelocity(character->handle);
}

/// Surface normal of the ground under the character.
pub Vec3 characterGroundNormal(const Character* character)
{
    if (character == null || character->handle == null) return Vec3::zero();
    return JoltC_CharacterVirtual_GetGroundNormal(character->handle);
}

/// Raw Jolt ground state (on ground, on steep ground, in air, ...).
pub i32 characterGroundState(const Character* character)
{
    if (character == null || character->handle == null) return 0;
    return JoltC_CharacterVirtual_GetGroundState(character->handle);
}

/// True when the last move ended supported by ground.
pub bool characterGrounded(const Character* character)
{
    return character != null && character->handle != null && character->grounded;
}

/// Collision layer this character queries against.
pub u32 characterLayer(const Character* character)
{
    if (character == null) return 0;
    return character->layer;
}

/// Destroys the Jolt character and resets the handle to null.
pub void characterDestroy(Character* character)
{
    if (character == null) return;
    if (character->handle != null)
        JoltC_CharacterVirtual_Destroy(character->handle);
    character->handle = null;
    character->entity = NIL;
    character->velocity = Vec3::zero();
    character->grounded = false;
}
