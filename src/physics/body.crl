/* Dynamic and static rigid bodies. Spawning always creates a Jolt shape,
   makes a body at the entity's local transform, and stores the entity/body
   pair in the world's flat record table. */

use math::math { Vec3, Quat, RVec3 };
use physics::layers { hasLayer, objectLayerFor };
use physics::world { BodyRecord, PhysicsWorld };
use scene::scene { Entity, EntityId, NIL };
use thirdparty::jolt {
    Shape, BodyCreationSettings, BodyID, ObjectLayer,
    BODY_ID_INVALID, MOTION_STATIC, MOTION_DYNAMIC, ACTIVATE,
    JoltC_BodyCreationSettings_Create3,
    JoltC_BodyCreationSettings_Destroy,
    JoltC_BodyCreationSettings_SetFriction,
    JoltC_BodyCreationSettings_SetRestitution,
    JoltC_BodyInterface_CreateAndAddBody,
    JoltC_BodyInterface_DestroyBody,
    JoltC_BodyInterface_SetLinearVelocity,
    JoltC_BoxShape_Create, JoltC_SphereShape_Create,
    JoltC_Shape_Release
};

Result<u32, str> _addShape(PhysicsWorld* world, EntityId entity, Shape shape, bool dynamic, u32 layer)
{
    if (world == null || !world->started)
        return Result<u32, str>::Err { .error = "physics: world not started" };
    if (world->scene == null)
        return Result<u32, str>::Err { .error = "physics: no scene bound" };
    if (!world->scene->alive(entity))
        return Result<u32, str>::Err { .error = "physics: entity is dead or invalid" };
    if (world->scene->entities[entity].parent != NIL)
        return Result<u32, str>::Err { .error = "physics: body entity must be a root" };
    if (world->count >= world->capacity)
        return Result<u32, str>::Err { .error = "physics: body table full" };
    if (shape == null)
        return Result<u32, str>::Err { .error = "physics: shape creation failed" };
    if (!hasLayer(&world->layers, layer))
    {
        JoltC_Shape_Release(shape);
        return Result<u32, str>::Err { .error = "physics: layer out of range" };
    }

    Entity* e = &world->scene->entities[entity];
    Vec3 p = e->local.position;
    Quat q = e->local.rotation;
    RVec3 position = RVec3 { .x = p.x, .y = p.y, .z = p.z };
    i32 motion = MOTION_STATIC;
    if (dynamic) motion = MOTION_DYNAMIC;

    ObjectLayer objectLayer = objectLayerFor(&world->layers, layer);
    BodyCreationSettings settings = JoltC_BodyCreationSettings_Create3(
        shape, position, q, motion, objectLayer);
    if (settings == null)
    {
        JoltC_Shape_Release(shape);
        return Result<u32, str>::Err { .error = "physics: body settings creation failed" };
    }

    // Conservative defaults for now; per-material tuning comes later.
    JoltC_BodyCreationSettings_SetFriction(settings, 0.5f);
    JoltC_BodyCreationSettings_SetRestitution(settings, 0.0f);
    
    BodyID body = JoltC_BodyInterface_CreateAndAddBody(world->bodies, settings, ACTIVATE);
    
    JoltC_BodyCreationSettings_Destroy(settings);
    JoltC_Shape_Release(shape);

    if (body == BODY_ID_INVALID)
        return Result<u32, str>::Err { .error = "physics: body creation failed" };

    BodyRecord* record = &world->records[world->count];
    record->entity = entity;
    record->body = body;
    record->layer = layer;
    world->count = world->count + 1;
    return Result<u32, str>::Ok { .value = body };
}

/// Creates a box body on layer 0.
pub Result<u32, str> addBox(PhysicsWorld* world, EntityId entity, Vec3 halfExtent, bool dynamic)
{
    return addBoxOnLayer(world, entity, halfExtent, dynamic, 0);
}

/// Creates a box body on a specific collision layer.
pub Result<u32, str> addBoxOnLayer(PhysicsWorld* world, EntityId entity, Vec3 halfExtent, bool dynamic, u32 layer)
{
    Shape shape = JoltC_BoxShape_Create(halfExtent, 0.05f);
    return _addShape(world, entity, shape, dynamic, layer);
}

/// Creates a sphere body on layer 0.
pub Result<u32, str> addSphere(PhysicsWorld* world, EntityId entity, f32 radius, bool dynamic)
{
    return addSphereOnLayer(world, entity, radius, dynamic, 0);
}

/// Creates a sphere body on a specific collision layer.
pub Result<u32, str> addSphereOnLayer(PhysicsWorld* world, EntityId entity, f32 radius, bool dynamic, u32 layer)
{
    Shape shape = JoltC_SphereShape_Create(radius);
    return _addShape(world, entity, shape, dynamic, layer);
}

i32 _find(PhysicsWorld* world, EntityId entity)
{
    if (world == null) return -1;
    for (u32 i = 0; i < world->count; i++)
    {
        if (world->records[i].entity == entity) return (i32)i;
    }
    return -1;
}

/// Destroys the body for an entity. The record table uses swap-remove, so
/// order is not stable after this call.
pub bool destroyBody(PhysicsWorld* world, EntityId entity)
{
    i32 index = _find(world, entity);
    if (index < 0) return false;

    u32 i = (u32)index;
    JoltC_BodyInterface_DestroyBody(world->bodies, world->records[i].body);
    world->count = world->count - 1;
    if (i < world->count)
        world->records[i] = world->records[world->count];
    return true;
}

/// Overwrites the linear velocity of an entity's body.
pub bool setLinearVelocity(PhysicsWorld* world, EntityId entity, Vec3 velocity)
{
    i32 index = _find(world, entity);
    if (index < 0) return false;
    JoltC_BodyInterface_SetLinearVelocity(world->bodies, world->records[index].body, velocity);
    return true;
}
