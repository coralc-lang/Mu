/* Core engine loop: logging, frame stats, and the fixed-step tick.
 * The body is callable as `frame()` from day one so the Web main-callback
 * build can drive it directly. Headless tests still use the same 1/60 tick. */

use scene::scene { Scene };
use render::render { Renderer };
use render::extract { DrawItem, DrawList, extractScene };
use platform::platform {
    platformPump, platformQuitRequested, platformConsumeResize
};
import std::time { nowMonotonic, timespecToF64 };

/// Simulation step used by the fixed-timestep loop.
pub const f32 FIXED_DT = 1.0f / 60.0f;
const f64 STATS_INTERVAL_SECONDS = 1.0;
const f64 MAX_FRAME_TIME = 0.25;

/// Writes a normal engine log line with the `[mu]` prefix.
pub void logInfo(str msg)
{
    println("[mu] {}", msg);
}

/// Writes an error line with the `[mu:error]` prefix.
pub void logError(str msg)
{
    println("[mu:error] {}", msg);
}

void _nullScriptUpdate(rawptr ctx, f32 dt)
{
    // no script host wired (M1 default) - engine/main swaps in scriptSystem
}

static DrawItem[4096] MuDrawItems;

/// Drives one scene and renderer pair in a fixed order every frame.
pub struct Loop
{
    Scene* scene;
    Renderer* renderer;
    DrawList drawList;
    rawptr scriptCtx;                // ScriptHost* - wired by engine/main (M1)
    void(rawptr, f32) scriptUpdate;  // script.update(dt); null host until wired
    rawptr physicsCtx;               // PhysicsWorld* - supplied by the caller
    void(rawptr, f32) physicsUpdate; // physics.step(dt)
    rawptr ui;            // null until M6, passed through to the renderer
    u64 frameCount;
    u64 statsFrame;
    u64 simTicks;
    f64 statsTime;
    f64 lastTime;
    f64 accumulator;
    f64 worstFrame;
    bool running;
    f32 dt;

    /// Builds a loop with a required physics slot and a no-op script slot
    /// until a script host is wired.
    static Loop new(Scene* scene, Renderer* renderer,
        rawptr physicsCtx, void(rawptr, f32) physicsUpdate)
    {
        f64 start = timespecToF64(nowMonotonic());
        return Loop {
            .scene = scene,
            .renderer = renderer,
            .drawList = DrawList::new(MuDrawItems, 4096),
            .scriptCtx = null,
            .scriptUpdate = _nullScriptUpdate,
            .physicsCtx = physicsCtx,
            .physicsUpdate = physicsUpdate,
            .ui = null,
            .frameCount = 0,
            .statsFrame = 0,
            .simTicks = 0,
            .statsTime = start,
            .lastTime = start,
            .accumulator = 0.0,
            .worstFrame = 0.0,
            .running = false,
            .dt = FIXED_DT
        };
    }

    void _logStats()
    {
        f64 now = timespecToF64(nowMonotonic());
        f64 elapsed = now - self.statsTime;
        if (elapsed < STATS_INTERVAL_SECONDS) return;
        u64 frames = self.frameCount - self.statsFrame;
        f64 fps = (f64)frames / elapsed;
        f64 avgMs = elapsed / (f64)frames * 1000.0;
        f64 worstMs = self.worstFrame * 1000.0;
        println("[mu] frame stats: frames={} total={} ticks={} elapsed={} fps={} avg_ms={} worst_ms={}",
            frames, self.frameCount, self.simTicks, elapsed, fps, avgMs, worstMs);
        self.statsFrame = self.frameCount;
        self.statsTime = now;
        self.worstFrame = 0.0;
    }

    void _beginFrame()
    {
        platformPump();
        i32 resizeWidth = 0;
        i32 resizeHeight = 0;
        if (platformConsumeResize(&resizeWidth, &resizeHeight))
            self.renderer->resize(
                self.renderer->ctx, resizeWidth, resizeHeight);
    }

    void _simulate(f32 dt)
    {
        self.simTicks = self.simTicks + 1;
        self.physicsUpdate(self.physicsCtx, dt);
        self.scene->update(dt);
        self.scriptUpdate(self.scriptCtx, dt);
    }

    void _present()
    {
        extractScene(self.scene, &self.drawList);
        self.renderer->draw(
            self.renderer->ctx, (rawptr)&self.drawList, self.ui);
        self.frameCount++;
        self._logStats();
    }

    /// Runs one frame in the fixed engine order. Missing layers stay stubbed
    /// until their milestone, but the call sites already match the final order.
    void frame()
    {
        self._beginFrame();

        f64 now = timespecToF64(nowMonotonic());
        f64 elapsed = now - self.lastTime;
        self.lastTime = now;
        if (elapsed < 0.0) elapsed = 0.0;
        if (elapsed > MAX_FRAME_TIME) elapsed = MAX_FRAME_TIME;
        if (elapsed > self.worstFrame) self.worstFrame = elapsed;
        self.accumulator = self.accumulator + elapsed;

        f64 step = (f64)self.dt;
        while (self.accumulator >= step)
        {
            self._simulate(self.dt);
            self.accumulator = self.accumulator - step;
        }

        self._present();
    }

    /// Runs a fixed number of frames. Primarily used by tests and probes.
    void run(u64 frames)
    {
        self.running = true;
        self.accumulator = 0.0;
        self.lastTime = timespecToF64(nowMonotonic());
        u64 i = 0;
        while (self.running && i < frames)
        {
            if (platformQuitRequested()) break;
            self._beginFrame();
            self._simulate(self.dt);
            self._present();
            i++;
        }
        self.running = false;
    }

    /// Runs until the platform or a script asks the engine to quit.
    void runUntilQuit()
    {
        self.running = true;
        while (self.running && !platformQuitRequested())
        {
            self.frame();
        }
        self.running = false;
    }
}
