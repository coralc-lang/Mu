/* Core engine loop: logging, frame stats, and the fixed-step tick.
 * The body is callable as `frame()` from day one so the Web main-callback
 * build can drive it directly. Headless tests still use the same 1/60 tick. 
 */

use scene::scene { Scene };
use render::render { Renderer };
use platform::platform {
    platformPump, platformQuitRequested, platformConsumeResize
};
import std::time { nowMonotonic, timespecToF64 };

/// Simulation step used by the fixed-timestep loop.
pub const f32 FIXED_DT = 1.0f / 60.0f;
const f64 STATS_INTERVAL_SECONDS = 1.0;

/// Writes a normal engine log line with the `[mu]` prefix.
pub void logInfo(str msg)
{
    println("[mu] {}", msg);
}

/// Writes an error line with the `[mu:error]` prefix.
pub void logError(str msg)
{
    println("[mu:error] {}", msg);
}

void _nullScriptUpdate(rawptr ctx, f32 dt)
{
    // no script host wired (M1 default) - engine/main swaps in scriptSystem
}

void _nullPhysicsUpdate(rawptr ctx, f32 dt)
{
    // no physics world wired - engine/main swaps in physicsSystem
}

/// Drives one scene and renderer pair in a fixed order every frame.
pub struct Loop
{
    Scene* scene;
    Renderer* renderer;
    rawptr scriptCtx;                // ScriptHost* - wired by engine/main (M1)
    void(rawptr, f32) scriptUpdate;  // §6 slot: script.update(dt)
    rawptr physicsCtx;               // PhysicsWorld* - wired by engine/main
    void(rawptr, f32) physicsUpdate; // §6 slot: physics.step(dt)
    rawptr ui;            // null until M6, passed through to the renderer
    u64 frameCount;
    u64 statsFrame;
    f64 statsTime;
    bool running;
    f32 dt;

    /// Builds a loop with no-op physics/script slots; engine/main swaps in
    /// the real systems once they are up.
    static Loop new(Scene* scene, Renderer* renderer)
    {
        f64 start = timespecToF64(nowMonotonic());
        return Loop {
            .scene = scene,
            .renderer = renderer,
            .scriptCtx = null,
            .scriptUpdate = _nullScriptUpdate,
            .physicsCtx = null,
            .physicsUpdate = _nullPhysicsUpdate,
            .ui = null,
            .frameCount = 0,
            .statsFrame = 0,
            .statsTime = start,
            .running = false,
            .dt = FIXED_DT
        };
    }

    void _logStats()
    {
        f64 now = timespecToF64(nowMonotonic());
        f64 elapsed = now - self.statsTime;
        if (elapsed < STATS_INTERVAL_SECONDS) return;
        u64 frames = self.frameCount - self.statsFrame;
        f64 fps = (f64)frames / elapsed;
        println("[mu] frame stats: frames={} total={} elapsed={} fps={}",
            frames, self.frameCount, elapsed, fps);
        self.statsFrame = self.frameCount;
        self.statsTime = now;
    }

    /// Runs one frame in ENGINE.md §6 order. Missing layers stay stubbed
    /// until their milestone, but the call sites already match the final order.
    void frame()
    {
        // dt = clock.tick()            fixed/deterministic until M3
        platformPump();
        i32 resizeWidth = 0;
        i32 resizeHeight = 0;
        if (platformConsumeResize(&resizeWidth, &resizeHeight))
            self.renderer->resize(
                self.renderer->ctx, resizeWidth, resizeHeight);
        self.physicsUpdate(self.physicsCtx, self.dt); // fixed-step Jolt update + scene sync
        self.scene->update(self.dt);
        self.scriptUpdate(self.scriptCtx, self.dt);   // M1: ScriptHost slot (M2 runs IR)
        // ui.frame()                   M6
        self.renderer->draw(self.renderer->ctx, (rawptr)self.scene, self.ui);
        self.frameCount++;
        self._logStats();
    }

    /// Runs a fixed number of frames. Primarily used by tests and probes.
    void run(u64 frames)
    {
        self.running = true;
        u64 i = 0;
        while (self.running && i < frames)
        {
            if (platformQuitRequested()) break;
            self.frame();
            i++;
        }
        self.running = false;
    }

    /// Runs until the platform or a script asks the engine to quit.
    void runUntilQuit()
    {
        self.running = true;
        while (self.running && !platformQuitRequested())
        {
            self.frame();
        }
        self.running = false;
    }
}
