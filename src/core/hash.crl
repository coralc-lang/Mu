/* ABI hashing for compiler-emitted symbol names.
 * We never rebuild or demangle a name at runtime; we hash the exact canonical
 * bytes the compiler produced. No random seed, so hashes survive runs, machines,
 * and hot reloads.
 */

/// Starting value for FNV-1a 64. Also used as the hash of a null string.
pub const u64 FNV1A_OFFSET_BASIS = 0xcbf29ce484222325;

/// FNV-1a 64 multiply step.
pub const u64 FNV1A_PRIME = 0x100000001b3;

/// Hashes a raw byte range with FNV-1a 64.
pub u64 hashBytes(const u8* bytes, usize len)
{
    u64 h = FNV1A_OFFSET_BASIS;
    for (usize i = 0; i < len; i++)
    {
        h = h ^ (u64)bytes[i];
        h = h * FNV1A_PRIME;
    }
    return h;
}

/// Hashes a Coral string without including the terminator.
pub u64 hashStr(str text)
{
    return hashBytes(text.ptr, text.len);
}

/// Hashes a NUL-terminated C string. Null hashes to the offset basis.
pub u64 hashCstr(const cchar* text)
{
    if (text == null) return FNV1A_OFFSET_BASIS;
    u64 h = FNV1A_OFFSET_BASIS;
    usize i = 0;
    while (text[i] != 0)
    {
        h = h ^ (u64)(u8)text[i];
        h = h * FNV1A_PRIME;
        i = i + 1;
    }
    return h;
}
