/* Shared math types (ENGINE.md §3): Vec2/Vec3/Vec4/Quat/RVec3 and the
   operations used by scene and physics. Everything is f32 because JoltC is
   built single precision, which also lets these structs cross the C ABI as-is.
   Operations are methods so call sites stay readable: pos.add(q.rotate(off)). */

use std::math { F32 };

/// Two-component float32 vector.
pub struct Vec2
{
    f32 x;
    f32 y;

    /// Creates a vector from its components.
    static Vec2 new(f32 x, f32 y)
    {
        return Vec2 { .x = x, .y = y };
    }

    /// Returns the component-wise sum with other.
    Vec2 add(Vec2 other)
    {
        return Vec2 {
            .x = self.x + other.x,
            .y = self.y + other.y
        };
    }

    /// Returns the component-wise difference with other.
    Vec2 sub(Vec2 other)
    {
        return Vec2 {
            .x = self.x - other.x,
            .y = self.y - other.y
        };
    }

    /// Returns the negated vector.
    Vec2 neg()
    {
        return Vec2 { .x = -self.x, .y = -self.y };
    }

    /// Returns the vector scaled by s.
    Vec2 scale(f32 s)
    {
        return Vec2 { .x = self.x * s, .y = self.y * s };
    }

    /// Returns the dot product with other.
    f32 dot(Vec2 other)
    {
        return self.x * other.x + self.y * other.y;
    }

    /// Returns the squared length.
    f32 lengthSq()
    {
        return self.x * self.x + self.y * self.y;
    }

    /// Returns the length.
    f32 length()
    {
        return F32::sqrt(self.lengthSq());
    }

    /// Returns a unit-length vector, or this vector when its length is near zero.
    Vec2 normalize()
    {
        f32 len = self.length();
        if (len < 1e-15) return *self;
        return self.scale(1.0 / len);
    }

    /// Linearly interpolates from this vector to other by t.
    Vec2 lerp(Vec2 other, f32 t)
    {
        return Vec2 {
            .x = self.x + (other.x - self.x) * t,
            .y = self.y + (other.y - self.y) * t
        };
    }
}

/// Three-component float32 vector.
pub struct Vec3
{
    f32 x;
    f32 y;
    f32 z;

    /// Creates a vector from its components.
    static Vec3 new(f32 x, f32 y, f32 z)
    {
        return Vec3 { .x = x, .y = y, .z = z };
    }

    /// Returns the zero vector.
    static Vec3 zero()
    {
        return Vec3 { .x = 0.0f, .y = 0.0f, .z = 0.0f };
    }

    /// Returns the vector with every component equal to 1.
    static Vec3 one()
    {
        return Vec3 { .x = 1.0f, .y = 1.0f, .z = 1.0f };
    }

    /// Returns the component-wise sum with other.
    Vec3 add(Vec3 other)
    {
        return Vec3 {
            .x = self.x + other.x,
            .y = self.y + other.y,
            .z = self.z + other.z
        };
    }

    /// Returns the component-wise difference with other.
    Vec3 sub(Vec3 other)
    {
        return Vec3 {
            .x = self.x - other.x,
            .y = self.y - other.y,
            .z = self.z - other.z
        };
    }

    /// Returns the negated vector.
    Vec3 neg()
    {
        return Vec3 { .x = -self.x, .y = -self.y, .z = -self.z };
    }

    /// Returns the vector scaled by s.
    Vec3 scale(f32 s)
    {
        return Vec3 { .x = self.x * s, .y = self.y * s, .z = self.z * s };
    }

    /// Returns the component-wise product with other.
    Vec3 componentMul(Vec3 other)
    {
        return Vec3 {
            .x = self.x * other.x,
            .y = self.y * other.y,
            .z = self.z * other.z
        };
    }

    /// Returns the dot product with other.
    f32 dot(Vec3 other)
    {
        return self.x * other.x + self.y * other.y + self.z * other.z;
    }

    /// Returns the cross product with other.
    Vec3 cross(Vec3 other)
    {
        return Vec3 {
            .x = self.y * other.z - self.z * other.y,
            .y = self.z * other.x - self.x * other.z,
            .z = self.x * other.y - self.y * other.x
        };
    }

    /// Returns the squared length.
    f32 lengthSq()
    {
        return self.x * self.x + self.y * self.y + self.z * self.z;
    }

    /// Returns the length.
    f32 length()
    {
        return F32::sqrt(self.lengthSq());
    }

    /// Returns a unit-length vector, or this vector when its length is near zero.
    Vec3 normalize()
    {
        f32 len = self.length();
        if (len < 1e-15) return *self;
        return self.scale(1.0 / len);
    }

    /// Linearly interpolates from this vector to other by t.
    Vec3 lerp(Vec3 other, f32 t)
    {
        return Vec3 {
            .x = self.x + (other.x - self.x) * t,
            .y = self.y + (other.y - self.y) * t,
            .z = self.z + (other.z - self.z) * t
        };
    }
}

/// Four-component float32 vector.
pub struct Vec4
{
    f32 x;
    f32 y;
    f32 z;
    f32 w;

    /// Creates a vector from its components.
    static Vec4 new(f32 x, f32 y, f32 z, f32 w)
    {
        return Vec4 { .x = x, .y = y, .z = z, .w = w };
    }

    /// Returns the component-wise sum with other.
    Vec4 add(Vec4 other)
    {
        return Vec4 {
            .x = self.x + other.x,
            .y = self.y + other.y,
            .z = self.z + other.z,
            .w = self.w + other.w
        };
    }

    /// Returns the component-wise difference with other.
    Vec4 sub(Vec4 other)
    {
        return Vec4 {
            .x = self.x - other.x,
            .y = self.y - other.y,
            .z = self.z - other.z,
            .w = self.w - other.w
        };
    }

    /// Returns the negated vector.
    Vec4 neg()
    {
        return Vec4 {
            .x = -self.x, .y = -self.y, .z = -self.z, .w = -self.w
        };
    }

    /// Returns the xyz components as a Vec3.
    Vec3 xyz()
    {
        return Vec3 { .x = self.x, .y = self.y, .z = self.z };
    }

    /// Returns the vector scaled by s.
    Vec4 scale(f32 s)
    {
        return Vec4 {
            .x = self.x * s,
            .y = self.y * s,
            .z = self.z * s,
            .w = self.w * s
        };
    }

    /// Returns the dot product with other.
    f32 dot(Vec4 other)
    {
        return self.x * other.x + self.y * other.y + self.z * other.z + self.w * other.w;
    }

    /// Returns the squared length.
    f32 lengthSq()
    {
        return self.x * self.x + self.y * self.y + self.z * self.z + self.w * self.w;
    }

    /// Returns the length.
    f32 length()
    {
        return F32::sqrt(self.lengthSq());
    }

    /// Returns a unit-length vector, or this vector when its length is near zero.
    Vec4 normalize()
    {
        f32 len = self.length();
        if (len < 1e-15) return *self;
        return self.scale(1.0 / len);
    }

    /// Linearly interpolates from this vector to other by t.
    Vec4 lerp(Vec4 other, f32 t)
    {
        return Vec4 {
            .x = self.x + (other.x - self.x) * t,
            .y = self.y + (other.y - self.y) * t,
            .z = self.z + (other.z - self.z) * t,
            .w = self.w + (other.w - self.w) * t
        };
    }
}

/// Axis and angle extracted from a unit quaternion.
pub struct AxisAngle
{
    Vec3 axis;
    f32 angle;
}

/// Unit quaternion - rotation, chained with mul/rotate like the vectors.
pub struct Quat
{
    f32 x;
    f32 y;
    f32 z;
    f32 w;

    /// Returns the identity (no rotation) quaternion.
    static Quat identity()
    {
        return Quat { .x = 0.0f, .y = 0.0f, .z = 0.0f, .w = 1.0f };
    }

    /// Components in order (x, y, z, w) - w is the scalar part; for an
    /// axis-angle rotation w = cos(theta/2), xyz = axis * sin(theta/2).
    static Quat new(f32 x, f32 y, f32 z, f32 w)
    {
        return Quat { .x = x, .y = y, .z = z, .w = w };
    }

    /// Builds a rotation of `radians` around `axis`; zero axes give identity.
    static Quat fromAxisAngle(Vec3 axis, f32 radians)
    {
        Vec3 n = axis.normalize();
        if (n.lengthSq() < 1e-15f) return Quat::identity();
        f32 half = radians * 0.5f;
        f32 s = F32::sin(half);
        return Quat {
            .x = n.x * s,
            .y = n.y * s,
            .z = n.z * s,
            .w = F32::cos(half)
        };
    }

    /// Builds a quaternion from a rotation matrix.
    static Quat fromMat3(Mat3 m)
    {
        return m.toQuat();
    }

    /// Returns the squared length.
    f32 normSq()
    {
        return self.x * self.x + self.y * self.y
            + self.z * self.z + self.w * self.w;
    }

    /// Returns the length.
    f32 length()
    {
        return F32::sqrt(self.normSq());
    }

    /// Returns a unit-length quaternion, or identity when near zero.
    Quat normalize()
    {
        f32 len = self.length();
        if (len < 1e-15f) return Quat::identity();
        f32 inv = 1.0f / len;
        return Quat {
            .x = self.x * inv,
            .y = self.y * inv,
            .z = self.z * inv,
            .w = self.w * inv
        };
    }

    /// Returns the conjugate; equal to the inverse for unit quaternions.
    Quat conjugate()
    {
        return Quat { .x = -self.x, .y = -self.y, .z = -self.z, .w = self.w };
    }

    /// Returns the multiplicative inverse, or identity when near zero.
    Quat inverse()
    {
        f32 n = self.normSq();
        if (n < 1e-15f) return Quat::identity();
        f32 inv = 1.0f / n;
        return Quat {
            .x = -self.x * inv,
            .y = -self.y * inv,
            .z = -self.z * inv,
            .w = self.w * inv
        };
    }

    /// Returns the dot product with other.
    f32 dot(Quat other)
    {
        return self.x * other.x + self.y * other.y
            + self.z * other.z + self.w * other.w;
    }

    /// Spherically interpolates along the shortest path to other by t.
    Quat slerp(Quat other, f32 t)
    {
        Quat target = other;
        f32 d = self.dot(other);
        if (d < 0.0f)
        {
            target = Quat::new(-other.x, -other.y, -other.z, -other.w);
            d = -d;
        }
        d = F32::clamp(d, -1.0f, 1.0f);
        if (d > 0.9995f)
        {
            return Quat::new(
                self.x + (target.x - self.x) * t,
                self.y + (target.y - self.y) * t,
                self.z + (target.z - self.z) * t,
                self.w + (target.w - self.w) * t
            ).normalize();
        }
        f32 theta0 = F32::acos(d);
        f32 theta = theta0 * t;
        f32 sinTheta0 = F32::sin(theta0);
        f32 s0 = F32::sin(theta0 - theta) / sinTheta0;
        f32 s1 = F32::sin(theta) / sinTheta0;
        return Quat {
            .x = self.x * s0 + target.x * s1,
            .y = self.y * s0 + target.y * s1,
            .z = self.z * s0 + target.z * s1,
            .w = self.w * s0 + target.w * s1
        };
    }

    /// Extracts the normalized axis and counter-clockwise angle.
    AxisAngle toAxisAngle()
    {
        Quat q = self.normalize();
        f32 w = F32::clamp(q.w, -1.0f, 1.0f);
        f32 angle = 2.0f * F32::acos(w);
        f32 s = F32::sqrt(1.0f - w * w);
        if (s < 1e-6f)
            return AxisAngle { .axis = Vec3::new(1.0f, 0.0f, 0.0f), .angle = angle };
        return AxisAngle {
            .axis = Vec3::new(q.x / s, q.y / s, q.z / s),
            .angle = angle
        };
    }

    /// Converts this rotation to a column-major 3x3 matrix.
    Mat3 toMat3()
    {
        return Mat3::fromQuat(*self);
    }

    /// Hamilton product: a.mul(b) rotates by b first, then a.
    Quat mul(Quat other)
    {
        return Quat {
            .x = self.w * other.x + self.x * other.w + self.y * other.z - self.z * other.y,
            .y = self.w * other.y - self.x * other.z + self.y * other.w + self.z * other.x,
            .z = self.w * other.z + self.x * other.y - self.y * other.x + self.z * other.w,
            .w = self.w * other.w - self.x * other.x - self.y * other.y - self.z * other.z
        };
    }

    /// Rotates v: v' = v + 2q.w*(u×v) + 2*u×(u×v),  u = q.xyz
    Vec3 rotate(Vec3 v)
    {
        Vec3 u = Vec3 { .x = self.x, .y = self.y, .z = self.z };
        Vec3 t = u.cross(v).scale(2.0f);
        return v.add(t.scale(self.w)).add(u.cross(t));
    }
}

/// Column-major 3x3 matrix.
pub struct Mat3
{
    Vec3 col0;
    Vec3 col1;
    Vec3 col2;

    /// Returns the identity matrix.
    static Mat3 identity()
    {
        return Mat3 {
            .col0 = Vec3::new(1.0f, 0.0f, 0.0f),
            .col1 = Vec3::new(0.0f, 1.0f, 0.0f),
            .col2 = Vec3::new(0.0f, 0.0f, 1.0f)
        };
    }

    /// Builds a matrix from three column vectors.
    static Mat3 new(Vec3 col0, Vec3 col1, Vec3 col2)
    {
        return Mat3 { .col0 = col0, .col1 = col1, .col2 = col2 };
    }

    /// Converts a unit quaternion to a column-major rotation matrix.
    static Mat3 fromQuat(Quat q)
    {
        f32 xx = q.x * q.x;
        f32 yy = q.y * q.y;
        f32 zz = q.z * q.z;
        f32 xy = q.x * q.y;
        f32 xz = q.x * q.z;
        f32 yz = q.y * q.z;
        f32 wx = q.w * q.x;
        f32 wy = q.w * q.y;
        f32 wz = q.w * q.z;
        return Mat3 {
            .col0 = Vec3::new(
                1.0f - 2.0f * (yy + zz),
                2.0f * (xy + wz),
                2.0f * (xz - wy)
            ),
            .col1 = Vec3::new(
                2.0f * (xy - wz),
                1.0f - 2.0f * (xx + zz),
                2.0f * (yz + wx)
            ),
            .col2 = Vec3::new(
                2.0f * (xz + wy),
                2.0f * (yz - wx),
                1.0f - 2.0f * (xx + yy)
            )
        };
    }

    /// Returns the matrix-vector product.
    Vec3 mulVec3(Vec3 v)
    {
        return self.col0.scale(v.x)
            .add(self.col1.scale(v.y))
            .add(self.col2.scale(v.z));
    }

    /// Returns the matrix-matrix product.
    Mat3 mul(Mat3 other)
    {
        return Mat3 {
            .col0 = self.mulVec3(other.col0),
            .col1 = self.mulVec3(other.col1),
            .col2 = self.mulVec3(other.col2)
        };
    }

    /// Returns the transpose.
    Mat3 transpose()
    {
        return Mat3 {
            .col0 = Vec3::new(self.col0.x, self.col1.x, self.col2.x),
            .col1 = Vec3::new(self.col0.y, self.col1.y, self.col2.y),
            .col2 = Vec3::new(self.col0.z, self.col1.z, self.col2.z)
        };
    }

    /// Returns the determinant.
    f32 determinant()
    {
        return self.col0.dot(self.col1.cross(self.col2));
    }

    /// Returns the inverse, or identity when the matrix is singular.
    Mat3 inverse()
    {
        f32 det = self.determinant();
        if (F32::abs(det) < 1e-12f) return Mat3::identity();
        f32 inv = 1.0f / det;
        return Mat3 {
            .col0 = self.col1.cross(self.col2).scale(inv),
            .col1 = self.col2.cross(self.col0).scale(inv),
            .col2 = self.col0.cross(self.col1).scale(inv)
        };
    }

    /// Converts this rotation matrix to a unit quaternion.
    Quat toQuat()
    {
        f32 m00 = self.col0.x;
        f32 m01 = self.col1.x;
        f32 m02 = self.col2.x;
        f32 m10 = self.col0.y;
        f32 m11 = self.col1.y;
        f32 m12 = self.col2.y;
        f32 m20 = self.col0.z;
        f32 m21 = self.col1.z;
        f32 m22 = self.col2.z;
        f32 trace = m00 + m11 + m22;
        if (trace > 0.0f)
        {
            f32 s = F32::sqrt(trace + 1.0f) * 2.0f;
            return Quat::new(
                (m21 - m12) / s,
                (m02 - m20) / s,
                (m10 - m01) / s,
                0.25f * s).normalize();
        }
        if (m00 > m11 && m00 > m22)
        {
            f32 s = F32::sqrt(1.0f + m00 - m11 - m22) * 2.0f;
            return Quat::new(
                0.25f * s,
                (m01 + m10) / s,
                (m02 + m20) / s,
                (m21 - m12) / s).normalize();
        }
        if (m11 > m22)
        {
            f32 s = F32::sqrt(1.0f + m11 - m00 - m22) * 2.0f;
            return Quat::new(
                (m01 + m10) / s,
                0.25f * s,
                (m12 + m21) / s,
                (m02 - m20) / s).normalize();
        }
        f32 s = F32::sqrt(1.0f + m22 - m00 - m11) * 2.0f;
        return Quat::new(
            (m02 + m20) / s,
            (m12 + m21) / s,
            0.25f * s,
            (m10 - m01) / s).normalize();
    }
}

/// Position vector - f32, same layout as Vec3 (Jolt RVec3 is single precision
/// here); kept distinct so physics call sites read as positions.
pub struct RVec3
{
    f32 x;
    f32 y;
    f32 z;
}
