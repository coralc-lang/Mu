#! run `coralc build --force`

schema = 2;
strict = true;

alias sdl = "thirdparty/sdl";
alias bgfx = "thirdparty/bgfx";

build "MuEngine" {
    root       = "src/";
    entry      = "engine/main.crl";
    target     = "x86_64";
    opt        = "debug";
    output     = "build/muengine";
    module_map = ".coral/modules.map";
    cache_dir  = ".coral/cache";

    flags = ["--strict", "--warn-unused"];

    modules = [
        "alloc",
        "core",
        "engine",
        "math",
        "physics",
        "platform",
        "render",
        "scene",
        "script",
        "thirdparty",
        "thirdparty/sdl",
        "thirdparty/bgfx",
        "thirdparty/jolt"
        # "thirdparty/cgltf",
        # "thirdparty/drlibs",
        # "thirdparty/fastnoise",
        # "thirdparty/ktx",
        # "thirdparty/mikktspace",
        # "thirdparty/miniz",
        # "thirdparty/stb",
        # "thirdparty/tinyexr",
        # "thirdparty/tracy",
        # "thirdparty/zstd",
    ];

    link {
        libs = [
            "build/native/libmualibs.a",
            "build/native/joltc/libJoltC.a",
            "build/native/joltc/libJolt.a",
            "packaged/linux-x86_64/lib/libbgfx.a",
            "packaged/linux-x86_64/lib/libbimg.a",
            "packaged/linux-x86_64/lib/libbx.a",
            "packaged/linux-x86_64/lib/libSDL3.so",
            "stdc++",
            "m",
            "pthread",
            "dl",
        ];
        flags = [
            "-Wl,-rpath,$ORIGIN/../packaged/linux-x86_64/lib",
        ];
    }
}

# deps {
#     "jolt"  = { path = "third_party/jolt"; };
#     "joltc" = { path = "third_party/JoltPhysicsC"; };
#     "sdl"   = { path = "third_party/SDL"; };
#     "stb"   = { path = "third_party/stb"; };
#     "cgltf" = { path = "third_party/cgltf"; };
#     "miniz"   = { path = "third_party/miniz"; };
#     "tinyexr" = { path = "third_party/tinyexr"; };
#     "drlibs"  = { path = "third_party/dr_libs"; };
#     "fastnoise" = { path = "third_party/FastNoiseLite"; };
#    "mikktspace" = { path = "third_party/MikkTSpace"; };
# }

task "run" {
    after = ["build"];
    exec  = "build/muengine";
}

task "physics-probe" {
    after = ["build"];
    exec  = "bash -c 'MU_PHYSICS_PROBE=1 build/muengine'";
}

task "render-probe" {
    after = ["build"];
    exec  = "bash -c 'MU_RENDER_PROBE=1 build/muengine'";
}
